// wolf.pkg — the wws manifest (working name; the public name is
// undecided and this repo has no remote until the human chooses it).
// Zero dependencies, by charter: wws is a from-parts wolf program.
// The pinned nginx under tests/differential/ is TEST INFRASTRUCTURE,
// not a dependency (D15-spirit, the ws00 contract's reading).
// `name` is a placeholder scope: it changes exactly once, at naming.
pkg {
    name:    "local/wws",
    version: "0.0.1",
    edition: "1",
}
