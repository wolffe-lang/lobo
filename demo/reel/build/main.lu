// One wolf program builds the whole site.
fn card(title: str, text: str) -> str {
    "<section><h2>{title}</h2><p>{text}</p></section>\n"
}

fn main() -> !int {
    let head = """
        <!doctype html><html lang="en"><head>
        <meta charset="utf-8"><meta name="viewport"
          content="width=device-width, initial-scale=1">
        <title>hello from wolf</title><style>
        body {{ font-family: system-ui; margin: 3rem auto;
          background: #0f1419; color: #e6edf3;
          max-width: 40rem; padding: 0 1rem; }}
        section {{ background: #1a2129; padding: 1rem;
          border-radius: 12px; margin: 1rem 0; }}
        h2 {{ margin: 0 0 .4rem; color: #7cc4ff; }}
        </style></head><body><h1>hello from wolf</h1>
        """
    let a = card("Written in wolf", "A wolf program wrote me.")
    let b = card("Served by lobo", "A web server in wolf.")
    let c = card("On a laptop", "No cloud. One machine.")
    let page = "{head}{a}{b}{c}</body></html>\n"
    fs_create_dir_all("html/files")?
    fs_write_text("html/index.html", page)?

    var big = "wolf " // 5 bytes, doubled 18 times: 1.3 MB
    for _ in 0..18 { big = "{big}{big}" }
    fs_write_text("html/files/big.bin", big)?
    print("wrote html/index.html and html/files/big.bin")
    print("big.bin is {big.len} bytes")
    0
}
