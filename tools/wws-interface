#!/bin/sh
# wws-interface — emit or check the checked-in `.wolfi` interface
# snapshots (the ws00 module-boundary discipline). Make-free POSIX sh.
#
#   tools/wws-interface --emit    regenerate src/<mod>/<mod>.wolfi
#                                 (and src/root.wolfi) from the tree
#   tools/wws-interface --check   re-emit and diff; any drift is a
#                                 named failure telling the ritual
#
# The ritual: your module's INTERNALS are yours; its `.wolfi` is a
# contract. When your change moves a `.wolfi`, run `--emit` and commit
# the snapshot(s) ALONE, message starting `interface(<module>): …`
# (root.wolfi rides along when a dep hash moves). The gauntlet runs
# `--check`; an unsynced surface edit fails it.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh   # resolves $WOLF, $LUPIN, verifies the pin

mode="${1:---check}"
tmp="target/ifaces.$$"
mkdir -p "$tmp" || exit 2

if ! "$WOLF" interface ./src >"$tmp/stream" 2>"$tmp/warnings"; then
    echo "wws-interface: FAILED — \`wolf interface ./src\` did not resolve the package:" >&2
    cat "$tmp/warnings" >&2
    rm -rf "$tmp"
    exit 1
fi

# Split the stream into one file per module. `module pkg :: (root)`
# becomes root.wolfi; `module pkg :: http` becomes http.wolfi.
# `std.*` modules are the PINNED std tree's surfaces (ws05's [std] in
# wolf-toolchain.toml) — upstream's contract, not this repo's; they are
# skipped, exactly as the toolchain binaries are not re-described here.
awk -v out="$tmp" '
    /^module pkg :: / {
        name = $4
        gsub(/[()]/, "", name)
        if (name ~ /^std\./) { file = "" } else { file = out "/" name ".wolfi" }
    }
    file != "" { print > file }
' "$tmp/stream"

rc=0
for f in "$tmp"/*.wolfi; do
    name=$(basename "$f" .wolfi)
    if [ "$name" = "root" ]; then dest="src/root.wolfi"; else dest="src/$name/$name.wolfi"; fi
    case "$mode" in
    --emit)
        cp "$f" "$dest"
        echo "wws-interface: wrote $dest"
        ;;
    --check)
        if [ ! -f "$dest" ]; then
            echo "wws-interface: FAILED — $dest is missing; run tools/wws-interface --emit and commit it as \`interface($name): …\`" >&2
            rc=1
        elif ! diff -u "$dest" "$f" >"$tmp/diff.$name" 2>&1; then
            echo "wws-interface: FAILED — module \`$name\` public surface drifted from its checked-in $dest:" >&2
            cat "$tmp/diff.$name" >&2
            echo "wws-interface: an interface change is a cross-lane contract change — run tools/wws-interface --emit and commit the snapshot ALONE, message \`interface($name): …\`" >&2
            rc=1
        fi
        ;;
    *)
        echo "usage: tools/wws-interface [--emit|--check]" >&2
        rm -rf "$tmp"
        exit 2
        ;;
    esac
done

# The reverse direction: a checked-in snapshot whose module vanished.
for dest in src/root.wolfi src/*/*.wolfi; do
    [ -f "$dest" ] || continue
    name=$(basename "$dest" .wolfi)
    if [ ! -f "$tmp/$name.wolfi" ]; then
        echo "wws-interface: FAILED — $dest names a module the tree no longer has" >&2
        rc=1
    fi
done

rm -rf "$tmp"
[ "$rc" = 0 ] && [ "$mode" = "--check" ] && echo "wws-interface: all module surfaces match their snapshots"
exit $rc
