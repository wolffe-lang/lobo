#!/bin/sh
# lobo-differential — the nginx differential harness. From ws02 lobo runs
# BESIDE the pinned oracle: for each case, the SAME raw request is
# replayed against the pinned nginx AND against lobo (each on its own
# loopback ephemeral port, each started from the checked-in minimal
# config templates), both replies are normalized by exactly the
# checked-in NORMALIZE list, and BOTH are byte-compared to the case's
# pinned `--- expect`. A case is green only when nginx AND lobo match
# the expected reply — the falsifiable drop-in claim (docs/DIFFERENTIAL.md).
#
# REFUSES, naming the pin, when the oracle is absent or drifted. The
# lobo side uses the release binary the gauntlet built (target/
# lobo-release); it is rebuilt by the gauntlet's tiers step before this
# runs.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

DIFF_DIR=tests/differential
BIN=$DIFF_DIR/bin/nginx
LOBO="$rig_root/target/lobo-release"
pin_version=$(sed -n 's/^version = //p' $DIFF_DIR/NGINX-PIN)
pin_configure=$(sed -n 's/^configure = //p' $DIFF_DIR/NGINX-PIN)

if [ ! -x "$BIN" ]; then
    echo "differential: REFUSED — pinned nginx binary missing at $BIN" >&2
    echo "differential: the pin is nginx/$pin_version (tests/differential/NGINX-PIN); build it once per docs/DIFFERENTIAL.md" >&2
    exit 1
fi
have_version=$("$BIN" -v 2>&1 | sed -n 's|^nginx version: nginx/||p')
if [ "$have_version" != "$pin_version" ]; then
    echo "differential: REFUSED — $BIN is nginx/$have_version, the pin (tests/differential/NGINX-PIN) is nginx/$pin_version" >&2
    echo "differential: rebuild the oracle per docs/DIFFERENTIAL.md" >&2
    exit 1
fi
have_configure=$("$BIN" -V 2>&1 | sed -n 's|^configure arguments: |./configure |p' | sed 's/ *$//')
if [ "$have_configure" != "$pin_configure" ]; then
    echo "differential: NOTE — configure-line drift (reported, not gated):" >&2
    echo "differential:   pin:   $pin_configure" >&2
    echo "differential:   built: $have_configure" >&2
fi
if [ ! -x "$LOBO" ]; then
    echo "differential: REFUSED — lobo release binary missing at $LOBO (the gauntlet's tiers step builds it before this runs)" >&2
    exit 1
fi

# normalize <in >out : replace the VALUE of every header the NORMALIZE
# list names with `<normalized>`, in the header section only. Applied
# to BOTH sides of every diff — the one normalizer is the whole
# tolerance of this harness.
# ws41: one BODY rule, `@error-footer` in NORMALIZE. A 4xx/5xx default
# page ends in the server's identity footer (`<hr><center>nginx/1.30.4
# </center>`, lobo's own token on lobo), so its body AND its
# Content-Length differ by exactly the token. When the list carries the
# rule, an error response whose body has that footer line gets the
# footer's text replaced by `<normalized>`, and its Content-Length
# replaced too — but ONLY when the declared length equals the body's
# actual byte count, so a wrong length still reds. Bytes, not chars:
# the awk runs under LC_ALL=C.
normalize() {
    LC_ALL=C awk -v listfile="$DIFF_DIR/NORMALIZE" '
        BEGIN {
            while ((getline l < listfile) > 0) {
                sub(/#.*/, "", l)
                gsub(/^[ \t]+|[ \t]+$/, "", l)
                if (l == "@error-footer") footer = 1
                else if (l != "") norm[tolower(l)] = 1
            }
        }
        { buf[NR] = $0 }
        END {
            hdr = 1; blank = 0; code = 0; cl = -1; clat = 0; foot = 0; body = 0
            split(buf[1], sl, " ")
            code = sl[2] + 0
            for (i = 1; i <= NR; i++) {
                probe = buf[i]
                sub(/\r$/, "", probe)
                if (hdr) {
                    if (probe == "") { hdr = 0; blank = i; continue }
                    n = index(probe, ":")
                    if (n > 1 && tolower(substr(probe, 1, n - 1)) == "content-length") {
                        cl = substr(probe, n + 1) + 0; clat = i
                    }
                } else {
                    body += length(buf[i]) + 1
                    if (probe ~ /^<hr><center>[^<]*<\/center>$/) foot = i
                }
            }
            fix = footer && code >= 400 && foot > 0 && clat > 0 && cl == body
            for (i = 1; i <= NR; i++) {
                line = buf[i]
                if (blank == 0 || i < blank) {
                    probe = line
                    sub(/\r$/, "", probe)
                    n = index(probe, ":")
                    if (n > 1 && tolower(substr(probe, 1, n - 1)) in norm) {
                        print substr(probe, 1, n - 1) ": <normalized>\r"
                        continue
                    }
                    if (fix && i == clat) {
                        print "Content-Length: <normalized>\r"
                        continue
                    }
                }
                if (fix && i == foot) {
                    print "<hr><center><normalized></center>\r"
                    continue
                }
                print line
            }
        }'
}

# server_extra <casefile> : the case's optional `--- server` section —
# directives spliced into BOTH servers' `server {}` at the templates'
# `@SERVER@` line (ws41: `max_ranges` per case). Empty when absent.
server_extra() {
    awk '
        {
            probe = $0
            sub(/\r$/, "", probe)
            if (probe ~ /^--- /) { in_s = (probe == "--- server"); next }
            if (in_s) print probe
        }' "$1"
}

# render <template> <port> <root> <extrafile> <out> : substitute the
# port and root, and splice the case's server directives at @SERVER@.
render() {
    sed -e "s|@PORT@|$2|" -e "s|@ROOT@|$3|" "$1" |
        awk -v extra="$4" '
            /^[ \t]*@SERVER@[ \t]*$/ {
                while ((getline l < extra) > 0) print "    " l
                next
            }
            { print }' > "$5"
}

# section <name> <casefile> : print a case section's raw bytes.
section() {
    awk -v want="--- $1" '
        {
            probe = $0
            sub(/\r$/, "", probe)
            if (probe ~ /^--- /) { in_s = (probe == want); next }
            if (in_s) print
        }' "$2"
}

# free_port : an OS-chosen ephemeral loopback port via the wolf rig.
free_port() {
    for _ in 1 2 3 4 5; do
        p=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu 2>/dev/null)
        case "$p" in '' | *[!0-9]*) continue ;; esac
        echo "$p"
        return 0
    done
    return 1
}

# send <port> <reqfile> <outfile> : replay the request, capture reply.
# Retries against the release-to-rebind race and the not-ready window.
send() {
    _port=$1
    _req=$2
    _out=$3
    for _poll in $(seq 1 50); do
        if "$WOLF" run "$rig_root"/tests/rig/diffsend.lu "$_port" "$_req" > "$_out" 2> "$_out.err"; then
            return 0
        fi
        grep -q 'error: refused' "$_out.err" || return 1
        sleep 0.1
    done
    return 1
}

failures=0
cases=0
for case in "$DIFF_DIR"/cases/*.case; do
    [ -f "$case" ] || continue
    cases=$((cases + 1))
    name=$(basename "$case" .case)
    scratch="target/differential/$name"
    rm -rf "$scratch"
    mkdir -p "$scratch/logs"
    cp -r "$DIFF_DIR/www" "$scratch/www"
    # deterministic Last-Modified/ETag: the corpus pins the mtime
    find "$scratch/www" -type f -exec touch -d '2026-01-01T00:00:00Z' {} +
    section request "$case" > "$scratch/request.raw"
    section expect "$case" > "$scratch/expect.raw"
    server_extra "$case" > "$scratch/server.extra"
    normalize < "$scratch/expect.raw" > "$scratch/expect.norm"

    # ---- the oracle side ----
    ng_ok=0
    for attempt in 1 2 3; do
        nport=$(free_port) || continue
        render "$DIFF_DIR/nginx.conf.in" "$nport" "$(pwd)/$scratch" "$scratch/server.extra" "$scratch/nginx.conf"
        "$BIN" -p "$(pwd)/$scratch" -c nginx.conf -e error.log &
        ngpid=$!
        if send "$nport" "$scratch/request.raw" "$scratch/nginx.actual"; then
            ng_ok=1
        fi
        kill "$ngpid" 2>/dev/null
        wait "$ngpid" 2>/dev/null
        [ "$ng_ok" = 1 ] && break
    done

    # ---- the lobo side (same request, its own port) ----
    lobo_ok=0
    for attempt in 1 2 3; do
        wport=$(free_port) || continue
        render "$DIFF_DIR/lobo.conf.in" "$wport" "$(pwd)/$scratch" "$scratch/server.extra" "$scratch/lobo.conf"
        "$LOBO" serve -p "$(pwd)/$scratch" -c "$(pwd)/$scratch/lobo.conf" \
            2> "$scratch/lobo.err" &
        lobopid=$!
        if send "$wport" "$scratch/request.raw" "$scratch/lobo.actual"; then
            lobo_ok=1
        fi
        kill "$lobopid" 2>/dev/null
        wait "$lobopid" 2>/dev/null
        [ "$lobo_ok" = 1 ] && break
    done

    if [ "$ng_ok" != 1 ]; then
        echo "differential: FAILED — $name: nginx never answered" >&2
        failures=$((failures + 1))
        continue
    fi
    if [ "$lobo_ok" != 1 ]; then
        echo "differential: FAILED — $name: lobo never answered (see $scratch/lobo.err)" >&2
        failures=$((failures + 1))
        continue
    fi

    normalize < "$scratch/nginx.actual" > "$scratch/nginx.norm"
    normalize < "$scratch/lobo.actual" > "$scratch/lobo.norm"

    ok=1
    if ! diff -u "$scratch/expect.norm" "$scratch/nginx.norm" > "$scratch/nginx.diff"; then
        echo "differential: FAILED — $name: the ORACLE diverged from expect (the pin is stale?):" >&2
        cat "$scratch/nginx.diff" >&2
        ok=0
    fi
    if ! diff -u "$scratch/expect.norm" "$scratch/lobo.norm" > "$scratch/lobo.diff"; then
        echo "differential: FAILED — $name: LOBO diverged from the expected reply (modulo NORMALIZE):" >&2
        cat "$scratch/lobo.diff" >&2
        ok=0
    fi
    if [ "$ok" = 1 ]; then
        echo "differential: ok — $name (nginx/$have_version and lobo both match, on loopback)"
    else
        failures=$((failures + 1))
    fi
done

if [ "$cases" = 0 ]; then
    echo "differential: FAILED — no case files under $DIFF_DIR/cases/" >&2
    exit 1
fi
echo "differential: $((cases - failures))/$cases case(s) green (oracle + lobo vs expect)"
[ "$failures" = 0 ] || exit 1
