#!/bin/sh
# lobo-proxy-differential — the TWO-SIDED proxy differential (ws03). A
# reverse proxy's compat is unverifiable from the client side alone, so
# this harness runs BOTH the pinned nginx AND lobo as the FRONT PROXY,
# each against its own instance of the SAME rig backend (tests/rig/
# rigback), and byte-compares BOTH legs of each exchange:
#   - the CLIENT-facing response (Server/Date normalized, as ws02), and
#   - the BACKEND-recorded request the proxy actually sent upstream
#     (the backend port normalized to @BPORT@ — the one dynamic value).
# A case is green only when nginx AND lobo agree with the case's pinned
# `--- expect-client` and `--- expect-backend`. W3 declares on this.
#
# REFUSES, naming the pin, when the oracle is absent/drifted. Loopback
# only, port 0 everywhere (the #121 lesson), deadline on every read.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

DIFF_DIR=tests/differential
BIN=$DIFF_DIR/bin/nginx
LOBO=target/lobo-release
RIGBACK="$rig_root/tests/rig/rigback/rigback.lu"
pin_version=$(sed -n 's/^version = //p' $DIFF_DIR/NGINX-PIN)

if [ ! -x "$BIN" ]; then
    echo "proxy-differential: REFUSED — pinned nginx missing at $BIN (nginx/$pin_version; build per docs/DIFFERENTIAL.md)" >&2
    exit 1
fi
have_version=$("$BIN" -v 2>&1 | sed -n 's|^nginx version: nginx/||p')
if [ "$have_version" != "$pin_version" ]; then
    echo "proxy-differential: REFUSED — $BIN is nginx/$have_version, the pin is nginx/$pin_version" >&2
    exit 1
fi
if [ ! -x "$LOBO" ]; then
    echo "proxy-differential: REFUSED — lobo release binary missing at $LOBO (the gauntlet's tiers step builds it)" >&2
    exit 1
fi

# normalize <in >out : replace the VALUE of every NORMALIZE-named
# response header with <normalized>, header section only (client leg).
normalize() {
    awk -v listfile="$DIFF_DIR/NORMALIZE" '
        BEGIN {
            while ((getline l < listfile) > 0) {
                sub(/#.*/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l)
                if (l != "") norm[tolower(l)] = 1
            }
            hdr = 1
        }
        {
            line = $0
            if (hdr) {
                probe = line; sub(/\r$/, "", probe)
                if (probe == "") { hdr = 0; print line; next }
                n = index(probe, ":")
                if (n > 1 && tolower(substr(probe, 1, n - 1)) in norm) {
                    print substr(probe, 1, n - 1) ": <normalized>\r"; next
                }
            }
            print line
        }'
}

# section <name> <casefile> : print a case section's raw bytes.
section() {
    awk -v want="--- $1" '
        { probe = $0; sub(/\r$/, "", probe)
          if (probe ~ /^--- /) { in_s = (probe == want); next }
          if (in_s) print }' "$2"
}

# free front port via the wolf rig.
free_port() {
    for _ in 1 2 3 4 5; do
        p=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu 2>/dev/null)
        case "$p" in '' | *[!0-9]*) continue ;; esac
        echo "$p"; return 0
    done
    return 1
}

# start_backend <record> <reply> <portfile> <errfile> : launch rigback,
# echo its pid; the caller polls <portfile> for the chosen port.
start_backend() {
    "$WOLF" run "$RIGBACK" "$1" "$2" 1 >"$3" 2>"$4" &
    echo $!
}

# wait_port <portfile> : poll for a numeric port, echo it (or fail).
wait_port() {
    for _ in $(seq 1 50); do
        p=$(head -1 "$1" 2>/dev/null)
        case "$p" in '' | *[!0-9]*) sleep 0.1; continue ;; esac
        echo "$p"; return 0
    done
    return 1
}

# send <port> <reqfile> <outfile> : replay the client request, capture
# the reply (retry against the not-ready window).
send() {
    for _poll in $(seq 1 50); do
        if "$WOLF" run "$rig_root"/tests/rig/diffsend.lu "$1" "$2" >"$3" 2>"$3.err"; then
            return 0
        fi
        grep -q 'error: refused' "$3.err" || return 1
        sleep 0.1
    done
    return 1
}

# run_side <which> <bin-invocation...> — sets globals via files. Too
# many moving parts for a function return; inlined per side below.

failures=0
cases=0
for case in "$DIFF_DIR"/proxy-cases/*.case; do
    [ -f "$case" ] || continue
    cases=$((cases + 1))
    name=$(basename "$case" .case)
    scratch="target/proxy-differential/$name"
    rm -rf "$scratch"; mkdir -p "$scratch"
    section request "$case" >"$scratch/request.raw"
    section reply "$case" >"$scratch/reply.raw"
    section expect-client "$case" >"$scratch/expect-client.raw"
    section expect-backend "$case" >"$scratch/expect-backend.raw"
    normalize <"$scratch/expect-client.raw" >"$scratch/expect-client.norm"
    # expect-backend is stored pre-normalized (port already @BPORT@)
    cp "$scratch/expect-backend.raw" "$scratch/expect-backend.norm"

    ok=1

    # ---------- the ORACLE side ----------
    ng_ok=0
    for attempt in 1 2 3; do
        rm -f "$scratch/ng.record"
        ngpid=$(start_backend "$scratch/ng.record" "$scratch/reply.raw" "$scratch/ng.bport" "$scratch/ng.rb.err")
        bport=$(wait_port "$scratch/ng.bport") || { kill "$ngpid" 2>/dev/null; continue; }
        fport=$(free_port) || { kill "$ngpid" 2>/dev/null; continue; }
        sed -e "s|@PORT@|$fport|" -e "s|@BACKEND@|127.0.0.1:$bport|" \
            "$DIFF_DIR/nginx.proxy.conf.in" >"$scratch/nginx.conf"
        "$BIN" -p "$(pwd)/$scratch" -c nginx.conf -e error.log &
        proxypid=$!
        if send "$fport" "$scratch/request.raw" "$scratch/ng.client"; then ng_ok=1; fi
        kill "$proxypid" 2>/dev/null; wait "$proxypid" 2>/dev/null
        kill "$ngpid" 2>/dev/null; wait "$ngpid" 2>/dev/null
        ng_bport=$bport
        [ "$ng_ok" = 1 ] && break
    done

    # ---------- the lobo side ----------
    lobo_ok=0
    for attempt in 1 2 3; do
        rm -f "$scratch/lobo.record"
        lobobpid=$(start_backend "$scratch/lobo.record" "$scratch/reply.raw" "$scratch/lobo.bport" "$scratch/lobo.rb.err")
        bport=$(wait_port "$scratch/lobo.bport") || { kill "$lobobpid" 2>/dev/null; continue; }
        fport=$(free_port) || { kill "$lobobpid" 2>/dev/null; continue; }
        sed -e "s|@PORT@|$fport|" -e "s|@BACKEND@|127.0.0.1:$bport|" \
            "$DIFF_DIR/lobo.proxy.conf.in" >"$scratch/lobo.conf"
        "$LOBO" serve -p "$(pwd)/$scratch" -c "$(pwd)/$scratch/lobo.conf" 2>"$scratch/lobo.err" &
        proxypid=$!
        if send "$fport" "$scratch/request.raw" "$scratch/lobo.client"; then lobo_ok=1; fi
        kill "$proxypid" 2>/dev/null; wait "$proxypid" 2>/dev/null
        kill "$lobobpid" 2>/dev/null; wait "$lobobpid" 2>/dev/null
        lobo_bport=$bport
        [ "$lobo_ok" = 1 ] && break
    done

    if [ "$ng_ok" != 1 ]; then
        echo "proxy-differential: FAILED — $name: nginx never answered" >&2
        failures=$((failures + 1)); continue
    fi
    if [ "$lobo_ok" != 1 ]; then
        echo "proxy-differential: FAILED — $name: lobo never answered (see $scratch/lobo.err)" >&2
        failures=$((failures + 1)); continue
    fi

    # normalize the client legs (Server/Date) and the backend legs
    # (the dynamic backend port → @BPORT@)
    normalize <"$scratch/ng.client" >"$scratch/ng.client.norm"
    normalize <"$scratch/lobo.client" >"$scratch/lobo.client.norm"
    sed "s|127.0.0.1:$ng_bport|127.0.0.1:@BPORT@|g" "$scratch/ng.record" >"$scratch/ng.record.norm"
    sed "s|127.0.0.1:$lobo_bport|127.0.0.1:@BPORT@|g" "$scratch/lobo.record" >"$scratch/lobo.record.norm"

    # ---- the four comparisons ----
    if ! diff -u "$scratch/expect-client.norm" "$scratch/ng.client.norm" >"$scratch/d1" 2>&1; then
        echo "proxy-differential: FAILED — $name: ORACLE client leg diverged from expect (pin stale?):" >&2
        cat "$scratch/d1" >&2; ok=0
    fi
    if ! diff -u "$scratch/expect-client.norm" "$scratch/lobo.client.norm" >"$scratch/d2" 2>&1; then
        echo "proxy-differential: FAILED — $name: LOBO client leg diverged from expect:" >&2
        cat "$scratch/d2" >&2; ok=0
    fi
    if ! diff -u "$scratch/expect-backend.norm" "$scratch/ng.record.norm" >"$scratch/d3" 2>&1; then
        echo "proxy-differential: FAILED — $name: ORACLE backend leg diverged from expect (pin stale?):" >&2
        cat "$scratch/d3" >&2; ok=0
    fi
    if ! diff -u "$scratch/expect-backend.norm" "$scratch/lobo.record.norm" >"$scratch/d4" 2>&1; then
        echo "proxy-differential: FAILED — $name: LOBO backend leg diverged from expect:" >&2
        cat "$scratch/d4" >&2; ok=0
    fi

    if [ "$ok" = 1 ]; then
        echo "proxy-differential: ok — $name (nginx + lobo agree, client AND backend legs, on loopback)"
    else
        failures=$((failures + 1))
    fi
done

# ==================================================================
# the https cases (wsm04, D21 retired): the UPSTREAM is the pinned
# oracle itself serving TLS 1.3 with the static fixture certificates
# (tests/tls/fixtures — Ed25519, SAN localhost: the exact profile
# lobo's std.x.tls.client speaks), and BOTH fronts proxy_pass
# https:// to it with verification ON against the fixture CA. The
# CLIENT leg byte-compares (Server/Date normalized); there is no
# backend-record leg here — the upstream is the oracle, not the
# recording rig backend (the request-building discipline is pinned by
# the plaintext cases; what an https case adds is the VERIFIED TLS
# dial). Case sections: request, body (the upstream's index.html,
# mtime pinned like the static corpus), expect-client. Requires the
# ssl-enabled oracle (the wsm04 NGINX-PIN).
# ==================================================================

FIX="$(pwd)/tests/tls/fixtures"

# wait until a TCP port accepts — the https upstream's readiness gate
# (the send() retry only covers the FRONT's not-ready window; a front
# that dials a half-up upstream would answer a real 502)
wait_tcp() { # <port>
    for _ in $(seq 1 50); do
        if nc -z 127.0.0.1 "$1" 2>/dev/null; then return 0; fi
        sleep 0.1
    done
    return 1
}

for case in "$DIFF_DIR"/proxy-https-cases/*.case; do
    [ -f "$case" ] || continue
    cases=$((cases + 1))
    name=$(basename "$case" .case)
    scratch="target/proxy-differential/$name"
    rm -rf "$scratch"; mkdir -p "$scratch/www" "$scratch/up"
    section request "$case" >"$scratch/request.raw"
    section body "$case" >"$scratch/www/index.html"
    section expect-client "$case" >"$scratch/expect-client.raw"
    normalize <"$scratch/expect-client.raw" >"$scratch/expect-client.norm"
    # deterministic Last-Modified/ETag through the proxy: pinned mtime
    find "$scratch/www" -type f -exec touch -d '2026-01-01T00:00:00Z' {} +

    ok=1
    for side in ng lobo; do
        side_ok=0
        for attempt in 1 2 3; do
            uport=$(free_port) || continue
            sed -e "s|@UPORT@|$uport|" -e "s|@CERT@|$FIX/fullchain.pem|" \
                -e "s|@KEY@|$FIX/leaf.key|" -e "s|@ROOT@|$(pwd)/$scratch|" \
                "$DIFF_DIR/nginx.upstream-https.conf.in" >"$scratch/up/nginx.conf"
            "$BIN" -p "$(pwd)/$scratch/up" -c nginx.conf -e error.log &
            uppid=$!
            if ! wait_tcp "$uport"; then
                kill "$uppid" 2>/dev/null; wait "$uppid" 2>/dev/null; continue
            fi
            fport=$(free_port) || { kill "$uppid" 2>/dev/null; wait "$uppid" 2>/dev/null; continue; }
            if [ "$side" = ng ]; then
                sed -e "s|@PORT@|$fport|" -e "s|@UPSTREAM@|localhost:$uport|" \
                    -e "s|@CA@|$FIX/ca.crt|" \
                    "$DIFF_DIR/nginx.proxy-https.conf.in" >"$scratch/nginx.conf"
                "$BIN" -p "$(pwd)/$scratch" -c nginx.conf -e error.log &
            else
                sed -e "s|@PORT@|$fport|" -e "s|@UPSTREAM@|localhost:$uport|" \
                    -e "s|@CA@|$FIX/ca.crt|" \
                    "$DIFF_DIR/lobo.proxy-https.conf.in" >"$scratch/lobo.conf"
                "$LOBO" serve -p "$(pwd)/$scratch" -c "$(pwd)/$scratch/lobo.conf" 2>"$scratch/lobo.err" &
            fi
            proxypid=$!
            if send "$fport" "$scratch/request.raw" "$scratch/$side.client"; then side_ok=1; fi
            kill "$proxypid" 2>/dev/null; wait "$proxypid" 2>/dev/null
            kill "$uppid" 2>/dev/null; wait "$uppid" 2>/dev/null
            [ "$side_ok" = 1 ] && break
        done
        if [ "$side_ok" != 1 ]; then
            echo "proxy-differential: FAILED — $name: $side never answered over the https leg" >&2
            [ "$side" = lobo ] && tail -4 "$scratch/lobo.err" >&2
            ok=0
        fi
    done

    if [ "$ok" = 1 ]; then
        normalize <"$scratch/ng.client" >"$scratch/ng.client.norm"
        normalize <"$scratch/lobo.client" >"$scratch/lobo.client.norm"
        if ! diff -u "$scratch/expect-client.norm" "$scratch/ng.client.norm" >"$scratch/d1" 2>&1; then
            echo "proxy-differential: FAILED — $name: ORACLE https client leg diverged from expect (pin stale?):" >&2
            cat "$scratch/d1" >&2; ok=0
        fi
        if ! diff -u "$scratch/expect-client.norm" "$scratch/lobo.client.norm" >"$scratch/d2" 2>&1; then
            echo "proxy-differential: FAILED — $name: LOBO https client leg diverged from expect:" >&2
            cat "$scratch/d2" >&2; ok=0
        fi
    fi

    if [ "$ok" = 1 ]; then
        echo "proxy-differential: ok — $name (nginx + lobo agree through a VERIFIED https upstream, on loopback)"
    else
        failures=$((failures + 1))
    fi
done

if [ "$cases" = 0 ]; then
    echo "proxy-differential: FAILED — no case files under $DIFF_DIR/proxy-cases/" >&2
    exit 1
fi
echo "proxy-differential: $((cases - failures))/$cases case(s) green (two-sided: oracle + lobo vs expect, both legs)"
[ "$failures" = 0 ] || exit 1
