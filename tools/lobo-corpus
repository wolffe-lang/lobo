#!/bin/sh
# lobo-corpus — the directive-file test runner. Make-free POSIX sh + jq
# (the one host tool the rig leans on; CI runners and dev boxes both
# carry it — see .docs/STYLE.md on why the runner is shell while the
# tests themselves are wolf).
#
# Format: wolf-lang's corpus directive header, verbatim —
#   //! check: run(exit=N[, stdout="…"])     (\n \" \\ escapes)
# `\r` is NOT in the upstream directive grammar (either machine), and
# a header lupin cannot parse silently JOINS the sibling-module merge
# (E0302 across the whole directory) — so this runner REFUSES a check
# line spelling `\r` rather than accepting what the loaders cannot.
# CRLF-bearing assertions print through `str.replace("\r\n", "~")`
# (see split_reply_edges.lu). Filed upstream: a web corpus wants \r.
#   //! phase: run
#   //! lanes: native checked lupin           (lobo delta: in-file lane
#                                              routing; default all 3)
# Member files (`//! member: true`) are modules, not tests. A lane a
# file DECLARES must run and match — `unsupported` on a declared lane
# is a failure, and a non-empty warnings array on any lane is a
# failure (the house deny-warnings rule; conform-run still has no
# --deny-warnings upstream).
#
#   //! stage-src: config [...]               (ws01: stage the named
#                                              src/ modules beside the
#                                              test and run the staged
#                                              copy)
#   //! explore: N                            (ws11: lupin lane only —
#                                              the file's WHOLE schedule
#                                              space, explored)
#   //! checked-refuses: <construct>          (ws14: the checked lane of
#                                              this runner is `wolf
#                                              conform-run --checked`, the
#                                              s23 UB machine — an
#                                              interpreter that refuses
#                                              structured concurrency BY
#                                              NAME at the expression it
#                                              reaches (`spawn`, scopes,
#                                              `select`; C1 deferred) —
#                                              NOT `wolf run --checked`,
#                                              which is the native build
#                                              under the checked profile
#                                              and runs procs. A file
#                                              whose run reaches a proc
#                                              therefore does not
#                                              declare `checked`; it
#                                              declares the exact
#                                              construct string the
#                                              machine's record must
#                                              carry in
#                                              `x-unsupported-construct`
#                                              (s134 named the refusal;
#                                              wolf-lang#219), and the
#                                              runner ASSERTS that
#                                              refusal as a lane-run —
#                                              a refusal by the wrong
#                                              name, a run, or a crash
#                                              is red. Never a blanket
#                                              skip: the lane is stated.)
# An explore-marked file runs `lupin conform-run --explore=N` after its
# lanes: every reachable interleaving must agree AND the frontier must
# CLOSE — an open frontier is red even on agreement (a verdict
# conditional on its budget is not a verdict), and a schedule-dependent
# outcome is red with the explorer's replay seed + decision stream
# printed (the two-command repro; docs/REPLAY.md is the workflow).
#
# LOBO_SEED=<n> seeds every lupin-lane run (`--seed=$LOBO_SEED`) — the
# ws11 replay knob: rerun the suite under the seed a bug report names.
# Unset, the lupin lane is the strict-FIFO default as ever.
# The loader's package root is the ENTRY FILE's directory, so a test
# under tests/ cannot `use` a src/ module in place. A committed
# symlink would work on the dev host and be a unixism in the tree, so
# the runner STAGES instead: copy the test plus each named src module
# into target/corpus-stage/<mangled-path>/ and run that entry. The
# staged copy is remade on every run — it cannot drift. cwd stays the
# repo root on every lane, so relative fs paths in tests still name
# repo paths.
#
#   tools/lobo-corpus [tests/...]    default: every .lu under tests/
#
# PROCESS HYGIENE (ws25, lobo#1). Every lane runs under `timeout -k 5
# $LOBO_LANE_CEILING` (default 60 s) in its OWN process group — the one
# timeout(1) leads — registered with tools/lib-rigproc.sh, so:
#   * the ceiling kills the whole group (the test, the master it
#     spawned, the hands the master spawned) — TERM, then KILL 5 s
#     later for a master that mishandles TERM;
#   * a signal to THIS runner (Ctrl-C, the tool ceiling) runs its trap,
#     which kills the in-flight group the same way, then reaps by name;
#   * after EVERY test file the runner takes a census: a test that
#     returned and left a process of this checkout's running (a master
#     it forgot to stop, a hand its SIGKILL orphaned) is RED by name,
#     and reaped. Three seconds of grace, because a `stop` fans out.
# The 60 s ceiling is the runner's own (the native lane's is 3x, its
# cold compile being inside it — see run_lane); LOBO_LANE_CEILING=<s>
# lowers it — the proof in the ws25 CHANGELOG entry kills prefork_e2e
# mid-run at LOBO_LANE_CEILING=4 and shows an empty census. A lane
# that took 20 s or more prints its wall beside its verdict.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

roots="${*:-tests}"
total=0
red=0
lobo_seed="${LOBO_SEED:-}"
if [ -n "$lobo_seed" ]; then
    echo "corpus: lupin lane runs SEEDED (--seed=$lobo_seed — the ws11 replay knob; unset LOBO_SEED for the FIFO default)"
fi
ceiling="${LOBO_LANE_CEILING:-60}"
if [ "$ceiling" != 60 ]; then
    echo "corpus: lane ceiling is ${ceiling}s (LOBO_LANE_CEILING; the default is 60)"
fi
mkdir -p target/corpus-run
grc=0
rec=""

# run_group <ceiling> <outfile> <stderr> <cmd...> — the command under
# the ceiling in its own process group (timeout's), registered with
# rigproc for the life of the run so the trap can take it down; stdout
# to <outfile>, stderr to <stderr>; the exit in $grc (124 = the
# ceiling, 137 = killed after the grace). Background + wait, not a
# `$(...)`: a trapped signal returns from `wait` at once and runs the
# trap, where a foreground command would hold the trap until it ended.
run_group() {
    _rg_c=$1
    _rg_o=$2
    _rg_e=$3
    shift 3
    timeout -k 5 "$_rg_c" "$@" > "$_rg_o" 2> "$_rg_e" &
    _rg_g=$!
    rig_group_add "$_rg_g"
    wait "$_rg_g"
    grc=$?
    # at the ceiling timeout(1) TERMs the group and returns as soon as
    # its own child dies — its -k KILL never fires for the REST of
    # the group, and a master that took the TERM mid-`quit` absorbs it
    # (measured at LOBO_LANE_CEILING=3: master and two hands alive
    # after the ceiling, caught by the census). The runner finishes
    # the job: TERM again, a moment, KILL, the whole group.
    if [ "$grc" = 124 ] || [ "$grc" = 137 ]; then
        kill -s TERM -- "-$_rg_g" 2> /dev/null
        sleep 0.5
        kill -s KILL -- "-$_rg_g" 2> /dev/null
    fi
    rig_group_del "$_rg_g"
}

expected_stdout() { # unescape \n \" \\ from the directive's stdout=
    printf '%s' "$1" | awk '{
        s = $0
        out = ""
        n = length(s)
        i = 1
        while (i <= n) {
            c = substr(s, i, 1)
            if (c == "\\" && i < n) {
                d = substr(s, i + 1, 1)
                if (d == "n") { out = out "\n"; i += 2; continue }
                if (d == "\"") { out = out "\""; i += 2; continue }
                if (d == "\\") { out = out "\\"; i += 2; continue }
            }
            out = out c
            i += 1
        }
        printf "%s", out
    }'
}

run_lane() { # run_lane <lane> <file> — the observation record in $rec, the exit in $grc, the wall in $lane_secs, the lane's stderr in target/corpus-run/stderr.txt
    _rl_o="target/corpus-run/record.json"
    _rl_e="target/corpus-run/stderr.txt"
    _rl_s=$(date +%s)
    case "$1" in
    # the native lane COMPILES the staged entry inside its ceiling
    # (the stage is remade every run, so the compile is cold), and on
    # this box under other lanes' load that compile-plus-run has
    # passed 60 s five times in a day (ws25: every one a re-staged
    # native lane, none a hung server — the census found nothing and
    # the next lane ran at once). A ceiling is for a HUNG test; the
    # native lane's is 3x so a slow compile is a number, not a red.
    native) run_group $((ceiling * 3)) "$_rl_o" "$_rl_e" "$WOLF" conform-run --native "$2" ;;
    checked) run_group "$ceiling" "$_rl_o" "$_rl_e" "$WOLF" conform-run --checked "$2" ;;
    lupin) run_group "$ceiling" "$_rl_o" "$_rl_e" "$LUPIN" conform-run --json ${lobo_seed:+--seed="$lobo_seed"} "$2" ;;
    esac
    lane_secs=$(( $(date +%s) - _rl_s ))
    rec=$(cat "$_rl_o")
}

# lane_stderr — the last lines of the lane's stderr, for a red: the
# program's own trap message lives there (an `assert` names itself on
# stderr, not in the record), and a runner that discards it makes a
# flake under load unreadable (ws25: G1 went red on prefork_e2e's
# checked lane with `trap(assert)` and nothing else).
lane_stderr() {
    if [ -n "$rec" ]; then
        printf '%s' "$rec" | jq -r '(.diagnostics // [])[] | "corpus:   diagnostic: \(.)"' 2>/dev/null | cut -c1-300 >&2
        printf '%s' "$rec" | jq -r '.stdout_inline // ""' 2>/dev/null | tail -3 | sed 's|^|corpus:   stdout: |' >&2
        # the checked machine records the trap's SPAN (bytes into the
        # entry) and neither machine records the assert's message
        # (wolf-lang#150): the line is what a runner in sh can give
        _span=$(printf '%s' "$rec" | jq -r '(.["x-trap-span"] // [])[0] // ""' 2>/dev/null)
        if [ -n "$_span" ] && [ -f "$entry" ]; then
            _line=$(head -c "$_span" "$entry" | wc -l | tr -d ' ')
            echo "corpus:   trap at $entry:$((_line + 1)) (x-trap-span byte $_span; the assert's message is not in the record — wolf-lang#150)" >&2
        fi
    fi
    [ -s target/corpus-run/stderr.txt ] || return 0
    grep -v '^lobo: \[notice\]' target/corpus-run/stderr.txt | tail -6 | cut -c1-300 | sed 's|^|corpus:   stderr: |' >&2
    # a spawned server's last events, when it wrote any (a ceiling
    # kill leaves them as the only account of where the run stood)
    grep '^lobo: \[notice\]' target/corpus-run/stderr.txt | tail -4 | cut -c1-200 | sed 's|^|corpus:   server: |' >&2
}

# ceiling_note — the words for an empty record, by the exit
ceiling_note() {
    case "$grc" in
    124 | 137) echo "the ceiling after ${lane_secs}s (exit $grc) — its process group was killed" ;;
    *) echo "crash, exit $grc after ${lane_secs}s" ;;
    esac
}

for f in $(find $roots -name '*.lu' | sort); do
    head -5 "$f" | grep -q '^//! member: true' && continue
    check=$(grep -m1 '^//! check: ' "$f" | sed 's|^//! check: ||')
    if [ -z "$check" ]; then
        echo "corpus: FAILED — $f has no \`//! check:\` directive and is not a member file" >&2
        red=$((red + 1))
        continue
    fi
    lanes=$(grep -m1 '^//! lanes: ' "$f" | sed 's|^//! lanes: ||')
    [ -z "$lanes" ] && lanes="native checked lupin"
    want_exit=$(printf '%s' "$check" | sed -n 's|^run(exit=\([0-9]*\).*|\1|p')
    if [ -z "$want_exit" ]; then
        echo "corpus: FAILED — $f: unsupported check form \`$check\` (ws00 runs run(exit=N[, stdout=…]) only)" >&2
        red=$((red + 1))
        continue
    fi
    want_out_raw=$(printf '%s' "$check" | sed -n 's|^run(exit=[0-9]*, stdout="\(.*\)")$|\1|p')
    case "$want_out_raw" in *'\r'*)
        echo "corpus: FAILED — $f: \`\\r\` is outside the upstream directive grammar; lupin's loader would merge this file into its siblings (E0302). Assert CRLF via str.replace — see the runner header" >&2
        red=$((red + 1))
        continue
        ;;
    esac

    entry="./$f"
    stage_mods=$(grep -m1 '^//! stage-src: ' "$f" | sed 's|^//! stage-src: ||')
    if [ -n "$stage_mods" ]; then
        sdir="target/corpus-stage/$(printf '%s' "$f" | tr '/' '_')"
        rm -rf "$sdir"
        mkdir -p "$sdir"
        cp "$f" "$sdir/"
        stage_bad=0
        for m in $stage_mods; do
            if [ ! -d "src/$m" ]; then
                echo "corpus: FAILED — $f: stage-src names src/$m, which does not exist" >&2
                red=$((red + 1))
                stage_bad=1
                break
            fi
            cp -R "src/$m" "$sdir/$m"
        done
        [ "$stage_bad" = 1 ] && continue
        entry="./$sdir/$(basename "$f")"
    fi

    for lane in $lanes; do
        total=$((total + 1))
        run_lane "$lane" "$entry"
        if [ -z "$rec" ]; then
            echo "corpus: FAILED — $f [$lane]: no observation record ($(ceiling_note))" >&2
            lane_stderr
            red=$((red + 1))
            continue
        fi
        verdict=$(printf '%s' "$rec" | jq -r .verdict)
        warns=$(printf '%s' "$rec" | jq -r '.warnings | length')
        if [ "$warns" != 0 ]; then
            echo "corpus: FAILED — $f [$lane]: warnings are denied here, record carries $warns:" >&2
            printf '%s' "$rec" | jq -c .warnings >&2
            red=$((red + 1))
            continue
        fi
        if [ "$verdict" != "exit($want_exit)" ]; then
            echo "corpus: FAILED — $f [$lane]: verdict \`$verdict\`, directive wants \`exit($want_exit)\`" >&2
            lane_stderr
            if [ "$lane" = lupin ]; then
                echo "corpus:   replay: $LUPIN run $entry${lobo_seed:+ --seed=$lobo_seed} (deterministic — strict FIFO when unseeded)" >&2
            fi
            red=$((red + 1))
            continue
        fi
        if [ -n "$want_out_raw" ]; then
            got=$(printf '%s' "$rec" | jq -r '.stdout_inline // ""')
            want=$(expected_stdout "$want_out_raw")
            # the record's stdout carries the trailing newline; the
            # directive's does not — compare modulo exactly that.
            if [ "$got" != "$want
" ] && [ "$got" != "$want" ]; then
                echo "corpus: FAILED — $f [$lane]: stdout mismatch" >&2
                printf 'corpus:   want: %s\n' "$(printf '%s' "$want" | head -c 200)" >&2
                printf 'corpus:   got:  %s\n' "$(printf '%s' "$got" | head -c 200)" >&2
                if [ "$lane" = lupin ]; then
                    echo "corpus:   replay: $LUPIN run $entry${lobo_seed:+ --seed=$lobo_seed} (deterministic — strict FIFO when unseeded)" >&2
                fi
                red=$((red + 1))
                continue
            fi
        fi
        # the wall is printed past 20 s only: a slow lane is a fact
        # about the box worth a line, a fast one is not
        if [ "$lane_secs" -ge 20 ]; then
            echo "corpus: ok — $f [$lane] $verdict (${lane_secs}s)"
        else
            echo "corpus: ok — $f [$lane] $verdict"
        fi
    done

    # ws14: the checked-refuses directive — the UB machine's refusal,
    # asserted by name (see the runner header). Contradicting a declared
    # `checked` lane is a header error, not a skip.
    refuses=$(grep -m1 '^//! checked-refuses: ' "$f" | sed 's|^//! checked-refuses: ||')
    if [ -n "$refuses" ]; then
        total=$((total + 1))
        case " $lanes " in
        *" checked "*)
            echo "corpus: FAILED — $f: declares the checked lane AND \`checked-refuses:\` — one or the other" >&2
            red=$((red + 1))
            ;;
        *)
            run_lane checked "$entry"
            if [ -z "$rec" ]; then
                echo "corpus: FAILED — $f [checked-refuses]: no observation record ($(ceiling_note))" >&2
                red=$((red + 1))
            else
                verdict=$(printf '%s' "$rec" | jq -r .verdict)
                construct=$(printf '%s' "$rec" | jq -r '.["x-unsupported-construct"] // ""')
                if [ "$verdict" = unsupported ] && [ "$construct" = "$refuses" ]; then
                    echo "corpus: ok — $f [checked-refuses] unsupported by name: $construct"
                else
                    echo "corpus: FAILED — $f [checked-refuses]: wanted \`unsupported\` naming \`$refuses\`, got verdict \`$verdict\` construct \`$construct\`" >&2
                    red=$((red + 1))
                fi
            fi
            ;;
        esac
    fi

    # ws11: the explore directive — search the file's whole schedule
    # space on the lupin lane. Agreement with a CLOSED frontier is the
    # only green; a dependent outcome is a finding printed WITH its
    # replay seed + decision stream (the explorer's own report lines).
    explore=$(grep -m1 '^//! explore: ' "$f" | sed 's|^//! explore: ||')
    if [ -n "$explore" ]; then
        total=$((total + 1))
        case " $lanes " in
        *" lupin "*)
            run_group 120 target/corpus-run/explore.txt target/corpus-run/explore.txt "$LUPIN" conform-run "$entry" --explore="$explore"
            xrc=$grc
            xrep=$(cat target/corpus-run/explore.txt)
            if [ "$xrc" = 0 ] && printf '%s\n' "$xrep" | grep -q 'frontier closed'; then
                echo "corpus: ok — $f [explore=$explore] $(printf '%s\n' "$xrep" | sed -n '1s|^[^:]*: ||p')"
            elif [ "$xrc" = 0 ]; then
                echo "corpus: FAILED — $f [explore=$explore]: agreement but the frontier is OPEN — the verdict was conditional on the budget; raise \`explore:\` or shrink the model:" >&2
                printf '%s\n' "$xrep" | sed 's|^|corpus:   |' >&2
                red=$((red + 1))
            else
                echo "corpus: FAILED — $f [explore=$explore]: schedule-dependent (or the explorer refused). The report below carries each outcome's replay — \`$LUPIN run <entry> --seed=S\` (or --schedule=ev:…):" >&2
                printf '%s\n' "$xrep" | sed 's|^|corpus:   |' >&2
                red=$((red + 1))
            fi
            ;;
        *)
            echo "corpus: FAILED — $f: \`//! explore:\` needs the lupin lane declared (the schedule space is the deterministic interpreter's)" >&2
            red=$((red + 1))
            ;;
        esac
    fi

    # ws25 (lobo#1): a test that leaves a process is red — by name.
    # Three seconds of grace: a `stop` fans out to the hands and the
    # master exits after them.
    if ! rig_gone 30; then
        echo "corpus: FAILED — $f left process(es) of this checkout running (lobo#1: a test that leaves a process is red; reaped now)" >&2
        rig_census "after $f"
        rig_reap "after $f"
        red=$((red + 1))
    fi
done

echo "corpus: $((total - red))/$total lane-runs green"
[ "$red" = 0 ] || exit 1
