#!/bin/sh
# lobo-corpus — the directive-file test runner. Make-free POSIX sh + jq
# (the one host tool the rig leans on; CI runners and dev boxes both
# carry it — see .docs/STYLE.md on why the runner is shell while the
# tests themselves are wolf).
#
# Format: wolf-lang's corpus directive header, verbatim —
#   //! check: run(exit=N[, stdout="…"])     (\n \" \\ escapes)
# `\r` is NOT in the upstream directive grammar (either machine), and
# a header lupin cannot parse silently JOINS the sibling-module merge
# (E0302 across the whole directory) — so this runner REFUSES a check
# line spelling `\r` rather than accepting what the loaders cannot.
# CRLF-bearing assertions print through `str.replace("\r\n", "~")`
# (see split_reply_edges.lu). Filed upstream: a web corpus wants \r.
#   //! phase: run
#   //! lanes: native checked lupin           (lobo delta: in-file lane
#                                              routing; default all 3)
# Member files (`//! member: true`) are modules, not tests. A lane a
# file DECLARES must run and match — `unsupported` on a declared lane
# is a failure, and a non-empty warnings array on any lane is a
# failure (the house deny-warnings rule; conform-run still has no
# --deny-warnings upstream).
#
#   //! stage-src: config [...]               (ws01: stage the named
#                                              src/ modules beside the
#                                              test and run the staged
#                                              copy)
#   //! explore: N                            (ws11: lupin lane only —
#                                              the file's WHOLE schedule
#                                              space, explored)
#   //! checked-refuses: <construct>          (ws14: the checked lane of
#                                              this runner is `wolf
#                                              conform-run --checked`, the
#                                              s23 UB machine — an
#                                              interpreter that refuses
#                                              structured concurrency BY
#                                              NAME at the expression it
#                                              reaches (`spawn`, scopes,
#                                              `select`; C1 deferred) —
#                                              NOT `wolf run --checked`,
#                                              which is the native build
#                                              under the checked profile
#                                              and runs procs. A file
#                                              whose run reaches a proc
#                                              therefore does not
#                                              declare `checked`; it
#                                              declares the exact
#                                              construct string the
#                                              machine's record must
#                                              carry in
#                                              `x-unsupported-construct`
#                                              (s134 named the refusal;
#                                              wolf-lang#219), and the
#                                              runner ASSERTS that
#                                              refusal as a lane-run —
#                                              a refusal by the wrong
#                                              name, a run, or a crash
#                                              is red. Never a blanket
#                                              skip: the lane is stated.)
# An explore-marked file runs `lupin conform-run --explore=N` after its
# lanes: every reachable interleaving must agree AND the frontier must
# CLOSE — an open frontier is red even on agreement (a verdict
# conditional on its budget is not a verdict), and a schedule-dependent
# outcome is red with the explorer's replay seed + decision stream
# printed (the two-command repro; docs/REPLAY.md is the workflow).
#
# LOBO_SEED=<n> seeds every lupin-lane run (`--seed=$LOBO_SEED`) — the
# ws11 replay knob: rerun the suite under the seed a bug report names.
# Unset, the lupin lane is the strict-FIFO default as ever.
# The loader's package root is the ENTRY FILE's directory, so a test
# under tests/ cannot `use` a src/ module in place. A committed
# symlink would work on the dev host and be a unixism in the tree, so
# the runner STAGES instead: copy the test plus each named src module
# into target/corpus-stage/<mangled-path>/ and run that entry. The
# staged copy is remade on every run — it cannot drift. cwd stays the
# repo root on every lane, so relative fs paths in tests still name
# repo paths.
#
#   tools/lobo-corpus [tests/...]    default: every .lu under tests/
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

roots="${*:-tests}"
total=0
red=0
lobo_seed="${LOBO_SEED:-}"
if [ -n "$lobo_seed" ]; then
    echo "corpus: lupin lane runs SEEDED (--seed=$lobo_seed — the ws11 replay knob; unset LOBO_SEED for the FIFO default)"
fi

expected_stdout() { # unescape \n \" \\ from the directive's stdout=
    printf '%s' "$1" | awk '{
        s = $0
        out = ""
        n = length(s)
        i = 1
        while (i <= n) {
            c = substr(s, i, 1)
            if (c == "\\" && i < n) {
                d = substr(s, i + 1, 1)
                if (d == "n") { out = out "\n"; i += 2; continue }
                if (d == "\"") { out = out "\""; i += 2; continue }
                if (d == "\\") { out = out "\\"; i += 2; continue }
            }
            out = out c
            i += 1
        }
        printf "%s", out
    }'
}

run_lane() { # run_lane <lane> <file> — emits the observation record
    case "$1" in
    native) timeout 60 "$WOLF" conform-run --native "$2" 2>/dev/null ;;
    checked) timeout 60 "$WOLF" conform-run --checked "$2" 2>/dev/null ;;
    lupin) timeout 60 "$LUPIN" conform-run --json ${lobo_seed:+--seed="$lobo_seed"} "$2" 2>/dev/null ;;
    esac
}

for f in $(find $roots -name '*.lu' | sort); do
    head -5 "$f" | grep -q '^//! member: true' && continue
    check=$(grep -m1 '^//! check: ' "$f" | sed 's|^//! check: ||')
    if [ -z "$check" ]; then
        echo "corpus: FAILED — $f has no \`//! check:\` directive and is not a member file" >&2
        red=$((red + 1))
        continue
    fi
    lanes=$(grep -m1 '^//! lanes: ' "$f" | sed 's|^//! lanes: ||')
    [ -z "$lanes" ] && lanes="native checked lupin"
    want_exit=$(printf '%s' "$check" | sed -n 's|^run(exit=\([0-9]*\).*|\1|p')
    if [ -z "$want_exit" ]; then
        echo "corpus: FAILED — $f: unsupported check form \`$check\` (ws00 runs run(exit=N[, stdout=…]) only)" >&2
        red=$((red + 1))
        continue
    fi
    want_out_raw=$(printf '%s' "$check" | sed -n 's|^run(exit=[0-9]*, stdout="\(.*\)")$|\1|p')
    case "$want_out_raw" in *'\r'*)
        echo "corpus: FAILED — $f: \`\\r\` is outside the upstream directive grammar; lupin's loader would merge this file into its siblings (E0302). Assert CRLF via str.replace — see the runner header" >&2
        red=$((red + 1))
        continue
        ;;
    esac

    entry="./$f"
    stage_mods=$(grep -m1 '^//! stage-src: ' "$f" | sed 's|^//! stage-src: ||')
    if [ -n "$stage_mods" ]; then
        sdir="target/corpus-stage/$(printf '%s' "$f" | tr '/' '_')"
        rm -rf "$sdir"
        mkdir -p "$sdir"
        cp "$f" "$sdir/"
        stage_bad=0
        for m in $stage_mods; do
            if [ ! -d "src/$m" ]; then
                echo "corpus: FAILED — $f: stage-src names src/$m, which does not exist" >&2
                red=$((red + 1))
                stage_bad=1
                break
            fi
            cp -R "src/$m" "$sdir/$m"
        done
        [ "$stage_bad" = 1 ] && continue
        entry="./$sdir/$(basename "$f")"
    fi

    for lane in $lanes; do
        total=$((total + 1))
        rec=$(run_lane "$lane" "$entry")
        if [ -z "$rec" ]; then
            echo "corpus: FAILED — $f [$lane]: no observation record (crash or 60s ceiling)" >&2
            red=$((red + 1))
            continue
        fi
        verdict=$(printf '%s' "$rec" | jq -r .verdict)
        warns=$(printf '%s' "$rec" | jq -r '.warnings | length')
        if [ "$warns" != 0 ]; then
            echo "corpus: FAILED — $f [$lane]: warnings are denied here, record carries $warns:" >&2
            printf '%s' "$rec" | jq -c .warnings >&2
            red=$((red + 1))
            continue
        fi
        if [ "$verdict" != "exit($want_exit)" ]; then
            echo "corpus: FAILED — $f [$lane]: verdict \`$verdict\`, directive wants \`exit($want_exit)\`" >&2
            if [ "$lane" = lupin ]; then
                echo "corpus:   replay: $LUPIN run $entry${lobo_seed:+ --seed=$lobo_seed} (deterministic — strict FIFO when unseeded)" >&2
            fi
            red=$((red + 1))
            continue
        fi
        if [ -n "$want_out_raw" ]; then
            got=$(printf '%s' "$rec" | jq -r '.stdout_inline // ""')
            want=$(expected_stdout "$want_out_raw")
            # the record's stdout carries the trailing newline; the
            # directive's does not — compare modulo exactly that.
            if [ "$got" != "$want
" ] && [ "$got" != "$want" ]; then
                echo "corpus: FAILED — $f [$lane]: stdout mismatch" >&2
                printf 'corpus:   want: %s\n' "$(printf '%s' "$want" | head -c 200)" >&2
                printf 'corpus:   got:  %s\n' "$(printf '%s' "$got" | head -c 200)" >&2
                if [ "$lane" = lupin ]; then
                    echo "corpus:   replay: $LUPIN run $entry${lobo_seed:+ --seed=$lobo_seed} (deterministic — strict FIFO when unseeded)" >&2
                fi
                red=$((red + 1))
                continue
            fi
        fi
        echo "corpus: ok — $f [$lane] $verdict"
    done

    # ws14: the checked-refuses directive — the UB machine's refusal,
    # asserted by name (see the runner header). Contradicting a declared
    # `checked` lane is a header error, not a skip.
    refuses=$(grep -m1 '^//! checked-refuses: ' "$f" | sed 's|^//! checked-refuses: ||')
    if [ -n "$refuses" ]; then
        total=$((total + 1))
        case " $lanes " in
        *" checked "*)
            echo "corpus: FAILED — $f: declares the checked lane AND \`checked-refuses:\` — one or the other" >&2
            red=$((red + 1))
            ;;
        *)
            rec=$(run_lane checked "$entry")
            if [ -z "$rec" ]; then
                echo "corpus: FAILED — $f [checked-refuses]: no observation record (crash or 60s ceiling)" >&2
                red=$((red + 1))
            else
                verdict=$(printf '%s' "$rec" | jq -r .verdict)
                construct=$(printf '%s' "$rec" | jq -r '.["x-unsupported-construct"] // ""')
                if [ "$verdict" = unsupported ] && [ "$construct" = "$refuses" ]; then
                    echo "corpus: ok — $f [checked-refuses] unsupported by name: $construct"
                else
                    echo "corpus: FAILED — $f [checked-refuses]: wanted \`unsupported\` naming \`$refuses\`, got verdict \`$verdict\` construct \`$construct\`" >&2
                    red=$((red + 1))
                fi
            fi
            ;;
        esac
    fi

    # ws11: the explore directive — search the file's whole schedule
    # space on the lupin lane. Agreement with a CLOSED frontier is the
    # only green; a dependent outcome is a finding printed WITH its
    # replay seed + decision stream (the explorer's own report lines).
    explore=$(grep -m1 '^//! explore: ' "$f" | sed 's|^//! explore: ||')
    if [ -n "$explore" ]; then
        total=$((total + 1))
        case " $lanes " in
        *" lupin "*)
            xrep=$(timeout 120 "$LUPIN" conform-run "$entry" --explore="$explore" 2>&1)
            xrc=$?
            if [ "$xrc" = 0 ] && printf '%s\n' "$xrep" | grep -q 'frontier closed'; then
                echo "corpus: ok — $f [explore=$explore] $(printf '%s\n' "$xrep" | sed -n '1s|^[^:]*: ||p')"
            elif [ "$xrc" = 0 ]; then
                echo "corpus: FAILED — $f [explore=$explore]: agreement but the frontier is OPEN — the verdict was conditional on the budget; raise \`explore:\` or shrink the model:" >&2
                printf '%s\n' "$xrep" | sed 's|^|corpus:   |' >&2
                red=$((red + 1))
            else
                echo "corpus: FAILED — $f [explore=$explore]: schedule-dependent (or the explorer refused). The report below carries each outcome's replay — \`$LUPIN run <entry> --seed=S\` (or --schedule=ev:…):" >&2
                printf '%s\n' "$xrep" | sed 's|^|corpus:   |' >&2
                red=$((red + 1))
            fi
            ;;
        *)
            echo "corpus: FAILED — $f: \`//! explore:\` needs the lupin lane declared (the schedule space is the deterministic interpreter's)" >&2
            red=$((red + 1))
            ;;
        esac
    fi
done

echo "corpus: $((total - red))/$total lane-runs green"
[ "$red" = 0 ] || exit 1
