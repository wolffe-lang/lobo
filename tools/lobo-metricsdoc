#!/bin/sh
# lobo-metricsdoc — generate/check docs/metrics.md from the ws12
# metric REGISTRY (src/metrics/metrics.lu, metrics.registry) through
# the built lobo binary (`lobo metrics-md`) — the lobo-directives /
# lobo-logvars pattern applied to metrics. The page is the
# Grafana-ready reference: every family, its type, its declared label
# shape and the SAME help text the `# HELP` line carries at /metrics,
# so a dashboard built from the page and a live scrape cannot
# disagree. NEVER hand-edited; the gauntlet runs --check after the
# tiers build.
#
#   tools/lobo-metricsdoc --emit    regenerate docs/metrics.md
#   tools/lobo-metricsdoc --check   regenerate and diff (default)
set -u
cd "$(dirname "$0")/.." || exit 2

BIN=target/lobo-debug
if [ ! -x "$BIN" ]; then
    echo "lobo-metricsdoc: FAILED — $BIN is missing; run the gauntlet's build step first (wolf build ./src/main.lu -o $BIN)" >&2
    exit 1
fi

mode="${1:---check}"
tmp="target/metrics.md.$$"
if ! "$BIN" metrics-md > "$tmp"; then
    echo "lobo-metricsdoc: FAILED — \`lobo metrics-md\` did not run" >&2
    rm -f "$tmp"
    exit 1
fi

case "$mode" in
--emit)
    mv "$tmp" docs/metrics.md
    echo "lobo-metricsdoc: wrote docs/metrics.md"
    ;;
--check)
    if [ ! -f docs/metrics.md ]; then
        echo "lobo-metricsdoc: FAILED — docs/metrics.md is missing; run tools/lobo-metricsdoc --emit and commit it with the registry change" >&2
        rm -f "$tmp"
        exit 1
    fi
    if ! diff -u docs/metrics.md "$tmp"; then
        echo "lobo-metricsdoc: FAILED — docs/metrics.md drifted from the registry; it is GENERATED (never hand-edited): run tools/lobo-metricsdoc --emit and commit it with the registry change" >&2
        rm -f "$tmp"
        exit 1
    fi
    rm -f "$tmp"
    echo "lobo-metricsdoc: docs/metrics.md matches the registry"
    ;;
*)
    echo "lobo-metricsdoc: unknown mode $mode (--emit | --check)" >&2
    rm -f "$tmp"
    exit 2
    ;;
esac
