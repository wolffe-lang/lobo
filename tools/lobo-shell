#!/bin/sh
# lobo-shell — the CLI probe table: every operator flag driven through
# BOTH the pinned oracle (nginx) and lobo, exit codes required to MATCH
# (report 11 §3's drop-in shell contract; the oracle is the record —
# "nginx's codes are folklore, the oracle is the record", ws04 §5).
# Where a case must diverge it carries a `delta=` reason (the named-
# delta discipline, as in lobo-confcheck); a case with a divergence and
# no reason FAILS. The version/help/error TEXT differs only by identity
# ("lobo:" for "nginx:", both on stderr) — a documented, non-gating
# delta; this harness gates on EXIT CODES, which carry across.
#
# The `-t` exit-code parity over the real config corpus is lobo-confcheck's;
# this harness owns the flag grammar confcheck does not exercise
# (version, help, unknown option, missing argument, invalid signal, and
# `-s` with no running master).
#
# Lives in sh because a wolf runner cannot read a child's exit code
# without os_spawn stdout capture (ws00's D3 / wolf-lang#129); the same
# reason lobo-confcheck is sh.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

NGINX="$(pwd)/tests/differential/bin/nginx"
LOBO="$(pwd)/target/lobo-debug"
pin_version=$(sed -n 's/^version = //p' tests/differential/NGINX-PIN)

if [ ! -x "$NGINX" ]; then
    echo "lobo-shell: REFUSED — pinned oracle missing at $NGINX (nginx/$pin_version; build per docs/DIFFERENTIAL.md)" >&2
    exit 1
fi
if [ ! -x "$LOBO" ]; then
    echo "lobo-shell: FAILED — $LOBO missing; the gauntlet's build step makes it" >&2
    exit 1
fi

red=0
total=0
parity=0
named=0

# a minimal, parseable config so `-s` reaches the pid-file lookup on
# both sides (nginx needs a valid config even to send a signal)
scratch="target/lobo-shell"
rm -rf "$scratch"
mkdir -p "$scratch/logs"
printf 'events {\n}\nhttp {\n  server { listen 18080; }\n}\n' > "$scratch/n.conf"

# probe <desc> <want_lobo> <want_oracle> <delta> -- <args...>
probe() {
    desc="$1"; want_lobo="$2"; want_oracle="$3"; delta="$4"
    shift 4
    [ "$1" = "--" ] && shift
    total=$((total + 1))

    "$LOBO" "$@" >/dev/null 2>"$scratch/lobo.err"
    got_lobo=$?
    "$NGINX" "$@" >/dev/null 2>"$scratch/oracle.err"
    got_oracle=$?

    ok=1
    if [ "$got_lobo" != "$want_lobo" ]; then
        echo "lobo-shell: FAILED — [$desc] lobo exited $got_lobo, want $want_lobo:" >&2
        sed 's/^/lobo-shell:   lobo: /' "$scratch/lobo.err" >&2
        ok=0
    fi
    if [ "$got_oracle" != "$want_oracle" ]; then
        echo "lobo-shell: FAILED — [$desc] oracle exited $got_oracle, want $want_oracle (the record moved — re-probe):" >&2
        sed 's/^/lobo-shell:   oracle: /' "$scratch/oracle.err" >&2
        ok=0
    fi
    if [ "$want_lobo" != "$want_oracle" ] && [ -z "$delta" ]; then
        echo "lobo-shell: FAILED — [$desc] lobo/oracle exits diverge ($want_lobo vs $want_oracle) with no delta= reason" >&2
        ok=0
    fi
    if [ "$ok" = 0 ]; then
        red=$((red + 1))
        return
    fi
    if [ "$want_lobo" = "$want_oracle" ]; then
        parity=$((parity + 1))
        echo "lobo-shell: ok — [$desc] exit $got_lobo (parity)"
    else
        named=$((named + 1))
        echo "lobo-shell: ok — [$desc] lobo $got_lobo vs oracle $got_oracle (named: $delta)"
    fi
}

# version / help — exit 0 both (identity text differs on stderr; not gated)
probe "-v version"        0 0 "" -- -v
probe "-V build metadata" 0 0 "" -- -V
probe "-h usage"          0 0 "" -- -h
probe "-? usage"          0 0 "" -- -\?

# unknown option — exit 1 both, `invalid option`
probe "-Z unknown option" 1 1 "" -- -Z

# missing arguments — exit 1 both
probe "-s no arg"         1 1 "" -- -s
probe "-c no arg"         1 1 "" -- -c
probe "-p no arg"         1 1 "" -- -p
probe "-e no arg"         1 1 "" -- -e
probe "-g no arg"         1 1 "" -- -g

# invalid signal word — exit 1 both
probe "-s bogus signal"   1 1 "" -- -s bogus

# -s with no running master: both read the pid file, find nothing,
# exit 1 (lobo: open() failed; nginx: open() failed — same shape)
probe "-s reload no master" 1 1 "" -- -s reload -p "$scratch" -c n.conf

# ws63 (wolf 0.2.29: os_pid, os_signal_send): with no `control`
# directive `-s` signals the pid in the pid file, as nginx's does, so
# the pid file's two failures are PARITY rows now — both exit 1 — and
# each side's diagnostic has the same shape (lobo's checked here; the
# oracle's are `kill(<pid>, <n>) failed (3: No such process)` and
# `invalid PID number "…" in "<file>"`). n.conf above is valid, has no
# control directive, and leaves the pid file at its default path.
# Through ws62 lobo refused this door by name (ws15: "reached ONLY
# over its control endpoint", wolf-lang#126).
deadpid=$(sh -c 'echo $$')
echo "$deadpid" > "$scratch/logs/nginx.pid"
probe "-s reload, a pid nobody holds" 1 1 "" -- -s reload -p "$scratch" -c n.conf
total=$((total + 1))
if grep -q "\[alert\] kill($deadpid, [0-9]*) failed" "$scratch/lobo.err" && grep -q "\[alert\] kill($deadpid, [0-9]*) failed" "$scratch/oracle.err"; then
    parity=$((parity + 1))
    echo "lobo-shell: ok — [-s reload, a pid nobody holds] both name the failed kill($deadpid, N)"
else
    echo "lobo-shell: FAILED — [-s reload, a pid nobody holds] lobo: $(head -1 "$scratch/lobo.err") / oracle: $(head -1 "$scratch/oracle.err")" >&2
    red=$((red + 1))
fi
echo "unix:logs/control.sock" > "$scratch/logs/nginx.pid"
probe "-s stop, no pid in the pid file" 1 1 "" -- -s stop -p "$scratch" -c n.conf
total=$((total + 1))
if grep -q 'invalid PID number "unix:logs/control.sock"' "$scratch/lobo.err" && grep -q 'invalid PID number "unix:logs/control.sock"' "$scratch/oracle.err"; then
    parity=$((parity + 1))
    echo "lobo-shell: ok — [-s stop, no pid in the pid file] both say invalid PID number"
else
    echo "lobo-shell: FAILED — [-s stop, no pid in the pid file] lobo: $(head -1 "$scratch/lobo.err") / oracle: $(head -1 "$scratch/oracle.err")" >&2
    red=$((red + 1))
fi
rm -f "$scratch/logs/nginx.pid"

# `status` needs a connection, so with no `control` directive it still
# refuses by name instead of dialling the http port (ws15's rule, kept
# for the verbs that need a reply; lobo-only, nginx has no `status`)
"$LOBO" status -p "$scratch" -c n.conf >/dev/null 2>"$scratch/noctl.err"
noctl=$?
total=$((total + 1))
if [ "$noctl" = 1 ] && grep -q 'no "control" directive' "$scratch/noctl.err"; then
    parity=$((parity + 1))
    echo "lobo-shell: ok — [status with no control directive] exit 1 and the diagnostic names the directive (a reply needs the endpoint; -s does not)"
else
    echo "lobo-shell: FAILED — [status with no control directive] exit $noctl, stderr: $(head -1 "$scratch/noctl.err")" >&2
    red=$((red + 1))
fi

# the lobo-native `control` subcommand: an invented verb is a named
# error before any socket is touched (nginx has no such subcommand, so
# this is a lobo-only probe, not a parity row)
"$LOBO" control shutdown -p "$scratch" -c n.conf >/dev/null 2>"$scratch/badverb.err"
badverb=$?
total=$((total + 1))
if [ "$badverb" = 1 ] && grep -q 'invalid "control" verb' "$scratch/badverb.err"; then
    named=$((named + 1))
    echo "lobo-shell: ok — [control shutdown] lobo-native verb set refuses an invented verb by name, exit 1 (named: nginx has no control subcommand — its -s takes exactly four words, and so does lobo's)"
else
    echo "lobo-shell: FAILED — [control shutdown] exit $badverb, stderr: $(head -1 "$scratch/badverb.err")" >&2
    red=$((red + 1))
fi

# ws54 (lobo#49): `-t -q`, gated on OUTPUT as well as the exit code —
# the one flag in this table whose whole meaning is what it does not
# print. Measured on the oracle (notes/ws54-contract.md §2): a good
# config under `-t -q` prints NOTHING and exits 0; a bad one still
# prints its `[emerg]` and `test failed` and exits 1; a `[warn]` still
# prints. Both servers are driven with the same -p/-c; their stderr
# and stdout are compared after the identity prefix ("nginx: " /
# "lobo: ") is taken off. The configs listen on a loopback port that
# `-t` may bind (nginx's -t is not a pure parse, ws40).
qgood="$scratch/q-good.conf"; qbad="$scratch/q-bad.conf"; quser="$scratch/q-user.conf"
printf 'events {\n}\nhttp {\n  server { listen 127.0.0.1:18557; }\n}\n' > "$qgood"
printf 'events {\n}\nhttp {\n  server { listen 127.0.0.1:18557; bogus_directive on; }\n}\n' > "$qbad"
printf 'user nobody;\nevents {\n}\nhttp {\n  server { listen 127.0.0.1:18557; }\n}\n' > "$quser"
# qprobe <desc> <conf> <want_exit> <want: silent|failed|warn>
qprobe() {
    total=$((total + 1))
    "$LOBO" -t -q -p "$scratch" -c "$(basename "$2")" > "$scratch/q-lobo.out" 2>&1
    ql=$?
    "$NGINX" -t -q -p "$scratch" -c "$(basename "$2")" > "$scratch/q-oracle.out" 2>&1
    qo=$?
    lo=$(sed 's/^lobo: //' "$scratch/q-lobo.out"); oo=$(sed 's/^nginx: //' "$scratch/q-oracle.out")
    ok=1
    [ "$ql" = "$3" ] && [ "$qo" = "$3" ] || ok=0
    case "$4" in
    silent) [ -z "$lo" ] && [ -z "$oo" ] || ok=0 ;;
    failed) echo "$lo" | grep -q 'test failed$' && echo "$oo" | grep -q 'test failed$' || ok=0
            echo "$lo$oo" | grep -q 'successful' && ok=0 ;;
    warn)   echo "$lo" | grep -q '^\[warn\] the "user" directive makes sense only if' && echo "$oo" | grep -q '^\[warn\] the "user" directive makes sense only if' || ok=0
            echo "$lo$oo" | grep -q 'syntax is ok\|successful' && ok=0 ;;
    esac
    if [ "$ok" = 1 ]; then
        parity=$((parity + 1))
        echo "lobo-shell: ok — [$1] exit $ql on both, output: $4 on both (lobo $(wc -l < "$scratch/q-lobo.out" | tr -d ' ') lines, oracle $(wc -l < "$scratch/q-oracle.out" | tr -d ' '))"
    else
        echo "lobo-shell: FAILED — [$1] want exit $3 and $4 output on both; lobo exited $ql, oracle $qo:" >&2
        sed 's/^/lobo-shell:   lobo: /' "$scratch/q-lobo.out" >&2
        sed 's/^/lobo-shell:   oracle: /' "$scratch/q-oracle.out" >&2
        red=$((red + 1))
    fi
}
qprobe "-t -q good config prints nothing (lobo#49)" "$qgood" 0 silent
qprobe "-t -q bad config still prints its failure" "$qbad" 1 failed
if [ "$(id -u)" != 0 ]; then
    qprobe "-t -q unprivileged \`user\` still prints the [warn]" "$quser" 0 warn
else
    echo "lobo-shell: SKIP — [-t -q user warn] runs only unprivileged (as root both drop privileges and print no [warn]: tools/lobo-user's rows, in a container); named skip" >&2
fi

# ------------------------------------------------------------------
# ws64 (lobo#84): AT THE LIMITS. `worker_connections` was a parsed word
# through ws63 and lobo had nothing of its own in front of the host's
# descriptor limit; out of descriptors it went silent. What nginx does
# at each limit was MEASURED on this oracle first (run, never read:
# notes/ws64-contract.md §2) and is held here as rows: the same
# configuration, the same client (tests/rig/climit.lu, one wolf
# program in front of both servers), and what the client saw and each
# server logged compared. A row is parity when both servers gave the
# client the line the oracle was measured to give and both logs carry
# the line's shape.
#
# The descriptor rows lower the limit with `ulimit -n` in the subshell
# that execs ONE server: that process's limit and nobody else's. Every
# server binds 127.0.0.1 on a port the kernel chose and is stopped by
# the pid this script started.
# ------------------------------------------------------------------

# `-t`: the values nginx refuses, refused (trunk at 1d23471: exit 0 on
# every one — the word was never read)
wct() { # wct <name> <events-body> [listens]
    printf 'events { %s }\nhttp {\n  server { %s }\n}\n' "$2" "${3:-listen 127.0.0.1:18558;}" > "$scratch/wc-$1.conf"
}
wct zero 'worker_connections 0;'
wct one 'worker_connections 1;'
wct word 'worker_connections x;'
wct minus 'worker_connections -1;'
wct unit 'worker_connections 1k;'
wct twice 'worker_connections 8; worker_connections 9;'
wct two2 'worker_connections 2;' 'listen 127.0.0.1:18558; listen 127.0.0.1:18559;'
wct two1 'worker_connections 2;'
probe "-t worker_connections 0"  1 1 "" -- -t -p "$scratch" -c wc-zero.conf
probe "-t worker_connections 1, one listen" 1 1 "" -- -t -p "$scratch" -c wc-one.conf
total=$((total + 1))
if grep -q '\[emerg\] 1 worker_connections are not enough for 1 listening sockets' "$scratch/lobo.err" && grep -q '\[emerg\] 1 worker_connections are not enough for 1 listening sockets' "$scratch/oracle.err"; then
    parity=$((parity + 1))
    echo "lobo-shell: ok — [-t worker_connections 1, one listen] both say 1 worker_connections are not enough for 1 listening sockets"
else
    echo "lobo-shell: FAILED — [-t worker_connections 1] lobo: $(head -1 "$scratch/lobo.err") / oracle: $(head -1 "$scratch/oracle.err")" >&2
    red=$((red + 1))
fi
probe "-t worker_connections x"  1 1 "" -- -t -p "$scratch" -c wc-word.conf
total=$((total + 1))
if grep -q '\[emerg\] invalid number "x" in ' "$scratch/lobo.err" && grep -q '\[emerg\] invalid number "x" in ' "$scratch/oracle.err"; then
    parity=$((parity + 1))
    echo "lobo-shell: ok — [-t worker_connections x] both say invalid number \"x\""
else
    echo "lobo-shell: FAILED — [-t worker_connections x] lobo: $(head -1 "$scratch/lobo.err") / oracle: $(head -1 "$scratch/oracle.err")" >&2
    red=$((red + 1))
fi
probe "-t worker_connections -1" 1 1 "" -- -t -p "$scratch" -c wc-minus.conf
probe "-t worker_connections 1k" 1 1 "" -- -t -p "$scratch" -c wc-unit.conf
probe "-t worker_connections twice" 1 1 "" -- -t -p "$scratch" -c wc-twice.conf
probe "-t worker_connections 2, two listens" 1 1 "" -- -t -p "$scratch" -c wc-two2.conf
probe "-t worker_connections 2, one listen (accepted: it then serves nobody)" 0 0 "" -- -t -p "$scratch" -c wc-two1.conf

# the live rows
lim="$scratch/lim"
mkdir -p "$lim/html" "$lim/logs"
limroot="$(pwd)/$lim"
echo small-page > "$lim/html/index.html"
head -c 25165824 /dev/zero | tr '\000' w > "$lim/html/big.bin"
CLIMIT="$(pwd)/$scratch/climit"
lim_ready=1
if ! "$WOLF" build "$rig_root"/tests/rig/climit.lu -o "$CLIMIT" > "$scratch/climit-build.err" 2>&1; then
    echo "lobo-shell: FAILED — the limit rows' client (tests/rig/climit.lu) does not build:" >&2
    sed 's/^/lobo-shell:   /' "$scratch/climit-build.err" >&2
    lim_ready=0
fi
if ! command -v curl > /dev/null 2>&1; then
    echo "lobo-shell: FAILED — the limit rows poll a started server with curl, which this host lacks (CLAUDE.md's host tools)" >&2
    lim_ready=0
fi

# lim_one <ng|lb> <tag> <worker_connections> <nofile|-> <mode> <n> <hold_ms>
# One server, started (under the lowered limit when one is given),
# polled until it answers, driven by the client, stopped by its pid.
# The client's line lands in ${side}_line, the server's stderr and
# error log in $lim/<side>-<tag>.log.
lim_one() {
    _side=$1; _tag=$2; _wc=$3; _nf=$4; _mode=$5; _n=$6; _hold=$7; _loc=${8:-}
    _port=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
    _log="$lim/$_side-$_tag.log"
    : > "$_log"
    if [ "$_side" = ng ]; then
        printf 'daemon off;\nmaster_process on;\nworker_processes 1;\npid logs/ng-%s.pid;\nerror_log ng-%s.log info;\nevents { worker_connections %s; }\nhttp {\n  access_log off;\n  server { listen 127.0.0.1:%s; root html; %s }\n}\n' \
            "$_tag" "$_tag" "$_wc" "$_port" "$_loc" > "$lim/ng-$_tag.conf"
        set -- "$NGINX" -p "$limroot" -c "ng-$_tag.conf" -e "ng-$_tag.log"
    else
        printf 'pid logs/lb-%s.pid;\nevents { worker_connections %s; }\nhttp {\n  types { text/html html; application/octet-stream bin; }\n  server { listen 127.0.0.1:%s; root html; %s }\n}\n' \
            "$_tag" "$_wc" "$_port" "$_loc" > "$lim/lb-$_tag.conf"
        set -- "$LOBO" serve -p "$limroot" -c "lb-$_tag.conf"
    fi
    if [ "$_nf" = - ]; then
        "$@" >> "$_log" 2>&1 &
    else
        (ulimit -n "$_nf" && exec "$@") >> "$_log" 2>&1 &
    fi
    _pid=$!
    _i=0
    while [ "$_i" -lt 50 ]; do
        curl -s -o /dev/null -m 1 "http://127.0.0.1:$_port/index.html" 2> /dev/null && break
        sleep 0.1
        _i=$((_i + 1))
    done
    _line=$("$CLIMIT" "$_port" "$_mode" "$_n" "$_hold" 2>> "$_log")
    kill "$_pid" 2> /dev/null
    wait "$_pid" 2> /dev/null
    eval "${_side}_line=\$_line"
}
# lim_count <ng|lb> <tag> <pattern> — lines of that run's log matching
lim_count() { grep -c -- "$3" "$lim/$1-$2.log" 2> /dev/null || true; }
# lim_row <desc> <0 ok|1 red> <what both gave> — one parity row
lim_row() {
    total=$((total + 1))
    if [ "$2" = 0 ]; then
        parity=$((parity + 1))
        echo "lobo-shell: ok — [$1] $3 (parity)"
    else
        echo "lobo-shell: FAILED — [$1] $3" >&2
        echo "lobo-shell:   lobo:   ${lb_line:-}" >&2
        echo "lobo-shell:   oracle: ${ng_line:-}" >&2
        red=$((red + 1))
    fi
}

if [ "$lim_ready" = 1 ]; then
    # A. past worker_connections with idle connections: both close the
    # least recently used to make room — the first eleven of 24 at 16,
    # with one listen — and serve the newcomer
    lim_one ng a 16 - idle 24 600
    lim_one lb a 16 - idle 24 600
    want="climit mode=idle n=24 map=111111111110000000000000 held=200 after=200"
    ok=1
    [ "$ng_line" = "$want" ] && [ "$lb_line" = "$want" ] && ok=0
    lim_row "worker_connections 16, 24 idle connections" "$ok" "both close the first eleven to make room and serve a newcomer"
    ok=1
    [ "$(lim_count ng a '\[warn\] .*16 worker_connections are not enough, reusing connections')" -ge 1 ] &&
        [ "$(lim_count lb a '\[warn\] 16 worker_connections are not enough, reusing connections')" -ge 1 ] && ok=0
    lim_row "…and its log line" "$ok" "both log [warn] 16 worker_connections are not enough, reusing connections"

    # B. past it with every connection busy: 14 slow downloads are
    # served, and each connection after them is accepted and closed at
    # once, one [alert] line each (six, and the probe: seven)
    lim_one ng b 16 - download 20 600
    lim_one lb b 16 - download 20 600
    want="climit mode=download n=20 map=22222222222222111111 held=closed after=200"
    ok=1
    [ "$ng_line" = "$want" ] && [ "$lb_line" = "$want" ] && ok=0
    lim_row "worker_connections 16, 20 slow downloads" "$ok" "both serve fourteen, close the rest at once, and serve again when they end"
    nga=$(lim_count ng b '\[alert\] .*16 worker_connections are not enough$')
    lba=$(lim_count lb b '\[alert\] 16 worker_connections are not enough$')
    ok=1
    [ "$nga" = 7 ] && [ "$lba" = 7 ] && ok=0
    lim_row "…and its log line" "$ok" "one [alert] 16 worker_connections are not enough a refused connection (oracle $nga, lobo $lba, want 7)"

    # C. out of descriptors (this one server's limit lowered to 48):
    # the accept fails; the connections that cannot be taken wait in
    # the kernel's queue unanswered and no idle one is closed for them;
    # the failure is logged about twice a second, however many wait;
    # and when descriptors return the queue is served
    lim_one ng c 1024 48 idle 100 2500
    lim_one lb c 1024 48 idle 100 2500
    zeros=$(printf '%0100d' 0)
    want="climit mode=idle n=100 map=$zeros held=none after=200"
    ok=1
    if [ "$(uname -s)" = Darwin ]; then
        # What a failed accept costs the connection it could not take
        # is the HOST's, not the server's: linux leaves it in the queue
        # (the line above, digit for digit), and macOS drops it (ws64,
        # measured in CI: the control endpoint lost its order that
        # way). There the connections past the limit go one a failed
        # accept, at each server's own half-second beat, so the two
        # lines are printed and held only to the part that is the
        # server's: nothing answered while out of descriptors, and
        # service again when they return.
        echo "lobo-shell: [out of descriptors, on macOS] oracle: $ng_line"
        echo "lobo-shell: [out of descriptors, on macOS] lobo:   $lb_line"
        case "$ng_line" in *" held=none after=200" | *" held=closed after=200")
            case "$lb_line" in *" held=none after=200" | *" held=closed after=200") ok=0 ;; esac ;;
        esac
        lim_row "out of descriptors, 100 idle connections" "$ok" "neither answers a newcomer while out of descriptors and both serve again when descriptors return (macOS drops a connection whose accept failed, so the clients' lines are printed, not compared digit for digit)"
    else
        [ "$ng_line" = "$want" ] && [ "$lb_line" = "$want" ] && ok=0
        lim_row "out of descriptors, 100 idle connections" "$ok" "both leave the newcomer unanswered in the queue, close nobody, and serve again when descriptors return"
    fi
    ngc=$(lim_count ng c '\[crit\] .*accept4\{0,1\}() failed (24: Too many open files)')
    lbc=$(lim_count lb c '\[crit\] accept() failed (24: Too many open files)')
    ok=1
    [ "$ngc" -ge 2 ] && [ "$ngc" -le 16 ] && [ "$lbc" -ge 2 ] && [ "$lbc" -le 16 ] && ok=0
    lim_row "…and its log line, at a bounded rate" "$ok" "[crit] accept() failed (24: Too many open files), about two a second for some six seconds (oracle $ngc, lobo $lbc; lobo names the call accept(), nginx accept4() where the host has it)"
    ok=1
    [ "$(lim_count ng c '\[warn\] .*1024 worker_connections exceed open file resource limit: 48')" -ge 1 ] &&
        [ "$(lim_count lb c '\[warn\] 1024 worker_connections exceed open file resource limit: 48')" -ge 1 ] && ok=0
    lim_row "…and the start warning" "$ok" "both warn 1024 worker_connections exceed open file resource limit: 48"

    # D. a FILE that cannot be opened for want of a descriptor: 500,
    # never 404, and the open logged. Whether the last descriptor goes
    # to a connection or to its file depends on how many a server holds
    # at rest (they differ), so each side is tried at two neighbouring
    # limits and the row reads the one where a connection took it.
    for side in ng lb; do
        eval "${side}_500=0"
        for nf in 48 49; do
            lim_one "$side" "d$nf" 1024 "$nf" download 24 300
            eval "_l=\$${side}_line"
            case "$_l" in
            *" held=500 "*)
                if [ "$(lim_count "$side" "d$nf" '\[crit\] .*open() ".*/html/index.html" failed (24: Too many open files)')" -ge 1 ]; then
                    eval "${side}_500=1"
                fi
                ;;
            esac
        done
    done
    ok=1
    [ "$ng_500" = 1 ] && [ "$lb_500" = 1 ] && ok=0
    ng_line="oracle answered 500 and logged the open: $ng_500"
    lb_line="lobo answered 500 and logged the open: $lb_500"
    lim_row "out of descriptors, a file cannot be opened" "$ok" "both answer 500 and log [crit] open() \"<path>\" failed (24: Too many open files)"

    # F. ws67 (lobo#81): a proxied request is TWO connections while its
    # upstream exchange is out — nginx's count, its directive's text:
    # "includes all connections (e.g. connections with proxied
    # servers)". Eight requests to an upstream that never answers
    # (tests/rig/wedge.lu: a listener nobody accepts on; the kernel
    # completes each dial in its backlog), 100 ms apart, at
    # worker_connections 16 with one listener: both hold seven and close
    # the eighth (7 x 2 + the listener + one = 16) with the [alert], and
    # a fresh GET beside them is refused too. Through 0.1.4 lobo's loop
    # was held by the first exchange: nothing after it was even taken.
    # When the clients close, nginx drops their exchanges at once
    # (proxy_ignore_client_abort off) and serves. Through ws67 lobo's
    # proc did not see the close while it waited on its upstream, so its
    # exchanges ended at proxy_read_timeout (10 s here): a named delta.
    # Since ws68 (lobo#99) the proc waits on its upstream AND its client
    # (`net_wait` over both), so a client's close ends the exchange at
    # once and frees both connections, as nginx's: parity.
    "$WOLF" run "$rig_root"/tests/rig/wedge.lu 20000 > "$lim/wedge.port" 2> "$lim/wedge.err" &
    wp=""
    _i=0
    while [ "$_i" -lt 100 ]; do
        wp=$(head -1 "$lim/wedge.port" 2> /dev/null | tr -cd '0-9')
        [ -n "$wp" ] && break
        sleep 0.1
        _i=$((_i + 1))
    done
    ploc="location /up/ { proxy_pass http://127.0.0.1:$wp; proxy_read_timeout 10s; }"
    lim_one ng f 16 - proxied 8 300 "$ploc"
    lim_one lb f 16 - proxied 8 300 "$ploc"
    want="climit mode=proxied n=8 map=00000001 held=closed"
    ok=1
    case "$ng_line" in "$want "*) case "$lb_line" in "$want "*) ok=0 ;; esac ;; esac
    lim_row "worker_connections 16, 8 proxied requests to a silent upstream" "$ok" "both hold seven, close the eighth, and refuse a fresh GET beside them: a proxied request is two connections"
    nga=$(lim_count ng f '\[alert\] .*16 worker_connections are not enough')
    lba=$(lim_count lb f '\[alert\] 16 worker_connections are not enough$')
    ok=1
    [ "$nga" -ge 1 ] && [ "$lba" -ge 1 ] && ok=0
    lim_row "…and its log line" "$ok" "both log [alert] 16 worker_connections are not enough (oracle $nga, lobo $lba)"
    total=$((total + 1))
    case "$ng_line" in *" after=200") ngafter=200 ;; *) ngafter="${ng_line##*after=}" ;; esac
    lbafter="${lb_line##*after=}"
    if [ "$ngafter" = 200 ] && [ "$lbafter" = 200 ]; then
        parity=$((parity + 1))
        echo "lobo-shell: ok — [8 proxied requests, after the clients close] both after=200: each exchange sees its client close and is dropped at once, its two connections freed (nginx's proxy_ignore_client_abort off; lobo since ws68, lobo#99)"
    else
        echo "lobo-shell: FAILED — [8 proxied requests, after the clients close] lobo after=$lbafter, oracle after=$ngafter (through ws67 lobo's exchanges held until proxy_read_timeout: after=closed)" >&2
        red=$((red + 1))
    fi

    # G. ws69 (lobo#104): the same eight requests to an upstream reached
    # over HTTPS that never answers its ClientHello (the wedge again: the
    # dial completes in its backlog, the hello waits there). nginx drops
    # each exchange when its client closes, whatever the scheme. Through
    # ws68 lobo watched the client on the plaintext leg only — the https
    # leg's waits were reads inside std.x.tls.client — so its eight
    # exchanges held their connections until proxy_read_timeout and the
    # fresh GET after the clients closed found none free: after=closed.
    # Since ws69 the https leg waits behind the same watch: parity. Any
    # PEM CERTIFICATE serves as the trust anchors, since no chain is ever
    # checked (lobo refuses an https proxy_pass without them)
    cp "$rig_root/tests/config-corpus/certbot-vhost/live/example.org/fullchain.pem" "$lim/ca.pem"
    gloc="location /up/ { proxy_pass https://127.0.0.1:$wp; proxy_read_timeout 10s; proxy_ssl_trusted_certificate $limroot/ca.pem; }"
    lim_one ng g 16 - proxied 8 300 "$gloc"
    lim_one lb g 16 - proxied 8 300 "$gloc"
    want="climit mode=proxied n=8 map=00000001 held=closed after=200"
    ok=1
    [ "$ng_line" = "$want" ] && [ "$lb_line" = "$want" ] && ok=0
    lim_row "worker_connections 16, 8 proxied requests to a silent https upstream, then the clients close" "$ok" "both hold seven, close the eighth, and drop every exchange when its client closes: after=200 (through ws68 lobo's https exchanges held until proxy_read_timeout: after=closed)"

    # H. ws69 (lobo#104): a static GET PIPELINED while a proxied request
    # waits (tests/rig/pipewait.lu is the client and the upstream: it
    # pipelines 200 ms into the wait and answers 300 ms later). nginx
    # answers both, the second right after the first, keeps the
    # connection and serves a third request on it. Through ws68 lobo's
    # exchange read the pipelined bytes while it watched its client and
    # could not hand them back: its reply said Connection: close and the
    # second request was never answered. Since ws69 they go back with the
    # exchange's account and the loop answers them next: parity
    pw_one() {
        _side=$1
        _port=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
        _up=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
        _log="$lim/$_side-h.log"
        : > "$_log"
        _loc="location /up/ { proxy_pass http://127.0.0.1:$_up; proxy_read_timeout 10s; }"
        if [ "$_side" = ng ]; then
            printf 'daemon off;\nmaster_process on;\nworker_processes 1;\npid logs/ng-h.pid;\nerror_log ng-h.log info;\nevents { worker_connections 64; }\nhttp {\n  access_log off;\n  server { listen 127.0.0.1:%s; root html; %s }\n}\n' \
                "$_port" "$_loc" > "$lim/ng-h.conf"
            set -- "$NGINX" -p "$limroot" -c "ng-h.conf" -e "ng-h.log"
        else
            printf 'pid logs/lb-h.pid;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s; root html; %s }\n}\n' \
                "$_port" "$_loc" > "$lim/lb-h.conf"
            set -- "$LOBO" serve -p "$limroot" -c "lb-h.conf"
        fi
        "$@" >> "$_log" 2>&1 &
        _pid=$!
        _i=0
        while [ "$_i" -lt 50 ]; do
            curl -s -o /dev/null -m 1 "http://127.0.0.1:$_port/index.html" 2> /dev/null && break
            sleep 0.1
            _i=$((_i + 1))
        done
        _line=$("$PIPEWAIT" "$_port" "$_up" 2>> "$_log")
        kill "$_pid" 2> /dev/null
        wait "$_pid" 2> /dev/null
        eval "${_side}_line=\$_line"
    }
    PIPEWAIT="$(pwd)/$scratch/pipewait"
    if "$WOLF" build "$rig_root"/tests/rig/pipewait.lu -o "$PIPEWAIT" > "$scratch/pipewait-build.err" 2>&1; then
        pw_one ng
        pw_one lb
        want="pipewait responses=2 close_in_first=0 second=lt150 third=200"
        ok=1
        [ "$ng_line" = "$want" ] && [ "$lb_line" = "$want" ] && ok=0
        lim_row "a static GET pipelined during a proxied wait" "$ok" "both answer it right after the proxied reply, keep the connection and serve a third request (through ws68 lobo said Connection: close and never answered it)"
    else
        echo "lobo-shell: FAILED — the pipelined row's rig (tests/rig/pipewait.lu) does not build:" >&2
        sed 's/^/lobo-shell:   /' "$scratch/pipewait-build.err" >&2
        red=$((red + 1))
        total=$((total + 1))
    fi

    # E. `-t` under a lowered limit prints the start warning too. The
    # configuration sets `error_log … info`: nginx prints this warning
    # only when its error log's level admits one (its default level is
    # `error`, measured: no line), where lobo's stderr carries every
    # line whatever the level (ws02's seam; docs/LOGGING.md)
    printf 'error_log logs/t-error.log info;\nevents { worker_connections 1024; }\nhttp {\n  server { listen 127.0.0.1:18558; }\n}\n' > "$scratch/wc-big.conf"
    (ulimit -n 48 && exec "$LOBO" -t -p "$scratch" -c wc-big.conf) > "$scratch/t-lobo.out" 2>&1
    tl=$?
    (ulimit -n 48 && exec "$NGINX" -t -p "$scratch" -c wc-big.conf) > "$scratch/t-oracle.out" 2>&1
    to=$?
    ok=1
    [ "$tl" = 0 ] && [ "$to" = 0 ] &&
        grep -q '\[warn\] 1024 worker_connections exceed open file resource limit: 48' "$scratch/t-lobo.out" &&
        grep -q '\[warn\] 1024 worker_connections exceed open file resource limit: 48' "$scratch/t-oracle.out" && ok=0
    lb_line=$(grep -m1 warn "$scratch/t-lobo.out")
    ng_line=$(grep -m1 warn "$scratch/t-oracle.out")
    lim_row "-t under a 48-descriptor limit" "$ok" "both exit 0 and warn 1024 worker_connections exceed open file resource limit: 48"
else
    red=$((red + 1))
    total=$((total + 1))
fi
rm -f "$lim/html/big.bin"

# assert the error diagnostics land on STDERR (nginx's stream), not stdout
"$LOBO" -Z >"$scratch/stdout" 2>/dev/null
if [ -s "$scratch/stdout" ]; then
    echo "lobo-shell: FAILED — -Z wrote to stdout; nginx writes diagnostics to stderr" >&2
    red=$((red + 1))
fi
total=$((total + 1))
[ ! -s "$scratch/stdout" ] && { parity=$((parity + 1)); echo "lobo-shell: ok — [-Z on stderr] diagnostics go to stderr (nginx's stream)"; }
rm -f "$scratch/stdout"

echo "lobo-shell: $total probes — $parity parity, $named named deltas, $red red"
[ "$red" = 0 ] && [ "$total" -gt 0 ] || exit 1
