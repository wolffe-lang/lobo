#!/bin/sh
# lobo-profile — THE PROFILE LEG (ws25, lobo#6): where one hand's time
# goes under the close shape, read with the host's sampling profiler,
# so that two trees can be compared on ONE box by SHARE rather than by
# req/s — the number a shared VM cannot hold still (docs/PARITY.md:
# six runner VMs spread 1.27x–1.44x on the close cell with no change
# to lobo). NOT a gauntlet step and never a gate.
#
#   tools/lobo-profile [binary] [label] [seconds] [shape]
#     binary   the lobo to profile (default target/lobo-release)
#     label    names the scratch dir and the report (default: lobo)
#     seconds  the sampling window (default 8)
#     shape    close (default — ws22's probe) or keepalive (ws27: the
#              read/serve path alone, `ab -k`, the cell linux is
#              furthest from)
#     N        worker_processes (default 1 — ws22's probe: the master
#              serves alone and is the process sampled). ws31: at N > 1
#              a real master with N hands serves the bar's own cell
#              (N = nproc on the runner) and ONE hand — worker 1 — is
#              the process sampled, so the herd (lobo#5: four hands
#              waking on one listener, the losers' parks) is in the
#              picture the way the parity table sees it. `perf` samples
#              CPU, not wall: a parked hand takes no samples, so a park
#              shows as its mechanics (the syscalls, the switch), never
#              as the wait itself; the by-thread report below is where
#              the reactor thread's and the signal forwarder's share
#              read.
#     hands    ws32 (lobo#5, item 2): `1` (the default — worker 1 is
#              the process sampled, as above) or `all` — EVERY hand at
#              once (`perf record -p` over the N pids), so a cost that
#              four hands pay each other and one hand's profile cannot
#              show (ws31's ~6 µs a request at four hands) has a row:
#              the report adds `--sort pid` over all the hands' threads
#              and `--sort cpu` (which vcpus the hands ran on). On
#              linux, whatever `hands` says, the tool ends with THE
#              SPLIT: a separate drive with no tracer at all, and per
#              sampled hand, off /proc — cpu seconds (utime+stime),
#              write syscalls (`syscw`: one `writev` a request on both
#              shapes at this pin, so a request count per hand without
#              ptrace), µs of cpu a request, and voluntary /
#              involuntary context switches a request.
#   `LOBO_LISTEN_ARGS` (ws32): words appended to the `listen` line
#   (e.g. `reuseport`) — a candidate posture profiled; "" is the bar's.
#
# The shape is ws22's probe (docs/PROFILE.md): `worker_processes 1`,
# the parity file (1 KiB), the close shape under four `ab -c 8`
# generators, and the profiler on the ONE serving process (at
# `worker_processes 1` the master serves alone — docs/WORKERS.md) for
# the window, in the middle of the drive. Two instruments,
# one per host, the same driver:
#   linux  — `perf record -F 997 -g -p <hand>` then `perf report
#            --no-children --sort sym` (the leaf shares: the syscalls,
#            the runtime's calls, lobo's own frames) and `--sort dso`
#            (kernel vs runtime vs lobo). A second, separate drive
#            runs `strace -c -f -p <hand>` for the syscall COUNTS per
#            request (ptrace perturbs, so it is never in the perf
#            window). Both need root on a stock runner
#            (perf_event_paranoid, yama ptrace_scope); the tool uses
#            sudo when it is not root and SKIPS loudly, by name, when
#            perf is absent — a skip is not a number.
#   macOS  — `sample(1)` on the hand (ws22's instrument), its
#            "top of stack" table.
# The report ends with the drive's own req/s (the generators' sum) so
# a profile is never read without the throughput it was taken at.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

BIN="${1:-$(pwd)/target/lobo-release}"
case "$BIN" in /*) ;; *) BIN="$(pwd)/$BIN" ;; esac
LABEL="${2:-lobo}"
SECS="${3:-8}"
SHAPE="${4:-close}"
case "$SHAPE" in
close) KA="" ;;
keepalive) KA="-k" ;;
*) echo "lobo-profile: REFUSED — shape is close or keepalive, not $SHAPE" >&2; exit 1 ;;
esac
N="${5:-1}"
case "$N" in
''|*[!0-9]*|0) echo "lobo-profile: REFUSED — N is a worker count, not $N" >&2; exit 1 ;;
esac
HANDS="${6:-1}"
case "$HANDS" in
1|all) ;;
*) echo "lobo-profile: REFUSED — hands is 1 or all, not $HANDS" >&2; exit 1 ;;
esac
[ "$N" = 1 ] && HANDS=1
LARGS="${LOBO_LISTEN_ARGS:-}"
GENS=4
PERGEN=8
[ -x "$BIN" ] || { echo "lobo-profile: REFUSED — $BIN is not an executable" >&2; exit 1; }
command -v ab > /dev/null 2>&1 || { echo "lobo-profile: REFUSED — ab(1) is not on PATH" >&2; exit 1; }
scratch="$(pwd)/target/profile-$LABEL-$SHAPE-n$N-h$HANDS"
rm -rf "$scratch"
mkdir -p "$scratch/www"
awk 'BEGIN { for (i = 0; i < 16; i++) printf "%063d\n", i }' > "$scratch/www/index.html"
host="$(uname -sm)"
SUDO=""
[ "$(id -u)" = 0 ] || SUDO="sudo -n"

wait_port() {
    i=0
    while [ $i -lt 80 ]; do
        printf 'GET /index.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n' > "$scratch/req.txt"
        "$WOLF" run "$rig_root"/tests/rig/diffsend.lu "$1" "$scratch/req.txt" 2>/dev/null | grep -q "200 OK" && return 0
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

start() { # start — one master, N hands; sets hp, mpid, hand, lconf
    hp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
    cp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
    lconf="$scratch/lobo.conf"
    printf 'worker_processes %s;\npid %s/lobo.pid;\ncontrol 127.0.0.1:%s;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s%s; root %s/www; }\n}\n' \
        "$N" "$scratch" "$cp" "$hp" "${LARGS:+ $LARGS}" "$scratch" > "$lconf"
    "$BIN" serve -p . -c "$lconf" 2>> "$scratch/lobo.log" &
    mpid=$!
    wait_port "$hp" || { echo "lobo-profile: $LABEL never served" >&2; kill "$mpid"; return 1; }
    sleep 1
    # at `worker_processes 1` lobo is ONE process — the master serves
    # (docs/WORKERS.md), so the hand is the master itself; at N > 1
    # (ws31) the hands are the master's children, `--worker k`, and
    # worker 1 is the one sampled — it is spawned after the listener
    # answers, so it is waited for by name. ws32: with hands=all the
    # sampled set is every hand, waited for until all N are up; `hand`
    # is then the comma list perf and strace take, `hands` the space
    # list the /proc split walks
    hand=""
    hands=""
    i=0
    while [ $i -lt 50 ]; do
        if [ "$HANDS" = all ]; then
            hands=$(pgrep -f -- "^$BIN .*--worker [0-9]* --worker-control" | sort -n | tr '\n' ' ')
            # shellcheck disable=SC2086
            [ "$(echo $hands | wc -w)" -ge "$N" ] && { hand=$(echo $hands | tr ' ' ','); break; }
        else
            hand=$(pgrep -f -- "^$BIN .*--worker 1 --worker-control" | head -1)
            [ -n "$hand" ] && { hands="$hand"; break; }
        fi
        [ "$N" = 1 ] && break
        sleep 0.1
        i=$((i + 1))
    done
    if [ -z "$hand" ]; then
        if [ "$N" = 1 ]; then
            hand=$mpid
            hands=$mpid
        else
            echo "lobo-profile: $LABEL at N=$N never spawned its hands ($HANDS wanted; up: $hands)" >&2
            kill "$mpid"
            return 1
        fi
    fi
}
# ws32: THE SPLIT, off /proc with no tracer. snap <tag> writes one
# line per sampled hand: pid utime+stime(ticks) syscw voluntary
# involuntary; split <before> <after> <requests> prints the table
snap() {
    : > "$scratch/$1.snap"
    for p in $hands; do
        t=$($SUDO cat "/proc/$p/stat" 2>/dev/null | awk '{ sub(/.*\) /, ""); print $12 + $13 }')
        w=$($SUDO awk '/^syscw:/ { print $2 }' "/proc/$p/io" 2>/dev/null)
        v=$($SUDO awk '/^voluntary_ctxt_switches:/ { print $2 }' "/proc/$p/status" 2>/dev/null)
        nv=$($SUDO awk '/^nonvoluntary_ctxt_switches:/ { print $2 }' "/proc/$p/status" 2>/dev/null)
        echo "$p ${t:-0} ${w:-0} ${v:-0} ${nv:-0}" >> "$scratch/$1.snap"
    done
}
split() {
    tck=$(getconf CLK_TCK 2>/dev/null || echo 100)
    echo ""
    echo "=== $LABEL — the split: per hand, off /proc, a drive with NO tracer ($3 requests completed over the whole drive; syscw = write syscalls in the window ≈ requests the hand answered)"
    echo "| hand (pid) | cpu s | syscw | µs cpu / syscw | vol. switches / syscw | invol. switches / syscw |"
    echo "|---|---|---|---|---|---|"
    awk -v tck="$tck" '
        FNR == NR { t0[$1] = $2; w0[$1] = $3; v0[$1] = $4; n0[$1] = $5; next }
        {
            cpu = ($2 - t0[$1]) / tck; w = $3 - w0[$1]; v = $4 - v0[$1]; n = $5 - n0[$1]
            us = (w > 0) ? cpu * 1e6 / w : 0; vr = (w > 0) ? v / w : 0; nr = (w > 0) ? n / w : 0
            printf "| %s | %.2f | %d | %.1f | %.3f | %.3f |\n", $1, cpu, w, us, vr, nr
            tc += cpu; tw += w; tv += v; tn += n
            if (w > 0) { if (mn == "" || us < mn) mn = us; if (us > mx) mx = us }
        }
        END {
            if (tw > 0) printf "| **all sampled** | **%.2f** | **%d** | **%.1f** | **%.3f** | **%.3f** |\n", tc, tw, tc * 1e6 / tw, tv / tw, tn / tw
            if (NR > 1 && mn != "" && mn > 0) printf "the hands spread %.2fx (max ÷ min of µs cpu a syscw)\n", mx / mn
        }' "$scratch/$1.snap" "$scratch/$2.snap"
}
stop() {
    "$BIN" -s stop -p . -c "$lconf" > /dev/null 2>&1
    wait "$mpid" 2>/dev/null
}
drive() { # drive <seconds> <tag> — the close shape, GENS generators; sets rps
    g=1
    genpids=""
    while [ $g -le $GENS ]; do
        # shellcheck disable=SC2086
        ab -q $KA -t "$1" -n 1000000 -c $PERGEN "http://127.0.0.1:$hp/index.html" > "$scratch/ab-$2-g$g.txt" 2>&1 &
        genpids="$genpids $!"
        g=$((g + 1))
    done
}
drive_wait() { # drive_wait <tag> — sets rps (sum) and failed
    wait $genpids
    rps=0; failed=0
    for f in "$scratch"/ab-$1-g*.txt; do
        r=$(awk '/^Requests per second/ { print $4 }' "$f")
        x=$(awk '/^Failed requests/ { print $3 }' "$f")
        rps=$(awk -v a="$rps" -v b="${r:-0}" 'BEGIN { printf "%.0f", a + b }')
        failed=$((failed + ${x:-0}))
    done
}

echo "lobo-profile: $(date -u +%Y-%m-%dT%H:%MZ) host $host, load(1m) $(uptime | awk -F'load average[s]*: ' '{ print $2 }' | tr -d ',' | awk '{ print $1 }'); $LABEL = $("$BIN" -v 2>&1 | head -1)${LARGS:+ (listen args: $LARGS)}; worker_processes $N, $([ "$HANDS" = all ] && echo "ALL $N hands" || echo "one hand") sampled, $SHAPE shape, $GENS × ab $KA -c $PERGEN, a $SECS s window"

case "$(uname -s)" in
Linux)
    if ! command -v perf > /dev/null 2>&1; then
        echo "lobo-profile: SKIPPED — perf(1) is not on PATH (linux-tools for this kernel); no profile for $LABEL" >&2
        exit 0
    fi
    start || exit 1
    drive $((SECS + 5)) perf
    sleep 2
    $SUDO perf record -q -F 997 -g -p "$hand" -o "$scratch/perf.data" -- sleep "$SECS" 2> "$scratch/perf.err" || {
        echo "lobo-profile: perf record failed:" >&2; cat "$scratch/perf.err" >&2
    }
    drive_wait perf
    stop
    echo "lobo-profile: $LABEL perf window: $rps req/s summed over the drive, failed=$failed, hand pid(s) $hand"
    if [ -s "$scratch/perf.data" ]; then
        # the report reads as the user that recorded (root through
        # sudo): perf refuses a data file another user owns, and the
        # first cut of this tool chowned it to the caller and then
        # asked root — three empty tables and no word why
        report() { # report <title> <lines> <perf report args...>
            _t=$1; _n=$2; shift 2
            echo ""
            echo "=== $LABEL — $_t"
            $SUDO perf report -i "$scratch/perf.data" --stdio "$@" > "$scratch/report.txt" 2> "$scratch/report.err"
            grep -v '^#' "$scratch/report.txt" | grep -v '^$' | grep -E '^ +[0-9]' | head -"$_n"
            [ -s "$scratch/report.txt" ] || { echo "lobo-profile: perf report printed nothing:" >&2; cat "$scratch/report.err" >&2; }
        }
        report "perf report, leaves (self), --sort sym, over 0.4%" 45 --no-children --sort sym --percent-limit 0.4
        report "perf report, by dso (kernel / runtime+lobo / libc)" 12 --no-children --sort dso
        # ws31: the user-space leaves BY DSO, down to 0.1% — the table
        # "by lobo function" the profile is asked for. `lobo-release`
        # is lobo's own frames AND the statically linked runtime
        # (`wolf_rt::*`, the `core::str` searchers under lobo's
        # `find`s); libc is the copies (`memset`, `memcpy`) and the
        # syscall wrappers. The whole-process table above cuts at 0.4%
        # and a request's user-space quarter is spread over rows
        # smaller than that, so without these two tables most of the
        # lobo-release share has no name.
        report "perf report, leaves in lobo-release (lobo's frames + the runtime), over 0.1%" 40 --no-children --sort sym --dso lobo-release --percent-limit 0.1
        report "perf report, leaves in libc, over 0.1%" 16 --no-children --sort sym --dso libc.so.6 --percent-limit 0.1
        # ws31: by thread — the serving thread against the runtime's
        # own (`wolf-reactor`, the parked signal forwarder's carrier):
        # what a park and a parked proc cost in CPU lands on THEIR
        # rows, and a thread with a handful of samples is the number
        # for a cost that is a clock, not a request. `pid` (perf's per-THREAD key, tid:comm), not `comm`:
        # an unnamed thread shares the process's comm and would fold
        # into the serving thread's row
        report "perf report, by thread (pid = the thread, with its comm) — the sampled hands' threads" $((4 * N + 4)) --no-children --sort pid
        if [ "$HANDS" = all ]; then
            # ws32: which vcpu each sample landed on — the four hands
            # over the four vcpus, and whether they stayed put
            report "perf report, by cpu (the vcpus the hands ran on)" 8 --no-children --sort cpu
        fi
        report "perf report, inclusive (children), --sort sym, over 3%" 40 --children --sort sym --percent-limit 3
    fi
    # ws32: THE SPLIT — a third drive, no perf, no strace: the hands'
    # own /proc counters over the window, per hand
    start || exit 1
    drive $((SECS + 5)) split
    sleep 2
    snap before
    sleep "$SECS"
    snap after
    drive_wait split
    stop
    echo ""
    echo "lobo-profile: $LABEL split window: $rps req/s summed over the drive, failed=$failed, hand pid(s) $hand (no tracer)"
    split before after "$(awk '/^Complete requests/ { s += $3 } END { print s }' "$scratch"/ab-split-g*.txt)"
    # the syscall COUNTS, on a separate drive: ptrace slows the hand
    # several-fold and the shares above must not carry that
    if command -v strace > /dev/null 2>&1; then
        start || exit 1
        drive $((SECS + 3)) strace
        sleep 1
        $SUDO strace -c -f -p "$hand" -o "$scratch/strace.txt" 2> "$scratch/strace.err" &
        spid=$!
        sleep "$SECS"
        $SUDO kill -INT "$spid" 2>/dev/null
        wait "$spid" 2>/dev/null
        drive_wait strace
        stop
        echo ""
        echo "=== $LABEL — strace -c over $SECS s (the hand, ptraced: $rps req/s under the tracer, not a rate)"
        n=$(awk '/^Requests per second/ { s += $4 } END { printf "%.0f", s }' "$scratch"/ab-strace-g*.txt)
        cat "$scratch/strace.txt" 2>/dev/null | head -30
        echo "lobo-profile: $LABEL — read the calls column against the requests the drive counted ($(awk '/^Complete requests/ { s += $3 } END { print s }' "$scratch"/ab-strace-g*.txt) complete over the whole drive)"
    else
        echo "lobo-profile: strace(1) absent — no syscall counts for $LABEL"
    fi
    ;;
Darwin)
    start || exit 1
    drive $((SECS + 5)) sample
    sleep 2
    sample "$hand" "$SECS" 1 -file "$scratch/sample.txt" > /dev/null 2>&1
    drive_wait sample
    stop
    echo "lobo-profile: $LABEL sample window: $rps req/s summed over the drive, failed=$failed, hand pid $hand"
    echo ""
    echo "=== $LABEL — sample(1), top of stack (the main thread's leaves), the first 40"
    awk '/^Sort by top of stack/ { p = 1; next } p' "$scratch/sample.txt" | grep -E '^ +[0-9]' | head -40
    ;;
*)
    echo "lobo-profile: SKIPPED — no profiler named for $(uname -s)"
    exit 0
    ;;
esac
