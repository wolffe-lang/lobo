#!/bin/sh
# lobo-user — the PRIVILEGE DROP witness (ws67, lobo#96). nginx's
# master, started as root, keeps root and runs its workers as the
# `user` directive's user and group, supplementary groups too; lobo
# does the same since ws67 (std.process.set_ids, wolf 0.2.30+). The
# measurement needs ROOT, and root is taken only inside a throwaway
# container, never on a host: this tool runs itself again (`--inside`)
# as root in a container of a stock ubuntu:24.04 image with no network
# but its own loopback, the lobo binary mounted read-only, and checks
# what the pinned nginx was measured to do (notes/ws67-contract.md §2):
#   1. `user lw lwx;` (one process configured): a master that reads
#      `Uid: 0 0 0 0` and ONE hand that reads `Uid: 1500 ×4`,
#      `Gid: 1600 ×4`, `Groups: 1600`; port 80, bound by the master,
#      answers 200 from the hand; a file only root may read is 403; the
#      log files are the user's (owner only), and after `-s reopen` with
#      the access log moved away the fresh one is the user's too;
#   2. `user lw;`: the group NAMED lw — `Gid: 1500 ×4`, `Groups: 1500
#      1600` (lw is listed in lwx);
#   3. `user lw lwx; worker_processes 2;`: both hands dropped;
#   4. `user nosuch;`: `-t` and the start refuse, `[emerg]
#      getpwnam("nosuch") failed in <file>:1`, exit 1;
#   5. not root (the same `user` line, run as lw): `-t` exits 0 with
#      nginx's `[warn] … makes sense only if the master process runs
#      with super-user privileges, ignored …`;
#   6. root with NO `user` line (ws68, the `user` default, ruled at
#      audit "match nginx"; ws67 kept one root process, a named delta):
#      nginx's default `user nobody nobody` — a master that keeps root
#      and ONE hand with the ids the pinned nginx's worker takes IN THIS
#      CONTAINER (the account named nobody's uid, else 65534; the group
#      named nobody's gid, else 65534; that gid and every group listing
#      nobody: notes/ws68-contract.md §2), a root-only file 403, and no
#      line about it (nginx prints none);
#   7. …with no account named nobody: the same ids, and lobo's one
#      `[warn]` (nginx drops and says nothing);
#   8. …with a group listing nobody: it joins the hand's groups;
#   9. `user root;`: the hand keeps root, as nginx's worker does.
# Rows 6–9 run the pinned oracle in the same container first, when it
# runs there (CI's is built on the ubuntu runner; elsewhere point
# LOBO_USER_IMAGE at an image its libraries are in), and the hand's
# Uid/Gid/Groups lines must equal its worker's; where it does not run,
# the rule above, applied to the container's account files, is the
# record, and the log says so.
# Through 0.1.4 rows 1–4 were red: root with `user` refused to start
# ("lobo cannot drop privileges at this pin"); through ws67 rows 6–8
# were red: root with no `user` line kept one root process.
#
# Where it runs: linux with podman or docker (LOBO_USER_ENGINE picks
# one). Elsewhere it SKIPS by name, exit 0: macOS has no drop at this
# pin (set_ids is linux's) and no container engine on the runner.
set -u

if [ "${1:-}" = "--inside" ]; then
    # ---- INSIDE the container, as root ---------------------------------
    LOBO=$2
    red=0
    total=0
    say() { echo "lobo-user: $1"; }
    check() { # check <desc> <ok(0/1)>
        total=$((total + 1))
        if [ "$2" = 0 ]; then say "ok — $1"; else
            say "FAILED — $1" >&2
            red=$((red + 1))
        fi
    }
    [ "$(id -u)" = 0 ] || { say "FAILED — not root inside the container" >&2; exit 1; }
    ORACLE=${3:-}
    if [ -n "$ORACLE" ] && ! "$ORACLE" -v > /dev/null 2>&1; then
        say "the pinned oracle does not run in this image ($("$ORACLE" -v 2>&1 | head -1 | cut -c1-160)); rows 6–9 hold the measured rule"
        ORACLE=""
    fi
    cp /etc/passwd /tmp/lobo-user.passwd
    cp /etc/group /tmp/lobo-user.group
    getent group lwx > /dev/null || groupadd -g 1600 lwx
    getent passwd lw > /dev/null || useradd -u 1500 -U -G lwx -M -d /nonexistent -s /usr/sbin/nologin lw
    D=/tmp/lobo-user
    fresh() { # fresh <main-context line>
        rm -rf "$D"
        mkdir -p "$D/logs" "$D/html"
        echo hello > "$D/html/index.html"
        echo secret > "$D/html/secret.txt"
        chmod 600 "$D/html/secret.txt"
        chmod 755 "$D" "$D/html"
        printf '%s\npid logs/lobo.pid;\nerror_log logs/error.log;\ncontrol unix:logs/c.sock;\nhttp {\n  types { text/html html; text/plain txt; }\n  access_log logs/access.log;\n  server { listen 80; root html; }\n}\n' "$1" > "$D/l.conf"
    }
    status_of() { # status_of <path> — the status code a GET on :80 answers
        exec 3<> /dev/tcp/127.0.0.1/80 || { echo none; return; }
        printf 'GET %s HTTP/1.0\r\nHost: x\r\n\r\n' "$1" >&3
        head -1 <&3 | awk '{print $2}'
        exec 3<&-
    }
    up() { # up — wait up to ~6 s for :80
        i=0
        while [ $i -lt 60 ]; do
            s=$(status_of /index.html 2> /dev/null)
            [ "$s" = 200 ] && return 0
            sleep 0.1
            i=$((i + 1))
        done
        return 1
    }
    kids() { # the children of $KP (the comm field is cut away first: it may hold spaces)
        for st in /proc/[0-9]*/stat; do
            pp=$(sed 's/^.*) //' "$st" 2> /dev/null | awk '{print $2}')
            if [ "$pp" = "$KP" ]; then
                p=${st#/proc/}
                echo "${p%/stat}"
            fi
        done
    }
    ids() { # ids <pid> — "Uid … | Gid … | Groups …", tabs as spaces
        grep -E '^(Uid|Gid|Groups):' "/proc/$1/status" | tr '\t' ' ' | sed 's/  */ /g; s/ $//' | tr '\n' '|'
    }
    start() { (cd "$D" && exec "$LOBO" -p "$D" -c l.conf serve > "$D/serve.out" 2>&1) & MP=$!; }
    stop() {
        "$LOBO" -p "$D" -c l.conf -s stop > /dev/null 2>&1
        i=0
        while [ $i -lt 50 ] && kill -0 "$MP" 2> /dev/null; do sleep 0.1; i=$((i + 1)); done
        kill -0 "$MP" 2> /dev/null && { say "(the master $MP outlived -s stop: TERM)"; kill "$MP"; }
        wait "$MP" 2> /dev/null
    }
    owner() { stat -c '%U:%G' "$1" 2> /dev/null || echo none; }
    # nginx's default, as measured (ws68): the lines a worker reads
    rule_ids() {
        u=$(awk -F: '$1 == "nobody" { print $3; exit }' /etc/passwd)
        g=$(awk -F: '$1 == "nobody" { print $3; exit }' /etc/group)
        u=${u:-65534}
        g=${g:-65534}
        gs=$( (echo "$g"; awk -F: '{ n = split($4, m, ","); for (i = 1; i <= n; i++) if (m[i] == "nobody") print $3 }' /etc/group) | sort -un | tr '\n' ' ' | sed 's/ $//')
        echo "Uid: $u $u $u $u|Gid: $g $g $g $g|Groups: $gs|"
    }
    # the pinned oracle's worker under <main-context line>, or "none"
    ng_ids() {
        [ -n "$ORACLE" ] || { echo none; return; }
        printf '%s\npid logs/ng.pid;\nerror_log logs/ng-error.log;\nevents { worker_connections 64; }\nhttp { access_log logs/ng-access.log; server { listen 80; root html; } }\n' "$1" > "$D/n.conf"
        "$ORACLE" -p "$D/" -c n.conf > "$D/ng.out" 2>&1 || { echo none; return; }
        i=0
        while [ $i -lt 50 ] && [ ! -s "$D/logs/ng.pid" ]; do sleep 0.1; i=$((i + 1)); done
        NM=$(cat "$D/logs/ng.pid" 2> /dev/null)
        sleep 0.3
        KP=$NM
        NW=$(kids | head -1)
        if [ -n "$NW" ]; then ids "$NW"; else echo none; fi
        "$ORACLE" -p "$D/" -c n.conf -s stop > /dev/null 2>&1
        i=0
        while [ $i -lt 50 ] && [ -n "$NM" ] && kill -0 "$NM" 2> /dev/null; do sleep 0.1; i=$((i + 1)); done
        rm -f "$D/logs/ng.pid"
    }
    accounts() { # accounts <stock|nouser|member>
        cp /tmp/lobo-user.passwd /etc/passwd
        cp /tmp/lobo-user.group /etc/group
        case "$1" in
        nouser) sed -i '/^nobody:/d' /etc/passwd ;;
        member) echo 'extra:x:1700:nobody' >> /etc/group ;;
        esac
    }
    # default_row <label> <accounts> <main-context line> <also-warn: yes|no>
    default_row() {
        accounts "$2"
        fresh "$3"
        want=$(rule_ids)
        ng=$(ng_ids "$3")
        say "$1: nginx's worker: $ng — the measured rule: $want"
        [ "$ng" = none ] || [ "$ng" = "$want" ]
        check "$1: the pinned nginx's worker reads the measured rule (or the oracle does not run here)" $?
        start
        if up; then
            KP=$MP; H=$(kids | head -1); NH=$(kids | wc -l | tr -d ' ')
            say "$1: master $MP: $(ids "$MP")"
            say "$1: hand ${H:-none}: $(ids "${H:-0}" 2> /dev/null)"
            case "$1" in
            "root, no user line")
                [ "$(ids "$MP")" = "Uid: 0 0 0 0|Gid: 0 0 0 0|Groups: 0|" ] && [ "$NH" = 1 ]
                check "$1: a master that keeps root and ONE hand ($NH), nginx's shape" $?
                check "$1: a file only root may read is 403 (through ws67: 200)" "$([ "$(status_of /secret.txt)" = 403 ] && echo 0 || echo 1)"
                sleep 0.3
                check "$1: the logs are nobody's ($(owner "$D/logs/access.log") $(owner "$D/logs/error.log"))" \
                    "$([ "$(stat -c %u "$D/logs/access.log" 2> /dev/null)" = "$(echo "$want" | awk '{print $2}')" ] && echo 0 || echo 1)"
                ;;
            esac
            [ "$(ids "${H:-0}" 2> /dev/null)" = "$want" ]
            check "$1: the hand reads nginx's worker's lines ($want)" $?
            if [ "$4" = yes ]; then
                check "$1: one [warn] says no account is named nobody" \
                    "$(grep -q '\[warn\] no "user" directive and no account named "nobody"' "$D/serve.out" && echo 0 || echo 1)"
            else
                check "$1: no line about the user (nginx prints none)" \
                    "$(grep -q '\[warn\].*"user"' "$D/serve.out" && echo 1 || echo 0)"
            fi
            stop
        else
            check "$1: the server came up on :80 ($(tr '\n' ' ' < "$D/serve.out" | cut -c1-300))" 1
            kill "$MP" 2> /dev/null
            wait "$MP" 2> /dev/null
        fi
        accounts stock
    }

    # 1. user lw lwx — one hand
    fresh "user lw lwx;"
    start
    if up; then
        KP=$MP; H=$(kids | head -1); NH=$(kids | wc -l | tr -d ' ')
        say "master $MP: $(ids "$MP")"
        say "hand ${H:-none}: $(ids "${H:-0}" 2> /dev/null)"
        [ "$(ids "$MP")" = "Uid: 0 0 0 0|Gid: 0 0 0 0|Groups: 0|" ]
        check "user lw lwx: the master keeps root" $?
        check "user lw lwx: one process configured is a master and ONE hand ($NH)" "$([ "$NH" = 1 ] && echo 0 || echo 1)"
        [ "$(ids "${H:-0}" 2> /dev/null)" = "Uid: 1500 1500 1500 1500|Gid: 1600 1600 1600 1600|Groups: 1600|" ]
        check "user lw lwx: the hand is uid 1500, gid 1600, groups 1600 (nginx's worker lines)" $?
        check "user lw lwx: port 80 answers 200" "$([ "$(status_of /index.html)" = 200 ] && echo 0 || echo 1)"
        check "user lw lwx: a file only root may read is 403" "$([ "$(status_of /secret.txt)" = 403 ] && echo 0 || echo 1)"
        sleep 0.3
        check "user lw lwx: the logs are lw's ($(owner "$D/logs/access.log") $(owner "$D/logs/error.log"))" \
            "$([ "$(owner "$D/logs/access.log")" = lw:root ] && [ "$(owner "$D/logs/error.log")" = lw:root ] && echo 0 || echo 1)"
        mv "$D/logs/access.log" "$D/logs/access.log.1"
        "$LOBO" -p "$D" -c l.conf -s reopen > /dev/null 2>&1
        sleep 0.5
        (status_of /index.html) > /dev/null 2>&1
        sleep 0.6
        check "user lw lwx: after -s reopen the fresh access log is lw's ($(owner "$D/logs/access.log")) and has the request" \
            "$([ "$(owner "$D/logs/access.log")" = lw:root ] && grep -q 'GET /index.html' "$D/logs/access.log" && echo 0 || echo 1)"
        stop
    else
        check "user lw lwx: the server came up on :80 ($(tr '\n' ' ' < "$D/serve.out" | cut -c1-300))" 1
        kill "$MP" 2> /dev/null
        wait "$MP" 2> /dev/null
    fi

    # 2. user lw — the group named like the user
    fresh "user lw;"
    start
    if up; then
        KP=$MP; H=$(kids | head -1)
        say "hand ${H:-none}: $(ids "${H:-0}" 2> /dev/null)"
        [ "$(ids "${H:-0}" 2> /dev/null)" = "Uid: 1500 1500 1500 1500|Gid: 1500 1500 1500 1500|Groups: 1500 1600|" ]
        check "user lw: the hand is uid 1500, gid 1500 (the group named lw), groups 1500 1600" $?
        stop
    else
        check "user lw: the server came up on :80 ($(tr '\n' ' ' < "$D/serve.out" | cut -c1-300))" 1
        kill "$MP" 2> /dev/null
        wait "$MP" 2> /dev/null
    fi

    # 3. two hands
    fresh "user lw lwx; worker_processes 2;"
    start
    if up; then
        KP=$MP; n=0; good=0
        for h in $(kids); do
            n=$((n + 1))
            [ "$(ids "$h")" = "Uid: 1500 1500 1500 1500|Gid: 1600 1600 1600 1600|Groups: 1600|" ] && good=$((good + 1))
        done
        check "worker_processes 2: both hands dropped ($good of $n)" "$([ "$n" = 2 ] && [ "$good" = 2 ] && echo 0 || echo 1)"
        stop
    else
        check "worker_processes 2: the server came up on :80" 1
        kill "$MP" 2> /dev/null
        wait "$MP" 2> /dev/null
    fi

    # 4. an unknown user
    fresh "user nosuch;"
    "$LOBO" -p "$D" -c l.conf -t > "$D/t.out" 2>&1
    rc=$?
    check "user nosuch: -t exits 1 ($rc) with getpwnam(\"nosuch\") failed, located" \
        "$([ "$rc" = 1 ] && grep -q "\[emerg\] getpwnam(\"nosuch\") failed in $D/l.conf:1" "$D/t.out" && echo 0 || echo 1)"
    "$LOBO" -p "$D" -c l.conf serve > "$D/serve.out" 2>&1
    rc=$?
    check "user nosuch: the start exits 1 ($rc) with the same line" \
        "$([ "$rc" = 1 ] && grep -q "\[emerg\] getpwnam(\"nosuch\") failed in $D/l.conf:1" "$D/serve.out" && echo 0 || echo 1)"

    # 5. not root
    fresh "user lw lwx;"
    chown -R lw:lw "$D"
    setpriv --reuid=1500 --regid=1500 --init-groups "$LOBO" -p "$D" -c l.conf -t > "$D/t.out" 2>&1
    rc=$?
    check "not root: -t exits 0 ($rc) with nginx's [warn]" \
        "$([ "$rc" = 0 ] && grep -q '\[warn\] the "user" directive makes sense only if the master process runs with super-user privileges, ignored in' "$D/t.out" && echo 0 || echo 1)"

    # 6–8. root, NO user line — nginx's default (ws68)
    default_row "root, no user line" stock "worker_processes 1;" no
    default_row "no user line, no account named nobody" nouser "worker_processes 1;" yes
    default_row "no user line, a group listing nobody" member "worker_processes 1;" no

    # 9. user root — the hand keeps root, as nginx's worker
    fresh "user root;"
    ng=$(ng_ids "user root;")
    start
    if up; then
        KP=$MP; H=$(kids | head -1)
        say "user root: nginx's worker: $ng — lobo's hand ${H:-none}: $(ids "${H:-0}" 2> /dev/null)"
        [ "$(ids "${H:-0}" 2> /dev/null)" = "Uid: 0 0 0 0|Gid: 0 0 0 0|Groups: 0|" ] && { [ "$ng" = none ] || [ "$ng" = "Uid: 0 0 0 0|Gid: 0 0 0 0|Groups: 0|" ]; }
        check "user root: the hand keeps root, as nginx's worker (0.1.4's posture, said in the config)" $?
        stop
    else
        check "user root: the server came up on :80" 1
        kill "$MP" 2> /dev/null
        wait "$MP" 2> /dev/null
    fi
    if [ "$red" = 0 ]; then
        say "$total/$total checks green (as root in a container: the master keeps root, the hands are the configured user and group — or nginx's default, nobody, with no user line — port 80 still bound, a root-only file refused)"
        exit 0
    fi
    say "$red of $total checks RED" >&2
    exit 1
fi

# ---- OUTSIDE: find an engine, run this file inside as root -----------------
cd "$(dirname "$0")/.." || exit 2
case "$(uname -s)" in
Linux) ;;
*)
    echo "lobo-user: SKIPPED — the privilege drop is linux's at this pin (std.process.set_ids answers unsupported elsewhere) and root is taken only in a container; named platform gap"
    exit 0
    ;;
esac
eng=${LOBO_USER_ENGINE:-}
if [ -z "$eng" ]; then
    if command -v podman > /dev/null 2>&1; then eng=podman; elif command -v docker > /dev/null 2>&1; then eng=docker; fi
fi
if [ -z "$eng" ]; then
    echo "lobo-user: SKIPPED — no container engine (podman or docker) on this host, and root is taken only inside one; named skip"
    exit 0
fi
LOBO="$(pwd)/target/lobo-release"
if [ ! -x "$LOBO" ]; then
    echo "lobo-user: FAILED — $LOBO missing; the gauntlet's build step makes it" >&2
    exit 1
fi
img=${LOBO_USER_IMAGE:-docker.io/library/ubuntu:24.04}
echo "lobo-user: $eng, $img, $LOBO ($(sha256sum "$LOBO" | cut -c1-16)…)"
# ws68: the pinned oracle beside it, for rows 6–9 (absent: the rule)
NG="$(pwd)/tests/differential/bin/nginx"
if [ -x "$NG" ]; then
    set -- -v "$NG:/oracle:ro"
    oarg=/oracle
    echo "lobo-user: the oracle $NG ($(sha256sum "$NG" | cut -c1-16)…) beside it"
else
    set --
    oarg=""
    echo "lobo-user: no oracle at $NG; rows 6–9 hold the measured rule"
fi
"$eng" run --rm --network none --user 0:0 \
    -v "$LOBO:/lobo:ro" -v "$(pwd)/tools/lobo-user:/lobo-user:ro" "$@" \
    "$img" bash /lobo-user --inside /lobo $oarg
rc=$?
if [ "$rc" != 0 ]; then
    echo "lobo-user: FAILED — exit $rc from the container (a red check above, or the container did not run)" >&2
    exit 1
fi
