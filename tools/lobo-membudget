#!/bin/sh
# lobo-membudget — the ws10 STRUCTURE AUDIT witness (target 1, the
# sprint's soul): budgets over a structure that secretly accumulates
# per-request memory would be theater, so this pins what the audit
# proved and NAMES what upstream still owes.
#
# THE METHOD (a deliverable of the audit; the full story is
# docs/BUDGET.md §audit): wolf exposes no in-language region
# accounting at this pin (the runtime's ledger — wolf_rt
# region_bytes()/live_region_bytes() — reaches no lane; the ask is
# FILED as wolf-lang#187), so the audit observes from OUTSIDE: the
# server's RSS via ps(1) around keepalive drives over ONE connection
# (tests/rig/memdrive.lu; a close before the count is a named
# failure — the keepalive half of the witness).
#
# WHAT GATES TODAY — the per-response REGION claim (the audit's fix):
# response-body bytes die with their response. Witnessed
# DIFFERENTIALLY: the same drive against a 16-byte body and against a
# 16 KiB body must cost the same memory — before the ws10 region fix
# the 16 KiB round leaked its ~6.4 MB of bodies (measured ~290 KB/req
# all-in); after it both rounds cost the same few KB/req. A coarse
# per-request ratchet also gates (a catastrophic regression trips it).
#
# WHAT IS NAMED-GATED — full O(1): str materializations never join
# regions at this pin (the native tier's root-arena realization —
# wolf-lang#191, filed from this audit), so every request still
# retains its head/parse/response STRING work (~24 KB/req under this
# padded shape). The absolute assertion prints its numbers and stays
# a loud skip until the [wolf] pin carries the #191 fix; then it
# flips to a hard gate.
#
# THE ORACLE'S OWN NOISE (ws14, measured 2026-09-02 at the 5f99b9f
# bump, macOS/arm64 with the compressor holding ~40 GB): ps(1)'s RSS
# can SHRINK between two samples when the kernel compresses idle
# pages, so round A's growth read 6976 / 7792 KB where the steady
# reading is ~10.6 MB (2 of 9 quiet runs; 0 of 15 at the previous
# pin) — and the differential then blamed the shortfall on round B.
# A leak is monotone and reproducible; a compressed sample is not.
# So a tripped differential is RE-DRIVEN ONCE, both pairs printed,
# and only a second trip is red — the gate stays real (a 6.4 MB leak
# trips every drive) and the host's page compressor stops writing
# the verdict. The compressor's own counters (`vm_stat`) are the
# evidence a red should be read against.
#
# THE CAP, ENFORCED (ws14 — the ws13 adoption landed at the 5f99b9f
# pin, wolf-lang#219 closed): a SECOND server runs under
# `memory_budget 40k`, so every budgeted response's body work runs
# inside a proc under `region r(cap: ledger_cap(40960))` — docs/
# BUDGET.md's arithmetic — and the suite RE-BASELINES the same rounds
# through that path: round A'/B' under the same two gates as A/B.
#
# ws15 RE-BASELINES THE BREACH ITSELF (D40). ws14 measured the
# ledger's growth law — charge(N) = 16 x pow2ceil(N) - 16 — and found
# a BAND in which the runtime refused a request the meter had
# admitted: under the flat 16x envelope (cap 655,360) a 33,000-byte
# file charged 1,048,560 and died at the join — 503 `site=region`,
# through a real socket. D40 makes the envelope follow the law
# (`16 x pow2ceil(budget)`, so 40k caps at 1,048,576) and the band
# CLOSES. This suite measures the closure end to end: the same
# 33,000-byte file, the same config, serves 200 in full and the log
# carries NO site=region event — while a 50,000-byte file beside it
# is still refused by the METER (503 `site=file`, before any proc
# runs). So the operator-visible refusal is the meter's alone and the
# cap is the backstop it was meant to be. The server keeps serving
# keepalive requests afterwards, and `lobo status` counts exactly one
# budget-503 with `mem-rt-hw` non-zero (the measured bytes came back
# through the self-pipe, so the capped proc really ran).
#
# The `site=region` mapping keeps its witness where a config can no
# longer reach it: tests/serve/budget_cap.lu drives the join directly
# and asserts the backstop theorem over the whole shape space the
# meter can admit.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

case "$(uname -s)" in
Linux | Darwin) ;;
*)
    echo "lobo-membudget: SKIPPED — the RSS oracle is ps(1) on Linux/macOS; other hosts join when a portable memory probe exists (named platform gap)"
    exit 0
    ;;
esac

LOBO="$(pwd)/target/lobo-release"
if [ ! -x "$LOBO" ]; then
    echo "lobo-membudget: FAILED — $LOBO missing; the gauntlet's build step makes it" >&2
    exit 1
fi

scratch="target/lobo-membudget"
rm -rf "$scratch"
mkdir -p "$scratch/w"
# small.html: 16 bytes. big.html: 16 KiB — the differential's body.
printf 'SMALL-BODY-16BB\n' > "$scratch/w/small.html"
i=0
while [ $i -lt 512 ]; do
    printf 'AUDIT-BODY-%05d-abcdefghijklmnopqr\n' "$i"
    i=$((i + 1))
done > "$scratch/w/big.html"

red=0
total=0
say() { echo "lobo-membudget: $1"; }
check() { # check <desc> <ok(0/1)>
    total=$((total + 1))
    if [ "$2" = 0 ]; then
        say "ok — $1"
    else
        say "FAILED — $1" >&2
        red=$((red + 1))
    fi
}

hp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
printf 'pid %s/lobo.pid;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s; root %s/w; }\n}\n' \
    "$scratch" "$hp" "$scratch" > "$scratch/lobo.conf"

"$LOBO" serve -p . -c "$scratch/lobo.conf" 2> "$scratch/lobo.log" &
pid=$!

i=0
while [ $i -lt 80 ]; do
    if grep -q "generation-activated gen=1" "$scratch/lobo.log" 2>/dev/null; then break; fi
    sleep 0.1
    i=$((i + 1))
done

rss_kb() { ps -o rss= -p "$pid" | tr -d ' '; }
drive() { # drive <count> <path> <desc>
    if out=$("$WOLF" run "$rig_root"/tests/rig/memdrive.lu "$hp" "$1" "$2" 2> "$scratch/drive.err"); then
        check "$3 ($out)" 0
    else
        check "$3 (stderr: $(tail -c 120 "$scratch/drive.err"))" 1
    fi
}

# warmup — allocator pools, lazy init, first-touch costs land here
drive 100 /small.html "warmup: 100 keepalive requests on one connection"

# rounds A and B, as one pair (re-driven once on a tripped
# differential — the header's compressor note)
pair() { # pair <label> — sets r0 r1 r2 ga gb diff
    r0=$(rss_kb)
    # round A: 400 small-body requests over ONE connection
    drive 400 /small.html "round A$1: 400 keepalive requests, 16 B body, one connection"
    r1=$(rss_kb)
    # round B: 400 big-body requests over ONE connection — same head
    # shape, bodies 1000x larger; the region claim says SAME memory cost
    drive 400 /big.html "round B$1: 400 keepalive requests, 16 KiB body, one connection"
    r2=$(rss_kb)
    if [ -z "$r0" ] || [ -z "$r1" ] || [ -z "$r2" ]; then
        ga=""
        return
    fi
    ga=$((r1 - r0))
    gb=$((r2 - r1))
    diff=$((gb - ga))
    say "growth$1: round A ${ga} KB, round B ${gb} KB, body-attributable difference ${diff} KB (a leaked 16 KiB body x 400 would be ~6400 KB)"
}
pair ""
if [ -n "${ga:-}" ] && [ "$diff" -ge 3200 ]; then
    say "note — the differential tripped once (round A ${ga} KB against a ~10.6 MB steady reading is the compressor's signature, not a body leak); re-driving the pair on the same server"
    pair " (re-drive)"
fi

kill "$pid" 2>/dev/null
wait "$pid" 2>/dev/null

if [ -z "${ga:-}" ]; then
    check "RSS sampled at all checkpoints (r0='$r0' r1='$r1' r2='$r2')" 1
else
    if [ "$diff" -lt 3200 ]; then
        check "response bodies die with their response (B-A ${diff} KB < 3200 KB): the per-response region is load-bearing" 0
    else
        check "response bodies die with their response (B-A ${diff} KB < 3200 KB) — tripped twice: a leak, not the compressor" 1
    fi
    perreq=$((gb / 400))
    if [ "$perreq" -lt 64 ]; then
        check "per-request retention ratchet (${perreq} KB/req < 64 KB/req)" 0
    else
        check "per-request retention ratchet (${perreq} KB/req < 64 KB/req)" 1
    fi
    if [ "$gb" -lt 4096 ]; then
        say "note — full O(1) already holds (round B grew ${gb} KB); if the [wolf] pin now carries the wolf-lang#191 fix, FLIP the gate below to hard"
    else
        say "NAMED GATE (loud skip, not a pass): full O(1) growth is upstream-gated — str materializations never join regions at this pin (wolf-lang#191, filed by this audit); round B retained ${gb} KB of string work. This line becomes a hard gate at the pin that carries the fix."
    fi
fi

# ---------------------------------------------------------------
# ws14: THE CAP, ENFORCED — the second server, under a budget
# ---------------------------------------------------------------
# band.bin: 33,000 bytes — pow2ceil 65,536 → the ledger charges
# 1,048,560. Under ws14's flat envelope (655,360) that was a breach;
# under D40's (16 x pow2ceil(40,960) = 1,048,576) it fits by sixteen
# bytes, which is the closure this round measures. fits.bin: 32,768
# bytes — a power of two → 524,272. over.bin: 50,000 bytes — over the
# DIRECTIVE, so the meter refuses it before any proc is spawned.
head -c 33000 /dev/zero | tr '\0' 'B' > "$scratch/w/band.bin"
head -c 32768 /dev/zero | tr '\0' 'F' > "$scratch/w/fits.bin"
head -c 50000 /dev/zero | tr '\0' 'O' > "$scratch/w/over.bin"
hp2=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
ctp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
conf2="$scratch/lobo-cap.conf"
printf 'pid %s/lobo-cap.pid;\ncontrol 127.0.0.1:%s;\nhttp {\n  types { text/html html; application/octet-stream bin; }\n  memory_budget 40k;\n  server { listen 127.0.0.1:%s; root %s/w; }\n}\n' \
    "$scratch" "$ctp" "$hp2" "$scratch" > "$conf2"

"$LOBO" serve -p . -c "$conf2" 2> "$scratch/lobo-cap.log" &
pid=$!
i=0
while [ $i -lt 80 ]; do
    if grep -q "generation-activated gen=1" "$scratch/lobo-cap.log" 2>/dev/null; then break; fi
    sleep 0.1
    i=$((i + 1))
done
hp="$hp2"

drive 100 /small.html "cap warmup: 100 keepalive requests through the capped proc"
pair " (cap)"
if [ -n "${ga:-}" ] && [ "$diff" -ge 3200 ]; then
    say "note — the capped differential tripped once (the compressor's signature); re-driving the pair on the same server"
    pair " (cap, re-drive)"
fi
if [ -z "${ga:-}" ]; then
    check "cap: RSS sampled at all checkpoints (r0='$r0' r1='$r1' r2='$r2')" 1
else
    if [ "$diff" -lt 3200 ]; then
        check "cap: response bodies die with their response THROUGH THE PROC (B-A ${diff} KB < 3200 KB): the capped region is load-bearing" 0
    else
        check "cap: response bodies die with their response THROUGH THE PROC (B-A ${diff} KB < 3200 KB) — tripped twice" 1
    fi
    perreq=$((gb / 400))
    if [ "$perreq" -lt 64 ]; then
        check "cap: per-request retention ratchet through the proc (${perreq} KB/req < 64 KB/req)" 0
    else
        check "cap: per-request retention ratchet through the proc (${perreq} KB/req < 64 KB/req)" 1
    fi
fi

# D40 re-baseline, through a real socket: the band closed. The file
# ws14 measured as a runtime refusal is admitted by the meter AND
# fits the envelope now; the meter is the only refusal a config can
# still reach.
ask() { # ask <path> — one raw GET, the whole reply on stdout
    printf 'GET %s HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n' "$1" | nc 127.0.0.1 "$hp2" 2>/dev/null
}
body_of() { # body_of <reply> — the byte length after the header block
    printf '%s' "$1" | awk 'BEGIN{RS="\r\n\r\n"} NR==2{printf "%d", length($0)}'
}
len_of() { # len_of <reply> — the Content-Length header value
    printf '%s' "$1" | sed -n 's/^Content-Length: \([0-9]*\).*/\1/p' | head -1
}

rband=$(ask /band.bin)
got_len=$(len_of "$rband")
body_len=$(body_of "$rband")
if printf '%s' "$rband" | head -1 | grep -q '^HTTP/1.1 200 OK' && [ "$got_len" = 33000 ] && [ "$body_len" = 33000 ]; then
    check "D40 band closed: 33,000 bytes under memory_budget 40k — the ws14 BREACH (charge 1,048,560 against the old 655,360 cap) — serves 200 in full through the proc under the new envelope, 16 x pow2ceil(40960) = 1,048,576" 0
else
    check "D40 band closed: expected 200 with 33000 body bytes, got status '$(printf '%s' "$rband" | head -1)' len=$got_len body=$body_len" 1
fi
r200=$(ask /fits.bin)
got_len=$(len_of "$r200")
body_len=$(body_of "$r200")
if printf '%s' "$r200" | head -1 | grep -q '^HTTP/1.1 200 OK' && [ "$got_len" = 32768 ] && [ "$body_len" = 32768 ]; then
    check "cap fits: the 32,768-byte file beside it (a power of two: 524,272 ledger units) serves 200 in full through the proc" 0
else
    check "cap fits: expected 200 with 32768 body bytes, got status '$(printf '%s' "$r200" | head -1)' len=$got_len body=$body_len" 1
fi

# the meter still refuses — and after D40 it is the ONLY refusal a
# config can reach (the cap is the backstop, not a second meter)
r503=$(ask /over.bin | tr -d '\r')
if printf '%s\n' "$r503" | head -1 | grep -q '^HTTP/1.1 503 Service Temporarily Unavailable$' \
    && printf '%s\n' "$r503" | grep -q '^Connection: close$'; then
    check "the meter still refuses: 50,000 bytes over memory_budget 40k is a 503 Service Temporarily Unavailable with Connection: close, through a real socket" 0
else
    check "the meter still refuses: expected a 503 through the socket, got: $(printf '%s' "$r503" | head -1)" 1
fi
sleep 0.2
if grep -q 'budget-exceeded gen=1 site=file budget=40960 ' "$scratch/lobo-cap.log"; then
    check "the meter still refuses: the event names the ADMISSION site — budget-exceeded site=file budget=40960, refused before any proc was spawned" 0
else
    check "the meter still refuses: the site=file event is missing from the log: $(grep budget-exceeded "$scratch/lobo-cap.log" | head -1)" 1
fi
if grep -q 'site=region' "$scratch/lobo-cap.log"; then
    check "D40: NO site=region event in the whole run (got: $(grep -o 'site=region.*' "$scratch/lobo-cap.log" | head -1))" 1
else
    check "D40: NO site=region event in the whole run — after the re-baseline no config reaches the runtime's refusal, and the join keeps its witness in tests/serve/budget_cap.lu" 0
fi
drive 50 /small.html "the server lives: 50 keepalive requests after the meter's refusal"
st=$("$LOBO" status -p . -c "$conf2" 2>/dev/null)
g1=$(printf '%s\n' "$st" | grep 'generation 1:' | head -1)
if printf '%s' "$g1" | grep -q 'budget-503s=1' && printf '%s' "$g1" | grep -q 'mem-rt-hw=' && ! printf '%s' "$g1" | grep -q 'mem-rt-hw=0 '; then
    check "status: exactly one budget-503 counted and mem-rt-hw non-zero (the measured bytes came back through the self-pipe): ${g1}" 0
else
    check "status: expected budget-503s=1 and a non-zero mem-rt-hw, got: ${g1}" 1
fi

kill "$pid" 2>/dev/null
wait "$pid" 2>/dev/null

if [ "$red" != 0 ]; then
    echo "lobo-membudget: RED — $red of $total checks failed (logs under $scratch/)" >&2
    exit 1
fi
echo "lobo-membudget: $total/$total checks green (bodies O(1) per response, through the capped proc too; D40's band closed — the ws14 breach serves 200 and the meter alone refuses, through a real socket; the str half is wolf-lang#191's, named above)"
