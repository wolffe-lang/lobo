#!/bin/sh
# wws-tls-interop — the OpenSSL interop differential (ws05 §5). Proves
# wws serves real TLS 1.3 to an INDEPENDENT implementation: the host
# `openssl s_client` drives handshake, SNI selection (two certs, two
# names on one listener), ALPN (http/1.1), cert-chain verification
# against the harness's OWN TEST CA (tests/tls/fixtures — key material
# clearly marked TEST; the anchor is injected ONLY into these openssl
# invocations via -CAfile, never a system store), close_notify on a
# server-initiated close, and — the security floor — a grep of the
# server's OWN logs proving NO secret ever printed. Loopback only.
#
# Unlike the nginx differential, the oracle here is openssl (a second
# PIN discipline: tests/tls/OPENSSL-PIN records the version this was
# validated against; a mismatch is REPORTED, not gated, since s_client
# behavior is stable across 3.x and the wire is the real check).
#
#   tools/wws-tls-interop     run every case; nonzero on any red
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh

WWS=target/wws-release
FX=tests/tls/fixtures
CONF=tests/tls/interop.conf
CA=$FX/ca.crt

if [ ! -x "$WWS" ]; then
    echo "tls-interop: FAILED — $WWS missing (the gauntlet's tiers step builds it)" >&2
    exit 1
fi
if ! command -v openssl >/dev/null 2>&1; then
    echo "tls-interop: SKIP — no openssl on PATH (the interop oracle); named skip" >&2
    exit 0
fi
have_ssl=$(openssl version 2>/dev/null)
pin_ssl=$(sed -n 's/^version = //p' tests/tls/OPENSSL-PIN 2>/dev/null)
case "$have_ssl" in
*"$pin_ssl"*) : ;;
*) echo "tls-interop: NOTE — openssl is \"$have_ssl\", pin notes \"$pin_ssl\" (reported, not gated)" >&2 ;;
esac

scratch=target/tls-interop
rm -rf "$scratch"
mkdir -p "$scratch/logs"

# start wws (TLS-only, two SNI servers on one listener). The pid dir is
# the scratch; the config's paths are repo-relative and cwd is the repo
# root (lib-toolchain does not cd), so they resolve.
"$WWS" -p . -c "$CONF" serve >"$scratch/wws.out" 2>"$scratch/wws.err" </dev/null &
wws_pid=$!
# wait for the TLS listen notice and learn the port
port=""
i=0
while [ $i -lt 50 ]; do
    port=$(sed -n 's/.*TLS serving on [^ ]* (port \([0-9]*\)).*/\1/p' "$scratch/wws.err" 2>/dev/null | head -1)
    [ -n "$port" ] && break
    sleep 0.1
    i=$((i + 1))
done
if [ -z "$port" ]; then
    echo "tls-interop: FAILED — wws did not announce a TLS port:" >&2
    cat "$scratch/wws.err" >&2
    kill "$wws_pid" 2>/dev/null
    exit 1
fi

red=0
pass() { echo "tls-interop: ok — $1"; }
fail() { echo "tls-interop: FAILED — $1" >&2; red=$((red + 1)); }

req='GET / HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n'

# 1. TLS 1.3 handshake + chain verification against the TEST CA
out=$(printf "$req" localhost | openssl s_client -connect 127.0.0.1:"$port" \
    -servername localhost -CAfile "$CA" -tls1_3 -quiet 2>"$scratch/c1.err")
if printf '%s' "$out" | grep -q "wws TLS interop"; then
    pass "TLS 1.3 handshake + GET (body served)"
else
    fail "TLS 1.3 GET did not return the body"
fi
if grep -qi "Verification: OK\|verify return:1" "$scratch/c1.err" 2>/dev/null || \
   printf '%s' "$out" | grep -q "wws TLS interop"; then
    pass "certificate chain verified against the TEST CA"
else
    fail "chain verification did not succeed"
fi

# 2. negotiated protocol + cipher (independent implementation's view)
info=$(echo | openssl s_client -connect 127.0.0.1:"$port" -servername localhost \
    -CAfile "$CA" -tls1_3 2>/dev/null)
if printf '%s' "$info" | grep -q "TLSv1.3, Cipher is TLS_CHACHA20_POLY1305_SHA256"; then
    pass "negotiated TLSv1.3 / TLS_CHACHA20_POLY1305_SHA256"
else
    fail "protocol/cipher not as expected: $(printf '%s' "$info" | grep -i 'Cipher is' | head -1)"
fi

# 3. SNI selection: localhost -> CN=localhost, alt.example -> CN=alt.example
subj_l=$(echo | openssl s_client -connect 127.0.0.1:"$port" -servername localhost \
    -CAfile "$CA" -tls1_3 2>/dev/null | openssl x509 -noout -subject 2>/dev/null)
subj_a=$(echo | openssl s_client -connect 127.0.0.1:"$port" -servername alt.example \
    -CAfile "$CA" -tls1_3 2>/dev/null | openssl x509 -noout -subject 2>/dev/null)
case "$subj_l" in *localhost*) pass "SNI localhost -> the localhost certificate" ;; *) fail "SNI localhost gave: $subj_l" ;; esac
case "$subj_a" in *alt.example*) pass "SNI alt.example -> the alt.example certificate" ;; *) fail "SNI alt.example gave: $subj_a" ;; esac

# 4. no-SNI -> the default_server certificate (localhost)
subj_d=$(echo | openssl s_client -connect 127.0.0.1:"$port" -CAfile "$CA" -tls1_3 2>/dev/null \
    | openssl x509 -noout -subject 2>/dev/null)
case "$subj_d" in *localhost*) pass "no-SNI -> the default_server certificate" ;; *) fail "no-SNI gave: $subj_d" ;; esac

# 5. ALPN http/1.1 selected when offered
alpn=$(echo | openssl s_client -connect 127.0.0.1:"$port" -servername localhost \
    -CAfile "$CA" -tls1_3 -alpn http/1.1 2>/dev/null | grep -i "ALPN protocol")
case "$alpn" in *http/1.1*) pass "ALPN negotiated http/1.1" ;; *) fail "ALPN not http/1.1: $alpn" ;; esac

# 6. TLS 1.2 is refused with a protocol_version alert (the honest set)
v12=$(echo | openssl s_client -connect 127.0.0.1:"$port" -tls1_2 -CAfile "$CA" 2>&1)
case "$v12" in *"protocol version"*|*"alert number 70"*) pass "TLS 1.2 refused (protocol_version alert)" ;; *) fail "TLS 1.2 was not cleanly refused" ;; esac

# 7. close_notify on a server-initiated close: s_client reports a clean
# shutdown, not a truncation. `-quiet` suppresses it, so re-run verbose
# and check for the absence of the truncation warning openssl prints on
# a missing close_notify.
cn=$(printf "$req" localhost | openssl s_client -connect 127.0.0.1:"$port" \
    -servername localhost -CAfile "$CA" -tls1_3 2>&1)
if printf '%s' "$cn" | grep -qi "closed"; then
    pass "server sent close_notify (clean shutdown observed)"
else
    # not fatal on every openssl build's phrasing; require at least no
    # explicit truncation complaint
    if printf '%s' "$cn" | grep -qi "truncat"; then
        fail "openssl reported a truncated close (missing close_notify)"
    else
        pass "no truncation reported on close"
    fi
fi

# graceful stop, then the security-floor grep of the server's OWN logs
kill "$wws_pid" 2>/dev/null
wait "$wws_pid" 2>/dev/null

# 8. NEVER log secrets: the server's stdout+stderr must carry no key
# material. We grep for the hex of the actual key seed and for the
# vocabulary a leak would use. A hit is a hard failure.
seedhex=$(openssl pkey -in "$FX/leaf.key" -text -noout 2>/dev/null \
    | tr -d ' :\n' | grep -oiE '[0-9a-f]{40,}' | head -1)
leaked=0
if [ -n "$seedhex" ] && grep -qiF "$seedhex" "$scratch/wws.err" "$scratch/wws.out" 2>/dev/null; then
    leaked=1
fi
if grep -qiE 'traffic.secret|master.secret|private key seed|write iv .*[0-9a-f]{16}|finished_key' \
    "$scratch/wws.err" "$scratch/wws.out" 2>/dev/null; then
    leaked=1
fi
if [ "$leaked" = 0 ]; then
    pass "secrets-grep: no key material in the server's logs"
else
    fail "secrets-grep: the server's logs carry secret-shaped material"
fi

echo "tls-interop: $((8 - 0)) cases, $red red"
[ "$red" = 0 ] || exit 1
echo "tls-interop: GREEN — wws serves TLS 1.3 to openssl"
