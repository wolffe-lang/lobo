#!/bin/sh
# lobo-signal — the REAL-SIGNAL witness (wsm01, s114 in the pin): a
# genuine SIGHUP / SIGQUIT / SIGTERM — sent with kill(1), the test
# harness's signal path; the server's os pid is the shell's `$!`,
# because nothing in wolf exposes a getpid yet (the named residue —
# the pid FILE still records the control endpoint) — drives the SAME
# observable drain ws08's control-channel tests pin:
#   1. a held keepalive connection puts generation 1 at live=1;
#   2. a REAL `kill -HUP` reloads: gen 1 DRAINING live=1 while gen 2
#      serves new connections (byte-checked against the new root);
#   3. the holder closes: gen 1 RETIRES;
#   4. a REAL `kill -QUIT` drains and exits 0, pid file removed;
#   5. a REAL `kill -TERM` is the fast shutdown — witnessed on a
#      server with NO control directive at all, which is the point:
#      signals need no channel.
# The log-event trail (`signal-received sig=… verb=… source=…`, the
# wsm01 vocabulary extension with ws15's appended field) is asserted
# both ways — and step 6 is ws15's own claim, MEASURED: a control verb
# and a real signal drive the SAME dispatch, so the two reloads' event
# blocks are byte-identical once the generation numbers and the seq
# stamps are normalized away, and `source` is the whole of the
# difference. That is what "a verb and a signal are indistinguishable
# in the log" means, stated as a diff rather than a promise.
#
# Linux + macOS at this pin ([os.signal.platform]: s114 was
# Linux-full; macOS joined at s59 via the task-layer port — the wsm03
# pin carries it, and the wsm03 gauntlet measured the full suite green
# on macOS/arm64). Other hosts still SKIP, by name, exit 0 (BSDs widen
# with s61; Windows has no HUP at all). The control channel remains
# the portable trigger and its tests gate on every platform.
set -u
cd "$(dirname "$0")/.." || exit 2
. tools/lib-toolchain.sh
. tools/lib-rigproc.sh
rig_arm

case "$(uname -s)" in
Linux | Darwin) ;;
*)
    echo "lobo-signal: SKIPPED — signal delivery is Linux+macOS at this pin (s114/s59); other hosts follow the ports (named platform gap)"
    exit 0
    ;;
esac

LOBO="$(pwd)/target/lobo-release"
if [ ! -x "$LOBO" ]; then
    echo "lobo-signal: FAILED — $LOBO missing; the gauntlet's build step makes it" >&2
    exit 1
fi

scratch="target/lobo-signal"
rm -rf "$scratch"
mkdir -p "$scratch/A" "$scratch/B"
echo "SIG-GEN-A" > "$scratch/A/index.html"
echo "SIG-GEN-B" > "$scratch/B/index.html"

red=0
total=0
say() { echo "lobo-signal: $1"; }
check() { # check <desc> <ok(0/1)>
    total=$((total + 1))
    if [ "$2" = 0 ]; then
        say "ok — $1"
    else
        say "FAILED — $1" >&2
        red=$((red + 1))
    fi
}

hp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
ctp=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
conf="$scratch/lobo.conf"
render() { # render <root>
    printf 'pid %s/lobo.pid;\ncontrol 127.0.0.1:%s;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s; root %s; }\n}\n' \
        "$scratch" "$ctp" "$hp" "$1" > "$conf"
}
render "$scratch/A"

"$LOBO" serve -p . -c "$conf" 2> "$scratch/lobo.log" &
pid=$!

# status text via the lobo CLI (reads the pid file's control endpoint)
status_text() { "$LOBO" status -p . -c "$conf" 2>/dev/null; }
poll() { # poll <desc> <grep-pattern> — up to ~8s
    i=0
    while [ $i -lt 80 ]; do
        if status_text | grep -q "$2"; then
            check "$1" 0
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
    say "status at timeout: $(status_text | tr '\n' ' | ')" >&2
    check "$1" 1
    return 1
}

poll "server up, generation 1 current" "generation 1: current"

# 1. hold a keepalive connection on generation 1
"$WOLF" run "$rig_root"/tests/rig/holdconn.lu "$hp" 4000 > "$scratch/hold.out" 2> "$scratch/hold.err" &
holder=$!
poll "held connection counted (gen 1 live=1)" "generation 1: current live=1"

# 2. REAL SIGHUP — the reload trigger. Swap the root first so the new
# generation is observably different.
render "$scratch/B"
kill -HUP "$pid"
poll "SIGHUP drains gen 1 (draining live=1)" "generation 1: draining live=1"
poll "generation 2 current while gen 1 drains" "generation 2: current"

# gen 2 serves a NEW connection while gen 1 still drains
printf 'GET /index.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n' > "$scratch/req.txt"
body=$("$WOLF" run "$rig_root"/tests/rig/diffsend.lu "$hp" "$scratch/req.txt" 2>/dev/null)
case "$body" in
*SIG-GEN-B*) check "new connection served by generation 2 during the drain" 0 ;;
*) check "new connection served by generation 2 during the drain (got: $(printf '%s' "$body" | tail -c 60))" 1 ;;
esac

# 3. the holder closes -> generation 1 retires
wait "$holder"
check "holder exited cleanly" $?
i=0
while [ $i -lt 80 ]; do
    if status_text | grep -q "generation 1:"; then sleep 0.1; i=$((i + 1)); else break; fi
done
if status_text | grep -q "generation 1:"; then
    check "generation 1 retired after the held connection closed" 1
else
    check "generation 1 retired after the held connection closed" 0
fi

# 4. REAL SIGQUIT — graceful drain-then-exit
kill -QUIT "$pid"
wait "$pid"
check "SIGQUIT exits 0 (graceful quit)" $?
if [ -f "$scratch/lobo.pid" ]; then
    check "pid file removed on quit" 1
else
    check "pid file removed on quit" 0
fi

# the log-event trail: the signal path names itself
for ev in \
    "signal-received sig=reload verb=reload" \
    "signal-received sig=quit verb=quit" \
    "generation-draining gen=1 held=1" \
    "generation-retired gen=1 drained=1"; do
    if grep -q "$ev" "$scratch/lobo.log"; then
        check "log event: $ev" 0
    else
        check "log event: $ev" 1
    fi
done

# 5. REAL SIGTERM on a server with NO control directive: the fast
# shutdown needs no channel (nginx parity: `kill -TERM` always works).
printf 'pid %s/lobo2.pid;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s; root %s; }\n}\n' \
    "$scratch" "$hp" "$scratch/A" > "$scratch/lobo2.conf"
"$LOBO" serve -p . -c "$scratch/lobo2.conf" 2> "$scratch/lobo2.log" &
pid2=$!
i=0
while [ $i -lt 80 ]; do
    if grep -q "generation-activated gen=1" "$scratch/lobo2.log" 2>/dev/null; then break; fi
    sleep 0.1
    i=$((i + 1))
done
kill -TERM "$pid2"
wait "$pid2"
check "SIGTERM exits 0 with no control channel configured" $?
if grep -q "signal-received sig=terminate verb=stop" "$scratch/lobo2.log"; then
    check "log event: signal-received sig=terminate verb=stop" 0
else
    check "log event: signal-received sig=terminate verb=stop" 1
fi

# 6. THE INDISTINGUISHABILITY WITNESS (ws15). One server, two
# reloads: the first over the control endpoint, the second by a real
# SIGHUP. Both flow through the ONE verb dispatch, so their event
# blocks differ only in the generation numbers, the seq stamps — and
# `source`. Normalize the first two away and the blocks must be
# IDENTICAL; leave `source` alone and it must be the only line that
# differs.
hp3=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
ctp3=$("$WOLF" run "$rig_root"/tests/rig/freeport.lu)
conf3="$scratch/lobo3.conf"
printf 'pid %s/lobo3.pid;\ncontrol 127.0.0.1:%s;\nhttp {\n  types { text/html html; }\n  server { listen 127.0.0.1:%s; root %s; }\n}\n' \
    "$scratch" "$ctp3" "$hp3" "$scratch/A" > "$conf3"
"$LOBO" serve -p . -c "$conf3" 2> "$scratch/lobo3.log" &
pid3=$!
status3() { "$LOBO" status -p . -c "$conf3" 2>/dev/null; }
wait_gen() { # wait_gen <n>
    i=0
    while [ $i -lt 80 ]; do
        if status3 | grep -q "generation $1: current"; then return 0; fi
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}
wait_gen 1 || check "the third server came up" 1

# door 1: the control endpoint (what `lobo -s reload` sends)
"$LOBO" -p . -c "$conf3" -s reload > /dev/null 2>&1
wait_gen 2 || check "the control-channel reload advanced the generation" 1
# door 2: a real SIGHUP
kill -HUP "$pid3"
wait_gen 3 || check "the signal reload advanced the generation" 1
kill -TERM "$pid3"
wait "$pid3" 2>/dev/null

# each reload emits five lines: the trigger event then the four
# generation events it drives
block() { # block <ordinal> — the nth reload's five-line event block
    awk -v want="$1" '
        /signal-received sig=reload/ { c++; if (c == want) n = 5 }
        n > 0 { print; n-- }' "$scratch/lobo3.log"
}
# gen numbers, seq stamps, the content hash and the age are the
# per-run facts; everything else is the shape under test
norm() { sed -e 's/gen=[0-9][0-9]*/gen=G/g' -e 's/seq=[0-9][0-9]*/seq=S/g' \
    -e 's/id=[0-9a-f][0-9a-f]*/id=I/g' -e 's/age-ms=[0-9][0-9]*/age-ms=A/g'; }

block 1 > "$scratch/door-control.log"
block 2 > "$scratch/door-signal.log"
lines_c=$(wc -l < "$scratch/door-control.log" | tr -d ' ')
lines_s=$(wc -l < "$scratch/door-signal.log" | tr -d ' ')
if [ "$lines_c" = 5 ] && [ "$lines_s" = 5 ]; then
    check "both doors emitted the same five-event block (trigger + draining + loaded + activated + retired)" 0
else
    check "expected a five-line block from each door, got control=$lines_c signal=$lines_s" 1
fi
if grep -q 'signal-received sig=reload verb=reload source=control' "$scratch/door-control.log"; then
    check "the control door names itself: signal-received sig=reload verb=reload source=control" 0
else
    check "the control door's trigger line is wrong: $(head -1 "$scratch/door-control.log")" 1
fi
if grep -q 'signal-received sig=reload verb=reload source=signal' "$scratch/door-signal.log"; then
    check "the signal door names itself: signal-received sig=reload verb=reload source=signal" 0
else
    check "the signal door's trigger line is wrong: $(head -1 "$scratch/door-signal.log")" 1
fi
norm < "$scratch/door-control.log" > "$scratch/door-control.norm"
norm < "$scratch/door-signal.log" > "$scratch/door-signal.norm"
ndiff=$(diff "$scratch/door-control.norm" "$scratch/door-signal.norm" | grep -c '^[<>]' || true)
if [ "$ndiff" = 2 ]; then
    check "INDISTINGUISHABLE: the two blocks differ on exactly ONE line, and only in its source field — a control verb and a real signal are the same code path (docs/CONTROL.md)" 0
else
    say "diff of the two normalized blocks:" >&2
    diff "$scratch/door-control.norm" "$scratch/door-signal.norm" >&2
    check "expected exactly one differing line between the doors, got $ndiff diff lines" 1
fi
sdiff=$(sed 's/source=[a-z][a-z]*/source=X/' "$scratch/door-control.norm" > "$scratch/dc.x"; \
    sed 's/source=[a-z][a-z]*/source=X/' "$scratch/door-signal.norm" > "$scratch/ds.x"; \
    diff "$scratch/dc.x" "$scratch/ds.x" | grep -c '^[<>]' || true)
if [ "$sdiff" = 0 ]; then
    check "with source normalized too the blocks are BYTE-IDENTICAL: source is the whole of the difference" 0
else
    diff "$scratch/dc.x" "$scratch/ds.x" >&2
    check "the blocks still differ with source normalized ($sdiff lines) — the doors are NOT one dispatch" 1
fi

if [ "$red" != 0 ]; then
    echo "lobo-signal: RED — $red of $total checks failed (logs under $scratch/)" >&2
    exit 1
fi
echo "lobo-signal: $total/$total checks green (a real SIGHUP drove the observable drain; and a control verb's event block is byte-identical to a signal's but for source=)"
