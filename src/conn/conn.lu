//! member: true
//! conn — THE SEAM (ws05). A connection the http lifecycle reads,
//! writes, deadlines and closes without knowing whether bytes travel
//! in the clear or inside TLS 1.3 records. serve/ drives every socket
//! operation through this abstraction; the plaintext backend forwards
//! verbatim to the net builtins (byte-identical to ws02 — the nginx
//! differential is the guard), the TLS backend routes through
//! tls.Sess (std.x.tls's server session). If TLS ever leaks past this
//! seam, every later sprint pays — so the reviewer's flag is this
//! module's `.wolfi`: serve's signatures speak `Conn`, never a raw
//! fd, from ws05 on.
//! The seam is deliberately the SAME five operations ws02 already
//! used (read a str, write a str, write raw bytes, arm a deadline,
//! close): TLS reads return DECRYPTED lengths unrelated to socket
//! reads and record boundaries split anywhere, but the lifecycle
//! above never sees that — conn_read hands back exactly what
//! net_read would have. On TLS, `tests/tls/session_pieces.lu` feeds a
//! session its records in pieces of 1, 7 and 64 bytes, and
//! `tests/serve/tls_step.lu` steps a TLS row over a loopback pair.
//! close_notify: conn_close on a TLS conn sends close_notify (every
//! server-initiated close does — the truncation defence); on the
//! plaintext side it is the bare socket close, unchanged.
//! This pin has no private field, so a Conn is forgeable; every op
//! reads the fields as data (kind picks the backend) and answers with
//! rows, never traps.
//! Lane note: net + tls — native is the executing lane (tls's crypto
//! rules lupin and the checked step budget out); the plaintext
//! backend alone is what ws02's own tests already exercise.
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use config
use tls

/// A connection the lifecycle serves through. `kind` 0 = plaintext
/// (forward to the net builtins, ws02 behavior verbatim), 1 = TLS
/// (route through `sess`). `fd` is the socket for the plaintext
/// backend and for arming deadlines on both. `sess` is the TLS
/// session (a placeholder `tls.no_sess()` on a plaintext conn — the
/// struct has no optional field at this pin, so it is always present
/// and simply unused when `kind` is 0).
pub struct Conn {
    kind: int,
    fd: int,
    sess: tls.Sess,
}

/// A plaintext connection over `fd` (the ws02 path — every op is the
/// bare net builtin). Total.
pub fn plain(fd: int) -> Conn {
    Conn { kind: 0, fd: fd, sess: tls.no_sess() }
}

/// A TLS connection wrapping an established session (the fd is the
/// same socket, kept for deadline arming). Total.
pub fn tls_conn(fd: int, take sess: tls.Sess) -> Conn {
    Conn { kind: 1, fd: fd, sess: sess }
}

/// Whether this is a TLS connection. Total.
pub fn is_tls(cn: Conn) -> bool {
    cn.kind == 1
}

/// The underlying socket fd — the plaintext-proxy handoff (proxy/ is
/// ws03, still fd-based; a TLS conn never reaches it, see serve).
/// Total.
pub fn fd(cn: Conn) -> int {
    cn.fd
}

/// The negotiated SNI on a TLS conn ("" plaintext or none). Total.
pub fn sni(cn: Conn) -> str {
    cn.sess.sni
}

/// Whether the peer truncated (EOF without close_notify) on a TLS
/// conn — the ws12 metric hook; always false plaintext. Total.
pub fn truncated(cn: Conn) -> bool {
    cn.sess.trunc
}

/// Read up to `max` bytes as a str, exactly as `net_read` would
/// (same rows: `closed`, `timeout`, `utf8`, `io`). The TLS backend
/// reads decrypted application bytes through the session and decodes
/// them — a chunk that splits a UTF-8 code point is the `utf8` row,
/// the same answer net_read gives (loopback HTTP is ASCII, so the
/// split never fires; the byte path carries binary). The plaintext
/// backend is `net_read` itself: since wolf 0.2.28 (s228) it places
/// its bytes in the caller's region, which is what ws57's `sock_read`
/// did by hand (ws62 retired it).
/// (W0602 allowed: the row mirrors net_read exactly (closed/timeout/utf8/io) so the seam is transparent.)
#[allow(w0602)]
pub fn conn_read(mut cn: Conn, max: int) -> str ! {closed, timeout, utf8, io} {
    if cn.kind == 0 {
        net_read(cn.fd, max)?
    } else {
        var code = 0
        let bytes = tls.sess_read(mut cn.sess, max) else |e| match e {
            closed => {
                code = 1
                List[byte]()
            },
            timeout => {
                code = 2
                List[byte]()
            },
            io => {
                code = 3
                List[byte]()
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return timeout
        }
        if code == 3 {
            return io
        }
        str_from_utf8(bytes) else |_| {
            return utf8
        }
    }
}

/// Read up to `max` bytes as a byte list (the binary path — no utf8
/// row). Rows: `closed`, `timeout`, `io`.
/// (W0602 allowed: the row mirrors net_read_bytes (closed/timeout/io).)
#[allow(w0602)]
pub fn conn_read_bytes(mut cn: Conn, max: int) -> List[byte] ! {closed, timeout, io} {
    if cn.kind == 0 {
        var code = 0
        let b = net_read_bytes(cn.fd, max) else |e| match e {
            closed => {
                code = 1
                List[byte]()
            },
            timeout => {
                code = 2
                List[byte]()
            },
            io => {
                code = 3
                List[byte]()
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return timeout
        }
        if code == 3 {
            return io
        }
        b
    } else {
        tls.sess_read(mut cn.sess, max)?
    }
}

/// One read of what has arrived, never more (lobo#142: the serving
/// loop's step, under the deadline its caller armed). Plaintext: the
/// bytes `net_read_bytes` answers, an empty read being the peer's EOF.
/// TLS: the raw bytes are fed to the session (`tls.sess_feed`), an
/// alert it answers is written best-effort, and the answer is the
/// application bytes of every record they completed. That can be none,
/// which means a record is not whole yet: never the peer's close.
/// Rows: `closed` (the peer's EOF, counted as truncation on a TLS
/// session with no close_notify first; or its close_notify or alert
/// with nothing opened), `timeout`, `io` (a TLS session broken by a
/// record it could not take: its alert is sent, and the bytes opened
/// before that record go with the connection, which the caller closes;
/// the blocking `sess_read` hands them over first).
/// (W0602 allowed: the row mirrors net_read_bytes (closed/timeout/io).)
#[allow(w0602)]
pub fn conn_step_read(mut cn: Conn, max: int) -> List[byte] ! {closed, timeout, io} {
    var code = 0
    let b = net_read_bytes(cn.fd, max) else |e| match e {
        closed => {
            code = 1
            List[byte]()
        },
        timeout => {
            code = 2
            List[byte]()
        },
        io => {
            code = 3
            List[byte]()
        },
    }
    if code == 2 {
        return timeout
    }
    if code == 3 {
        return io
    }
    if code == 1 || b.is_empty() {
        if cn.kind != 0 {
            tls.sess_eof(mut cn.sess)
        }
        return closed
    }
    if cn.kind == 0 {
        return b
    }
    let o = tls.sess_feed(mut cn.sess, b)
    if !o.send.is_empty() {
        net_write_bytes(cn.fd, o.send) else |_| {}
    }
    if o.io {
        return io
    }
    if o.closed && o.plain.is_empty() {
        return closed
    }
    o.plain
}

/// The application bytes of the whole records a TLS session already
/// holds, without reading: those the handshake was fed past the client
/// Finished (lobo#142). An alert the session answers is written
/// best-effort. Plaintext: nothing. Rows: `closed` (the peer's
/// close_notify or alert with nothing opened), `io` (a broken session).
/// (W0602 allowed: conn_step_read's rows, less the read's timeout.)
#[allow(w0602)]
pub fn conn_open_held(mut cn: Conn) -> List[byte] ! {closed, io} {
    if cn.kind == 0 {
        return List[byte]()
    }
    let o = tls.sess_feed(mut cn.sess, List[byte]())
    if !o.send.is_empty() {
        net_write_bytes(cn.fd, o.send) else |_| {}
    }
    if o.io {
        return io
    }
    if o.closed && o.plain.is_empty() {
        return closed
    }
    o.plain
}

/// On a TLS conn, send close_notify once and leave the socket open, for
/// a caller that closes the socket itself (the serving loop's rows).
/// Plaintext: nothing. Total.
pub fn conn_notify(mut cn: Conn) {
    if cn.kind != 0 {
        tls.sess_notify(mut cn.sess)
    }
}

/// A TLS conn's session as bytes (`tls.sess_pack`), the state the
/// serving loop keeps for its row between steps; nothing on plaintext.
/// Total.
pub fn conn_state(cn: Conn) -> List[byte] {
    if cn.kind == 0 {
        return List[byte]()
    }
    tls.sess_pack(cn.sess)
}

/// What a TLS row's state is (`tls.state_phase`): 0 or 1 a handshake,
/// 2 a session, -1 no state. Total.
pub fn state_phase(state: List[byte]) -> int {
    tls.state_phase(state)
}

/// The TLS conn over `fd` whose session is the state `state`
/// (`tls.sess_unpack`; a state that is not a session answers a broken
/// one). Total.
pub fn from_state(fd: int, state: List[byte]) -> Conn {
    tls_conn(fd, take tls.sess_unpack(state, fd))
}

/// What one step of a TLS row's handshake did (lobo#142). `active`:
/// bytes came. `close`: the row is done (a failure, already answered,
/// or the peer's close). `end`: how the handshake ended in this step, as
/// `tls.accept`'s rows were counted: 0 not yet, 1 open, 2 refused (a
/// named failure, the peer's alert, close or EOF), 4 io. `state`: the
/// row's state after it, the handshake's or, once open, the session's.
/// `plain`: once open, the application bytes of the records already
/// behind the client Finished; when those records closed or broke the
/// session, `close` is set and its close_notify is sent.
pub struct HsStep {
    active: bool,
    close: bool,
    end: int,
    state: List[byte],
    plain: List[byte],
}

fn hs_step(
    active: bool,
    close: bool,
    end: int,
    take state: List[byte],
    take plain: List[byte],
) -> HsStep {
    HsStep { active: active, close: close, end: end, state: state, plain: plain }
}

/// One step of a TLS row's handshake whose state is `state`, under the
/// certificate model `sc` (lobo#142): one read under `poll_ms`, fed to
/// the handshake (`tls.hs_feed`), what it answers written. The step that
/// verifies the client Finished opens the session and, in the same step,
/// the records already behind the Finished (`plain`), so a request sent
/// with the Finished is not left unread. Never closes the socket. Total.
pub fn hs_row_step(fd: int, state: List[byte], sc: config.SslConf, poll_ms: int) -> HsStep {
    var h = tls.hs_unpack(state, sc)
    net_deadline(fd, poll_ms) else |_| {
        return hs_step(false, true, 4, take tls.hs_pack(h), take List[byte]())
    }
    // the sentinel shape (tls.accept): route the read's rows through
    // an int
    var errc = 0
    let piece = net_read_bytes(fd, 4096) else |e| match e {
        closed => {
            errc = 1
            List[byte]()
        },
        timeout => {
            errc = 2
            List[byte]()
        },
        io => {
            errc = 3
            List[byte]()
        },
    }
    if errc == 2 {
        return hs_step(false, false, 0, take tls.hs_pack(h), take List[byte]())
    }
    if errc != 0 || piece.is_empty() {
        let why = if errc == 3 { 4 } else { 2 }
        return hs_step(false, true, why, take tls.hs_pack(h), take List[byte]())
    }
    let o = tls.hs_feed(mut h, piece)
    if o.failed {
        // best-effort: the connection is being torn down regardless
        net_write_bytes(fd, o.send) else |_| {}
        let why = if o.io { 4 } else { 2 }
        return hs_step(true, true, why, take tls.hs_pack(h), take List[byte]())
    }
    var wrote = true
    if !o.send.is_empty() {
        net_write_bytes(fd, o.send) else |_| {
            wrote = false
        }
    }
    if !wrote {
        return hs_step(true, true, 4, take tls.hs_pack(h), take List[byte]())
    }
    if !o.done {
        return hs_step(true, false, 0, take tls.hs_pack(h), take List[byte]())
    }
    var cn = tls_conn(fd, take tls.hs_session(h, fd))
    var code = 0
    let held = conn_open_held(mut cn) else |e| match e {
        closed => {
            code = 1
            List[byte]()
        },
        io => {
            code = 1
            List[byte]()
        },
    }
    if code != 0 {
        conn_notify(mut cn)
        return hs_step(true, true, 1, take conn_state(cn), take List[byte]())
    }
    hs_step(true, false, 1, take conn_state(cn), take held)
}

/// Write the full bytes of `s` (str path). Rows: `closed`, `io`.
/// (W0602 allowed: the net writer's vocabulary, carried.)
#[allow(w0602)]
pub fn conn_write(mut cn: Conn, s: str) -> () ! {closed, io} {
    if cn.kind == 0 {
        net_write(cn.fd, s)?
    } else {
        var body = List[byte]()
        for b in s.bytes() {
            (mut body).push(b)
        }
        tls.sess_write(mut cn.sess, body)?
    }
}

/// Write a raw byte body (binary static files). Rows: `closed`, `io`.
/// (W0602 allowed: the net writer's vocabulary, carried.)
#[allow(w0602)]
pub fn conn_write_bytes(mut cn: Conn, body: List[byte]) -> () ! {closed, io} {
    if cn.kind == 0 {
        var code = 0
        net_write_bytes(cn.fd, body) else |e| match e {
            closed => {
                code = 1
            },
            invalid => {
                code = 2
            },
            io => {
                code = 2
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return io
        }
    } else {
        tls.sess_write(mut cn.sess, body)?
    }
}

/// Arm (or clear, ms <= 0) the read/write deadline on the underlying
/// socket — the SAME builtin on both backends (a TLS session's
/// records ride the same fd). Row: net `io`.
pub fn conn_deadline(cn: Conn, ms: int) -> () ! {io} {
    net_deadline(cn.fd, ms)?
}

/// Close the connection. Plaintext: the bare socket close. TLS: send
/// close_notify (every server-initiated close does — the truncation
/// defence) then close the socket. Total; failures swallowed (the
/// connection is done either way).
pub fn conn_close(mut cn: Conn) {
    if cn.kind == 0 {
        net_close(cn.fd) else |_| {}
    } else {
        tls.sess_close(mut cn.sess)
    }
}
