//! member: true
//! conn — THE SEAM (ws05). A connection the http lifecycle reads,
//! writes, deadlines and closes without knowing whether bytes travel
//! in the clear or inside TLS 1.3 records. serve/ drives every socket
//! operation through this abstraction; the plaintext backend forwards
//! verbatim to the net builtins (byte-identical to ws02 — the nginx
//! differential is the guard), the TLS backend routes through
//! tls.Sess (std.x.tls's server session). If TLS ever leaks past this
//! seam, every later sprint pays — so the reviewer's flag is this
//! module's `.wolfi`: serve's signatures speak `Conn`, never a raw
//! fd, from ws05 on.
//! The seam is deliberately the SAME five operations ws02 already
//! used (read a str, write a str, write raw bytes, arm a deadline,
//! close): TLS reads return DECRYPTED lengths unrelated to socket
//! reads and record boundaries split anywhere, but the lifecycle
//! above never sees that — conn_read hands back exactly what
//! net_read would have, and the drip-feed suite runs over both.
//! close_notify: conn_close on a TLS conn sends close_notify (every
//! server-initiated close does — the truncation defence); on the
//! plaintext side it is the bare socket close, unchanged.
//! This pin has no private field, so a Conn is forgeable; every op
//! reads the fields as data (kind picks the backend) and answers with
//! rows, never traps.
//! Lane note: net + tls — native is the executing lane (tls's crypto
//! rules lupin and the checked step budget out); the plaintext
//! backend alone is what ws02's own tests already exercise.
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use tls

/// A connection the lifecycle serves through. `kind` 0 = plaintext
/// (forward to the net builtins, ws02 behavior verbatim), 1 = TLS
/// (route through `sess`). `fd` is the socket for the plaintext
/// backend and for arming deadlines on both. `sess` is the TLS
/// session (a placeholder `tls.no_sess()` on a plaintext conn — the
/// struct has no optional field at this pin, so it is always present
/// and simply unused when `kind` is 0).
pub struct Conn {
    kind: int,
    fd: int,
    sess: tls.Sess,
}

/// A plaintext connection over `fd` (the ws02 path — every op is the
/// bare net builtin). Total.
pub fn plain(fd: int) -> Conn {
    Conn { kind: 0, fd: fd, sess: tls.no_sess() }
}

/// A TLS connection wrapping an established session (the fd is the
/// same socket, kept for deadline arming). Total.
pub fn tls_conn(fd: int, sess: tls.Sess) -> Conn {
    Conn { kind: 1, fd: fd, sess: sess }
}

/// Whether this is a TLS connection. Total.
pub fn is_tls(cn: Conn) -> bool {
    cn.kind == 1
}

/// The underlying socket fd — the plaintext-proxy handoff (proxy/ is
/// ws03, still fd-based; a TLS conn never reaches it, see serve).
/// Total.
pub fn fd(cn: Conn) -> int {
    cn.fd
}

/// The negotiated SNI on a TLS conn ("" plaintext or none). Total.
pub fn sni(cn: Conn) -> str {
    cn.sess.sni
}

/// Whether the peer truncated (EOF without close_notify) on a TLS
/// conn — the ws12 metric hook; always false plaintext. Total.
pub fn truncated(cn: Conn) -> bool {
    cn.sess.trunc
}

/// Read up to `max` bytes as a str, exactly as `net_read` would
/// (same rows: `closed`, `timeout`, `utf8`, `io`). The TLS backend
/// reads decrypted application bytes through the session and decodes
/// them — a chunk that splits a UTF-8 code point is the `utf8` row,
/// the same answer net_read gives (loopback HTTP is ASCII, so the
/// split never fires; the byte path carries binary). The plaintext
/// backend IS `net_read`.
/// (W0602 allowed: the row mirrors net_read exactly (closed/timeout/utf8/io) so the seam is transparent.)
#[allow(w0602)]
pub fn conn_read(mut cn: Conn, max: int) -> str ! {closed, timeout, utf8, io} {
    if cn.kind == 0 {
        net_read(cn.fd, max)?
    } else {
        var code = 0
        let bytes = tls.sess_read(mut cn.sess, max) else |e| match e {
            closed => {
                code = 1
                List[byte]()
            },
            timeout => {
                code = 2
                List[byte]()
            },
            io => {
                code = 3
                List[byte]()
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return timeout
        }
        if code == 3 {
            return io
        }
        str_from_utf8(bytes) else |_| {
            return utf8
        }
    }
}

/// Read up to `max` bytes as a byte list (the binary path — no utf8
/// row). Rows: `closed`, `timeout`, `io`.
/// (W0602 allowed: the row mirrors net_read_bytes (closed/timeout/io).)
#[allow(w0602)]
pub fn conn_read_bytes(mut cn: Conn, max: int) -> List[byte] ! {closed, timeout, io} {
    if cn.kind == 0 {
        var code = 0
        let b = net_read_bytes(cn.fd, max) else |e| match e {
            closed => {
                code = 1
                List[byte]()
            },
            timeout => {
                code = 2
                List[byte]()
            },
            io => {
                code = 3
                List[byte]()
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return timeout
        }
        if code == 3 {
            return io
        }
        b
    } else {
        tls.sess_read(mut cn.sess, max)?
    }
}

/// Write the full bytes of `s` (str path). Rows: `closed`, `io`.
/// (W0602 allowed: the net writer's vocabulary, carried.)
#[allow(w0602)]
pub fn conn_write(mut cn: Conn, s: str) -> () ! {closed, io} {
    if cn.kind == 0 {
        net_write(cn.fd, s)?
    } else {
        var body = List[byte]()
        for b in s.bytes() {
            (mut body).push(b)
        }
        tls.sess_write(mut cn.sess, body)?
    }
}

/// Write a raw byte body (binary static files). Rows: `closed`, `io`.
/// (W0602 allowed: the net writer's vocabulary, carried.)
#[allow(w0602)]
pub fn conn_write_bytes(mut cn: Conn, body: List[byte]) -> () ! {closed, io} {
    if cn.kind == 0 {
        var code = 0
        net_write_bytes(cn.fd, body) else |e| match e {
            closed => {
                code = 1
            },
            invalid => {
                code = 2
            },
            io => {
                code = 2
            },
        }
        if code == 1 {
            return closed
        }
        if code == 2 {
            return io
        }
    } else {
        tls.sess_write(mut cn.sess, body)?
    }
}

/// Arm (or clear, ms <= 0) the read/write deadline on the underlying
/// socket — the SAME builtin on both backends (a TLS session's
/// records ride the same fd). Row: net `io`.
pub fn conn_deadline(cn: Conn, ms: int) -> () ! {io} {
    net_deadline(cn.fd, ms)?
}

/// Close the connection. Plaintext: the bare socket close. TLS: send
/// close_notify (every server-initiated close does — the truncation
/// defence) then close the socket. Total; failures swallowed (the
/// connection is done either way).
pub fn conn_close(mut cn: Conn) {
    if cn.kind == 0 {
        net_close(cn.fd) else |_| {}
    } else {
        tls.sess_close(mut cn.sess)
    }
}
