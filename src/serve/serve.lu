//! member: true
//! serve — the listener, the connection lifecycle, the response
//! writer, and static file serving. This is the io half of the
//! server: it reads bytes off a socket under a deadline, hands the
//! head to http.parse_request (PURE), executes http.route's decision
//! against the fs, and writes the reply. http/ never calls back into
//! here — the dependency runs serve → {http, config}, one way
//! (ARCHITECTURE.md).
//! The response-splitting defence lives HERE, at the writer: no
//! header value may carry CR or LF, asserted on the way out, so no
//! later sprint can reintroduce it (ws02 contract §2).
//! Lane note: net runs on all three lanes, fs on native+checked only
//! (lupin has no fs), so full static serving is a native+checked
//! integration surface; the pure response helpers (dates, mime,
//! status lines, error bodies) run everywhere and are tested there.
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use config
use conn
use http
use metrics
use obs
use proxy
use resolver

/// This module's interface version. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ------------------------------------------------------------------
// response-side pure helpers (dates, hex, status lines, error bodies,
// mime) — no io, run on all three lanes
// ------------------------------------------------------------------

/// The reason phrase nginx pairs with a status code (its spellings,
/// not the RFC's — the differential holds us to the oracle: nginx
/// writes "Request-URI Too Large", "Not Allowed", "Request Time-out").
/// An unknown code answers "Status" (never traps). Total.
pub fn status_phrase(code: int) -> str {
    if code == 200 {
        return "OK"
    }
    if code == 301 {
        return "Moved Permanently"
    }
    if code == 304 {
        return "Not Modified"
    }
    if code == 400 {
        return "Bad Request"
    }
    if code == 403 {
        return "Forbidden"
    }
    if code == 404 {
        return "Not Found"
    }
    if code == 405 {
        return "Not Allowed"
    }
    if code == 408 {
        return "Request Time-out"
    }
    if code == 413 {
        return "Request Entity Too Large"
    }
    if code == 414 {
        return "Request-URI Too Large"
    }
    if code == 500 {
        return "Internal Server Error"
    }
    if code == 502 {
        return "Bad Gateway"
    }
    if code == 501 {
        return "Not Implemented"
    }
    if code == 503 {
        return "Service Temporarily Unavailable"
    }
    "Status"
}

/// A non-negative int as lowercase hex (no `0x`). Total.
pub fn to_hex(n: int) -> str {
    if n == 0 {
        return "0"
    }
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    while v > 0 {
        let d = v % 16
        out = "{digits[d..d + 1]}{out}"
        v = v / 16
    }
    out
}

/// Zero-pad a non-negative int to two digits. Total.
fn pad2(n: int) -> str {
    if n < 10 {
        return "0{n}"
    }
    "{n}"
}

/// Day-of-week abbreviation, 0=Sun..6=Sat. Total.
fn wkday(i: int) -> str {
    let names = "Sun Mon Tue Wed Thu Fri Sat"
    let at = i * 4
    names[at..at + 3]
}

/// Month abbreviation, 1=Jan..12=Dec. Total for 1..12.
fn month(i: int) -> str {
    let names = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec"
    let at = (i - 1) * 4
    names[at..at + 3]
}

/// Format a Unix time in SECONDS as an IMF-fixdate (RFC 9110 §5.6.7,
/// e.g. "Thu, 01 Jan 2026 00:00:00 GMT") — the byte-exact shape nginx
/// writes for Date and Last-Modified. Uses Howard Hinnant's
/// civil-from-days; total for any non-negative second count.
pub fn http_date(secs: int) -> str {
    let days = secs / 86400
    let tod = secs - days * 86400
    let hh = tod / 3600
    let mm = (tod - hh * 3600) / 60
    let ss = tod - hh * 3600 - mm * 60
    let wd = (days + 4) % 7
    // civil_from_days
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var mo = mp + 3
    if mp >= 10 {
        mo = mp - 9
    }
    if mo <= 2 {
        y = y + 1
    }
    "{wkday(wd)}, {pad2(d)} {month(mo)} {y} {pad2(hh)}:{pad2(mm)}:{pad2(ss)} GMT"
}

/// The default error body nginx serves for `code`, byte-for-byte
/// modulo the identity footer (`server` — nginx puts its own token
/// there, lobo puts lobo's; that footer is a documented server-identity
/// delta, the body analogue of the Server header). Total.
pub fn error_body(code: int, server: str) -> str {
    let phrase = status_phrase(code)
    "<html>\r\n<head><title>{code} {phrase}</title></head>\r\n<body>\r\n<center><h1>{code} {phrase}</h1></center>\r\n<hr><center>{server}</center>\r\n</body>\r\n</html>\r\n"
}

/// The header-too-large 400 body (nginx's special shape: a distinct
/// title and an extra centered line). `server` is the identity
/// footer. Total.
pub fn header_too_large_body(server: str) -> str {
    "<html>\r\n<head><title>400 Request Header Or Cookie Too Large</title></head>\r\n<body>\r\n<center><h1>400 Bad Request</h1></center>\r\n<center>Request Header Or Cookie Too Large</center>\r\n<hr><center>{server}</center>\r\n</body>\r\n</html>\r\n"
}

/// The lowercased extension of `path` (after the last `.`), or "".
/// Total.
fn extension(path: str) -> str {
    let dot = path.rfind(".") else -1
    if dot < 0 {
        return ""
    }
    let slash = path.rfind("/") else -1
    if dot < slash {
        return ""
    }
    path[dot + 1..path.len].lower()
}

/// The MIME type for `path`'s extension, consulting the config
/// `types` model (kind "e" entries under a `types` block: the row's
/// NAME is the type, its args the extensions). Falls back to a
/// `default_type` directive, else "text/plain" (nginx's compiled-in
/// default). Total; never traps.
pub fn mime_for(c: config.Conf, path: str) -> str {
    let ext = extension(path)
    if !ext.is_empty() {
        var i: int = 0
        let total = c.names.len
        while i < total {
            if c.kinds[i] == "e" && c.ctx[i] == "types" {
                let at = c.args_at[i]
                let nn = c.args_n[i]
                var j: int = 0
                while j < nn {
                    if c.argp[at + j] == ext {
                        return c.names[i]
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
    }
    // default_type directive anywhere, else nginx's text/plain
    var k: int = 0
    let count = c.names.len
    while k < count {
        if c.names[k] == "default_type" && c.args_n[k] >= 1 {
            return c.argp[c.args_at[k]]
        }
        k = k + 1
    }
    "text/plain"
}

// ------------------------------------------------------------------
// server configuration resolved from the model
// ------------------------------------------------------------------

/// The server's runtime knobs, resolved once from the config model
/// (serve/ reads directives; http/ never does). `token` is the
/// Server header identity, `keepalive_timeout_ms` the idle gap before
/// a persistent connection is closed, `keepalive_requests` the per-
/// connection request budget. ws12 adds `metrics_on` — the effective
/// `metrics` switch. Like every other field here it is resolved ONCE
/// at start: ServerOpts is process-wide, not per-generation (only
/// `http.Limits` and the config model itself freeze per generation),
/// so a reload that flips the endpoint takes effect at the next
/// restart. Said out loud rather than implied; the per-generation
/// ServerOpts freeze is routed residue.
pub struct ServerOpts {
    token: str,
    keepalive_timeout_ms: int,
    keepalive_requests: int,
    read_timeout_ms: int,
    challenge_dir: str,
    metrics_on: bool,
}

/// The lobo-flavoured defaults (nginx analogues: keepalive_timeout 75s,
/// keepalive_requests 1000). `server_tokens on` → "lobo/<ver>". Total.
pub fn default_opts() -> ServerOpts {
    ServerOpts {
        token: "lobo/0.1.0",
        keepalive_timeout_ms: 75000,
        keepalive_requests: 1000,
        read_timeout_ms: 60000,
        challenge_dir: "",
        metrics_on: false,
    }
}

/// The effective Limits off a frozen model (ws10): the fence
/// directives override the nginx-shaped defaults, `memory_budget`
/// arms the per-request admitted-bytes budget (0 = off) —
/// docs/BUDGET.md is the model. Resolution is config's
/// first-server-else-http (the D29 pattern). An invalid value keeps
/// the default (the -t half named it; load stays tolerant), and
/// `client_max_body_size 0` maps to the parser's own Content-Length
/// ceiling (nginx's 0-means-unlimited). Total.
pub fn resolve_limits(c: config.Conf) -> http.Limits {
    var lim = http.default_limits()
    let bm = config.body_max(c)
    if bm == 0 {
        lim.max_body = 999999999999999
    } else if bm > 0 {
        lim.max_body = bm
    }
    let hb = config.header_buffers(c)
    if hb.0 > 0 && hb.1 > 0 {
        lim.max_request_line = hb.1
        lim.max_header_line = hb.1
        lim.max_header_total = hb.0 * hb.1
    }
    lim.memory_budget = config.mem_budget(c)
    lim
}

// ------------------------------------------------------------------
// the budget meter (ws10) — the per-request admitted-bytes charge.
// The rule, written before the code (docs/BUDGET.md): the FENCE
// fires first, the budget second, at every site; a budget 503 always
// closes (shedding memory is the point). Sites: head (after a clean
// parse), body (pre-admission on a declared length), body-chunked
// (while accumulating), file (from stat, before any response byte).
// ------------------------------------------------------------------

/// The running charge of one request. `site` non-empty = the budget
/// refused at that site (`limit`/`would` are the event's numbers);
/// `used` is the admitted-bytes total either way — the high-water
/// the status surface aggregates.
/// One request's memory accounting. `used`/`limit`/`would`/`site` are
/// ws10's ADMISSION meter — bytes lobo decided to let in, counted by
/// lobo, above the runtime. `rt` is ws12's MEASURED half: the largest
/// `region_bytes` reading taken inside a per-response region while
/// serving this request ([mem.region.account.1], wolf-lang s131) —
/// the runtime's own ledger, not lobo's estimate. The two are
/// different numbers on purpose and the docs say so: `used` is what
/// the budget rules on (it is knowable BEFORE the bytes are admitted,
/// which is what makes a pre-admission 503 possible); `rt` is what
/// the machine actually charged (knowable only after). `rt` is 0 for
/// a request that materialized no regioned body — a HEAD, a 304, an
/// error response, or the TLS path, whose body cannot be regioned at
/// this pin (the D24 residue).
struct Charge {
    used: int,
    site: str,
    limit: int,
    would: int,
    rt: int,
}

fn charge_new(budget: int) -> Charge {
    Charge { used: 0, site: "", limit: budget, would: 0, rt: 0 }
}

// ------------------------------------------------------------------
// the writer — the response-splitting defence lives here
// ------------------------------------------------------------------

/// Assert a header VALUE carries no CR or LF, then return it. THE
/// response-splitting defence (ws02 contract §2): every header line
/// lobo emits routes its value through here, so a CR/LF that reached a
/// value (a mis-decoded Location, a future header from config) traps
/// rather than splitting the response. Traps `assert` on violation —
/// a server bug, caught in-process, never a corrupt wire.
fn safe_value(v: str) -> str {
    for b in v.bytes() {
        assert(b != 13, "header value carries CR — response-splitting refused")
        assert(b != 10, "header value carries LF — response-splitting refused")
    }
    v
}

/// One header line, `Name: value` with the value CR/LF-checked. Total
/// unless the value is unsafe (then it traps, by design).
fn hline(name: str, value: str) -> str {
    "{name}: {safe_value(value)}\r\n"
}

/// Write the full bytes of `s` to `conn`. Rows: the net builtins'
/// `closed`/`io` — a peer that vanished mid-write.
fn write_all(mut cn: conn.Conn, s: str) -> () ! {closed, io} {
    conn.conn_write(mut cn, s)?
}

/// Write a raw byte body to `conn` (wsm01, s115's net byte path —
/// wolf-lang#137 delivered): the write that carries a BINARY static
/// file, which the str tier could not represent (deferral D8). An
/// `invalid` element cannot occur here — the bytes come from the fs
/// byte tier, which yields only 0..255 — so it folds to `io` (a
/// truthful coarsening should a future pin reach it). The sentinel
/// shape is the W0305 dodge (see shell.control_send).
fn write_bytes_all(mut cn: conn.Conn, body: List[int]) -> () ! {closed, io} {
    conn.conn_write_bytes(mut cn, body)?
}

/// Build a complete error response (status line + headers + default
/// body). Errors always close the connection (Connection: close).
/// `code` picks the phrase and body; `special_header_body` swaps in
/// the header-too-large body shape when true. `date` and `token` are
/// the Date/Server values. Total (pure string building).
pub fn error_response(code: int, special_header_body: bool, date: str, token: str) -> str {
    let phrase = status_phrase(code)
    var body = error_body(code, token)
    if special_header_body {
        body = header_too_large_body(token)
    }
    var head = "HTTP/1.1 {code} {phrase}\r\n"
    head = "{head}{hline("Server", token)}"
    head = "{head}{hline("Date", date)}"
    head = "{head}{hline("Content-Type", "text/html")}"
    head = "{head}{hline("Content-Length", "{body.len}")}"
    head = "{head}{hline("Connection", "close")}"
    "{head}\r\n{body}"
}

// ------------------------------------------------------------------
// access-record helpers (ws09) — what one request looked like, for
// the entry's sinks. serve fills the record; the entry stamps times
// and renders (serve never opens a log file).
// ------------------------------------------------------------------

/// The RAW request line off an unparsed head: everything before the
/// first CR or LF (the oracle logs a garbage line cut at the CR —
/// probed). Total.
pub fn raw_line(head: str) -> str {
    var i: int = 0
    for b in head.bytes() {
        if b == 13 || b == 10 {
            return head[0..i]
        }
        i = i + 1
    }
    head
}

/// The body length of the default error page for `code` (`special`
/// selects the header-too-large shape) — what $body_bytes_sent is
/// for an error response. Total.
fn err_len(code: int, special: bool, token: str) -> int {
    if special {
        return header_too_large_body(token).len
    }
    error_body(code, token).len
}

/// Copy the parsed request's line and headers into the access record
/// (names arrive lowercased from the parser). Total.
fn fill_req_acc(mut acc: obs.Access, req: http.Request) {
    acc.request = "{req.method} {req.target} {req.version}"
    var i: int = 0
    for h in req.hnames {
        obs.access_header(mut acc, h, req.hvals[i])
        i = i + 1
    }
}

// ------------------------------------------------------------------
// the reader — bytes off the socket, under a deadline, size-bounded
// ------------------------------------------------------------------

/// A head-read outcome: the header block (before the blank line), the
/// leftover bytes after the blank line (body / next request), and a
/// status. `status` 0 = a head was read; else a size/timeout status
/// the caller writes (408 timeout, 400/431 oversize). `closed` true
/// means the peer finished with no (further) request — a clean end.
struct HeadRead {
    status: int,
    special: bool,
    head: str,
    rest: str,
    closed: bool,
}

/// Read from `conn` (accumulating into `carry`) until the CRLFCRLF
/// that ends the header block, enforcing the total-header bound as it
/// grows (over-limit → 400 header-too-large, special body). A
/// deadline-fired read is 408 when a partial head is in flight, a
/// clean close when nothing is buffered. Rows: only the net builtins'
/// `io` (a genuinely broken socket); `timeout`/`closed`/`utf8` are
/// turned into a HeadRead status here (utf8 → 400, the request head
/// was not valid UTF-8). Chosen so the lifecycle reads one value.
fn read_head(mut cn: conn.Conn, carry: str, limits: http.Limits) -> HeadRead ! {io} {
    var buf = carry
    // maybe the carry already holds a full head (pipelined)
    loop {
        // detect the header-block boundary LENIENTLY — CRLFCRLF, or a
        // bare LF-LF (a client that terminated with lone LFs) — so the
        // boundary is FOUND; the strict parser then rejects the bare
        // LF as `malformed` (a server that cannot recognise the frame
        // cannot reject it, and a peer that only ever sends "\n\n"
        // must not be able to hang the read to the keepalive timeout).
        let m1 = buf.find("\r\n\r\n") else -1
        let m2 = buf.find("\n\n") else -1
        var marker: int = -1
        var mlen: int = 0
        if m1 >= 0 && (m2 < 0 || m1 <= m2) {
            marker = m1
            mlen = 4
        } else if m2 >= 0 {
            marker = m2
            mlen = 2
        }
        if marker >= 0 {
            let head = buf[0..marker]
            let rest = buf[marker + mlen..buf.len]
            return HeadRead { status: 0, special: false, head: head, rest: rest, closed: false }
        }
        if buf.len > limits.max_header_total {
            return HeadRead { status: 400, special: true, head: "", rest: "", closed: false }
        }
        let piece = conn.conn_read(mut cn, 4096) else |e| match e {
            closed => {
                // peer finished. an empty buffer is a clean end; a
                // partial head is a broken request, dropped (no reply
                // is owed to a half-sent head at close)
                return HeadRead { status: 0, special: false, head: "", rest: buf, closed: true }
            },
            timeout => {
                if buf.is_empty() {
                    return HeadRead { status: 0, special: false, head: "", rest: "", closed: true }
                }
                return HeadRead { status: 408, special: false, head: "", rest: "", closed: false }
            },
            utf8 => {
                return HeadRead { status: 400, special: false, head: "", rest: "", closed: false }
            },
            io => {
                return io
            },
        }
        buf = "{buf}{piece}"
    }
}

/// Read exactly `want` more bytes beyond what `carry` already holds,
/// for a fixed-length body (consumed and discarded — a static GET
/// carries no meaning in its body, but a persistent connection must
/// drain it to find the next request, and a proxied request FORWARDS
/// it upstream). Rows: net `io`; a `closed`/`timeout`/`utf8` mid-body
/// is a broken request → the caller closes, so they ride out as `io`.
/// Read exactly `want` bytes of a fixed-length body, returning
/// (body, leftover-after-body).
fn take_length(mut cn: conn.Conn, carry: str, want: int) -> (str, str) ! {io} {
    var buf = carry
    while buf.len < want {
        let piece = conn.conn_read(mut cn, 4096) else |_| {
            return io
        }
        buf = "{buf}{piece}"
    }
    (buf[0..want], buf[want..buf.len])
}

// ------------------------------------------------------------------
// static file serving (fs half — native + checked only)
// ------------------------------------------------------------------

/// The current wall-clock time as an IMF-fixdate. Uses `time_unix_ms`
/// (native + checked + lupin). Not pure — a clock read — so it lives
/// beside the io.
fn now_date() -> str {
    http_date(time_unix_ms() / 1000)
}

/// host[:port] for a Location, mirroring nginx: the Host verbatim
/// when it already carries a port, else Host with the listening port
/// appended (omitted only for the default port 80). Total.
fn hostport(host: str, port: int) -> str {
    if host.contains(":") {
        return host
    }
    if port == 80 {
        return host
    }
    "{host}:{port}"
}

/// Send a full error response and swallow the write outcome (the
/// connection is closing regardless). Total.
fn send_err(mut cn: conn.Conn, code: int, special: bool, token: str) {
    let resp = error_response(code, special, now_date(), token)
    conn.conn_write(mut cn, resp) else |_| {}
}

/// Serve one already-resolved file at `path` (known to exist and be a
/// regular file). Writes a 200 (or 304 on a matching
/// If-Modified-Since), byte-order matching nginx's static handler:
/// Server, Date, Content-Type, Content-Length, Last-Modified,
/// Connection, ETag, Accept-Ranges. `is_head` omits the body. Reads
/// the whole file BEFORE writing headers when it is small, so a read
/// error becomes a clean 500 instead of a truncated 200; streams a
/// large file in bounded chunks (no whole-file-into-memory), and a
/// mid-stream read error can only close (bytes are already on the
/// wire — the ws02 pitfall). Returns should_close. Rows: net `io`.
fn serve_file(
    mut cn: conn.Conn,
    c: config.Conf,
    req: http.Request,
    path: str,
    token: str,
    keep: bool,
    is_head: bool,
    local_port: int,
    mut acc: obs.Access,
    mut chg: Charge,
) -> bool ! {closed, io} {
    let size = fs_size(path) else |e| match e {
        not_found => {
            acc.status = 404
            acc.body_bytes = err_len(404, false, token)
            send_err(mut cn, 404, false, token)
            return true
        },
        denied => {
            acc.status = 403
            acc.body_bytes = err_len(403, false, token)
            send_err(mut cn, 403, false, token)
            return true
        },
        io => {
            acc.status = 500
            acc.body_bytes = err_len(500, false, token)
            send_err(mut cn, 500, false, token)
            return true
        },
    }
    var secs: int = 0
    let mms = fs_modified_ms(path) else |_| 0
    secs = mms / 1000
    let lm = http_date(secs)
    let etag = "\"{to_hex(secs)}-{to_hex(size)}\""
    let mime = mime_for(c, path)
    let conn_hdr = keep_token(keep)

    // conditional GET: a matching If-Modified-Since → 304, no body
    let ims = http.header(req, "if-modified-since") else ""
    if !ims.is_empty() && ims == lm {
        acc.status = 304
        acc.body_bytes = 0
        var h304 = "HTTP/1.1 304 Not Modified\r\n"
        h304 = "{h304}{hline("Server", token)}"
        h304 = "{h304}{hline("Date", now_date())}"
        h304 = "{h304}{hline("Last-Modified", lm)}"
        h304 = "{h304}{hline("Connection", conn_hdr)}"
        h304 = "{h304}{hline("ETag", etag)}"
        h304 = "{h304}\r\n"
        write_all(mut cn, h304)?
        return !keep
    }

    // ws10, the `file` site: the response body this request is about
    // to materialize, known deterministically from the stat — a whole
    // small file, or one 64 KiB stream chunk; HEAD materializes
    // nothing. Fence-free site (nothing bounds response size), so the
    // budget alone rules; refused BEFORE any response byte is written.
    var fcharge = 0
    if !is_head {
        fcharge = if size <= 65536 { size } else { 65536 }
    }
    if chg.limit > 0 && chg.used + fcharge > chg.limit {
        chg.site = "file"
        chg.would = chg.used + fcharge
        acc.status = 503
        acc.body_bytes = err_len(503, false, token)
        send_err(mut cn, 503, false, token)
        return true
    }
    chg.used = chg.used + fcharge

    acc.status = 200
    acc.body_bytes = if is_head { 0 } else { size }
    var head = "HTTP/1.1 200 OK\r\n"
    head = "{head}{hline("Server", token)}"
    head = "{head}{hline("Date", now_date())}"
    head = "{head}{hline("Content-Type", mime)}"
    head = "{head}{hline("Content-Length", "{size}")}"
    head = "{head}{hline("Last-Modified", lm)}"
    head = "{head}{hline("Connection", conn_hdr)}"
    head = "{head}{hline("ETag", etag)}"
    head = "{head}{hline("Accept-Ranges", "bytes")}"
    head = "{head}\r\n"

    if is_head {
        write_all(mut cn, head)?
        return !keep
    }

    // small files: read whole BEFORE the headers, so a read failure
    // is a clean 500. The 65536 threshold is the stream boundary.
    // BYTES, not text (wsm01, s115/#137): a static file is bytes —
    // a PNG, a gzip, a favicon — and the old `fs_read_text` 500'd on
    // the first non-UTF-8 byte (deferral D8, now retired here).
    // ws10 (the structure audit): the body bytes live in a per-
    // response REGION and die wholesale at its close — without it
    // every served body is charged to the process root region for the
    // process's whole life ([mem.region.create.3]: the ambient region
    // is the caller's, and no caller up this tree scoped one).
    if size <= 65536 {
        if conn.is_tls(cn) {
            // TLS: the session write is a REAL potential retainer (the
            // record layer buffers through `sess`), so the body cannot
            // die in a per-response region — the TLS region story
            // rides the D24 stepper refactor, named residue.
            let body = fs_read_bytes(path) else |_| {
                acc.status = 500
                acc.body_bytes = err_len(500, false, token)
                send_err(mut cn, 500, false, token)
                return true
            }
            write_all(mut cn, head)?
            write_bytes_all(mut cn, body)?
            return !keep
        }
        // plaintext: the body bytes live in a per-response REGION and
        // die wholesale at its close (the ws10 structure audit —
        // without it every served body is charged to the process root
        // region for the process's whole life, [mem.region.create.3]).
        // The write goes through the bare fd: a socket write stores
        // nothing, and the fd path is what lets the checker see that
        // (a `mut cn` write inside the region is E1010 — the TLS arm
        // above is the retaining case it guards against).
        let sock = conn.fd(cn)
        var failed = false
        // 0 clean, 1 closed, 2 io — the write rows carried across the
        // region boundary as a scalar (heap values must not escape it)
        var wcode = 0
        region resp {
            let body = fs_read_bytes(path) else |_| {
                failed = true
                List[int]()
            }
            // ws12: the runtime's OWN number for this response's body.
            // Read after the read that charges it and before the block
            // closes — an int, so it crosses the boundary like `wcode`.
            // Monotone and stable between allocations by
            // [mem.region.account.1]; its UNITS are the native arena's
            // (alignment-rounded container storage), which is why the
            // docs quote it as measured-per-tier and never compare it
            // to `chg.used`.
            chg.rt = region_bytes(resp)
            if !failed {
                net_write(sock, head) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    io => {
                        wcode = 2
                    },
                }
                if wcode == 0 {
                    net_write_bytes(sock, body) else |e| match e {
                        closed => {
                            wcode = 1
                        },
                        invalid => {
                            wcode = 2
                        },
                        io => {
                            wcode = 2
                        },
                    }
                }
            }
            // the block's tail is a scalar on purpose: a call-tailed
            // region block reads as "the region's value escapes" to
            // the checker (E1010), and nothing here escapes
            wcode = wcode
        }
        if failed {
            acc.status = 500
            acc.body_bytes = err_len(500, false, token)
            send_err(mut cn, 500, false, token)
            return true
        }
        if wcode == 1 {
            return closed
        }
        if wcode == 2 {
            return io
        }
        return !keep
    }

    // large files: headers first (Content-Length is known), then
    // stream in bounded byte chunks (fs_read_chunk has no utf8 row —
    // a lone 0x80 is data). A mid-stream read error can only close —
    // bytes are already on the wire.
    write_all(mut cn, head)?
    let fd = fs_open(path) else |_| {
        // could not even open after stat: nothing sent yet past head,
        // but Content-Length is committed, so close
        return true
    }
    var streaming = true
    if conn.is_tls(cn) {
        // TLS: unregioned, as the small path (the session may retain;
        // D24 residue). Byte-identical behavior to the pre-audit code.
        while streaming {
            var bad = false
            let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                eof => {
                    streaming = false
                    List[int]()
                },
                io => {
                    bad = true
                    List[int]()
                },
            }
            if bad {
                fs_close(fd) else |_| {}
                return true
            }
            if chunk.len > 0 {
                var wcode = 0
                write_bytes_all(mut cn, chunk) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    io => {
                        wcode = 2
                    },
                }
                if wcode != 0 {
                    fs_close(fd) else |_| {}
                    if wcode == 1 {
                        return closed
                    }
                    return io
                }
            }
        }
        fs_close(fd) else |_| {}
        return !keep
    }
    let sock = conn.fd(cn)
    while streaming {
        var bad = false
        var wcode = 0
        // per-chunk region (ws10 audit): a 64 KiB chunk dies at each
        // `}` instead of accumulating in the root region for the whole
        // file length; the failed-write path also closes the fd, which
        // the pre-audit `?` re-raise leaked.
        region chunkr {
            let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                eof => {
                    streaming = false
                    List[int]()
                },
                io => {
                    bad = true
                    List[int]()
                },
            }
            if !bad && chunk.len > 0 {
                net_write_bytes(sock, chunk) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    invalid => {
                        wcode = 2
                    },
                    io => {
                        wcode = 2
                    },
                }
            }
            // ws12: the HIGH WATER of the per-chunk regions, not their
            // sum — each dies at this `}`, so what a streamed file
            // costs the machine at once is the largest single chunk
            // region, and that is the number the budget's `file` site
            // charges 64 KiB for. Summing would report a file size and
            // call it memory.
            let chunk_rt = region_bytes(chunkr)
            if chunk_rt > chg.rt {
                chg.rt = chunk_rt
            }
            // scalar tail on purpose — see the small-path region note
            wcode = wcode
        }
        if bad {
            fs_close(fd) else |_| {}
            return true
        }
        if wcode == 1 {
            fs_close(fd) else |_| {}
            return closed
        }
        if wcode == 2 {
            fs_close(fd) else |_| {}
            return io
        }
    }
    fs_close(fd) else |_| {}
    !keep
}

/// The Connection header token for a keepalive decision. Total.
fn keep_token(keep: bool) -> str {
    if keep {
        return "keep-alive"
    }
    "close"
}

// ------------------------------------------------------------------
// the admin endpoint (ws12) — /metrics and /status.json
//
// TWO PHASE, on purpose. serve/ knows HTTP framing; it does not know
// the counters, which live as plain ints in the ENTRY's poll loop
// (src/metrics/metrics.lu's header says why that is the measured
// hot-path answer and not a shortcut). So `serve_request` RECOGNISES
// an admin request and hands it back unanswered — `ReqOut.admin` names
// which one — and the entry renders the body and calls `write_admin`.
// The alternative, handing serve a pre-rendered snapshot every pass,
// would build a few KB of exposition eighty times a second whether or
// not anyone scraped; at this pin those bytes are never reclaimed
// (wolf-lang#191), so the loop would leak megabytes an hour to answer
// a scrape that arrives once a minute. Recognition costs two string
// compares.
//
// V0 POSTURE, stated here and in docs/directives.md: the endpoint
// answers on the PLAINTEXT step path only. `serve_conn_cn` (the TLS
// and blocking path) has its own flow and no second phase, so over TLS
// these two paths route to the filesystem like any other URI — the
// same D24/D27 rider ws10's counters carry. Access control is the bind
// address and nothing else (ws14 revisits); LOBO-L011 says so at load.
// ------------------------------------------------------------------

/// Which admin surface `path` names, or "" for an ordinary request.
/// Answers "" when the endpoint is off — the switch is the whole
/// access gate at v0, so an off endpoint's paths must route to the
/// filesystem exactly as they would have. Total.
pub fn admin_kind(on: bool, path: str) -> str {
    if !on {
        return ""
    }
    if path == metrics.metrics_path() {
        return "metrics"
    }
    if path == metrics.status_path() {
        return "status"
    }
    ""
}

/// Write an admin response: a 200 with `ctype`, `body`, and the
/// keepalive token — the entry's half of the two-phase endpoint.
/// Returns the body byte count for the access record. The header set
/// is deliberately the minimum a scraper needs: no Last-Modified, no
/// ETag, no Accept-Ranges on a body that is different every time.
/// Rows: the net builtins' `closed`/`io` — the same two-tag row every
/// writer in this module carries (W0602's "reuse one spelling"
/// reading, already the house shape for conn's write pair).
#[allow(w0602)]
pub fn write_admin(conn: int, body: str, ctype: str, token: str, keep: bool) -> int ! {closed, io} {
    var cn = conn_mod_plain(conn)
    var head = "HTTP/1.1 200 OK\r\n"
    head = "{head}{hline("Server", token)}"
    head = "{head}{hline("Date", now_date())}"
    head = "{head}{hline("Content-Type", ctype)}"
    head = "{head}{hline("Content-Length", "{body.len}")}"
    head = "{head}{hline("Connection", keep_token(keep))}"
    head = "{head}{hline("Cache-Control", "no-store")}"
    head = "{head}\r\n"
    write_all(mut cn, head)?
    write_all(mut cn, body)?
    body.len
}

/// The 503 an admin response takes when its rendered body would blow
/// the request's memory budget — the ws10 `file` site's rule applied
/// to a body lobo generates rather than reads. Total.
pub fn write_admin_503(conn: int, token: str) {
    var cn = conn_mod_plain(conn)
    send_err(mut cn, 503, false, token)
}

/// The error-body length for an admin 503, so the entry can fill the
/// access record without reaching into serve's internals. Total.
pub fn admin_err_len(token: str) -> int {
    err_len(503, false, token)
}

/// Execute a routing decision against the fs: directory redirect,
/// index resolution, file serve, or the 403/404 nginx draws. Returns
/// should_close. Rows: net `io`.
fn handle_request(
    mut cn: conn.Conn,
    c: config.Conf,
    req: http.Request,
    norm_path: str,
    token: str,
    keep: bool,
    local_port: int,
    challenge_dir: str,
    mut acc: obs.Access,
    mut chg: Charge,
) -> bool ! {closed, io} {
    // method: GET and HEAD serve; anything else is 405 (the CVE
    // corpus's POSTs are already rejected at parse when they smuggle)
    let is_head = req.method == "HEAD"
    if req.method != "GET" && !is_head {
        acc.status = 405
        acc.body_bytes = err_len(405, false, token)
        send_err(mut cn, 405, false, token)
        return true
    }

    // ws06: the ACME HTTP-01 challenge self-serves. When a challenge
    // dir is armed (cert auto is on) a GET under
    // /.well-known/acme-challenge/<token> is answered from it BEFORE
    // routing — the same webroot mechanism certbot's http-01 uses, so
    // the dance and the dance-free path exercise one serving surface.
    // The token is a single base64url path segment; anything with a
    // slash or a dot-dot is refused (no traversal into the store).
    if !challenge_dir.is_empty() {
        let cprefix = "/.well-known/acme-challenge/"
        if norm_path.starts_with(cprefix) {
            let tok = norm_path[cprefix.len..norm_path.len]
            if tok.is_empty() || tok.contains("/") || tok.contains("..") {
                acc.status = 404
                acc.body_bytes = err_len(404, false, token)
                send_err(mut cn, 404, false, token)
                return true
            }
            let body = fs_read_text("{challenge_dir}/{tok}") else |_| {
                acc.status = 404
                acc.body_bytes = err_len(404, false, token)
                send_err(mut cn, 404, false, token)
                return true
            }
            acc.status = 200
            acc.body_bytes = if is_head { 0 } else { body.len }
            var h = "HTTP/1.1 200 OK\r\n"
            h = "{h}{hline("Server", token)}"
            h = "{h}{hline("Date", now_date())}"
            h = "{h}{hline("Content-Type", "application/octet-stream")}"
            h = "{h}{hline("Content-Length", "{body.len}")}"
            h = "{h}{hline("Connection", keep_token(keep))}"
            h = "{h}\r\n"
            if !is_head {
                h = "{h}{body}"
            }
            write_all(mut cn, h)?
            return !keep
        }
    }

    let d = http.route(c, norm_path)
    if d.fs_path.is_empty() {
        acc.status = 404
        acc.body_bytes = err_len(404, false, token)
        send_err(mut cn, 404, false, token)
        return true
    }

    if fs_is_dir(d.fs_path) {
        if !norm_path.ends_with("/") {
            // 301 to the trailing-slash form (nginx's dir redirect)
            let loc = "http://{hostport(req.host, local_port)}{norm_path}/"
            let body = error_body(301, token)
            acc.status = 301
            acc.body_bytes = if is_head { 0 } else { body.len }
            var h = "HTTP/1.1 301 Moved Permanently\r\n"
            h = "{h}{hline("Server", token)}"
            h = "{h}{hline("Date", now_date())}"
            h = "{h}{hline("Content-Type", "text/html")}"
            h = "{h}{hline("Content-Length", "{body.len}")}"
            h = "{h}{hline("Location", loc)}"
            h = "{h}{hline("Connection", keep_token(keep))}"
            h = "{h}\r\n{body}"
            write_all(mut cn, h)?
            return !keep
        }
        // directory with a trailing slash: try the index files
        var idxs = d.index
        if idxs.is_empty() {
            (mut idxs).push("index.html")
        }
        for name in idxs {
            let cand = join_fs(d.fs_path, name)
            if fs_is_file(cand) {
                return serve_file(
                    mut cn,
                    c,
                    req,
                    cand,
                    token,
                    keep,
                    is_head,
                    local_port,
                    mut acc,
                    mut chg,
                )
            }
        }
        // no index, autoindex off → 403 (nginx)
        acc.status = 403
        acc.body_bytes = err_len(403, false, token)
        send_err(mut cn, 403, false, token)
        return true
    }

    if fs_is_file(d.fs_path) {
        return serve_file(
            mut cn,
            c,
            req,
            d.fs_path,
            token,
            keep,
            is_head,
            local_port,
            mut acc,
            mut chg,
        )
    }

    acc.status = 404
    acc.body_bytes = err_len(404, false, token)
    send_err(mut cn, 404, false, token)
    true
}

/// Join a directory path and a file name with one `/`. Total.
fn join_fs(dir: str, name: str) -> str {
    if dir.ends_with("/") {
        return "{dir}{name}"
    }
    "{dir}/{name}"
}

// ------------------------------------------------------------------
// the connection lifecycle — read → parse → route → respond →
// keepalive-or-close, an explicit loop (not control-flow folklore).
// SPAWN-FREE on purpose: the checked lane refuses structured
// concurrency, so task-per-connection is wired at the entry (main),
// which spawns this per accepted socket. Runs on native + checked
// (net + fs both present there); lupin lacks fs, so its lane is the
// pure helpers above.
// ------------------------------------------------------------------

/// Briefly read-and-discard from `conn` before a close, so a client
/// still sending a large body does not RST the connection and eat the
/// final response (the half-close drain — ws02 §3). Bounded: a few
/// short reads, then return. Swallows everything.
fn half_close_drain(mut cn: conn.Conn) {
    conn.conn_deadline(cn, 200) else |_| {
        return
    }
    var i: int = 0
    while i < 4 {
        let _ = conn.conn_read(mut cn, 4096) else |_| {
            return
        }
        i = i + 1
    }
}

/// Accumulate a chunked body until its terminating zero-chunk, then
/// validate it through http.decode_chunked. Returns (leftover after
/// the body, admitted body bytes). A framing error is `bad` (→ 400),
/// an over-limit body `big` (→ 413), a body that would blow the
/// memory budget `over` (→ 503 — checked WHILE accumulating, the
/// fence's `big` first at each step, per docs/BUDGET.md's order;
/// `used` is the request's charge so far); net trouble is `io`.
/// Bounded by twice `max_body` so a peer dribbling forever cannot
/// pin memory.
fn read_chunked(mut cn: conn.Conn, carry: str, limits: http.Limits, used: int) -> (str, int) ! {
    bad,
    big,
    over,
    io,
} {
    var buf = carry
    let cap = limits.max_body * 2
    loop {
        // the terminating "0" chunk followed by CRLFCRLF (no trailers)
        // or a "\r\n0\r\n\r\n" boundary is our stop signal
        if buf.ends_with("0\r\n\r\n") || buf.contains("\r\n0\r\n\r\n") {
            let _ = http.decode_chunked(buf, limits) else |e| match e {
                malformed => {
                    return bad
                },
                too_large => {
                    return big
                },
            }
            return ("", buf.len)
        }
        if buf.len > cap {
            return big
        }
        if limits.memory_budget > 0 && used + buf.len > limits.memory_budget {
            return over
        }
        let piece = conn.conn_read(mut cn, 4096) else |_| {
            return io
        }
        buf = "{buf}{piece}"
    }
}

/// Serve one connection to completion: the full keepalive lifecycle.
/// SPAWN-FREE. `local_port` is the port lobo is listening on (for the
/// absolute Location of a directory redirect, matching nginx).
/// Total: every error path resolves to a written response and/or a
/// close; the socket is always closed before return.
pub fn serve_conn(conn: int, c: config.Conf, opts: ServerOpts, limits: http.Limits, local_port: int) {
    var cn = conn_mod_plain(conn)
    // ws13: the blocking driver owns a resolver of its own — a name
    // it meets resolves INLINE (bounded by resolver_timeout) because
    // there is no loop here to park on; the rig and the differential
    // dial literals, so this cache stays empty in every gauntlet run
    var rs0 = resolver.new()
    serve_conn_cn(mut cn, c, opts, limits, local_port, mut rs0)
}

/// A plaintext Conn over `fd` (the wrapper avoids importing `conn` as
/// a name that would shadow the many `conn` parameters this file's
/// history carried; a one-line indirection). Total.
fn conn_mod_plain(fd: int) -> conn.Conn {
    conn.plain(fd)
}

/// The keepalive lifecycle over a Conn (ws05 — the seam): plaintext
/// and TLS drive the SAME body, so ws02's behavior is byte-identical
/// on both (the nginx differential guards the plaintext side; the
/// openssl interop and the TLS drip-feed guard the TLS side). A TLS
/// conn whose route resolves to a proxy_pass is a NAMED refusal
/// (502) — proxy-over-TLS-downstream needs proxy/ threaded through
/// this seam, ws05 residue (see the status file). SPAWN-FREE.
pub fn serve_conn_cn(
    mut cn: conn.Conn,
    c: config.Conf,
    opts: ServerOpts,
    limits: http.Limits,
    local_port: int,
    mut rs: resolver.Resolver,
) {
    var carry = ""
    var served: int = 0
    loop {
        // between requests the idle budget is keepalive_timeout; the
        // first read of a request onward uses read_timeout. v0 arms
        // one deadline covering the whole head read.
        conn.conn_deadline(cn, opts.keepalive_timeout_ms) else |_| {
            conn.conn_close(mut cn)
            return
        }
        let hr = read_head(mut cn, carry, limits) else |_| {
            conn.conn_close(mut cn)
            return
        }
        if hr.closed {
            conn.conn_close(mut cn)
            return
        }
        if hr.status != 0 {
            // a size/timeout outcome from the reader: 408/400, always
            // close (a 408 is written; a between-request timeout came
            // back as closed above, so a status here is a real error)
            if hr.status != 408 || !carry.is_empty() {
                send_err(mut cn, hr.status, hr.special, opts.token)
            }
            conn.conn_close(mut cn)
            return
        }

        var should_close = false
        let req = http.parse_request(hr.head, limits) else |e| match e {
            malformed => {
                send_err(mut cn, 400, false, opts.token)
                conn.conn_close(mut cn)
                return
            },
            uri_too_long => {
                send_err(mut cn, 414, false, opts.token)
                conn.conn_close(mut cn)
                return
            },
            too_large => {
                send_err(mut cn, 400, true, opts.token)
                conn.conn_close(mut cn)
                return
            },
            unimplemented => {
                send_err(mut cn, 501, false, opts.token)
                conn.conn_close(mut cn)
                return
            },
        }

        // ws10, the `head` site: fences (414/400) already spoke above;
        // the budget rules what they admitted. A budget 503 always
        // closes — shedding memory is the point (docs/BUDGET.md).
        var chg = charge_new(limits.memory_budget)
        chg.used = hr.head.len
        if chg.limit > 0 && chg.used > chg.limit {
            send_err(mut cn, 503, false, opts.token)
            conn.conn_close(mut cn)
            return
        }

        // body framing: buffer a fixed-length body (a proxied request
        // forwards it; a static one discards it), validate a chunked
        // one; an over-size length body is 413 with the half-close
        // drain (the client must still read the 413). Fence first,
        // budget second (the ws10 `body` site: a declared length is
        // refused PRE-ADMISSION — zero body bytes read).
        var rest = hr.rest
        var body = ""
        if req.body_mode == "length" {
            if req.content_length > limits.max_body {
                send_err(mut cn, 413, false, opts.token)
                half_close_drain(mut cn)
                conn.conn_close(mut cn)
                return
            }
            if chg.limit > 0 && chg.used + req.content_length > chg.limit {
                send_err(mut cn, 503, false, opts.token)
                half_close_drain(mut cn)
                conn.conn_close(mut cn)
                return
            }
            let taken = take_length(mut cn, rest, req.content_length) else |_| {
                conn.conn_close(mut cn)
                return
            }
            body = taken.0
            rest = taken.1
            chg.used = chg.used + body.len
        } else if req.body_mode == "chunked" {
            let ck = read_chunked(mut cn, rest, limits, chg.used) else |e| match e {
                bad => {
                    send_err(mut cn, 400, false, opts.token)
                    conn.conn_close(mut cn)
                    return
                },
                big => {
                    send_err(mut cn, 413, false, opts.token)
                    half_close_drain(mut cn)
                    conn.conn_close(mut cn)
                    return
                },
                over => {
                    send_err(mut cn, 503, false, opts.token)
                    half_close_drain(mut cn)
                    conn.conn_close(mut cn)
                    return
                },
                io => {
                    conn.conn_close(mut cn)
                    return
                },
            }
            rest = ck.0
            chg.used = chg.used + ck.1
        }

        // decode → normalize → map, in that ORDER (the traversal
        // defence). A bad escape or a control byte post-decode is 400.
        let decoded = http.percent_decode(req.path) else |_| {
            send_err(mut cn, 400, false, opts.token)
            conn.conn_close(mut cn)
            return
        }
        if http.has_control(decoded) {
            send_err(mut cn, 400, false, opts.token)
            conn.conn_close(mut cn)
            return
        }
        let norm = http.normalize_path(decoded) else {
            send_err(mut cn, 400, false, opts.token)
            conn.conn_close(mut cn)
            return
        }

        let keep = req.keepalive && served + 1 < opts.keepalive_requests

        // proxy dispatch: a matched location with a proxy_pass hands the
        // exchange to proxy/ (the upstream leg); otherwise serve the fs.
        // The client address is 127.0.0.1 — loopback-only, and net has
        // no peer-address builtin yet (a named delta for $remote_addr).
        // proxy/ is fd-based (ws03); a TLS downstream cannot hand it the
        // raw socket (that would write the response IN THE CLEAR), so a
        // proxy route on a TLS conn is a NAMED 502 — proxy-over-TLS-
        // downstream is ws05 residue (proxy/ threaded through this seam).
        let pplan = proxy.plan(c, norm)
        if pplan.is_proxy {
            if conn.is_tls(cn) {
                eprint(
                    "lobo: [error] proxy_pass over a TLS listener is not wired yet (ws05 residue): the downstream response would bypass encryption; answering 502",
                )
                send_err(mut cn, 502, false, opts.token)
                conn.conn_close(mut cn)
                return
            }
            var pacc0 = proxy.run_acc()
            should_close = proxy.
                run(
                conn.fd(cn),
                c,
                req,
                body,
                pplan,
                "127.0.0.1",
                opts.token,
                now_date(),
                keep,
                mut rs,
                mut pacc0,
            ) else |_| {
                conn.conn_close(mut cn)
                return
            }
        } else {
            var acc0 = obs.access_new()
            should_close = handle_request(
                mut cn,
                c,
                req,
                norm,
                opts.token,
                keep,
                local_port,
                opts.challenge_dir,
                mut acc0,
                mut chg,
            ) else |_| {
                conn.conn_close(mut cn)
                return
            }
        }
        served = served + 1
        if should_close || !keep {
            conn.conn_close(mut cn)
            return
        }
        carry = rest
    }
}

// ------------------------------------------------------------------
// the drain-aware step (ws08) — serve_conn blocks a connection to
// completion, which a single poll loop cannot afford when it must ALSO
// watch old generations drain while a new one serves. conn_step does
// ONE poll's worth of work on a connection under a SHORT deadline and
// yields, so the entry's loop multiplexes many connections and keeps a
// per-generation live counter honest. serve_request is serve_conn's
// per-request core, factored out; serve_conn itself is left untouched
// (its tests and the differential are its guard). Same helpers, same
// order — the response bytes are identical whichever driver runs.
// ------------------------------------------------------------------

/// The drain loop's per-request outcome: whether the connection should
/// close after this request, the bytes to carry into the next request
/// on a kept-alive connection, and the ACCESS RECORD (ws09): `logged`
/// says a request was actually served (a record exists to log); `acc`
/// is what serve knew — the entry stamps times and renders it through
/// the configured sinks. ws10 adds the budget outcome: `bud_site` is
/// non-empty when the memory budget refused (head|body|body-chunked|
/// file — the entry emits `budget-exceeded` and counts it),
/// `bud_limit`/`bud_would` its numbers, and `mem_hw` the request's
/// admitted-bytes total (the per-generation high-water's feed). ws12
/// adds `mem_rt`: the MEASURED region bytes this request's response
/// body cost the runtime ([mem.region.account.1]) — 0 where no
/// regioned body was materialized. `mem_hw` is the meter, `mem_rt` is
/// the machine; the entry high-waters both, separately.
pub struct ReqOut {
    close: bool,
    carry: str,
    logged: bool,
    acc: obs.Access,
    bud_site: str,
    bud_limit: int,
    bud_would: int,
    mem_hw: int,
    mem_rt: int,
    admin: str,
    resolve: str,
    resolve_addr: str,
    resolve_timeout_ms: int,
    resolve_valid_ms: int,
}

/// A ReqOut off a finished (or refused) request — every serve_request
/// exit builds through here so the budget fields never straggle.
/// Total.
fn req_out(close: bool, carry: str, acc: obs.Access, chg: Charge) -> ReqOut {
    ReqOut {
        close: close,
        carry: carry,
        logged: true,
        acc: acc,
        bud_site: chg.site,
        bud_limit: chg.limit,
        bud_would: chg.would,
        mem_hw: chg.used,
        mem_rt: chg.rt,
        admin: "",
        resolve: "",
        resolve_addr: "",
        resolve_timeout_ms: 0,
        resolve_valid_ms: 0,
    }
}

/// A ReqOut that asks the loop to WAIT (ws13): nothing has been
/// written, no byte past the head has been read, and `resolve` names
/// the upstream host the request cannot dial until the resolver
/// answers. The loop parks the connection (its whole buffer carried
/// back) and steps it again once the name settles. Total.
fn req_out_wait(acc: obs.Access, chg: Charge, need: proxy.Need) -> ReqOut {
    ReqOut {
        close: false,
        carry: "",
        logged: false,
        acc: acc,
        bud_site: "",
        bud_limit: chg.limit,
        bud_would: 0,
        mem_hw: 0,
        mem_rt: 0,
        admin: "",
        resolve: need.host,
        resolve_addr: need.addr,
        resolve_timeout_ms: need.timeout_ms,
        resolve_valid_ms: need.valid_ms,
    }
}

/// A ReqOut for a recognised ADMIN request: nothing has been written
/// and `admin` names which surface the entry must render. The access
/// record is filled except for status and body bytes, which only the
/// entry knows. Total.
fn req_out_admin(close: bool, carry: str, acc: obs.Access, chg: Charge, kind: str) -> ReqOut {
    ReqOut {
        close: close,
        carry: carry,
        logged: true,
        acc: acc,
        bud_site: chg.site,
        bud_limit: chg.limit,
        bud_would: chg.would,
        mem_hw: chg.used,
        mem_rt: chg.rt,
        admin: kind,
        resolve: "",
        resolve_addr: "",
        resolve_timeout_ms: 0,
        resolve_valid_ms: 0,
    }
}

/// Serve ONE already-framed request — its header block `head` read,
/// `rest0` the bytes after the blank line — and write the response.
/// serve_conn's request core, factored so the drain-aware accept loop
/// (main) can serve a connection one request at a time without blocking
/// on the keepalive idle gap; the loop's per-generation counters then
/// watch an old generation drain while a new one serves (ws08). Does
/// NOT close the socket — the caller closes when `close` is true; the
/// caller arms the body-read deadline. `served` is how many requests
/// this connection has already handled (the keepalive budget). Total:
/// every path resolves to a written response and a close-or-carry.
pub fn serve_request(
    conn: int,
    c: config.Conf,
    opts: ServerOpts,
    limits: http.Limits,
    local_port: int,
    head: str,
    rest0: str,
    served: int,
    mut rs: resolver.Resolver,
) -> ReqOut {
    var cn = conn_mod_plain(conn)
    var acc = obs.access_new()
    acc.request = raw_line(head)
    var chg = charge_new(limits.memory_budget)
    let req = http.parse_request(head, limits) else |e| match e {
        malformed => {
            acc.status = 400
            acc.body_bytes = err_len(400, false, opts.token)
            send_err(mut cn, 400, false, opts.token)
            return req_out(true, "", acc, chg)
        },
        uri_too_long => {
            acc.status = 414
            acc.body_bytes = err_len(414, false, opts.token)
            send_err(mut cn, 414, false, opts.token)
            return req_out(true, "", acc, chg)
        },
        too_large => {
            acc.status = 400
            acc.body_bytes = err_len(400, true, opts.token)
            send_err(mut cn, 400, true, opts.token)
            return req_out(true, "", acc, chg)
        },
        unimplemented => {
            acc.status = 501
            acc.body_bytes = err_len(501, false, opts.token)
            send_err(mut cn, 501, false, opts.token)
            return req_out(true, "", acc, chg)
        },
    }
    fill_req_acc(mut acc, req)

    // ws10, the `head` site: the fences above (414/400) fire first;
    // the budget rules what they admitted (docs/BUDGET.md's order).
    // A budget 503 always closes — shedding memory is the point.
    chg.used = head.len
    if chg.limit > 0 && chg.used > chg.limit {
        chg.site = "head"
        chg.would = chg.used
        acc.status = 503
        acc.body_bytes = err_len(503, false, opts.token)
        send_err(mut cn, 503, false, opts.token)
        return req_out(true, "", acc, chg)
    }

    // ws13: THE WAIT — before a byte past the head is consumed, ask
    // whether the route's upstream is a name the resolver has not
    // answered yet. If so the loop parks this connection with its
    // whole buffer and steps it again when the name settles; the
    // request is then served from the top with the cache warm. The
    // check is pure over the model and the cache, and it runs
    // before the body read on purpose: nothing consumed, nothing to
    // replay.
    let need = proxy.resolve_need(c, req.path, rs, time_unix_ms())
    if !need.host.is_empty() {
        return req_out_wait(acc, chg, need)
    }

    var rest = rest0
    var body = ""
    if req.body_mode == "length" {
        if req.content_length > limits.max_body {
            acc.status = 413
            acc.body_bytes = err_len(413, false, opts.token)
            send_err(mut cn, 413, false, opts.token)
            half_close_drain(mut cn)
            return req_out(true, "", acc, chg)
        }
        // the ws10 `body` site: refused PRE-ADMISSION — the declared
        // length would blow the budget, so zero body bytes are read
        if chg.limit > 0 && chg.used + req.content_length > chg.limit {
            chg.site = "body"
            chg.would = chg.used + req.content_length
            acc.status = 503
            acc.body_bytes = err_len(503, false, opts.token)
            send_err(mut cn, 503, false, opts.token)
            half_close_drain(mut cn)
            return req_out(true, "", acc, chg)
        }
        let taken = take_length(mut cn, rest, req.content_length) else |_| {
            return req_out(true, "", acc, chg)
        }
        body = taken.0
        rest = taken.1
        chg.used = chg.used + body.len
    } else if req.body_mode == "chunked" {
        let ck = read_chunked(mut cn, rest, limits, chg.used) else |e| match e {
            bad => {
                acc.status = 400
                acc.body_bytes = err_len(400, false, opts.token)
                send_err(mut cn, 400, false, opts.token)
                return req_out(true, "", acc, chg)
            },
            big => {
                acc.status = 413
                acc.body_bytes = err_len(413, false, opts.token)
                send_err(mut cn, 413, false, opts.token)
                half_close_drain(mut cn)
                return req_out(true, "", acc, chg)
            },
            over => {
                // the ws10 `body-chunked` site: the accumulating body
                // crossed the budget mid-read; shed
                chg.site = "body-chunked"
                chg.would = chg.limit + 1
                acc.status = 503
                acc.body_bytes = err_len(503, false, opts.token)
                send_err(mut cn, 503, false, opts.token)
                half_close_drain(mut cn)
                return req_out(true, "", acc, chg)
            },
            io => {
                return req_out(true, "", acc, chg)
            },
        }
        rest = ck.0
        chg.used = chg.used + ck.1
    }

    let decoded = http.percent_decode(req.path) else |_| {
        acc.status = 400
        acc.body_bytes = err_len(400, false, opts.token)
        send_err(mut cn, 400, false, opts.token)
        return req_out(true, "", acc, chg)
    }
    if http.has_control(decoded) {
        acc.status = 400
        acc.body_bytes = err_len(400, false, opts.token)
        send_err(mut cn, 400, false, opts.token)
        return req_out(true, "", acc, chg)
    }
    let norm = http.normalize_path(decoded) else {
        acc.status = 400
        acc.body_bytes = err_len(400, false, opts.token)
        send_err(mut cn, 400, false, opts.token)
        return req_out(true, "", acc, chg)
    }

    let keep = req.keepalive && served + 1 < opts.keepalive_requests

    // ws12: the admin endpoint, recognised and handed BACK. Every
    // fence and every budget site above has already run, so a scrape
    // that blew the header budget is a 503 like any other request
    // (the ws10 interplay, and a rig case). GET and HEAD only — the
    // 405 for anything else is `handle_request`'s job, so an admin
    // path with a POST falls through to routing and answers 405 there
    // exactly as it would for a file.
    if opts.metrics_on && (req.method == "GET" || req.method == "HEAD") {
        let kind = admin_kind(true, norm)
        if !kind.is_empty() {
            return req_out_admin(!keep, if keep { rest } else { "" }, acc, chg, kind)
        }
    }

    var should_close = false
    let pplan = proxy.plan(c, norm)
    if pplan.is_proxy {
        var pacc = proxy.run_acc()
        var raised = false
        should_close = proxy.
            run(
            conn,
            c,
            req,
            body,
            pplan,
            "127.0.0.1",
            opts.token,
            now_date(),
            keep,
            mut rs,
            mut pacc,
        ) else |_| {
            raised = true
            true
        }
        acc.proxied = true
        acc.up_addr = pacc.addr
        acc.up_status = pacc.status
        acc.up_ms = pacc.up_ms
        acc.status = pacc.status
        acc.body_bytes = pacc.body_bytes
        if raised {
            return req_out(true, "", acc, chg)
        }
    } else {
        var raised = false
        should_close = handle_request(
            mut cn,
            c,
            req,
            norm,
            opts.token,
            keep,
            local_port,
            opts.challenge_dir,
            mut acc,
            mut chg,
        ) else |_| {
            raised = true
            true
        }
        if raised {
            return req_out(true, "", acc, chg)
        }
    }
    if !chg.site.is_empty() {
        // a budget refusal deeper in the tree (the `file` site) wrote
        // its 503; a budget 503 always closes
        return req_out(true, "", acc, chg)
    }
    if should_close || !keep {
        return req_out(true, "", acc, chg)
    }
    req_out(false, rest, acc, chg)
}

/// A header-block boundary search: `ready` when `buf` holds a full
/// header block, `marker` its start and `mlen` the blank-line length (4
/// for CRLFCRLF, 2 for a lone LF-LF). Lenient like read_head — the
/// strict parser rejects a bare-LF frame later. Total.
struct HeadCut {
    ready: bool,
    marker: int,
    mlen: int,
}

fn head_cut(buf: str) -> HeadCut {
    let m1 = buf.find("\r\n\r\n") else -1
    let m2 = buf.find("\n\n") else -1
    if m1 >= 0 && (m2 < 0 || m1 <= m2) {
        return HeadCut { ready: true, marker: m1, mlen: 4 }
    }
    if m2 >= 0 {
        return HeadCut { ready: true, marker: m2, mlen: 2 }
    }
    HeadCut { ready: false, marker: -1, mlen: 0 }
}

/// One poll step's outcome. `active` is true when the step made
/// progress (read bytes or served a request) — the loop resets that
/// connection's idle clock on it. `close` means the connection is
/// finished (peer close, error, a written terminal response, or the
/// keepalive budget spent): the caller closes the socket and decrements
/// the owning generation. `carry`/`served` thread the connection state.
pub struct ConnStep {
    active: bool,
    close: bool,
    carry: str,
    served: int,
    logged: bool,
    acc: obs.Access,
    bud_site: str,
    bud_limit: int,
    bud_would: int,
    mem_hw: int,
    mem_rt: int,
    admin: str,
    resolve: str,
    resolve_addr: str,
    resolve_timeout_ms: int,
    resolve_valid_ms: int,
}

/// A ConnStep with NO served request (idle poll, peer close, a
/// pre-parse 400): zero budget fields; `logged` says whether `acc`
/// carries a record. Total.
fn step_out(active: bool, close: bool, carry: str, served: int, logged: bool, acc: obs.Access) -> ConnStep {
    ConnStep {
        active: active,
        close: close,
        carry: carry,
        served: served,
        logged: logged,
        acc: acc,
        bud_site: "",
        bud_limit: 0,
        bud_would: 0,
        mem_hw: 0,
        mem_rt: 0,
        admin: "",
        resolve: "",
        resolve_addr: "",
        resolve_timeout_ms: 0,
        resolve_valid_ms: 0,
    }
}

/// A full head is present in `buf` at `cut`: split it, arm the
/// body-read deadline, and serve exactly one request. Total.
fn step_serve(
    conn: int,
    c: config.Conf,
    opts: ServerOpts,
    limits: http.Limits,
    local_port: int,
    buf: str,
    cut: HeadCut,
    served: int,
    mut rs: resolver.Resolver,
) -> ConnStep {
    let head = buf[0..cut.marker]
    let rest = buf[cut.marker + cut.mlen..buf.len]
    net_deadline(conn, opts.read_timeout_ms) else |_| {}
    let ro = serve_request(conn, c, opts, limits, local_port, head, rest, served, mut rs)
    if !ro.resolve.is_empty() {
        // ws13: parked — the WHOLE buffer rides back as the carry
        // (the head is unconsumed as far as the loop is concerned),
        // nothing was served, and the loop steps this connection
        // again once `resolve` settles
        var w = step_out(false, false, buf, served, false, obs.access_new())
        w.resolve = ro.resolve
        w.resolve_addr = ro.resolve_addr
        w.resolve_timeout_ms = ro.resolve_timeout_ms
        w.resolve_valid_ms = ro.resolve_valid_ms
        return w
    }
    let ns = served + 1
    ConnStep {
        active: true,
        close: ro.close,
        carry: if ro.close { "" } else { ro.carry },
        served: ns,
        logged: ro.logged,
        acc: ro.acc,
        bud_site: ro.bud_site,
        bud_limit: ro.bud_limit,
        bud_would: ro.bud_would,
        mem_hw: ro.mem_hw,
        mem_rt: ro.mem_rt,
        admin: ro.admin,
        resolve: "",
        resolve_addr: "",
        resolve_timeout_ms: 0,
        resolve_valid_ms: 0,
    }
}

/// One poll step on a connection for the drain-aware accept loop: arm a
/// SHORT deadline `poll_ms`, do one bounded read, and — when a full
/// request head is present (already carried, or completed by this read)
/// — serve exactly one request. NEVER blocks on the keepalive idle gap:
/// an idle keepalive connection returns `active: false, close: false`,
/// so the loop keeps its per-generation counter live, checks the idle
/// clock itself, and moves on to poll siblings and the control channel.
/// This is the whole reason an old generation's drain is watchable
/// while a new one serves (ws08). Total.
pub fn conn_step(
    conn: int,
    c: config.Conf,
    opts: ServerOpts,
    limits: http.Limits,
    local_port: int,
    carry: str,
    served: int,
    poll_ms: int,
    mut rs: resolver.Resolver,
) -> ConnStep {
    var cn = conn_mod_plain(conn)
    var buf = carry
    let pre = head_cut(buf)
    if pre.ready {
        return step_serve(conn, c, opts, limits, local_port, buf, pre, served, mut rs)
    }
    if buf.len > limits.max_header_total {
        send_err(mut cn, 400, true, opts.token)
        var acc4 = obs.access_new()
        acc4.request = raw_line(buf)
        acc4.status = 400
        acc4.body_bytes = err_len(400, true, opts.token)
        return step_out(true, true, "", served, true, acc4)
    }
    net_deadline(conn, poll_ms) else |_| {
        return step_out(false, true, buf, served, false, obs.access_new())
    }
    let piece = net_read(conn, 4096) else |e| match e {
        closed => {
            return step_out(false, true, buf, served, false, obs.access_new())
        },
        timeout => {
            return step_out(false, false, buf, served, false, obs.access_new())
        },
        utf8 => {
            send_err(mut cn, 400, false, opts.token)
            var acc5 = obs.access_new()
            acc5.request = raw_line(buf)
            acc5.status = 400
            acc5.body_bytes = err_len(400, false, opts.token)
            return step_out(true, true, "", served, true, acc5)
        },
        io => {
            return step_out(false, true, buf, served, false, obs.access_new())
        },
    }
    if piece.is_empty() {
        return step_out(false, true, buf, served, false, obs.access_new())
    }
    buf = "{buf}{piece}"
    let cut = head_cut(buf)
    if cut.ready {
        return step_serve(conn, c, opts, limits, local_port, buf, cut, served, mut rs)
    }
    step_out(true, false, buf, served, false, obs.access_new())
}

// ------------------------------------------------------------------
// the accept loop (sequential — spawn-free, so it runs on native +
// checked; the entry wraps serve_conn in a task per connection for
// the concurrent posture on native)
// ------------------------------------------------------------------

/// Bind `addr`, then accept and serve connections one at a time.
/// Returns the port bound (never, in practice — it loops until `io`).
/// The differential and the rig drive `serve_conn` directly; this is
/// the standalone entry's loop. Row: net `io` (bind or a fatal
/// accept failure).
pub fn accept_loop(c: config.Conf, addr: str, opts: ServerOpts, limits: http.Limits) -> () ! {io} {
    let l = net_listen(addr)?
    let port = net_port(l)?
    loop {
        let conn = net_accept(l) else |_| {
            continue
        }
        serve_conn(conn, c, opts, limits, port)
    }
}

/// The bind address of the first NON-ssl `listen` directive (the
/// plaintext listener; "" when every listen carries `ssl`). A bare
/// port becomes a loopback bind. Total.
pub fn listen_addr_plain(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" && c.args_n[i] >= 1 {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var has_ssl = false
            var j: int = 0
            while j < nn {
                if c.argp[at + j] == "ssl" {
                    has_ssl = true
                }
                j = j + 1
            }
            if !has_ssl {
                let a = c.argp[at]
                if a.contains(":") {
                    return a
                }
                return "127.0.0.1:{a}"
            }
        }
        i = i + 1
    }
    ""
}

/// The bind address from the config model's first `listen` directive
/// (a bare port becomes a loopback bind — this server is loopback-only
/// in every test, forever). Falls back to 127.0.0.1:8080. Total.
pub fn listen_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" && c.args_n[i] >= 1 {
            let a = c.argp[c.args_at[i]]
            if a.contains(":") {
                return a
            }
            return "127.0.0.1:{a}"
        }
        i = i + 1
    }
    "127.0.0.1:8080"
}
