//! member: true
//! config — nginx.conf loading: lexer, parser, include graph,
//! directive tables, footgun lints, and the -t/-T shell behavior.
//! ws01's territory, implemented against the PINNED oracle
//! (tests/differential/NGINX-PIN; the probe battery is cited
//! per-rule across this module's files). The model is immutable
//! after parse: hot reload (ws04) builds a NEW Conf and swaps —
//! nothing in this surface mutates one.

/// This module's interface version. Bumped by ws01 with the first
/// real surface (the ws00 stub was 0.0.1). Total; never traps.
#[allow(w0314)]
pub fn version() -> str {
    "0.1.0"
}

/// The -t/-T verb: parse + table-check + lint, in nginx's shell
/// shape (probe p01/p57: two `nginx: ...` lines on stderr, exit 0;
/// `[emerg]` + `test failed`, exit 1 — lobo prints the same shapes
/// under its own name, deltas recorded in the ws01 status file).
/// `dump` prints the effective config with provenance on stdout
/// (lobo's -T: per-directive `# from file:line`, chain on included
/// hops — nginx dumps raw files instead; deliberate delta,
/// finally-list #4). Lints render as `[warn]` lines after any error,
/// before the verdict; they never change the exit code. Returns the
/// process exit code (0 ok / 1 failed, the oracle's contract).
pub fn check(prefix: str, conf_rel: str, dump: bool) -> int {
    var conf = conf_rel
    if !conf.starts_with("/") {
        conf = "{prefix}/{conf_rel}"
    }
    let c = load(prefix, conf_rel)
    var verdict: int = 0
    if !ok(c) {
        if c.err_line == 0 {
            eprint("lobo: [emerg] {c.err}")
        } else {
            eprint("lobo: [emerg] {c.err} in {c.err_file}:{c.err_line}")
        }
        verdict = 1
    } else if delta_count(c) > 0 {
        let d = c.delta_at[0]
        eprint(
            "lobo: [emerg] directive \"{c.names[d]}\" is not implemented in lobo ({c.delta_note[0]}) in {c.files[d]}:{c.lines[d]}",
        )
        verdict = 1
    }
    // ws05: the ssl half of -t — certificates load, pairs MATCH
    // (public-key comparison), leaf-first order holds, and an alg
    // outside the sc22 ladder is a NAMED refusal. Warns (protocol/
    // cipher deltas) print in nginx's [warn] stream and never change
    // the exit code.
    var sslw = ""
    if verdict == 0 {
        let s = ssl_resolve(c, prefix)
        sslw = s.warns
        if !ssl_ok(s) {
            if s.err_line == 0 {
                eprint("lobo: [emerg] {s.err}")
            } else {
                eprint("lobo: [emerg] {s.err} in {s.err_file}:{s.err_line}")
            }
            verdict = 1
        }
    }
    // ws06: the cert-auto half of -t — the pure shape checks (names,
    // listeners, the CA this pin can dial) and the store write-probe
    // (the contract's write-access rule; nginx -t opens its logs, lobo
    // probes its store). One named [emerg], first failure wins.
    if verdict == 0 {
        var cerr = auto_check(c)
        if cerr.is_empty() {
            cerr = auto_store_probe(c, prefix)
        }
        if !cerr.is_empty() {
            eprint("lobo: [emerg] {cerr}")
            verdict = 1
        }
    }
    // ws09: the log half of -t — log_format names/escapes/variables,
    // access_log parameters, the error_log level ladder. One named
    // [emerg], first failure wins (oracle-shaped where the oracle has
    // a spelling; lobo-named for the class-C variable refusals).
    if verdict == 0 {
        let lerr = log_check(c)
        if !lerr.is_empty() {
            eprint("lobo: [emerg] {lerr}")
            verdict = 1
        }
    }
    // ws10: the fence-and-budget half of -t — every size directive's
    // value parses (oracle-shaped spellings, probed). One named
    // [emerg], first failure wins.
    if verdict == 0 {
        let merr = limits_check(c)
        if !merr.is_empty() {
            eprint("lobo: [emerg] {merr}")
            verdict = 1
        }
    }
    // ws12: the metrics half of -t — the endpoint switch is on|off,
    // wherever it appears. One named [emerg], first failure wins.
    if verdict == 0 {
        let xerr = metrics_check(c)
        if !xerr.is_empty() {
            eprint("lobo: [emerg] {xerr}")
            verdict = 1
        }
    }
    // ws13: the resolver half of -t — `resolver` names an address and
    // takes nginx's parameters (valid=, ipv4=, ipv6=; the two lobo
    // cannot honour refuse by name), `resolver_timeout` parses as a
    // time. One named [emerg], first failure wins.
    if verdict == 0 {
        let rerr = resolver_check(c)
        if !rerr.is_empty() {
            eprint("lobo: [emerg] {rerr}")
            verdict = 1
        }
    }
    // wsm04: the upstream-TLS half of -t — an https proxy_pass names
    // its trust anchors (the client verifies always) and the file
    // loads. One named [emerg], first failure wins.
    if verdict == 0 {
        var perr = proxy_tls_check(c)
        if perr.is_empty() {
            perr = proxy_tls_probe(c)
        }
        if !perr.is_empty() {
            eprint("lobo: [emerg] {perr}")
            verdict = 1
        }
    }
    let findings = lint(c)
    if !findings.is_empty() {
        for line in findings.lines() {
            eprint("lobo: [warn] {line}")
        }
    }
    if !sslw.is_empty() {
        for line in sslw.lines() {
            eprint("lobo: [warn] {line}")
        }
    }
    if verdict == 1 {
        eprint("lobo: configuration file {conf} test failed")
        return 1
    }
    if dump {
        print_raw(render_t(c))
    }
    eprint("lobo: the configuration file {conf} syntax is ok")
    eprint("lobo: configuration file {conf} test is successful")
    0
}
