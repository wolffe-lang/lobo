//! member: true
//! config/render — the -T dump and the generated directive docs.
//! nginx -T dumps raw FILES (`# configuration file <path>:` then the
//! bytes, p57); lobo -T dumps the EFFECTIVE tree with per-directive
//! provenance — `# from <file>:<line>`, plus `(via <chain>)` for
//! every included hop — which is finally-list #4 ("which file set
//! this?") landing a campaign early because the parser owns the
//! data. The verbatim source slice of each directive is preserved
//! (quoting, escapes, interior comments), re-indented to tree depth.
//! docs/directives.md is generated from the table by
//! tools/lobo-directives in the gauntlet — never hand-edited.

/// Render the effective config with provenance (the -T body).
pub fn render_t(c: Conf) -> str {
    render_level(c, -1, 0)
}

fn render_level(c: Conf, parent: int, depth: int) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.parent[i] == parent {
            let pad = "    ".repeat(depth)
            var via = ""
            if !c.chains[i].is_empty() {
                via = " (via {c.chains[i]})"
            }
            out = "{out}{pad}# from {c.files[i]}:{c.lines[i]}{via}\n"
            out = "{out}{pad}{c.raws[i]}\n"
            if c.kinds[i] == "b" {
                out = "{out}{render_level(c, i, depth + 1)}{pad}}}\n"
            }
        }
        i = i + 1
    }
    out
}

/// Render one arity for the docs table.
fn arity_str(s: Spec) -> str {
    var a = ""
    if s.min_args == s.max_args {
        a = "exact({s.min_args})"
    } else if s.max_args == -1 {
        a = "at_least({s.min_args})"
    } else {
        a = "{s.min_args}..{s.max_args}"
    }
    if !s.opens.is_empty() {
        a = "{a} + block"
    }
    a
}

/// The generated docs page (docs/directives.md) — the drop-in
/// story's public ledger. One row per (name, context) spec, plus the
/// status counts the ratchet story quotes.
pub fn directives_markdown() -> str {
    let t = table()
    var implemented: int = 0
    var planned: int = 0
    var named: int = 0
    var rows = ""
    var i: int = 0
    while i < spec_count(t) {
        let s = spec_at(t, i)
        if s.status == "implemented" {
            implemented = implemented + 1
        } else if s.status == "named_error" {
            named = named + 1
        } else {
            planned = planned + 1
        }
        rows = "{rows}| `{s.name}` | {s.contexts} | {arity_str(s)} | {s.status} | {s.note} |\n"
        i = i + 1
    }
    var out = "# lobo directives — the compat ledger\n\n"
    out = "{out}GENERATED by `tools/lobo-directives` from `src/config/table.lu` — never hand-edit (the gauntlet regenerates and diffs).\n\n"
    out = "{out}Every directive lobo recognizes has a declared row keyed by (name, context). A directive with no row is a load-time error naming the nearest known row. `named_error` rows are the class-C posture: refused BY NAME, never silently ignored, never accidentally inert.\n\n"
    out = "{out}Status counts: **{implemented} implemented** / **{planned} planned** / **{named} named_error** ({spec_count(t)} rows).\n\n"
    out = "{out}| directive | contexts | arity | status | note |\n"
    out = "{out}|---|---|---|---|---|\n"
    out = "{out}{rows}"
    out
}
