//! member: true
//! config/lint — the footgun linter: a pass over the parsed tree,
//! each lint a code + span + nginx's behavior + lobo's stance, printed
//! by -t after errors. ws01 ships the skeleton and the three
//! PARSE-VISIBLE footguns report 11 §1C verified (the corrected
//! reading: nginx [emerg]s on wrong-context directives — the real
//! class is legal-but-ambushed configuration, which is exactly what a
//! linter can name at load time). Sources, per the ws00 verification
//! pass (wolf/refs/articles/lobo/class-c-config-footguns.md):
//!   L001 — nginx "If Is Evil" wiki: "In some cases it even
//!          segfaults"; only return / rewrite...last are safe in
//!          location-if; try_files silently disabled.
//!   L002 — proxy_set_header docs: "inherited from the previous
//!          configuration level if and only if there are no
//!          proxy_set_header directives defined on the current
//!          level" — one child line drops ALL parent lines.
//!   L003 — the alias off-by-slash traversal (PortSwigger
//!          nginx-alias-traversal / gixy alias-traversal advisory):
//!          location /i + alias /data/w3/images/ lets /i../secret
//!          escape; nginx upstream calls it configuration, not a bug.
//! Semantic lints wait for semantics; adding one here is a matcher
//! function and a call — the skeleton is the deliverable.

/// Run every lint over a parsed config. Returns one finding per
/// line: `CODE|file:line|message` — "" when clean. Pure over the
/// frozen model; -t renders these as `[warn]` lines (they never
/// change the exit code).
pub fn lint(c: Conf) -> str {
    "{lint_if_in_location(c)}{lint_psh_shadow(c)}{lint_alias_slash(c)}{lint_cert_native(c)}{lint_log_inert(c)}{lint_log_native(c)}{lint_log_loses(c)}{lint_budget_native(c)}{lint_body_size_inert(c)}{lint_metrics_native(c)}{lint_metrics_exposed(c)}{lint_name_unresolved(c)}{lint_resolver_static(c)}"
}

/// LOBO-L001: `if` inside a `location` block.
fn lint_if_in_location(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "if" && c.kinds[i] == "b" && c.ctx[i] == "location" {
            out = "{out}LOBO-L001|{c.files[i]}:{c.lines[i]}|\"if\" inside \"location\": nginx evaluates this in ways its own wiki calls unpredictable (\"If Is Evil\" — try_files silently disabled, proxy_pass URI changes, documented segfaults; only \"return\" and \"rewrite ... last\" are safe). lobo parses the block today and will give it defined semantics at ws03; prefer \"map\", separate locations, or \"return\".\n"
        }
        i = i + 1
    }
    out
}

/// LOBO-L002: `proxy_set_header` in a child block while an ancestor
/// level also sets some — the child's presence drops EVERY
/// parent-level header line; the finding names exactly which lines
/// stop applying.
fn lint_psh_shadow(c: Conf) -> str {
    var out = ""
    // Every block index that directly holds a proxy_set_header.
    var blocks = List[int]()
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "proxy_set_header" {
            var seen = false
            for b in blocks {
                if b == c.parent[i] {
                    seen = true
                }
            }
            if !seen {
                (mut blocks).push(c.parent[i])
            }
        }
        i = i + 1
    }
    for b in blocks {
        if b < 0 {
            // main holds no proxy_set_header rows (table-checked);
            // defensive skip.
        } else {
            var dropped = ""
            var a = c.parent[b]
            while a >= -1 {
                for other in blocks {
                    if other == a {
                        dropped = "{dropped}{psh_lines(c, a)}"
                    }
                }
                if a == -1 {
                    a = -2
                } else {
                    a = c.parent[a]
                }
            }
            if !dropped.is_empty() {
                let lines = dropped.strip_suffix(", ") else dropped
                out = "{out}LOBO-L002|{c.files[b]}:{c.lines[b]}|\"proxy_set_header\" in this block discards ALL parent-level proxy_set_header directives — nginx array directives inherit only when the current level sets NONE (proxy module docs, verbatim: inherited \"if and only if there are no proxy_set_header directives defined on the current level\"). These parent lines stop applying here: {lines}. lobo keeps nginx's rule when proxying lands (ws03) and names it at load time.\n"
            }
        }
    }
    out
}

/// The `file:line` list of proxy_set_header rows directly under
/// block `b`.
fn psh_lines(c: Conf, b: int) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "proxy_set_header" && c.parent[i] == b {
            out = "{out}{c.files[i]}:{c.lines[i]}, "
        }
        i = i + 1
    }
    out
}

/// LOBO-L003: the alias off-by-slash traversal shape — a non-exact
/// location whose prefix does NOT end in `/` holding an `alias`
/// whose path DOES.
fn lint_alias_slash(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "alias" && c.args_n[i] == 1 {
            let target = c.argp[c.args_at[i]]
            // nearest enclosing location block (alias may sit inside
            // an `if` whose context is still location)
            var l = c.parent[i]
            while l >= 0 && !(c.names[l] == "location" && c.kinds[l] == "b") {
                l = c.parent[l]
            }
            if l >= 0 && target.ends_with("/") {
                let n = c.args_n[l]
                let modifier = if n == 2 { c.argp[c.args_at[l]] } else { "" }
                let path = c.argp[c.args_at[l] + n - 1]
                if modifier != "=" && !path.ends_with("/") {
                    out = "{out}LOBO-L003|{c.files[i]}:{c.lines[i]}|\"alias\" ends with \"/\" under location \"{path}\", which does not: nginx replaces only the matched part, so a request for \"{path}../secret\" resolves OUTSIDE the alias root (the off-by-slash traversal — PortSwigger nginx-alias-traversal / gixy advisory; nginx upstream treats it as configuration, not a bug). lobo will refuse the traversal shape when alias serves (ws02); today the fix is matching slashes on both.\n"
                }
            }
        }
        i = i + 1
    }
    out
}

/// LOBO-L004 (ws06): the cert* directive family is lobo-NATIVE — the
/// WWS-L-native class. Fires ONCE, on the `cert` directive, and says
/// the one-way-door sentence out loud: a config that adopts `cert
/// auto` cannot be carried back to nginx (its -t rejects the name);
/// the certbot layout it replaces still loads in both servers. The
/// pre-ws06 native directive (`control`) predates this class and its
/// note lives in the table; new native surface lints from here on.
fn lint_cert_native(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "cert" {
            out = "{out}LOBO-L004|{c.files[i]}:{c.lines[i]}|\"cert\" is lobo-native (WWS-L-native class): nginx -t rejects this directive, so adopting \"cert auto\" is a ONE-WAY DOOR out of nginx-carryable configs — deliberate and documented (the ws06 charter clause). The certbot flow keeps working: delete the cert* lines and restore ssl_certificate/ssl_certificate_key to walk back.\n"
            return out
        }
        i = i + 1
    }
    out
}

/// LOBO-L005 (ws09): an access_log below the v0 resolution levels
/// (location/if) PARSES but does not yet apply — named, never
/// silently inert (the class-C posture applied to lobo's own gap;
/// the row lifts when per-location resolution lands).
fn lint_log_inert(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "access_log" && c.ctx[i] != "http" && c.ctx[i] != "server" {
            out = "{out}LOBO-L005|{c.files[i]}:{c.lines[i]}|\"access_log\" at {c.ctx[i]} level parses but does not APPLY at this pin: lobo resolves the effective output set at http/server level only (ws09 v0). Move the directive up a level, or wait for the per-location resolution row.\n"
        }
        i = i + 1
    }
    out
}

/// LOBO-L006 (ws09): the structured-log doors are lobo-NATIVE (the
/// WWS-L-native class, ws06's L004 pattern): `log_headers`, and the
/// `format=json` parameter on access_log/error_log. nginx -t rejects
/// each, so adopting them is the one-way door out of nginx-carryable
/// configs — deliberate; the nginx-compat door (log_format +
/// escape=json) stays open beside them, and walking back is deleting
/// the native lines.
fn lint_log_native(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "log_headers" {
            out = "{out}LOBO-L006|{c.files[i]}:{c.lines[i]}|\"log_headers\" is lobo-native (WWS-L-native class): nginx -t rejects it. It only feeds the format=json door's \"headers\" object; the nginx-compat spelling of the same fact is $http_<name> in a log_format.\n"
        }
        if c.names[i] == "access_log" || c.names[i] == "error_log" {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var j: int = 1
            while j < nn {
                if c.argp[at + j] == "format=json" {
                    out = "{out}LOBO-L006|{c.files[i]}:{c.lines[i]}|\"{c.names[i]} ... format=json\" is lobo-native (WWS-L-native class): nginx -t rejects the parameter. The nginx-compat twin is a log_format with escape=json; the native door adds TYPED numbers and a versioned schema (docs/LOGGING.md).\n"
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    out
}

/// LOBO-L007 (ws09): what a used log_format LOSES against the
/// structured door — the charter-tension linter: the compat format
/// carries, and the linter names the machine-valuable facts it never
/// records plus the escape mode's parseability cost. Fires once per
/// access_log row naming a declared format.
fn lint_log_loses(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "access_log" && c.args_n[i] >= 2 {
            let name = c.argp[c.args_at[i] + 1]
            if !name.contains("=") && name != "combined" {
                let row = logfmt_row(c, name)
                if row >= 0 {
                    let vars = fmt_vars(logfmt_text(c, row))
                    var lost = ""
                    let probe = "status body_bytes_sent request_time request"
                    for want in probe.words() {
                        var found = false
                        for v in vars.words() {
                            if v == want {
                                found = true
                            }
                        }
                        if !found {
                            lost = if lost.is_empty() { "${want}" } else { "{lost} ${want}" }
                        }
                    }
                    let esc = logfmt_esc(c, row)
                    var note = ""
                    if !lost.is_empty() {
                        note = "never records {lost}"
                    }
                    if esc == "default" {
                        let extra = "escape=default hex-escapes bytes a parser must undo (and - conflates missing with literal dash)"
                        note = if note.is_empty() { extra } else { "{note}; {extra}" }
                    } else if esc == "none" {
                        let extra = "escape=none lets attacker-controlled header bytes forge log lines (no escaping at all)"
                        note = if note.is_empty() { extra } else { "{note}; {extra}" }
                    }
                    if !note.is_empty() {
                        out = "{out}LOBO-L007|{c.files[i]}:{c.lines[i]}|log_format \"{name}\" loses against the structured door: {note}. \"access_log <path> format=json\" is the typed, schema-versioned line (docs/LOGGING.md); the format still carries as configured — this is a note, not a refusal.\n"
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

/// LOBO-L008 (ws10): `memory_budget` is lobo-NATIVE (the WWS-L-native
/// class, L004's pattern): nginx -t rejects the name — its answer to
/// memory pressure is the OOM killer, which is exactly the charter
/// clause this directive retires. Fires once, on the first row.
fn lint_budget_native(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "memory_budget" {
            out = "{out}LOBO-L008|{c.files[i]}:{c.lines[i]}|\"memory_budget\" is lobo-native (WWS-L-native class): nginx -t rejects it — nginx's answer to memory pressure is the OOM killer, lobo's is a 503 with a name (docs/BUDGET.md). Delete the line to walk back to an nginx-carryable config; the fence directives (client_max_body_size, large_client_header_buffers) carry in both servers.\n"
            return out
        }
        i = i + 1
    }
    out
}

/// LOBO-L009 (ws10): a location-level `client_max_body_size` PARSES
/// but does not yet apply — limits resolve at http/server level while
/// server selection is host-blind (the L005 pattern; the row lifts
/// with per-location resolution, the sprint D22/D29 also wait on).
fn lint_body_size_inert(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "client_max_body_size" && c.ctx[i] != "http" && c.ctx[i] != "server" {
            out = "{out}LOBO-L009|{c.files[i]}:{c.lines[i]}|\"client_max_body_size\" at {c.ctx[i]} level parses but does not APPLY at this pin: lobo resolves limits at http/server level only (ws10 v0). Move the directive up a level, or wait for the per-location resolution row.\n"
        }
        i = i + 1
    }
    out
}

/// LOBO-L010 (ws12): `metrics` is lobo-NATIVE (the WWS-L-native
/// class) — nginx -t rejects the directive outright, so turning the
/// endpoint on is the same one-way door as `cert auto`, `log_headers`
/// and `memory_budget`. Named at load, deliberately.
fn lint_metrics_native(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "metrics" {
            out = "{out}LOBO-L010|{c.files[i]}:{c.lines[i]}|\"metrics\" is lobo-native (WWS-L-native class): nginx -t rejects it — nginx's own metrics story is a third-party module or the commercial build, lobo's is in core with no recompile (docs/metrics.md). Delete the line to walk back to an nginx-carryable config; nothing else in the server depends on it.\n"
        }
        i = i + 1
    }
    out
}

/// LOBO-L011 (ws12): `metrics on` where the server's `listen` is not
/// a loopback address. THE CARDINALITY FENCE keeps the exposition
/// cheap; this lint keeps it PRIVATE, which is the entire v0 access
/// posture — there is no auth on the endpoint beyond where it is
/// bound (ws14 revisits, and the contract says so in as many words).
/// A warning, not a refusal: a private-network bind is a legitimate
/// admin posture lobo cannot tell apart from a public one by reading
/// an address.
fn lint_metrics_exposed(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        let on = c.names[i] == "metrics" && c.args_n[i] >= 1 && c.argp[c.args_at[i]] == "on"
        if on {
            // every listen at or under the same block level
            var j: int = 0
            while j < count(c) {
                let same = c.names[j] == "listen" && c.args_n[j] >= 1 && c.parent[j] == c.parent[i]
                if same && !listen_is_loopback(c.argp[c.args_at[j]]) {
                    out = "{out}LOBO-L011|{c.files[i]}:{c.lines[i]}|\"metrics on\" publishes /metrics and /status.json on listen \"{c.argp[c.args_at[j]]}\", which is not a loopback address. lobo's v0 access posture for the endpoint IS the bind address — there is no auth beyond it (ws14 revisits), and the exposition names your generations, upstream error rates and memory high waters. Bind this server to 127.0.0.1 or an admin network, or turn the endpoint off.\n"
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    out
}

/// LOBO-L012 (ws13): a `proxy_pass` (or an `upstream` `server`) names
/// a HOSTNAME and no `resolver` is in effect for it. Without a
/// resolver the name reaches the dial as text and the host resolver
/// answers it SYNCHRONOUSLY on the poll loop's thread with no
/// deadline — every other connection waits behind a slow or dead
/// nameserver (report 11 §2 item 9, the stall docs/RESOLVER.md
/// measures). nginx has the same shape at load time only (it resolves
/// once and keeps the address until reload — trac #1064); lobo
/// resolves at every dial, so the stall recurs. A warning: the config
/// carries and serves; the fix is one directive.
fn lint_name_unresolved(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        let is_pass = c.names[i] == "proxy_pass" && c.args_n[i] >= 1
        let is_peer = c.names[i] == "server" && c.ctx[i] == "upstream" && c.args_n[i] >= 1
        if is_pass || is_peer {
            let host = authority_host(c.argp[c.args_at[i]], is_pass)
            if !host.is_empty() &&
                !resolver_is_literal(host) &&
                !(is_pass && upstream_exists(c, host)) {
                if !resolver_in_effect(c, i) {
                    out = "{out}LOBO-L012|{c.files[i]}:{c.lines[i]}|\"{c.names[i]}\" names the host \"{host}\" and no \"resolver\" is in effect: the name is resolved by the host resolver at every dial, synchronously on the poll loop, with no deadline — a slow or dead nameserver stalls every connection behind it (docs/RESOLVER.md measures the stall). Add \"resolver <address> valid=30s;\" to resolve asynchronously through lobo's cache, or name an IP literal.\n"
                }
            }
        }
        i = i + 1
    }
    out
}

/// LOBO-L013 (ws13): a `resolver` IS in effect for a static
/// `proxy_pass` name — the named DELTA: nginx resolves a static
/// proxy_pass name ONCE at load through the system resolver and never
/// consults `resolver` for it (only the variable form and `server ...
/// resolve` do); lobo resolves it through `resolver` at runtime, under
/// the TTL cache, so a changed record is picked up without a reload
/// (trac #1064's complaint, answered). Informational: says out loud
/// that this config behaves differently under lobo, in lobo's favour.
fn lint_resolver_static(c: Conf) -> str {
    var out = ""
    var i: int = 0
    while i < count(c) {
        if c.names[i] == "proxy_pass" && c.args_n[i] >= 1 {
            let host = authority_host(c.argp[c.args_at[i]], true)
            if !host.is_empty() &&
                !resolver_is_literal(host) &&
                !upstream_exists(c, host) &&
                resolver_in_effect(c, i) {
                out = "{out}LOBO-L013|{c.files[i]}:{c.lines[i]}|\"proxy_pass\" names the host \"{host}\" and a \"resolver\" is in effect: lobo re-resolves this name at runtime through the resolver's TTL cache (a changed record applies without a reload); nginx resolves a static proxy_pass name ONCE at load via the system resolver and ignores \"resolver\" for it (trac #1064). A named delta in lobo's favour (docs/RESOLVER.md) — nothing to change.\n"
            }
        }
        i = i + 1
    }
    out
}
