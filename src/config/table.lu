//! member: true
//! config/table — the directive tables: one declared row per
//! (name, context) family, the sprint's public artifact. The table is
//! (name, context)-keyed because nginx reuses names across contexts
//! with different shapes — `server` is a BLOCK in `http` and a simple
//! directive in `upstream` (the ws01 contract's collision pitfall,
//! held by tests/config/table_lookup.lu). Every directive the corpus
//! or the obvious core speaks has a row; a directive with NO row is
//! the parser's own named error with a nearest-name suggestion. Rows
//! with status `named_error` are the class-C posture (report 11 §1C,
//! as VERIFIED: nginx [emerg]s on wrong contexts and unknown names —
//! the real footgun is legal-but-inert directives, which the linter
//! owns): never silently ignored, never implemented by accident.
//! `docs/directives.md` is generated from this table in the gauntlet
//! (tools/wws-directives) — the drop-in story's public ledger, never
//! hand-edited.

/// One declared directive row. `contexts` is the space-joined set of
/// context names that admit the directive (`any` admits all).
/// `opens` is "" for a simple directive, a context name for a block,
/// `same` for a block whose body stays in the surrounding context
/// (`if`), or `opaque` for a block wws refuses but skips whole (the
/// lua-block family). `min_args`/`max_args` bound the argument count
/// (`max_args` -1 = unbounded — mime.types' `at_least(1)` rows).
/// `status` is `implemented`, `planned(<sprint>)`, or `named_error`;
/// `note` is the one line -t/-T and the docs page show.
pub struct Spec {
    name: str,
    contexts: str,
    opens: str,
    min_args: int,
    max_args: int,
    status: str,
    note: str,
}

/// The directive table, immutable once built — hot reload swaps the
/// whole Conf, never edits it, and the table is a pure function of
/// the build.
pub struct Table {
    specs: List[Spec],
}

fn row(mut t: Table, name: str, contexts: str, opens: str, lo: int, hi: int, status: str, note: str) {
    (mut t.specs).push(Spec {
        name: name,
        contexts: contexts,
        opens: opens,
        min_args: lo,
        max_args: hi,
        status: status,
        note: note,
    })
}

