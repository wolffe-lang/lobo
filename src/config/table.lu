        "",
        1,
        2,
        "planned(wsc02)",
        "session cache — TLS 1.3 resumption is a NAMED std.x.tls roadmap row (ws05 serves full handshakes only)",
    )
    row(
        mut t,
        "ssl_session_timeout",
        "http server",
        "",
        1,
        1,
        "planned(wsc02)",
        "session TTL — rides the resumption roadmap row (ws05 note)",
    )
    row(mut t, "ssl_dhparam", "http server", "", 1, 1, "planned(wsc02)", "DH parameters")
    row(mut t, "ssl_stapling", "http server", "", 1, 1, "planned(wsc02)", "OCSP stapling")
    row(
        mut t,
        "ssl_stapling_verify",
        "http server",
        "",
        1,
        1,
        "planned(wsc02)",
        "OCSP verification",
    )
    // ---- implemented at ws06: certificates without the dance (ACME).
    // The cert* family is lobo-native (the L004 one-way door: an nginx
    // -t rejects these names — the linter says so at load). HTTP-01
    // against a LOOPBACK directory — http:// or, since wsm04 (the D25
    // retirement), https:// via std.x.tls.client with cert_ca_root as
    // the trust anchor. A non-loopback cert_ca stays refused BY NAME
    // (the loopback law, forever).
    row(
        mut t,
        "cert",
        "server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06): \"cert auto\" — the server acquires, renews and rotates its own certificate via ACME HTTP-01; the certbot dance keeps working beside it (coexistence is the posture). NOT an nginx directive (L004 one-way door)",
    )
    row(
        mut t,
        "cert_contact",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06): ACME account contact (a mailto: URL or bare address) sent at account creation",
    )
    row(
        mut t,
        "cert_ca",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06; https at wsm04): the ACME directory URL — loopback http:// or https:// (the https dial rides std.x.tls.client, verified against cert_ca_root). LOOPBACK ONLY forever: a non-loopback URL is a named -t refusal (the loopback law)",
    )
    row(
        mut t,
        "cert_ca_root",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (wsm04): the trust-anchor PEM for an https cert_ca — the ACME client verifies the directory's chain against it ALWAYS (required when cert_ca is https://; the harness CA writes its root out for exactly this)",
    )
    row(
        mut t,
        "cert_store",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06): where acquired certificates live (default: <prefix>/certs) — per-domain dirs, account key separate, every artifact written atomically (write+rename)",
    )
    row(
        mut t,
        "cert_renew_before",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06): renew when the certificate has less than this long to live (nginx time units; default 30d)",
    )
    row(
        mut t,
        "cert_check_interval",
        "http server",
        "",
        1,
        1,
        "implemented",
        "lobo-native (ws06): how often the renewal daemon wakes to check expiry (nginx time units; default 1d — sub-daily values are the harness's, not production advice)",
    )
    // ---- named_error: refused by name, never silently
    row(
        mut t,
        "content_by_lua_block",
        "location if",
        "opaque",
        0,
        0,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua; block skipped by token-level brace count (a }} inside a Lua comment or long string defeats the skip)",
    )
    row(
        mut t,
        "access_by_lua_block",
        "http server location if",
        "opaque",
        0,
        0,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua; block skipped by token-level brace count",
    )
    row(
        mut t,
        "init_by_lua_block",
        "http",
        "opaque",
        0,
        0,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua; block skipped by token-level brace count",
    )
    row(
        mut t,
        "rewrite_by_lua_block",
        "http server location if",
        "opaque",
        0,
        0,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua; block skipped by token-level brace count",
    )
    row(
        mut t,
        "lua_package_path",
        "http",
        "",
        1,
        1,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua",
    )
    row(
        mut t,
        "lua_shared_dict",
        "http",
        "",
        2,
        2,
        "named_error",
        "OpenResty Lua — lobo embeds no Lua",
    )
    row(
        mut t,
        "perl",
        "location if",
        "",
        1,
        1,
        "named_error",
        "embedded Perl — out of scope permanently",
    )
    row(
        mut t,
        "perl_modules",
        "http",
        "",
        1,
        1,
        "named_error",
        "embedded Perl — out of scope permanently",
    )
    t
}

/// Find the row admitting (name, ctx). Returns the spec index, or -1
/// when no row has the name, or -2 when rows exist but none admits
/// this context (nginx's "not allowed here").
pub fn find(t: Table, name: str, ctx: str) -> int {
    var i: int = 0
    var seen_name = false
    while i < t.specs.len {
        let s = copy t.specs[i]
        if s.name == name {
            seen_name = true
            if s.contexts == "any" || " {s.contexts} ".contains(" {ctx} ") {
                return i
            }
        }
        i = i + 1
    }
    if seen_name {
        return -2
    }
    -1
}

/// Copy out one row (the arena is index-addressed).
pub fn spec_at(t: Table, i: int) -> Spec {
    copy t.specs[i]
}

/// Number of rows.
pub fn spec_count(t: Table) -> int {
    t.specs.len
}

/// Levenshtein distance over bytes — the nearest-name suggestion's
/// engine. Error path only; names are short.
fn lev(a: str, b: str) -> int {
    let ab = a.bytes()
    let bb = b.bytes()
    var prev = List[int]()
    var j: int = 0
    while j <= bb.len {
        (mut prev).push(j)
        j = j + 1
    }
    var i: int = 0
    while i < ab.len {
        var cur = List[int]()
        (mut cur).push(i + 1)
        j = 0
        while j < bb.len {
            let sub = if ab[i] == bb[j] { prev[j] } else { prev[j] + 1 }
            var best = sub
            if prev[j + 1] + 1 < best {
                best = prev[j + 1] + 1
            }
            if cur[j] + 1 < best {
                best = cur[j] + 1
            }
            (mut cur).push(best)
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    prev[bb.len]
}

/// The nearest known directive name to `name` — the unknown-directive
/// error's suggestion (a lobo improvement over the oracle's bare
/// "unknown directive"; recorded as a -t output delta). Ties break to
/// the first row; "" when nothing is within distance 3.
pub fn nearest(t: Table, name: str) -> str {
    var best = ""
    var best_d: int = 4
    var i: int = 0
    while i < t.specs.len {
        let cand = copy t.specs[i].name
        let d = lev(name, cand)
        if d < best_d {
            best_d = d
            best = cand
        }
        i = i + 1
    }
    best
}
