//! wws — a production web server in wolf (working name). Entry file:
//! the operator shell. The CLI grammar, the text builders, the pid
//! lifecycle, the control channel and the reload verbs are shell/'s
//! (ws04); main is the thin dispatch over them plus the acting paths
//! (the drain-aware serve loop, signal-send, and `status`) that wire
//! net/fs to the model and own the per-generation drain bookkeeping
//! (ws08).
//!
//! `main`'s legal shapes are E0414's: no parameters — arguments come
//! through `env_args`, which drops argv[0].
//!
//! The signal split (ws04 §3, FLIPPED at wsm01). The s115 pin carries
//! s114's signal RECEPTION (wolf-lang #126): the server listens for
//! real SIGHUP/SIGTERM/SIGQUIT (the RELOAD/TERMINATE/QUIT meanings)
//! and each received meaning feeds the SAME verb dispatch the control
//! channel drives — the one-layer design ws04 built for exactly this
//! flip. The control channel STAYS
//! (the portable path, and the Windows reload story — [os.signal.
//! platform] names RELOAD/UPGRADE as having no Windows analog). What
//! did NOT land: a getpid surface — so `-s` still SENDS over the
//! control channel and the pid file still records the control
//! endpoint (named residue; a real pid file follows a getpid).
//! Signal delivery is Linux-full at this pin (non-Linux follows the
//! task-layer port); where the listen refuses, the server says so and
//! runs control-channel-only — a named gap, never a fake.
//!
//! Serve stays SPAWN-FREE (D7, ws04's shape): ONE poll loop
//! multiplexes the http listener, the control channel, the signal
//! queue, and every open connection, each stepped a slice at a time
//! under a short deadline (serve.conn_step) so no single connection
//! blocks the loop. Signals are polled by SELF-RAISE: each pass
//! raises the UPGRADE meaning as a probe and waits once — the
//! runtime's queue is FIFO, so a real pending SIGHUP/TERM/QUIT comes
//! back BEFORE the probe and the probe bounds the wait (never a
//! park on a signal that may not come). The clean parked-forwarder
//! task ([os.signal.wait]'s intended shape) is blocked at this pin by
//! an upstream release-tier bug — s43's cluster partition follows
//! CALL edges only, so a task-entry shim can land in a different
//! object than its spawner's `func.addr` and the LLVM tier refuses
//! (filed; the corpus-shape witness is tools' probe record). The poll
//! flips to the forwarder the sprint after the fix enters the pin.
//! That is what makes the DRAIN WATCHABLE (ws08): a per-generation live
//! counter in the loop's own bookkeeping lets an operator see an old
//! generation drain — via `wws status` and log events — while a new one
//! serves. A reloaded-away generation keeps its FROZEN model and its
//! open connections finish on it (the reload-under-load invariant,
//! pinned by the rig). File-header note (F-0016): comments never sit
//! directly above a dotted call.

use config
use conn
use dryrun
use http
use obs
use proxy
use serve
use shell
use tls

/// The package version. Matches wolf.pkg; the release ritual (far
/// future) bumps both in one commit. Total; never traps.
fn version() -> str {
    "0.0.1"
}

/// The no-argument banner: identity plus every module's frozen
/// interface version, which is also what keeps each stub import
/// honestly used (E0305).
fn banner() {
    print("wws {version()} — a web server in wolf (working name)")
    let mods = "config {config.version()} · dryrun {dryrun.version()} · http {http.version()} · obs {obs.version()} · proxy {proxy.version()} · serve {serve.version()} · shell {shell.version()}"
    print("modules: {mods}")
}

// ------------------------------------------------------------------
// the control loop's line reader and verb dispatch
// ------------------------------------------------------------------

/// Read one newline-terminated command line from `conn` (bounded — a
/// control peer sends one short verb). Returns the line without the
/// newline. Swallows net trouble into "" (the loop then replies with
/// an error and moves on). Total.
fn read_command(conn: int) -> str {
    var buf = ""
    var reading = true
    while reading {
        let nl = buf.find("\n") else -1
        if nl >= 0 {
            return buf[0..nl].trim()
        }
        if buf.len > 4096 {
            return buf.trim()
        }
        let piece = net_read(conn, 512) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    buf.trim()
}

// ------------------------------------------------------------------
// the generation table (ws08) — the drain you can watch. One row per
// LIVE generation (current + every still-draining old one), each
// carrying its FROZEN model, its live-connection count, its state, and
// the accounting a retirement reports. The counter is here, in the
// poll loop's own bookkeeping — spawn-free, no concurrent tasks (D7 /
// ws04). The table is a local List[GenRow]: a List of an IMPORTED
// struct is refused in the checked tier, but a List of a LOCAL struct
// is fine, so the row type lives here and shell formats it one field at
// a time. Rows are never mutated in place (index-assignment is a
// one-lane shape) — every update REBUILDS the list, which is cheap: a
// server holds a handful of generations, never more.
// ------------------------------------------------------------------

/// One live generation. `state` is "current" (the one accepting new
/// connections) or "draining" (a reloaded-away generation still holding
/// connections). `loaded_ms` is when it was created, `since_ms` when it
/// began draining (0 while current). `drained`/`aborted` accumulate its
/// retirement accounting; `shash` is its content-hash id.
struct GenRow {
    conf: config.Conf,
    gen: int,
    live: int,
    state: str,
    loaded_ms: int,
    since_ms: int,
    drained: int,
    aborted: int,
    shash: str,
}

/// The generation number of the current (accepting) row, or -1. Total.
fn current_gen(gens: List[GenRow]) -> int {
    for g in gens {
        if g.state == "current" {
            return g.gen
        }
    }
    -1
}

/// The index of the row for `gen`, or -1. Total.
fn index_of(gens: List[GenRow], gen: int) -> int {
    var i: int = 0
    let n = gens.len
    while i < n {
        if gens[i].gen == gen {
            return i
        }
        i = i + 1
    }
    -1
}

/// The frozen model a connection tagged `gen` serves under — full
/// fidelity, so a request arriving on a draining connection routes
/// under the model it was accepted on (the frozen-model discipline,
/// ws04). Falls back to the current row, then to an empty model, for a
/// generation that cannot be found (never happens while it holds a
/// connection — a generation retires only at zero). Total.
fn conf_for(gens: List[GenRow], gen: int) -> config.Conf {
    let i = index_of(gens, gen)
    if i >= 0 {
        return gens[i].conf
    }
    if gens.len > 0 {
        return gens[0].conf
    }
    config.parse_str("http {{\n}}\n", "empty")
}

/// A generation's age in ms in its current role: since load while
/// current, since drain start while draining. Total.
fn gen_age(g: GenRow, now: int) -> int {
    if g.state == "current" {
        return now - g.loaded_ms
    }
    now - g.since_ms
}

/// The worker_shutdown_timeout remaining for a DRAINING generation, or
/// -1 when none applies (a current generation, or no timeout). Clamped
/// at 0. Total.
fn gen_remaining(g: GenRow, shutdown_ms: int, now: int) -> int {
    if g.state != "draining" || shutdown_ms <= 0 {
        return -1
    }
    let rem = shutdown_ms - (now - g.since_ms)
    if rem < 0 {
        return 0
    }
    rem
}

/// Rebuild `gens` with `gen`'s live count changed by `delta`. Total.
fn bump_live(gens: List[GenRow], gen: int, delta: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live + delta,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Account one closed connection on `gen`: decrement its live count and,
/// when the generation is DRAINING, tally it (`aborted` on a timeout
/// force-close, else `drained`) and emit `connection-retired`. THE
/// never-negative assertion lives here and stays in every profile
/// (checked-arithmetic spirit — a leak that made a generation immortal
/// would be loud). Returns the rebuilt table. Total unless the
/// invariant breaks (then it traps, by design).
fn on_conn_close(gens: List[GenRow], gen: int, aborted: bool) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            let nlive = g.live - 1
            assert(nlive >= 0, "generation {gen} live-connection count went negative")
            var nd = g.drained
            var na = g.aborted
            if g.state == "draining" {
                if aborted {
                    na = na + 1
                } else {
                    nd = nd + 1
                }
                eprint("wws: [notice] {shell.ev_connection_retired(gen, nlive)}")
            }
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: nlive,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: nd,
                aborted: na,
                shash: g.shash,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Retire every DRAINING generation that has reached zero connections:
/// emit `generation-retired` with its accounting and drop it from the
/// table. Total.
fn retire_zero(gens: List[GenRow], now: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.state == "draining" && g.live == 0 {
            let age = now - g.since_ms
            eprint("wws: [notice] {shell.ev_generation_retired(g.gen, g.drained, g.aborted, age)}")
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Begin a reload: mark the current generation draining (as of `now`)
/// and append the freshly frozen `newconf` as the new current
/// generation `newgen`. Total.
fn start_reload(
    gens: List[GenRow],
    curgen: int,
    newconf: config.Conf,
    newgen: int,
    newhash: str,
    now: int,
) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == curgen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
            })
        } else {
            (mut out).push(g)
        }
    }
    (mut out).push(GenRow {
        conf: newconf,
        gen: newgen,
        live: 0,
        state: "current",
        loaded_ms: now,
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: newhash,
    })
    out
}

/// Mark `gen` draining (as of `now`) without creating a successor — the
/// quit path (drain everything, then exit). Total.
fn mark_draining(gens: List[GenRow], gen: int, now: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen && g.state == "current" {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Build the status stanza (contract §1): the generation table with
/// per-generation live counts, ages, ids, and worker_shutdown_timeout
/// remaining, plus the quit posture. `json` selects the versioned
/// single-line JSON (ws07 convention, ws12 reuses it); otherwise the
/// human, one-fact-per-line text. The read races the generation swap by
/// design — a torn read across generations is acceptable and each
/// count is monotone-correct per generation (documented in docs/). The
/// snapshot is one pass over the table reference. Total.
fn status_stanza(gens: List[GenRow], shutdown_ms: int, quitting: bool, json: bool) -> str {
    let now = time_unix_ms()
    let cur = current_gen(gens)
    if json {
        var s = shell.status_json_open(cur, quitting)
        var first = true
        for g in gens {
            let sep = if first { "" } else { "," }
            first = false
            let obj = shell.
                status_json_obj(
                g.gen,
                g.state,
                g.live,
                gen_age(g, now),
                g.shash,
                gen_remaining(g, shutdown_ms, now),
            )
            s = "{s}{sep}{obj}"
        }
        return "{s}{shell.status_json_close()}"
    }
    var s = shell.status_head_text(cur, quitting)
    for g in gens {
        s = "{s}{shell.status_line_text(g.gen, g.live, g.state, gen_age(g, now), g.shash, gen_remaining(g, shutdown_ms, now))}"
    }
    s
}

// ------------------------------------------------------------------
// serve — bind, write the pid file, and run the poll loop
// ------------------------------------------------------------------

/// The serving verb. Loads and freezes the config (generation 1),
/// refuses to start if a live master already holds the pid file
/// (stale-pid detection), writes the pid file (its content is the
/// control endpoint at this pin), then runs the DRAIN-AWARE poll loop
/// (ws08): one spawn-free loop multiplexes the http listener, the
/// control channel, and every open connection, keeping a per-generation
/// live counter so an operator can WATCH an old generation drain while a
/// new one serves. Returns 1 on a config error, a failed bind, or a
/// refused start; the loop runs until `stop`, or until `quit` has
/// drained everything. Loopback only.
/// The bind address of the first `listen ... ssl` directive (the TLS
/// listener; a bare port becomes a loopback bind — loopback-only,
/// forever). "" when no ssl listen exists. Total.
fn ssl_listen_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var has_ssl = false
            var j: int = 0
            while j < nn {
                if c.argp[at + j] == "ssl" {
                    has_ssl = true
                }
                j = j + 1
            }
            if has_ssl && nn >= 1 {
                let a = c.argp[at]
                if a.contains(":") {
                    return a
                }
                return "127.0.0.1:{a}"
            }
        }
        i = i + 1
    }
    ""
}

fn serve_main(prefix: str, conf: str) -> int {
    let c0 = config.load(prefix, conf)
    if !config.ok(c0) {
        eprint("wws: [emerg] configuration file {conf} test failed")
        return 1
    }
    let ctrl = shell.control_addr(c0)
    let pidp = shell.pid_path(c0, prefix)

    // stale-pid detection: an existing pid file whose endpoint is
    // alive means a master is already running (refuse, nginx-shaped);
    // a dead endpoint is a stale file (replace with a warning).
    let existing = shell.pid_read(pidp) else |_| ""
    if !existing.is_empty() {
        if shell.control_alive(existing) {
            eprint("wws: [emerg] a wws master is already running (control {existing})")
            return 1
        }
        eprint("wws: [warn] removing stale pid file \"{pidp}\" (control {existing} not responding)")
    }

    // the plaintext listener binds the first NON-ssl listen; a config
    // whose only listen carries `ssl` has no plaintext socket (the
    // TLS-only server). `hport` is the port a directory redirect's
    // absolute Location uses — the plaintext port when there is one,
    // else the TLS port (set below).
    let addr = serve.listen_addr_plain(c0)
    var have_http = false
    var hl: int = 0
    var hport: int = 0
    if !addr.is_empty() {
        hl = net_listen(addr) else |_| {
            eprint("wws: [emerg] bind() to {addr} failed")
            return 1
        }
        hport = net_port(hl) else |_| {
            eprint("wws: [emerg] could not read the listen port")
            return 1
        }
        have_http = true
    }

    // ws05: the TLS listener. `listen ... ssl` opens a second socket;
    // the SslConf (certs, keys, SNI table) is resolved and FROZEN per
    // generation beside the Conf (the same freeze-and-swap the model
    // rides — a reload rebuilds it, cert-reload atomicity for free).
    // TLS connections are served BLOCKING to completion in the poll
    // loop below (the drain multiplexer's table is parallel primitive
    // lists and cannot hold a per-connection TLS session on the native
    // tier — wolf-lang#144; interleaved TLS drain awaits the fix, a
    // NAMED residue). The plaintext drain is untouched.
    var have_tls = false
    var tls_l: int = 0
    var ssl0 = config.ssl_resolve(c0, prefix)
    let tls_addr = ssl_listen_addr(c0)
    if !tls_addr.is_empty() {
        if !config.ssl_ok(ssl0) {
            eprint("wws: [emerg] TLS configuration invalid: {ssl0.err}")
            return 1
        }
        tls_l = net_listen(tls_addr) else |_| {
            eprint("wws: [emerg] bind() to TLS {tls_addr} failed")
            return 1
        }
        let tport = net_port(tls_l) else |_| {
            return 1
        }
        if !have_http {
            hport = tport
        }
        have_tls = true
        eprint(
            "wws: [notice] TLS serving on {tls_addr} (port {tport}); TLS 1.3, TLS_CHACHA20_POLY1305_SHA256, certificate entries loaded: {ssl0.names.len}",
        )
    }

    // the control endpoint is what the pid file records (so -s and the
    // next start's stale-check can reach us). No control directive →
    // no channel; the pid file still records the http addr as identity.
    var have_ctrl = false
    var cl: int = 0
    var ctrl_ep = addr
    if !ctrl.is_empty() {
        cl = net_listen(ctrl) else |_| {
            eprint("wws: [emerg] bind() to control {ctrl} failed")
            return 1
        }
        let cport = net_port(cl) else |_| {
            return 1
        }
        ctrl_ep = "127.0.0.1:{cport}"
        have_ctrl = true
    }

    shell.pid_write(pidp, ctrl_ep) else |_| {
        eprint("wws: [emerg] could not write pid file \"{pidp}\"")
        return 1
    }

    let opts = serve.default_opts()
    let lim = http.default_limits()
    let shutdown_ms = shell.shutdown_timeout_ms(c0)
    let where = if have_http { addr } else { "(no plaintext listener)" }
    eprint("wws: [notice] serving on {where}, control {ctrl_ep}, pid file {pidp}")

    // signal reception (wsm01, s114 in the pin): register interest in
    // RELOAD|TERMINATE|QUIT by MEANING, plus the probe bit (UPGRADE —
    // the self-raise poll below). Where delivery is not wired (s114 is
    // Linux-full; non-Linux follows the task-layer port) the listen
    // answers `io` and the control channel stays the only trigger —
    // the NAMED platform gap, said out loud at startup.
    let sprobe = shell.sig_probe()
    var sig_on = true
    os_signal_listen(shell.sig_mask() + sprobe) else |_| {
        sig_on = false
    }
    if sig_on {
        eprint("wws: [notice] signal reception armed (HUP=reload, TERM=stop, QUIT=quit)")
    } else {
        eprint(
            "wws: [notice] signal reception unavailable on this platform; the control channel is the trigger",
        )
    }

    // generation 1 is current
    let h1 = shell.conf_hash(c0)
    var gens = List[GenRow]()
    (mut gens).push(GenRow {
        conf: c0,
        gen: 1,
        live: 0,
        state: "current",
        loaded_ms: time_unix_ms(),
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: h1,
    })
    eprint("wws: [notice] {shell.ev_generation_loaded(1, h1)}")
    eprint("wws: [notice] {shell.ev_generation_activated(1)}")

    // the connection table (parallel primitive lists — a List of a
    // local/primitive type constructs on every lane; rebuilt each pass)
    var cfds = List[int]()
    var cgens = List[int]()
    var ccarry = List[str]()
    var cserved = List[int]()
    var cidle = List[int]()

    var running = true
    var quitting = false
    while running {
        let now = time_unix_ms()

        // 1. collect ONE trigger for the verb dispatch: a control-
        // channel line (with a reply socket) or a received signal
        // (reply-less; a real SIGHUP lands here). Both flow through
        // the SAME dispatch below — ws04's one-layer design,
        // flipped real by s114. A control verb wins the pass; a
        // signal waits buffered for the next pass, so neither is
        // lost.
        var verb = ""
        var cc = -1
        if have_ctrl {
            net_deadline(cl, 25) else |_| {}
            var got_ctrl = true
            let cand = net_accept(cl) else |_| {
                got_ctrl = false
                0
            }
            if got_ctrl {
                cc = cand
                net_deadline(cc, 2000) else |_| {}
                verb = read_command(cc)
            }
        }
        if sig_on && cc < 0 {
            // The self-raise poll: enqueue the probe meaning, then
            // wait ONCE. The runtime queue is FIFO, so a real
            // pending signal comes back before the probe and the
            // probe bounds the wait — a spawn-free, non-blocking
            // signal check (see the header note; flips to the
            // parked forwarder when the upstream cluster fix
            // lands). A failed raise skips the wait: without a
            // probe in the queue the wait could park forever.
            var m = 0
            os_signal_raise(sprobe) else |_| {
                m = -1
            }
            if m == 0 {
                m = os_signal_wait(shell.sig_mask() + sprobe) else |_| { sprobe }
            }
            if m > 0 && m != sprobe {
                verb = shell.signal_verb(m)
                eprint("wws: [notice] {shell.ev_signal_received(m)}")
            }
        }
        if cc >= 0 || !verb.is_empty() {
            let curgen = current_gen(gens)
            if verb == "ping" {
                reply(cc, "pong\n")
            } else if verb == "status" {
                let body = status_stanza(gens, shutdown_ms, quitting, false)
                reply(cc, "{body}\n")
            } else if verb == "status json" {
                let body = status_stanza(gens, shutdown_ms, quitting, true)
                reply(cc, "{body}\n")
            } else if verb == "stop" {
                reply(cc, "stop: shutting down (generation {curgen})\n")
                running = false
            } else if verb == "quit" {
                reply(cc, "quit: draining then exiting (generation {curgen})\n")
                quitting = true
                let held = held_of(gens, curgen)
                gens = mark_draining(gens, curgen, now)
                eprint("wws: [notice] {shell.ev_generation_draining(curgen, held)}")
                gens = retire_zero(gens, now)
            } else if verb == "reopen" {
                reply(cc, "reopen: log outputs cycled (generation {curgen})\n")
            } else if verb == "reload" {
                let ci = index_of(gens, curgen)
                let prev = shell.Gen {
                    conf: copy gens[ci].conf,
                    gen: curgen,
                    ok: true,
                    note: "",
                }
                let ng = shell.reload(prefix, conf, prev)
                if ng.ok && ng.gen > curgen {
                    let held = gens[ci].live
                    let nhash = shell.conf_hash(ng.conf)
                    // cert-reload atomicity (ws05): rebuild the frozen
                    // SslConf from the new model. ssl_resolve validates
                    // the PAIR; a reload whose certs fail keeps serving
                    // (the ng.ok gate already held the config valid, and
                    // TLS conns are served to completion, so in-flight
                    // ones finish under the old cert — the ws04 rule).
                    let nssl = config.ssl_resolve(ng.conf, prefix)
                    if config.ssl_ok(nssl) {
                        ssl0 = nssl
                    } else {
                        eprint(
                            "wws: [error] reloaded config has invalid TLS ({nssl.err}); keeping the previous certificates",
                        )
                    }
                    gens = start_reload(gens, curgen, ng.conf, ng.gen, nhash, now)
                    eprint("wws: [notice] {shell.ev_generation_draining(curgen, held)}")
                    eprint("wws: [notice] {shell.ev_generation_loaded(ng.gen, nhash)}")
                    eprint("wws: [notice] {shell.ev_generation_activated(ng.gen)}")
                    gens = retire_zero(gens, now)
                }
                reply(cc, "{ng.note}\n")
            } else {
                reply(cc, "unknown verb \"{verb}\"\n")
            }
            if cc >= 0 {
                net_close(cc) else |_| {}
            }
        }

        // 2. accept a new http connection (unless winding down) — it is
        // tagged with the CURRENT generation and bumps that counter
        if have_http && running && !quitting {
            net_deadline(hl, 25) else |_| {}
            var got_conn = true
            let conn = net_accept(hl) else |_| {
                got_conn = false
                0
            }
            if got_conn {
                let curgen = current_gen(gens)
                gens = bump_live(gens, curgen, 1)
                (mut cfds).push(conn)
                (mut cgens).push(curgen)
                (mut ccarry).push("")
                (mut cserved).push(0)
                (mut cidle).push(now)
            }
        }

        // 2b. TLS: accept and serve BLOCKING to completion (ws05).
        // The session cannot ride the drain table (wolf-lang#144), so a
        // TLS connection is handshaked and served here, start to finish,
        // under the current generation's frozen SslConf. It is tagged to
        // the current gen for the live counter (a reload while a TLS
        // conn serves waits for it — acceptable on loopback; interleaved
        // TLS drain is the named residue). A stalled handshake is bounded
        // by the read deadline, never a hang.
        if have_tls && running && !quitting {
            net_deadline(tls_l, 25) else |_| {}
            var got_tls = true
            let tconn = net_accept(tls_l) else |_| {
                got_tls = false
                0
            }
            if got_tls {
                let tgen = current_gen(gens)
                gens = bump_live(gens, tgen, 1)
                let tconf = conf_for(gens, tgen)
                var aborted_t = false
                var z = tls.accept(tconn, ssl0, opts.read_timeout_ms) else |e| match e {
                    refused => {
                        aborted_t = true
                        tls.no_sess()
                    },
                    timeout => {
                        aborted_t = true
                        tls.no_sess()
                    },
                    io => {
                        aborted_t = true
                        tls.no_sess()
                    },
                }
                if aborted_t {
                    net_close(tconn) else |_| {}
                } else {
                    var tcn = conn.tls_conn(tconn, z)
                    serve.serve_conn_cn(mut tcn, tconf, opts, lim, hport)
                }
                gens = on_conn_close(gens, tgen, false)
            }
        }

        // 3. give every open connection ONE short poll step, rebuilding
        // the table without the ones that finished. A close decrements
        // the owning generation; a draining generation past its
        // worker_shutdown_timeout has its remainder aborted.
        var nfds = List[int]()
        var ngens = List[int]()
        var ncarry = List[str]()
        var nserved = List[int]()
        var nidle = List[int]()
        var k: int = 0
        let ktot = cfds.len
        while k < ktot {
            let fd = cfds[k]
            let cg = cgens[k]
            let car = ccarry[k]
            let sv = cserved[k]
            let idle0 = cidle[k]
            let cconf = conf_for(gens, cg)
            let st = serve.conn_step(fd, cconf, opts, lim, hport, car, sv, 12)
            var close_it = st.close
            var new_idle = idle0
            if st.active {
                new_idle = now
            }
            var aborted_flag = false
            if !close_it && !st.active && now - new_idle >= opts.keepalive_timeout_ms {
                close_it = true
            }
            if !close_it && shutdown_ms > 0 {
                let gi = index_of(gens, cg)
                if gi >= 0 && gens[gi].state == "draining" && now - gens[gi].since_ms >= shutdown_ms {
                    close_it = true
                    aborted_flag = true
                }
            }
            if close_it {
                net_close(fd) else |_| {}
                gens = on_conn_close(gens, cg, aborted_flag)
            } else {
                (mut nfds).push(fd)
                (mut ngens).push(cg)
                (mut ncarry).push(st.carry)
                (mut nserved).push(st.served)
                (mut nidle).push(new_idle)
            }
            k = k + 1
        }
        cfds = nfds
        cgens = ngens
        ccarry = ncarry
        cserved = nserved
        cidle = nidle

        // 4. retire drained generations, 5. finish a quit once empty
        gens = retire_zero(gens, now)
        if quitting && cfds.len == 0 {
            running = false
        }
    }

    // shutdown: close any still-open connections, the listeners, pid
    for fd in cfds {
        net_close(fd) else |_| {}
    }
    if have_http {
        net_close(hl) else |_| {}
    }
    if have_tls {
        net_close(tls_l) else |_| {}
    }
    if have_ctrl {
        net_close(cl) else |_| {}
    }
    shell.pid_remove(pidp) else |_| {}
    0
}

/// Write a control reply when the trigger carried a reply socket (a
/// signal trigger has none — `cc` is -1). Write trouble is swallowed:
/// the peer is closing anyway. Total.
fn reply(cc: int, s: str) {
    if cc >= 0 {
        net_write(cc, s) else |_| {}
    }
}

/// The live-connection count `gen` currently holds, or 0. Total.
fn held_of(gens: List[GenRow], gen: int) -> int {
    for g in gens {
        if g.gen == gen {
            return g.live
        }
    }
    0
}

// ------------------------------------------------------------------
// signal-send — `-s verb` reaches the running master through the
// control channel (the pin has no arbitrary-pid signal send; #126)
// ------------------------------------------------------------------

/// `-s <verb>`: read the pid file for the running master's control
/// endpoint (nginx reads it for the pid), connect, send the verb, and
/// print the reply. nginx exit codes: a missing pid file is exit 1
/// with the open() diagnostic; a refused endpoint (stale file, dead
/// master) is exit 1. Loads the config first, as nginx does, to
/// resolve the pid path.
fn signal_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    let pidp = shell.pid_path(c, cli.prefix)
    let ep = shell.pid_read(pidp) else |e| match e {
        none => {
            eprint("wws: [alert] open() \"{pidp}\" failed (2: No such file or directory)")
            return 1
        },
        io => {
            eprint("wws: [alert] could not read pid file \"{pidp}\"")
            return 1
        },
    }
    let reply = shell.control_send(ep, cli.signal) else |e| match e {
        refused => {
            eprint(
                "wws: [error] the master at {ep} is not responding (stale pid file, or signal reception awaits wolf-lang #126)",
            )
            return 1
        },
        io => {
            eprint("wws: [error] control channel error to {ep}")
            return 1
        },
    }
    print(reply)
    0
}

// ------------------------------------------------------------------
// status — `wws status [--format json]` reads the drain you can watch
// off the running master's control channel (ws08)
// ------------------------------------------------------------------

/// `wws status [--format json]`: read the running master's control
/// endpoint from the pid file, fetch the status stanza over the control
/// channel (read to close — the stanza is multi-line), and print it.
/// nginx has no status command; this is wws-native, the observable
/// drain's operator surface. Exit codes mirror `-s`: a missing pid file
/// or a refused/dead endpoint is exit 1 with an nginx-shaped alert.
fn status_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    let pidp = shell.pid_path(c, cli.prefix)
    let ep = shell.pid_read(pidp) else |e| match e {
        none => {
            eprint("wws: [alert] open() \"{pidp}\" failed (2: No such file or directory)")
            return 1
        },
        io => {
            eprint("wws: [alert] could not read pid file \"{pidp}\"")
            return 1
        },
    }
    let verb = if cli.format == "json" {
        "status json"
    } else {
        "status"
    }
    let reply = shell.control_fetch(ep, verb) else |e| match e {
        refused => {
            eprint(
                "wws: [error] the master at {ep} is not responding (stale pid file, or signal reception awaits wolf-lang #126)",
            )
            return 1
        },
        io => {
            eprint("wws: [error] control channel error to {ep}")
            return 1
        },
    }
    print_raw("{reply}\n")
    0
}

// ------------------------------------------------------------------
// the -g feed and the main dispatch
// ------------------------------------------------------------------

/// Validate `-g "directives"` through the ws01 parser (same table,
/// same named errors). v0 delta: the globals are VALIDATED but not
/// merged into the served model (recorded — a full merge is a later
/// sprint). Returns 0 when clean, 1 with an nginx-shaped diagnostic
/// otherwise.
fn check_globals(globals: str) -> int {
    if globals.is_empty() {
        return 0
    }
    let g = config.parse_str("{globals}\n", "command-line")
    if !config.ok(g) {
        eprint("wws: [emerg] {g.err} in the -g command-line directives")
        return 1
    }
    0
}

/// The ws07 dry-run: `-t --request` answers what the config would DO
/// with each probe — matched server, matched location with the
/// why-it-lost trace, effective directives with provenance, terminal
/// decision — offline (the ONLY fs is the -t surface itself: config
/// files and, under --stat, the one mapped path; no socket ever
/// opens — dryrun/ imports no io module, and its pure core runs on
/// the fs-less, socket-less interpreter lane as the standing proof).
/// Exit is the -t verdict: a config that fails -t fails here, with
/// the same [emerg] lines; probes answer on stdout (text stanzas or
/// the schema-versioned JSON twin).
fn dryrun_main(cli: shell.Cli) -> int {
    // the -t half first, verbatim (stderr verdict lines included)
    let verdict = config.check(cli.prefix, cli.conf, false)
    if verdict != 0 {
        return verdict
    }
    let c = config.load(cli.prefix, cli.conf)
    let plain_addr = serve.listen_addr_plain(c)
    let tls_addr = ssl_listen_addr(c)
    // TLS-selection inputs: certificates are config files — the -t
    // fs surface, nothing beyond it
    var s = config.ssl_none()
    if !tls_addr.is_empty() {
        s = config.ssl_resolve(c, cli.prefix)
    }
    let json = cli.format == "json"
    var out = ""
    if json {
        out = dryrun.json_open()
    }
    var first = true
    for spec in cli.requests {
        let p = dryrun.probe_request(spec)
        if !p.input_err.is_empty() {
            eprint("wws: {p.input_err}")
            return 1
        }
        var tr = http.trace_new()
        var listener = plain_addr
        if p.scheme == "https" {
            listener = tls_addr
        }
        let v = dryrun.decide(c, p, plain_addr, tls_addr, mut tr)
        var tls_line = ""
        if p.scheme == "https" && !tls_addr.is_empty() {
            tls_line = dryrun.tls_note(s, cli.sni)
        }
        var stat_line = ""
        if cli.stat {
            stat_line = dryrun.stat_note(v, p.path)
        }
        if json {
            let obj = dryrun.stanza_json(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                out = "{out}{obj}"
                first = false
            } else {
                out = "{out},{obj}"
            }
        } else {
            let st = dryrun.stanza(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                first = false
            } else {
                print("")
            }
            print_raw(st)
        }
    }
    if json {
        out = "{out}{dryrun.json_close()}"
        print(out)
    }
    0
}

fn main() -> int {
    let cli = shell.parse_cli(env_args())
    if cli.mode == "error" {
        eprint("wws: {cli.err_msg}")
        return cli.exit_code
    }
    if cli.mode == "banner" {
        banner()
        return 0
    }
    if cli.mode == "version" {
        eprint(shell.version_report())
        return 0
    }
    if cli.mode == "version_verbose" {
        eprint_raw(shell.version_verbose())
        return 0
    }
    if cli.mode == "help" {
        eprint_raw(shell.usage_text())
        return 0
    }
    let gbad = check_globals(cli.globals)
    if gbad != 0 {
        return gbad
    }
    if cli.mode == "check" {
        if cli.requests.len > 0 {
            return dryrun_main(cli)
        }
        return config.check(cli.prefix, cli.conf, false)
    }
    if cli.mode == "dump" {
        return config.check(cli.prefix, cli.conf, true)
    }
    if cli.mode == "docs" {
        print_raw(config.directives_markdown())
        return 0
    }
    if cli.mode == "signal" {
        return signal_main(cli)
    }
    if cli.mode == "status" {
        return status_main(cli)
    }
    if cli.mode == "serve" {
        return serve_main(cli.prefix, cli.conf)
    }
    banner()
    0
}
