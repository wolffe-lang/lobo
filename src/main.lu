//! lobo — a production web server in wolf. Entry file:
//! the operator shell. The CLI grammar, the text builders, the pid
//! lifecycle, the control channel and the reload verbs are shell/'s
//! (ws04); main is the thin dispatch over them plus the acting paths
//! (the drain-aware serve loop, signal-send, and `status`) that wire
//! net/fs to the model and own the per-generation drain bookkeeping
//! (ws08).
//!
//! `main`'s legal shapes are E0414's: no parameters — arguments come
//! through `env_args`, which drops argv[0].
//!
//! The signal split (ws04 §3, FLIPPED at wsm01). The s115 pin carries
//! s114's signal RECEPTION (wolf-lang #126): the server listens for
//! real SIGHUP/SIGTERM/SIGQUIT (the RELOAD/TERMINATE/QUIT meanings)
//! and each received meaning feeds the SAME verb dispatch the control
//! channel drives — the one-layer design ws04 built for exactly this
//! flip. The control channel STAYS
//! (the portable path, and the Windows reload story — [os.signal.
//! platform] names RELOAD/UPGRADE as having no Windows analog). What
//! did NOT land: a getpid surface — so `-s` still SENDS over the
//! control channel and the pid file still records the control
//! endpoint (named residue; a real pid file follows a getpid).
//! Signal delivery is Linux+macOS at the wsm03 pin (s114/s59; other
//! hosts follow the ports); where the listen refuses, the server says
//! so and runs control-channel-only — a named gap, never a fake.
//!
//! Serve stays SPAWN-FREE (D7, ws04's shape): ONE poll loop
//! multiplexes the http listener, the control channel, the signal
//! queue, and every open connection, each stepped a slice at a time
//! under a short deadline (serve.conn_step) so no single connection
//! blocks the loop. Signals are polled by SELF-RAISE: each pass
//! raises the UPGRADE meaning as a probe and waits once — the
//! runtime's queue is FIFO, so a real pending SIGHUP/TERM/QUIT comes
//! back BEFORE the probe and the probe bounds the wait (never a
//! park on a signal that may not come). The clean parked-forwarder
//! task ([os.signal.wait]'s intended shape) is blocked at this pin by
//! an upstream release-tier bug — s43's cluster partition follows
//! CALL edges only, so a task-entry shim can land in a different
//! object than its spawner's `func.addr` and the LLVM tier refuses
//! (filed; the corpus-shape witness is tools' probe record). The poll
//! flips to the forwarder the sprint after the fix enters the pin.
//! That is what makes the DRAIN WATCHABLE (ws08): a per-generation live
//! counter in the loop's own bookkeeping lets an operator see an old
//! generation drain — via `lobo status` and log events — while a new one
//! serves. A reloaded-away generation keeps its FROZEN model and its
//! open connections finish on it (the reload-under-load invariant,
//! pinned by the rig). File-header note (F-0016): comments never sit
//! directly above a dotted call.

use acme
use config
use conn
use dryrun
use http
use obs
use proxy
use serve
use shell
use tls

/// The package version. Matches wolf.pkg; the release ritual (far
/// future) bumps both in one commit. Total; never traps.
fn version() -> str {
    "0.0.1"
}

/// The no-argument banner: identity plus every module's frozen
/// interface version, which is also what keeps each stub import
/// honestly used (E0305).
fn banner() {
    print("lobo {version()} — a web server in wolf")
    let mods = "config {config.version()} · dryrun {dryrun.version()} · http {http.version()} · obs {obs.version()} · proxy {proxy.version()} · serve {serve.version()} · shell {shell.version()}"
    print("modules: {mods}")
}

// ------------------------------------------------------------------
// the control loop's line reader and verb dispatch
// ------------------------------------------------------------------

/// Read one newline-terminated command line from `conn` (bounded — a
/// control peer sends one short verb). Returns the line without the
/// newline. Swallows net trouble into "" (the loop then replies with
/// an error and moves on). Total.
fn read_command(conn: int) -> str {
    var buf = ""
    var reading = true
    while reading {
        let nl = buf.find("\n") else -1
        if nl >= 0 {
            return buf[0..nl].trim()
        }
        if buf.len > 4096 {
            return buf.trim()
        }
        let piece = net_read(conn, 512) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    buf.trim()
}

// ------------------------------------------------------------------
// the generation table (ws08) — the drain you can watch. One row per
// LIVE generation (current + every still-draining old one), each
// carrying its FROZEN model, its live-connection count, its state, and
// the accounting a retirement reports. The counter is here, in the
// poll loop's own bookkeeping — spawn-free, no concurrent tasks (D7 /
// ws04). The table is a local List[GenRow]: a List of an IMPORTED
// struct is refused in the checked tier, but a List of a LOCAL struct
// is fine, so the row type lives here and shell formats it one field at
// a time. Rows are never mutated in place (index-assignment is a
// one-lane shape) — every update REBUILDS the list, which is cheap: a
// server holds a handful of generations, never more.
// ------------------------------------------------------------------

/// One live generation. `state` is "current" (the one accepting new
/// connections) or "draining" (a reloaded-away generation still holding
/// connections). `loaded_ms` is when it was created, `since_ms` when it
/// began draining (0 while current). `drained`/`aborted` accumulate its
/// retirement accounting; `shash` is its content-hash id. ws10: `lim`
/// is the generation's FROZEN effective Limits (fence + budget resolve
/// once at freeze, exactly like the model — a draining generation
/// keeps serving under ITS numbers); `mem_hw` the high-water admitted
/// bytes of any single request it served; `bud_hits` its budget-503
/// count.
struct GenRow {
    conf: config.Conf,
    gen: int,
    live: int,
    state: str,
    loaded_ms: int,
    since_ms: int,
    drained: int,
    aborted: int,
    shash: str,
    lim: http.Limits,
    mem_hw: int,
    bud_hits: int,
}

/// The generation number of the current (accepting) row, or -1. Total.
fn current_gen(gens: List[GenRow]) -> int {
    for g in gens {
        if g.state == "current" {
            return g.gen
        }
    }
    -1
}

/// The index of the row for `gen`, or -1. Total.
fn index_of(gens: List[GenRow], gen: int) -> int {
    var i: int = 0
    let n = gens.len
    while i < n {
        if gens[i].gen == gen {
            return i
        }
        i = i + 1
    }
    -1
}

/// The frozen model a connection tagged `gen` serves under — full
/// fidelity, so a request arriving on a draining connection routes
/// under the model it was accepted on (the frozen-model discipline,
/// ws04). Falls back to the current row, then to an empty model, for a
/// generation that cannot be found (never happens while it holds a
/// connection — a generation retires only at zero). Total.
fn conf_for(gens: List[GenRow], gen: int) -> config.Conf {
    let i = index_of(gens, gen)
    if i >= 0 {
        return gens[i].conf
    }
    if gens.len > 0 {
        return gens[0].conf
    }
    config.parse_str("http {{\n}}\n", "empty")
}

/// A generation's age in ms in its current role: since load while
/// current, since drain start while draining. Total.
fn gen_age(g: GenRow, now: int) -> int {
    if g.state == "current" {
        return now - g.loaded_ms
    }
    now - g.since_ms
}

/// The worker_shutdown_timeout remaining for a DRAINING generation, or
/// -1 when none applies (a current generation, or no timeout). Clamped
/// at 0. Total.
fn gen_remaining(g: GenRow, shutdown_ms: int, now: int) -> int {
    if g.state != "draining" || shutdown_ms <= 0 {
        return -1
    }
    let rem = shutdown_ms - (now - g.since_ms)
    if rem < 0 {
        return 0
    }
    rem
}

/// Rebuild `gens` with `gen`'s live count changed by `delta`. Total.
fn bump_live(gens: List[GenRow], gen: int, delta: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live + delta,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// The frozen effective Limits a connection tagged `gen` serves under
/// (the same freeze-and-fall-back rule as conf_for). Total.
fn lim_for(gens: List[GenRow], gen: int) -> http.Limits {
    let i = index_of(gens, gen)
    if i >= 0 {
        return gens[i].lim
    }
    if gens.len > 0 {
        return gens[0].lim
    }
    http.default_limits()
}

/// Fold one served request's budget outcome into its generation's
/// aggregates: raise the high-water mark, count a refusal. Rebuilds
/// only when something changed (the per-request hot path pays a
/// comparison, not a rebuild). Total.
fn note_request(gens: List[GenRow], gen: int, hw: int, hit: bool) -> List[GenRow] {
    let i = index_of(gens, gen)
    if i < 0 {
        return gens
    }
    if !hit && hw <= gens[i].mem_hw {
        return gens
    }
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            var nhw = g.mem_hw
            if hw > nhw {
                nhw = hw
            }
            var nhits = g.bud_hits
            if hit {
                nhits = nhits + 1
            }
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: nhw,
                bud_hits: nhits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Account one closed connection on `gen`: decrement its live count and,
/// when the generation is DRAINING, tally it (`aborted` on a timeout
/// force-close, else `drained`) and emit `connection-retired`. THE
/// never-negative assertion lives here and stays in every profile
/// (checked-arithmetic spirit — a leak that made a generation immortal
/// would be loud). Returns the rebuilt table. Total unless the
/// invariant breaks (then it traps, by design).
fn on_conn_close(gens: List[GenRow], gen: int, aborted: bool, mut el: ELog) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            let nlive = g.live - 1
            assert(nlive >= 0, "generation {gen} live-connection count went negative")
            var nd = g.drained
            var na = g.aborted
            if g.state == "draining" {
                if aborted {
                    na = na + 1
                } else {
                    nd = nd + 1
                }
                ev_log(mut el, "notice", shell.ev_connection_retired(gen, nlive))
            }
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: nlive,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: nd,
                aborted: na,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Retire every DRAINING generation that has reached zero connections:
/// emit `generation-retired` with its accounting and drop it from the
/// table. Total.
fn retire_zero(gens: List[GenRow], now: int, mut el: ELog) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.state == "draining" && g.live == 0 {
            let age = now - g.since_ms
            ev_log(mut el, "notice", shell.ev_generation_retired(g.gen, g.drained, g.aborted, age))
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Begin a reload: mark the current generation draining (as of `now`)
/// and append the freshly frozen `newconf` as the new current
/// generation `newgen`. Total.
fn start_reload(
    gens: List[GenRow],
    curgen: int,
    newconf: config.Conf,
    newgen: int,
    newhash: str,
    now: int,
) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == curgen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    let nlim = serve.resolve_limits(newconf)
    (mut out).push(GenRow {
        conf: newconf,
        gen: newgen,
        live: 0,
        state: "current",
        loaded_ms: now,
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: newhash,
        lim: nlim,
        mem_hw: 0,
        bud_hits: 0,
    })
    out
}

/// Mark `gen` draining (as of `now`) without creating a successor — the
/// quit path (drain everything, then exit). Total.
fn mark_draining(gens: List[GenRow], gen: int, now: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen && g.state == "current" {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Build the status stanza (contract §1): the generation table with
/// per-generation live counts, ages, ids, and worker_shutdown_timeout
/// remaining, plus the quit posture. `json` selects the versioned
/// single-line JSON (ws07 convention, ws12 reuses it); otherwise the
/// human, one-fact-per-line text. The read races the generation swap by
/// design — a torn read across generations is acceptable and each
/// count is monotone-correct per generation (documented in docs/). The
/// snapshot is one pass over the table reference. Total.
fn status_stanza(gens: List[GenRow], shutdown_ms: int, quitting: bool, json: bool) -> str {
    let now = time_unix_ms()
    let cur = current_gen(gens)
    if json {
        var s = shell.status_json_open(cur, quitting)
        var first = true
        for g in gens {
            let sep = if first { "" } else { "," }
            first = false
            let obj = shell.
                status_json_obj(
                g.gen,
                g.state,
                g.live,
                gen_age(g, now),
                g.shash,
                gen_remaining(g, shutdown_ms, now),
                g.mem_hw,
                g.bud_hits,
            )
            s = "{s}{sep}{obj}"
        }
        return "{s}{shell.status_json_close()}"
    }
    var s = shell.status_head_text(cur, quitting)
    for g in gens {
        s = "{s}{shell.status_line_text(g.gen, g.live, g.state, gen_age(g, now), g.shash, gen_remaining(g, shutdown_ms, now), g.mem_hw, g.bud_hits)}"
    }
    s
}

// ------------------------------------------------------------------
// serve — bind, write the pid file, and run the poll loop
// ------------------------------------------------------------------

/// The serving verb. Loads and freezes the config (generation 1),
/// refuses to start if a live master already holds the pid file
/// (stale-pid detection), writes the pid file (its content is the
/// control endpoint at this pin), then runs the DRAIN-AWARE poll loop
/// (ws08): one spawn-free loop multiplexes the http listener, the
/// control channel, and every open connection, keeping a per-generation
/// live counter so an operator can WATCH an old generation drain while a
/// new one serves. Returns 1 on a config error, a failed bind, or a
/// refused start; the loop runs until `stop`, or until `quit` has
/// drained everything. Loopback only.
/// The bind address of the first `listen ... ssl` directive (the TLS
/// listener; a bare port becomes a loopback bind — loopback-only,
/// forever). "" when no ssl listen exists. Total.
fn ssl_listen_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var has_ssl = false
            var j: int = 0
            while j < nn {
                if c.argp[at + j] == "ssl" {
                    has_ssl = true
                }
                j = j + 1
            }
            if has_ssl && nn >= 1 {
                let a = c.argp[at]
                if a.contains(":") {
                    return a
                }
                return "127.0.0.1:{a}"
            }
        }
        i = i + 1
    }
    ""
}

// ------------------------------------------------------------------
// the log sinks (ws09) — the entry owns the outputs: per-output
// bounded sinks built from the frozen model, pumped once per poll
// pass (emit never blocks; a pass does ONE bounded append per sink),
// cycled by `reopen`, flushed on quit/stop. The rows are LOCAL
// structs over obs values (the checked tier refuses List[<imported
// struct>]() — the GenRow pattern), rebuilt on mutation, never
// index-assigned.
// ------------------------------------------------------------------

/// One access-log output: the sink plus its rendering door (the
/// compat format text + escape mode, or the native JSON line).
struct SinkRow {
    s: obs.Sink,
    json: bool,
    fmttext: str,
    esc: str,
}

/// One finished request awaiting the pass's pump (the local-wrapper
/// List shape).
struct AccRow {
    a: obs.Access,
}

/// The error-log output (`have` false = stderr only, as before ws09).
struct ELog {
    s: obs.Sink,
    have: bool,
    json: bool,
    level: str,
}

/// A config log path against the prefix (absolute carries). Total.
fn resolve_log_path(prefix: str, p: str) -> str {
    if p.starts_with("/") {
        return p
    }
    "{prefix}/{p}"
}

/// The access-output rows of a frozen model. Total (nothing opens
/// until the first flush). A reload rebuilds — nginx's old workers
/// keep old-config logs, lobo's one process logs through the CURRENT
/// generation's outputs (named delta, docs/LOGGING.md).
fn build_sinks(c: config.Conf, prefix: str) -> List[SinkRow] {
    var out = List[SinkRow]()
    var i: int = 0
    let n = config.access_out_count(c)
    while i < n {
        let path = resolve_log_path(prefix, config.access_out_path(c, i))
        (mut out).push(SinkRow {
            s: obs.sink_new(path, config.access_out_buffer(c, i)),
            json: config.access_out_json(c, i),
            fmttext: config.access_out_fmt(c, i),
            esc: config.access_out_esc(c, i),
        })
        i = i + 1
    }
    out
}

/// The error-log output of a frozen model ("" path = none). Total.
fn build_elog(c: config.Conf, prefix: str) -> ELog {
    let p = config.errlog_path(c)
    if p.is_empty() {
        return ELog { s: obs.sink_new("", 0), have: false, json: false, level: "error" }
    }
    ELog {
        s: obs.sink_new(resolve_log_path(prefix, p), 0),
        have: true,
        json: config.errlog_json(c),
        level: config.errlog_level(c),
    }
}

/// The ws09 event seam: STDERR keeps every line exactly as before
/// (the ws02 seam — the rig and the signal witness read it), and the
/// configured error_log receives the level-gated copy in its door's
/// shape (nginx text or JSON lines). Total (emit never blocks).
fn ev_log(mut el: ELog, level: str, body: str) {
    eprint("lobo: [{level}] {body}")
    if el.have && obs.level_passes(level, el.level) {
        let ms = time_unix_ms()
        let line = if el.json { obs.render_error_jsonl(level, body, ms) } else {
            obs.render_error(level, body, ms)
        }
        obs.sink_emit(mut el.s, line)
    }
}

/// Pump the access sinks: render this pass's records through each
/// output's door, one bounded flush per sink, drops reported LOUDLY
/// through the event seam. Returns the rebuilt rows. fs tier.
fn pump_sinks(rows: List[SinkRow], accs: List[AccRow], optin: str, mut el: ELog) -> List[SinkRow] {
    var out = List[SinkRow]()
    for r in rows {
        var sk = r.s
        if accs.len > 0 {
            let f = obs.compile(r.fmttext)
            for ar in accs {
                let line = if r.json { obs.render_access_jsonl(ar.a, optin.words()) } else {
                    obs.render_access(f, ar.a, r.esc)
                }
                obs.sink_emit(mut sk, line)
            }
        }
        let _ = obs.sink_flush(mut sk)
        let note = obs.sink_drop_note(mut sk)
        if !note.is_empty() {
            ev_log(mut el, "warn", note)
        }
        (mut out).push(SinkRow { s: sk, json: r.json, fmttext: r.fmttext, esc: r.esc })
    }
    out
}

/// Flush the error-log sink (its own drop note goes to stderr only —
/// never recurse into the seam that overflowed). fs tier.
fn flush_elog(el: ELog) -> ELog {
    var sk = el.s
    if el.have {
        let _ = obs.sink_flush(mut sk)
        let note = obs.sink_drop_note(mut sk)
        if !note.is_empty() {
            eprint("lobo: [warn] {note}")
        }
    }
    ELog { s: sk, have: el.have, json: el.json, level: el.level }
}

/// Close every access output (flushing first) so the NEXT flush
/// reopens at the configured paths — the `reopen` verb's action, and
/// the quit path's final flush. Returns the rebuilt rows. fs tier.
fn reopen_sinks(rows: List[SinkRow]) -> List[SinkRow] {
    var out = List[SinkRow]()
    for r in rows {
        var sk = r.s
        obs.sink_reopen(mut sk)
        (mut out).push(SinkRow { s: sk, json: r.json, fmttext: r.fmttext, esc: r.esc })
    }
    out
}

/// The error-log twin of reopen_sinks. fs tier.
fn reopen_elog(el: ELog) -> ELog {
    var sk = el.s
    if el.have {
        obs.sink_reopen(mut sk)
    }
    ELog { s: sk, have: el.have, json: el.json, level: el.level }
}

fn serve_main(prefix: str, conf: str) -> int {
    let c0 = config.load(prefix, conf)
    if !config.ok(c0) {
        eprint("lobo: [emerg] configuration file {conf} test failed")
        return 1
    }
    let ctrl = shell.control_addr(c0)
    let pidp = shell.pid_path(c0, prefix)

    // stale-pid detection: an existing pid file whose endpoint is
    // alive means a master is already running (refuse, nginx-shaped);
    // a dead endpoint is a stale file (replace with a warning).
    let existing = shell.pid_read(pidp) else |_| ""
    if !existing.is_empty() {
        if shell.control_alive(existing) {
            eprint("lobo: [emerg] a lobo master is already running (control {existing})")
            return 1
        }
        eprint(
            "lobo: [warn] removing stale pid file \"{pidp}\" (control {existing} not responding)",
        )
    }

    // the plaintext listener binds the first NON-ssl listen; a config
    // whose only listen carries `ssl` has no plaintext socket (the
    // TLS-only server). `hport` is the port a directory redirect's
    // absolute Location uses — the plaintext port when there is one,
    // else the TLS port (set below).
    let addr = serve.listen_addr_plain(c0)
    var have_http = false
    var hl: int = 0
    var hport: int = 0
    if !addr.is_empty() {
        hl = net_listen(addr) else |_| {
            eprint("lobo: [emerg] bind() to {addr} failed")
            return 1
        }
        hport = net_port(hl) else |_| {
            eprint("lobo: [emerg] could not read the listen port")
            return 1
        }
        have_http = true
    }

    // ws05: the TLS listener. `listen ... ssl` opens a second socket;
    // the SslConf (certs, keys, SNI table) is resolved and FROZEN per
    // generation beside the Conf (the same freeze-and-swap the model
    // rides — a reload rebuilds it, cert-reload atomicity for free).
    // TLS connections are served BLOCKING to completion in the poll
    // loop below. The upstream gate retired at the wsm02 pin
    // (wolf-lang#144 fixed: a List row mixing bool/int/List — the
    // Sess shape — now tiles on the native tier, probed at wsm02
    // including an imported-struct field); what remains is lobo's own
    // work — a Conn-based conn_step (serve_request re-plumbed over
    // the conn seam), a session-carrying row table, and a TLS-holder
    // drain witness — a NAMED follow-on rider (ledger D24), the
    // least critical of wsm02's three retirements. The plaintext
    // drain is untouched.
    var have_tls = false
    var tls_l: int = 0
    var ssl0 = config.ssl_resolve(c0, prefix)
    let tls_addr = ssl_listen_addr(c0)
    if !tls_addr.is_empty() {
        if !config.ssl_ok(ssl0) {
            eprint("lobo: [emerg] TLS configuration invalid: {ssl0.err}")
            return 1
        }
        // wsm02 entropy probe (s118): TLS session keys come from
        // os_random, which has no error row and never falls back — a
        // host whose CSPRNG cannot serve TRAPS. Draw once HERE so an
        // entropy-less host dies loudly at startup, never
        // mid-handshake. The probe bytes are discarded (never logged,
        // never reused); every handshake draws its own fresh bytes.
        if os_random(32).len != 32 {
            eprint("lobo: [emerg] entropy probe short (impossible per [os.random])")
            return 1
        }
        tls_l = net_listen(tls_addr) else |_| {
            eprint("lobo: [emerg] bind() to TLS {tls_addr} failed")
            return 1
        }
        let tport = net_port(tls_l) else |_| {
            return 1
        }
        if !have_http {
            hport = tport
        }
        have_tls = true
        eprint(
            "lobo: [notice] TLS serving on {tls_addr} (port {tport}); TLS 1.3, TLS_CHACHA20_POLY1305_SHA256, certificate entries loaded: {ssl0.names.len}",
        )
    }

    // the control endpoint is what the pid file records (so -s and the
    // next start's stale-check can reach us). No control directive →
    // no channel; the pid file still records the http addr as identity.
    var have_ctrl = false
    var cl: int = 0
    var ctrl_ep = addr
    if !ctrl.is_empty() {
        cl = net_listen(ctrl) else |_| {
            eprint("lobo: [emerg] bind() to control {ctrl} failed")
            return 1
        }
        let cport = net_port(cl) else |_| {
            return 1
        }
        ctrl_ep = "127.0.0.1:{cport}"
        have_ctrl = true
    }

    shell.pid_write(pidp, ctrl_ep) else |_| {
        eprint("lobo: [emerg] could not write pid file \"{pidp}\"")
        return 1
    }

    var opts = serve.default_opts()
    // ws10: the effective Limits (fence + budget) freeze PER
    // GENERATION beside the model — resolved here for gen 1, by
    // start_reload for successors, and read back per connection
    // through lim_for (a draining generation keeps serving under ITS
    // numbers, the frozen-model discipline).
    let lim1 = serve.resolve_limits(c0)
    let shutdown_ms = shell.shutdown_timeout_ms(c0)

    // ws09: the log outputs — per-output bounded sinks off the frozen
    // model (nothing opens until the first flush), the error-log
    // mirror (stderr keeps every line — the ws02 seam the rig reads),
    // and the JSON door's header opt-in list.
    var asinks = build_sinks(c0, prefix)
    var elog = build_elog(c0, prefix)
    var optin = config.log_headers_join(c0)

    // ws06: the ACME renewal daemon. When `cert auto` is on, arm the
    // challenge webroot (the http-01 route serves from it) and build
    // the issuance flow, ticked spawn-free in the poll loop below. The
    // flow is entirely async to the accept path — a server with `cert
    // auto` and no cert yet serves the challenge and the pending-TLS
    // posture ssl_resolve set (the never-block-serving pitfall).
    var have_auto = config.auto_on(c0)
    var chall_dir = ""
    if have_auto {
        chall_dir = config.auto_challenge_dir(c0, prefix)
        fs_create_dir_all(chall_dir) else |_| {}
        opts = serve.ServerOpts {
            token: opts.token,
            keepalive_timeout_ms: opts.keepalive_timeout_ms,
            keepalive_requests: opts.keepalive_requests,
            read_timeout_ms: opts.read_timeout_ms,
            challenge_dir: chall_dir,
        }
    }
    let auto_primary = config.auto_primary(c0)
    var flow = acme.
        flow_new(
        config.auto_store(c0, prefix),
        config.auto_names(c0),
        config.auto_contact(c0),
        config.auto_ca(c0),
        config.auto_ca_root(c0),
        config.auto_renew_before_s(c0),
        config.auto_check_interval_s(c0),
    )
    // announce the BOUND plaintext port (not the configured addr,
    // which may carry :0) so a client — the ACME challenge dial-back
    // included — can find the http listener. The TLS notice already
    // prints its bound port.
    let where = if have_http { "127.0.0.1:{hport} (port {hport})" } else {
        "(no plaintext listener)"
    }
    ev_log(mut elog, "notice", "serving on {where}, control {ctrl_ep}, pid file {pidp}")

    // signal reception (wsm01, s114 in the pin): register interest in
    // RELOAD|TERMINATE|QUIT by MEANING, plus the probe bit (UPGRADE —
    // the self-raise poll below). Where delivery is not wired (s114 is
    // Linux-full; non-Linux follows the task-layer port) the listen
    // answers `io` and the control channel stays the only trigger —
    // the NAMED platform gap, said out loud at startup.
    let sprobe = shell.sig_probe()
    var sig_on = true
    os_signal_listen(shell.sig_mask() + sprobe) else |_| {
        sig_on = false
    }
    if sig_on {
        ev_log(mut elog, "notice", "signal reception armed (HUP=reload, TERM=stop, QUIT=quit)")
    } else {
        ev_log(
            mut elog,
            "notice",
            "signal reception unavailable on this platform; the control channel is the trigger",
        )
    }

    // generation 1 is current
    let h1 = shell.conf_hash(c0)
    var gens = List[GenRow]()
    (mut gens).push(GenRow {
        conf: c0,
        gen: 1,
        live: 0,
        state: "current",
        loaded_ms: time_unix_ms(),
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: h1,
        lim: lim1,
        mem_hw: 0,
        bud_hits: 0,
    })
    ev_log(mut elog, "notice", shell.ev_generation_loaded(1, h1))
    ev_log(mut elog, "notice", shell.ev_generation_activated(1))

    // the connection table (parallel primitive lists — a List of a
    // local/primitive type constructs on every lane; rebuilt each pass)
    var cfds = List[int]()
    var cgens = List[int]()
    var ccarry = List[str]()
    var cserved = List[int]()
    var cidle = List[int]()
    var cstart = List[int]()

    var running = true
    var quitting = false
    while running {
        let now = time_unix_ms()

        // 1. collect ONE trigger for the verb dispatch: a control-
        // channel line (with a reply socket) or a received signal
        // (reply-less; a real SIGHUP lands here). Both flow through
        // the SAME dispatch below — ws04's one-layer design,
        // flipped real by s114. A control verb wins the pass; a
        // signal waits buffered for the next pass, so neither is
        // lost.
        var verb = ""
        var cc = -1
        if have_ctrl {
            net_deadline(cl, 25) else |_| {}
            var got_ctrl = true
            let cand = net_accept(cl) else |_| {
                got_ctrl = false
                0
            }
            if got_ctrl {
                cc = cand
                net_deadline(cc, 2000) else |_| {}
                verb = read_command(cc)
            }
        }
        if sig_on && cc < 0 {
            // The self-raise poll: enqueue the probe meaning, then
            // wait ONCE. The runtime queue is FIFO, so a real
            // pending signal comes back before the probe and the
            // probe bounds the wait — a spawn-free, non-blocking
            // signal check (see the header note; flips to the
            // parked forwarder when the upstream cluster fix
            // lands). A failed raise skips the wait: without a
            // probe in the queue the wait could park forever.
            var m = 0
            os_signal_raise(sprobe) else |_| {
                m = -1
            }
            if m == 0 {
                m = os_signal_wait(shell.sig_mask() + sprobe) else |_| { sprobe }
            }
            if m > 0 && m != sprobe {
                verb = shell.signal_verb(m)
                ev_log(mut elog, "notice", shell.ev_signal_received(m))
            }
        }
        if cc >= 0 || !verb.is_empty() {
            let curgen = current_gen(gens)
            if verb == "ping" {
                reply(cc, "pong\n")
            } else if verb == "status" {
                let body = status_stanza(gens, shutdown_ms, quitting, false)
                reply(cc, "{body}\n")
            } else if verb == "status json" {
                let body = status_stanza(gens, shutdown_ms, quitting, true)
                reply(cc, "{body}\n")
            } else if verb == "stop" {
                reply(cc, "stop: shutting down (generation {curgen})\n")
                running = false
            } else if verb == "quit" {
                reply(cc, "quit: draining then exiting (generation {curgen})\n")
                quitting = true
                let held = held_of(gens, curgen)
                gens = mark_draining(gens, curgen, now)
                ev_log(mut elog, "notice", shell.ev_generation_draining(curgen, held))
                gens = retire_zero(gens, now, mut elog)
            } else if verb == "reopen" {
                asinks = reopen_sinks(asinks)
                elog = reopen_elog(elog)
                ev_log(mut elog, "notice", "reopening log files")
                reply(cc, "reopen: log outputs cycled (generation {curgen})\n")
            } else if verb == "reload" {
                let ci = index_of(gens, curgen)
                let prev = shell.Gen {
                    conf: copy gens[ci].conf,
                    gen: curgen,
                    ok: true,
                    note: "",
                }
                let ng = shell.reload(prefix, conf, prev)
                if ng.ok && ng.gen > curgen {
                    let held = gens[ci].live
                    let nhash = shell.conf_hash(ng.conf)
                    // cert-reload atomicity (ws05): rebuild the frozen
                    // SslConf from the new model. ssl_resolve validates
                    // the PAIR; a reload whose certs fail keeps serving
                    // (the ng.ok gate already held the config valid, and
                    // TLS conns are served to completion, so in-flight
                    // ones finish under the old cert — the ws04 rule).
                    let nssl = config.ssl_resolve(ng.conf, prefix)
                    if config.ssl_ok(nssl) {
                        ssl0 = nssl
                    } else {
                        eprint(
                            "lobo: [error] reloaded config has invalid TLS ({nssl.err}); keeping the previous certificates",
                        )
                    }
                    gens = start_reload(gens, curgen, ng.conf, ng.gen, nhash, now)
                    ev_log(mut elog, "notice", shell.ev_generation_draining(curgen, held))
                    ev_log(mut elog, "notice", shell.ev_generation_loaded(ng.gen, nhash))
                    ev_log(mut elog, "notice", shell.ev_generation_activated(ng.gen))
                    gens = retire_zero(gens, now, mut elog)
                    // ws09: the log outputs follow the CURRENT
                    // generation (named delta — nginx's old workers
                    // keep old-config logs; lobo's one process logs
                    // through the live model's outputs)
                    asinks = reopen_sinks(asinks)
                    asinks = build_sinks(ng.conf, prefix)
                    elog = reopen_elog(elog)
                    elog = build_elog(ng.conf, prefix)
                    optin = config.log_headers_join(ng.conf)
                }
                reply(cc, "{ng.note}\n")
            } else {
                reply(cc, "unknown verb \"{verb}\"\n")
            }
            if cc >= 0 {
                net_close(cc) else |_| {}
            }
        }

        // 2. accept a new http connection (unless winding down) — it is
        // tagged with the CURRENT generation and bumps that counter
        if have_http && running && !quitting {
            net_deadline(hl, 25) else |_| {}
            var got_conn = true
            let conn = net_accept(hl) else |_| {
                got_conn = false
                0
            }
            if got_conn {
                let curgen = current_gen(gens)
                gens = bump_live(gens, curgen, 1)
                (mut cfds).push(conn)
                (mut cgens).push(curgen)
                (mut ccarry).push("")
                (mut cserved).push(0)
                (mut cidle).push(now)
                (mut cstart).push(now)
            }
        }

        // 2b. TLS: accept and serve BLOCKING to completion (ws05).
        // A TLS connection is handshaked and served here, start to
        // finish, under the current generation's frozen SslConf. It is
        // tagged to the current gen for the live counter (a reload
        // while a TLS conn serves waits for it — acceptable on
        // loopback). The #144 layout gate retired at the wsm02 pin;
        // joining the drain table is now lobo's own stepper refactor,
        // the NAMED D24 rider (see the listener comment above). A
        // stalled handshake is bounded by the read deadline, never a
        // hang.
        if have_tls && running && !quitting {
            net_deadline(tls_l, 25) else |_| {}
            var got_tls = true
            let tconn = net_accept(tls_l) else |_| {
                got_tls = false
                0
            }
            if got_tls {
                let tgen = current_gen(gens)
                gens = bump_live(gens, tgen, 1)
                let tconf = conf_for(gens, tgen)
                var aborted_t = false
                var z = tls.accept(tconn, ssl0, opts.read_timeout_ms) else |e| match e {
                    refused => {
                        aborted_t = true
                        tls.no_sess()
                    },
                    timeout => {
                        aborted_t = true
                        tls.no_sess()
                    },
                    io => {
                        aborted_t = true
                        tls.no_sess()
                    },
                }
                if aborted_t {
                    net_close(tconn) else |_| {}
                } else {
                    var tcn = conn.tls_conn(tconn, z)
                    serve.serve_conn_cn(mut tcn, tconf, opts, lim_for(gens, tgen), hport)
                }
                gens = on_conn_close(gens, tgen, false, mut elog)
            }
        }

        // 3. give every open connection ONE short poll step, rebuilding
        // the table without the ones that finished. A close decrements
        // the owning generation; a draining generation past its
        // worker_shutdown_timeout has its remainder aborted.
        var nfds = List[int]()
        var ngens = List[int]()
        var ncarry = List[str]()
        var nserved = List[int]()
        var nidle = List[int]()
        var ncstart = List[int]()
        var pass_accs = List[AccRow]()
        var k: int = 0
        let ktot = cfds.len
        while k < ktot {
            let fd = cfds[k]
            let cg = cgens[k]
            let car = ccarry[k]
            let sv = cserved[k]
            let idle0 = cidle[k]
            let cs0 = cstart[k]
            let cconf = conf_for(gens, cg)
            let st = serve.conn_step(fd, cconf, opts, lim_for(gens, cg), hport, car, sv, 12)
            var close_it = st.close
            var new_idle = idle0
            if st.active {
                new_idle = now
            }
            // ws09: a served request becomes an access record — the
            // entry stamps the times serve cannot know (wall clock,
            // and the span since this request's first byte)
            var new_start = cs0
            if st.logged {
                var a2 = st.acc
                a2.unix_ms = now
                var span = now - cs0
                if span < 0 {
                    span = 0
                }
                a2.req_ms = span
                (mut pass_accs).push(AccRow { a: a2 })
                new_start = now
                // ws10: the budget observability — a refusal is a LOUD
                // error event (the ws09 seam) and the generation's
                // counters move; every served request feeds the
                // high-water aggregate
                let hit = !st.bud_site.is_empty()
                if hit {
                    ev_log(
                        mut elog,
                        "error",
                        shell.ev_budget_exceeded(cg, st.bud_site, st.bud_limit, st.bud_would),
                    )
                }
                gens = note_request(gens, cg, st.mem_hw, hit)
            } else if !st.active && st.carry.is_empty() {
                new_start = now
            }
            var aborted_flag = false
            if !close_it && !st.active && now - new_idle >= opts.keepalive_timeout_ms {
                close_it = true
            }
            if !close_it && shutdown_ms > 0 {
                let gi = index_of(gens, cg)
                if gi >= 0 && gens[gi].state == "draining" && now - gens[gi].since_ms >= shutdown_ms {
                    close_it = true
                    aborted_flag = true
                }
            }
            if close_it {
                net_close(fd) else |_| {}
                gens = on_conn_close(gens, cg, aborted_flag, mut elog)
            } else {
                (mut nfds).push(fd)
                (mut ngens).push(cg)
                (mut ncarry).push(st.carry)
                (mut nserved).push(st.served)
                (mut nidle).push(new_idle)
                (mut ncstart).push(new_start)
            }
            k = k + 1
        }
        cfds = nfds
        cgens = ngens
        ccarry = ncarry
        cserved = nserved
        cidle = nidle
        cstart = ncstart

        // ws09: pump the pass's records through every access output
        // (ONE bounded append per sink per pass — emit never blocked
        // the serve path) and flush the error mirror
        asinks = pump_sinks(asinks, pass_accs, optin, mut elog)
        elog = flush_elog(elog)

        // 3b. ws06: the renewal daemon tick — spawn-free, in the loop's
        // own bookkeeping (D7). Acts only when the flow's schedule is
        // due (a comparison otherwise), so the accept path never waits
        // on ACME. On issuance the running server REBUILDS its frozen
        // SslConf from the store and swaps it — no reload, no deploy
        // hook: certbot's dance eliminated (the "finally"). Every
        // failure is LOUD (an error log line per attempt) with the
        // named reason the flow carries.
        if have_auto && running && !quitting {
            let ev = acme.tick(mut flow, now)
            if ev == "issued" {
                let rssl = config.ssl_resolve(conf_for(gens, current_gen(gens)), prefix)
                if config.ssl_ok(rssl) {
                    ssl0 = rssl
                    ev_log(
                        mut elog,
                        "notice",
                        "cert auto: issued/renewed {auto_primary}; new TLS connections serve the fresh certificate (no reload)",
                    )
                } else {
                    ev_log(
                        mut elog,
                        "error",
                        "cert auto: issued a certificate the server cannot load ({rssl.err}); keeping the previous certificates",
                    )
                }
            } else if ev == "failed" {
                ev_log(
                    mut elog,
                    "error",
                    "cert auto: issuance/renewal attempt failed: {flow.err} (will retry with backoff)",
                )
            }
        }

        // 4. retire drained generations, 5. finish a quit once empty
        gens = retire_zero(gens, now, mut elog)
        if quitting && cfds.len == 0 {
            running = false
        }
    }

    // shutdown: flush-and-close the log outputs FIRST (the ws09
    // flush-on-quit rule: the last request of a quit run is in the
    // log), then close connections, listeners, pid
    asinks = reopen_sinks(asinks)
    elog = reopen_elog(elog)
    for fd in cfds {
        net_close(fd) else |_| {}
    }
    if have_http {
        net_close(hl) else |_| {}
    }
    if have_tls {
        net_close(tls_l) else |_| {}
    }
    if have_ctrl {
        net_close(cl) else |_| {}
    }
    shell.pid_remove(pidp) else |_| {}
    0
}

/// Write a control reply when the trigger carried a reply socket (a
/// signal trigger has none — `cc` is -1). Write trouble is swallowed:
/// the peer is closing anyway. Total.
fn reply(cc: int, s: str) {
    if cc >= 0 {
        net_write(cc, s) else |_| {}
    }
}

/// The live-connection count `gen` currently holds, or 0. Total.
fn held_of(gens: List[GenRow], gen: int) -> int {
    for g in gens {
        if g.gen == gen {
            return g.live
        }
    }
    0
}

// ------------------------------------------------------------------
// signal-send — `-s verb` reaches the running master through the
// control channel (the pin has no arbitrary-pid signal send; #126)
// ------------------------------------------------------------------

/// `-s <verb>`: read the pid file for the running master's control
/// endpoint (nginx reads it for the pid), connect, send the verb, and
/// print the reply. nginx exit codes: a missing pid file is exit 1
/// with the open() diagnostic; a refused endpoint (stale file, dead
/// master) is exit 1. Loads the config first, as nginx does, to
/// resolve the pid path.
fn signal_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    let pidp = shell.pid_path(c, cli.prefix)
    let ep = shell.pid_read(pidp) else |e| match e {
        none => {
            eprint("lobo: [alert] open() \"{pidp}\" failed (2: No such file or directory)")
            return 1
        },
        io => {
            eprint("lobo: [alert] could not read pid file \"{pidp}\"")
            return 1
        },
    }
    let reply = shell.control_send(ep, cli.signal) else |e| match e {
        refused => {
            eprint(
                "lobo: [error] the master at {ep} is not responding (stale pid file, or signal reception awaits wolf-lang #126)",
            )
            return 1
        },
        io => {
            eprint("lobo: [error] control channel error to {ep}")
            return 1
        },
    }
    print(reply)
    0
}

// ------------------------------------------------------------------
// status — `lobo status [--format json]` reads the drain you can watch
// off the running master's control channel (ws08)
// ------------------------------------------------------------------

/// `lobo status [--format json]`: read the running master's control
/// endpoint from the pid file, fetch the status stanza over the control
/// channel (read to close — the stanza is multi-line), and print it.
/// nginx has no status command; this is lobo-native, the observable
/// drain's operator surface. Exit codes mirror `-s`: a missing pid file
/// or a refused/dead endpoint is exit 1 with an nginx-shaped alert.
fn status_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    let pidp = shell.pid_path(c, cli.prefix)
    let ep = shell.pid_read(pidp) else |e| match e {
        none => {
            eprint("lobo: [alert] open() \"{pidp}\" failed (2: No such file or directory)")
            return 1
        },
        io => {
            eprint("lobo: [alert] could not read pid file \"{pidp}\"")
            return 1
        },
    }
    let verb = if cli.format == "json" {
        "status json"
    } else {
        "status"
    }
    let reply = shell.control_fetch(ep, verb) else |e| match e {
        refused => {
            eprint(
                "lobo: [error] the master at {ep} is not responding (stale pid file, or signal reception awaits wolf-lang #126)",
            )
            return 1
        },
        io => {
            eprint("lobo: [error] control channel error to {ep}")
            return 1
        },
    }
    print_raw("{reply}\n")
    0
}

// ------------------------------------------------------------------
// cert status — `lobo cert status` reads the renewal daemon's own
// record off the store (ws06 §4): the domain, its certificate expiry,
// and the last attempt/result — the operator's one-glance answer.
// nginx has no analogue; lobo-native. Exit is nonzero (a `-t`-style
// failure signal) when a cert-auto config's certificate is MISSING or
// the last renewal attempt FAILED, so a monitor can gate on it.
// ------------------------------------------------------------------

/// `lobo cert status`: read the store's status file and the stored
/// leaf's expiry, print one fact per line, exit nonzero on a missing
/// certificate or a failed last attempt. Offline — the only fs is the
/// store, never a socket.
fn cert_status_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    if !config.auto_on(c) {
        eprint("lobo: [error] cert status: no \"cert auto\" server block in {cli.conf}")
        return 1
    }
    let store = config.auto_store(c, cli.prefix)
    let primary = config.auto_primary(c)
    let now_s = time_unix_ms() / 1000
    let expiry = acme.cert_expiry(store, primary)
    print_raw("domain: {primary}\n")
    print_raw("store: {store}\n")
    if expiry == 0 {
        print_raw("certificate: NONE (not yet issued — the challenge route serves meanwhile)\n")
    } else {
        let remaining = expiry - now_s
        let days = remaining / 86400
        print_raw("certificate: present\n")
        print_raw("expires_unix: {expiry}\n")
        print_raw("expires_in_days: {days}\n")
    }
    // the daemon's last-attempt record, if any
    let rec = fs_read_text(acme.status_path(store)) else |_| ""
    var failed = false
    if !rec.is_empty() {
        for line in rec.lines() {
            if line.starts_with("last_result ") {
                let r = line[12..line.len]
                print_raw("last_result: {r}\n")
                if r.starts_with("failed") {
                    failed = true
                }
            } else if line.starts_with("last_attempt_ms ") {
                print_raw("last_attempt_ms: {line[16..line.len]}\n")
            }
        }
    } else {
        print_raw("last_result: (no attempt recorded yet)\n")
    }
    if expiry == 0 || failed {
        return 1
    }
    0
}

// ------------------------------------------------------------------
// the -g feed and the main dispatch
// ------------------------------------------------------------------

/// Validate `-g "directives"` through the ws01 parser (same table,
/// same named errors). v0 delta: the globals are VALIDATED but not
/// merged into the served model (recorded — a full merge is a later
/// sprint). Returns 0 when clean, 1 with an nginx-shaped diagnostic
/// otherwise.
fn check_globals(globals: str) -> int {
    if globals.is_empty() {
        return 0
    }
    let g = config.parse_str("{globals}\n", "command-line")
    if !config.ok(g) {
        eprint("lobo: [emerg] {g.err} in the -g command-line directives")
        return 1
    }
    0
}

/// The ws07 dry-run: `-t --request` answers what the config would DO
/// with each probe — matched server, matched location with the
/// why-it-lost trace, effective directives with provenance, terminal
/// decision — offline (the ONLY fs is the -t surface itself: config
/// files and, under --stat, the one mapped path; no socket ever
/// opens — dryrun/ imports no io module, and its pure core runs on
/// the fs-less, socket-less interpreter lane as the standing proof).
/// Exit is the -t verdict: a config that fails -t fails here, with
/// the same [emerg] lines; probes answer on stdout (text stanzas or
/// the schema-versioned JSON twin).
fn dryrun_main(cli: shell.Cli) -> int {
    // the -t half first, verbatim (stderr verdict lines included)
    let verdict = config.check(cli.prefix, cli.conf, false)
    if verdict != 0 {
        return verdict
    }
    let c = config.load(cli.prefix, cli.conf)
    let plain_addr = serve.listen_addr_plain(c)
    let tls_addr = ssl_listen_addr(c)
    // TLS-selection inputs: certificates are config files — the -t
    // fs surface, nothing beyond it
    var s = config.ssl_none()
    if !tls_addr.is_empty() {
        s = config.ssl_resolve(c, cli.prefix)
    }
    let json = cli.format == "json"
    var out = ""
    if json {
        out = dryrun.json_open()
    }
    var first = true
    for spec in cli.requests {
        let p = dryrun.probe_request(spec)
        if !p.input_err.is_empty() {
            eprint("lobo: {p.input_err}")
            return 1
        }
        var tr = http.trace_new()
        var listener = plain_addr
        if p.scheme == "https" {
            listener = tls_addr
        }
        let v = dryrun.decide(c, p, plain_addr, tls_addr, mut tr)
        var tls_line = ""
        if p.scheme == "https" && !tls_addr.is_empty() {
            tls_line = dryrun.tls_note(s, cli.sni)
        }
        var stat_line = ""
        if cli.stat {
            stat_line = dryrun.stat_note(v, p.path)
        }
        if json {
            let obj = dryrun.stanza_json(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                out = "{out}{obj}"
                first = false
            } else {
                out = "{out},{obj}"
            }
        } else {
            let st = dryrun.stanza(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                first = false
            } else {
                print("")
            }
            print_raw(st)
        }
    }
    if json {
        out = "{out}{dryrun.json_close()}"
        print(out)
    }
    0
}

fn main() -> int {
    let cli = shell.parse_cli(env_args())
    if cli.mode == "error" {
        eprint("lobo: {cli.err_msg}")
        return cli.exit_code
    }
    if cli.mode == "banner" {
        banner()
        return 0
    }
    if cli.mode == "version" {
        eprint(shell.version_report())
        return 0
    }
    if cli.mode == "version_verbose" {
        eprint_raw(shell.version_verbose())
        return 0
    }
    if cli.mode == "help" {
        eprint_raw(shell.usage_text())
        return 0
    }
    let gbad = check_globals(cli.globals)
    if gbad != 0 {
        return gbad
    }
    if cli.mode == "check" {
        if cli.requests.len > 0 {
            return dryrun_main(cli)
        }
        return config.check(cli.prefix, cli.conf, false)
    }
    if cli.mode == "dump" {
        return config.check(cli.prefix, cli.conf, true)
    }
    if cli.mode == "docs" {
        print_raw(config.directives_markdown())
        return 0
    }
    if cli.mode == "logvars" {
        print_raw(obs.vars_markdown())
        return 0
    }
    if cli.mode == "signal" {
        return signal_main(cli)
    }
    if cli.mode == "status" {
        return status_main(cli)
    }
    if cli.mode == "cert_status" {
        return cert_status_main(cli)
    }
    if cli.mode == "serve" {
        return serve_main(cli.prefix, cli.conf)
    }
    banner()
    0
}
