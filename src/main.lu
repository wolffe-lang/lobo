//! lobo — a production web server in wolf. Entry file:
//! the operator shell. The CLI grammar, the text builders, the pid
//! lifecycle, the control channel and the reload verbs are shell/'s
//! (ws04); main is the thin dispatch over them plus the acting paths
//! (the drain-aware serve loop, signal-send, and `status`) that wire
//! net/fs to the model and own the per-generation drain bookkeeping
//! (ws08).
//!
//! `main`'s legal shapes are E0414's: no parameters — arguments come
//! through `env_args`, which drops argv[0].
//!
//! The signal split (ws04 §3, FLIPPED at wsm01). The s115 pin carries
//! s114's signal RECEPTION (wolf-lang #126): the server listens for
//! real SIGHUP/SIGTERM/SIGQUIT (the RELOAD/TERMINATE/QUIT meanings)
//! and each received meaning feeds the SAME verb dispatch the control
//! channel drives — the one-layer design ws04 built for exactly this
//! flip. The control channel STAYS
//! (the portable path, and the Windows reload story — [os.signal.
//! platform] names RELOAD/UPGRADE as having no Windows analog). What
//! did NOT land: a getpid surface — so `-s` still SENDS over the
//! control channel and the pid file still records the control
//! endpoint (named residue; a real pid file follows a getpid).
//! Signal delivery is Linux+macOS at the wsm03 pin (s114/s59; other
//! hosts follow the ports); where the listen refuses, the server says
//! so and runs control-channel-only — a named gap, never a fake.
//! ws14, against s60b's landed windows table: there the listen
//! SUCCEEDS (a console handler), CTRL_C/CTRL_CLOSE deliver terminate
//! and CTRL_BREAK quit, and RELOAD never arrives from outside — so
//! the startup notice below names the meanings, not unix signal
//! names, and docs/DRAIN.md carries lobo's windows promise: reload
//! is the control channel's, or nothing (the language has no
//! platform query, so the sentence is documented, not detected).
//!
//! Serve stays SPAWN-FREE (D7, ws04's shape): ONE poll loop
//! multiplexes the http listener, the control channel, the signal
//! queue, and every open connection, each stepped a slice at a time
//! under a short deadline (serve.conn_step) so no single connection
//! blocks the loop. ws16 (D73): with `worker_processes N` (N >= 2)
//! that loop runs N times over, one os process each — a MASTER
//! starts the hands through `os_spawn` and supervises them over
//! per-worker control endpoints (`master_main` below); a hand is
//! `serve_main` with `worker > 0`: no pid file, the master's chosen
//! endpoint, every log line stamped `worker=N`, and a listener it
//! RETRIES rather than dies for (the measured accept-distribution
//! posture at this pin — docs/WORKERS.md). D7 is KEPT inside every
//! process. Signals are polled by SELF-RAISE: each pass
//! raises the UPGRADE meaning as a probe and waits once — the
//! runtime's queue is FIFO, so a real pending SIGHUP/TERM/QUIT comes
//! back BEFORE the probe and the probe bounds the wait (never a
//! park on a signal that may not come). The clean parked-forwarder
//! task ([os.signal.wait]'s intended shape) is blocked at this pin by
//! an upstream release-tier bug — s43's cluster partition follows
//! CALL edges only, so a task-entry shim can land in a different
//! object than its spawner's `func.addr` and the LLVM tier refuses
//! (filed; the corpus-shape witness is tools' probe record). The poll
//! flips to the forwarder the sprint after the fix enters the pin.
//! That is what makes the DRAIN WATCHABLE (ws08): a per-generation live
//! counter in the loop's own bookkeeping lets an operator see an old
//! generation drain — via `lobo status` and log events — while a new one
//! serves. A reloaded-away generation keeps its FROZEN model and its
//! open connections finish on it (the reload-under-load invariant,
//! pinned by the rig). File-header note (F-0016): comments never sit
//! directly above a dotted call.

use acme
use config
use conn
use dryrun
use http
use metrics
use obs
use proxy
use resolver
use serve
use shell
use tls

/// The package version. Matches wolf.pkg; the release ritual (far
/// future) bumps both in one commit. Total; never traps.
fn version() -> str {
    "0.0.1"
}

/// The no-argument banner: identity plus every module's frozen
/// interface version, which is also what keeps each stub import
/// honestly used (E0305).
fn banner() {
    print("lobo {version()} — a web server in wolf")
    let mods = "config {config.version()} · dryrun {dryrun.version()} · http {http.version()} · obs {obs.version()} · proxy {proxy.version()} · serve {serve.version()} · shell {shell.version()}"
    print("modules: {mods}")
}

// ------------------------------------------------------------------
// the control loop's line reader and verb dispatch
// ------------------------------------------------------------------

/// Read one newline-terminated command line from `conn` (bounded — a
/// control peer sends one short verb). Returns the line without the
/// newline. Swallows net trouble into "" (the loop then replies with
/// an error and moves on). Total.
fn read_command(conn: int) -> str {
    var buf = ""
    var reading = true
    while reading {
        let nl = buf.find("\n") else -1
        if nl >= 0 {
            return buf[0..nl].trim()
        }
        if buf.len > 4096 {
            return buf.trim()
        }
        let piece = net_read(conn, 512) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    buf.trim()
}

// ------------------------------------------------------------------
// the generation table (ws08) — the drain you can watch. One row per
// LIVE generation (current + every still-draining old one), each
// carrying its FROZEN model, its live-connection count, its state, and
// the accounting a retirement reports. The counter is here, in the
// poll loop's own bookkeeping — spawn-free, no concurrent tasks (D7 /
// ws04). The table is a local List[GenRow]: a List of an IMPORTED
// struct is refused in the checked tier, but a List of a LOCAL struct
// is fine, so the row type lives here and shell formats it one field at
// a time. Rows are never mutated in place (index-assignment is a
// one-lane shape) — every update REBUILDS the list, which is cheap: a
// server holds a handful of generations, never more.
// ------------------------------------------------------------------

/// One live generation. `state` is "current" (the one accepting new
/// connections) or "draining" (a reloaded-away generation still holding
/// connections). `loaded_ms` is when it was created, `since_ms` when it
/// began draining (0 while current). `drained`/`aborted` accumulate its
/// retirement accounting; `shash` is its content-hash id. ws10: `lim`
/// is the generation's FROZEN effective Limits (fence + budget resolve
/// once at freeze, exactly like the model — a draining generation
/// keeps serving under ITS numbers); `mem_hw` the high-water admitted
/// bytes of any single request it served; `bud_hits` its budget-503
/// count. ws12 adds `mem_rt_hw` — the high-water MEASURED region bytes
/// of any single request it served ([mem.region.account.1], the
/// runtime's own ledger). Two high waters, deliberately: one is the
/// meter's estimate, one is the machine's answer.
struct GenRow {
    conf: config.Conf,
    gen: int,
    live: int,
    state: str,
    loaded_ms: int,
    since_ms: int,
    drained: int,
    aborted: int,
    shash: str,
    lim: http.Limits,
    mem_hw: int,
    mem_rt_hw: int,
    bud_hits: int,
}

/// The generation number of the current (accepting) row, or -1. Total.
fn current_gen(gens: List[GenRow]) -> int {
    for g in gens {
        if g.state == "current" {
            return g.gen
        }
    }
    -1
}

/// The index of the row for `gen`, or -1. Total.
fn index_of(gens: List[GenRow], gen: int) -> int {
    var i: int = 0
    let n = gens.len
    while i < n {
        if gens[i].gen == gen {
            return i
        }
        i = i + 1
    }
    -1
}

/// The frozen model a connection tagged `gen` serves under — full
/// fidelity, so a request arriving on a draining connection routes
/// under the model it was accepted on (the frozen-model discipline,
/// ws04). Falls back to the current row, then to an empty model, for a
/// generation that cannot be found (never happens while it holds a
/// connection — a generation retires only at zero). Total.
fn conf_for(gens: List[GenRow], gen: int) -> config.Conf {
    let i = index_of(gens, gen)
    if i >= 0 {
        return gens[i].conf
    }
    if gens.len > 0 {
        return gens[0].conf
    }
    config.parse_str("http {{\n}}\n", "empty")
}

/// A generation's age in ms in its current role: since load while
/// current, since drain start while draining. Total.
fn gen_age(g: GenRow, now: int) -> int {
    if g.state == "current" {
        return now - g.loaded_ms
    }
    now - g.since_ms
}

/// The worker_shutdown_timeout remaining for a DRAINING generation, or
/// -1 when none applies (a current generation, or no timeout). Clamped
/// at 0. Total.
fn gen_remaining(g: GenRow, shutdown_ms: int, now: int) -> int {
    if g.state != "draining" || shutdown_ms <= 0 {
        return -1
    }
    let rem = shutdown_ms - (now - g.since_ms)
    if rem < 0 {
        return 0
    }
    rem
}

/// Rebuild `gens` with `gen`'s live count changed by `delta`. Total.
fn bump_live(gens: List[GenRow], gen: int, delta: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live + delta,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                mem_rt_hw: g.mem_rt_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// The frozen effective Limits a connection tagged `gen` serves under
/// (the same freeze-and-fall-back rule as conf_for). Total.
fn lim_for(gens: List[GenRow], gen: int) -> http.Limits {
    let i = index_of(gens, gen)
    if i >= 0 {
        return gens[i].lim
    }
    if gens.len > 0 {
        return gens[0].lim
    }
    http.default_limits()
}

/// Fold one served request's budget outcome into its generation's
/// aggregates: raise the high-water mark, count a refusal. Rebuilds
/// only when something changed (the per-request hot path pays a
/// comparison, not a rebuild). Total.
fn note_request(gens: List[GenRow], gen: int, hw: int, rt: int, hit: bool) -> List[GenRow] {
    let i = index_of(gens, gen)
    if i < 0 {
        return gens
    }
    if !hit && hw <= gens[i].mem_hw && rt <= gens[i].mem_rt_hw {
        return gens
    }
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            var nhw = g.mem_hw
            if hw > nhw {
                nhw = hw
            }
            var nrt = g.mem_rt_hw
            if rt > nrt {
                nrt = rt
            }
            var nhits = g.bud_hits
            if hit {
                nhits = nhits + 1
            }
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: nhw,
                mem_rt_hw: nrt,
                bud_hits: nhits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Account one closed connection on `gen`: decrement its live count and,
/// when the generation is DRAINING, tally it (`aborted` on a timeout
/// force-close, else `drained`) and emit `connection-retired`. THE
/// never-negative assertion lives here and stays in every profile
/// (checked-arithmetic spirit — a leak that made a generation immortal
/// would be loud). Returns the rebuilt table. Total unless the
/// invariant breaks (then it traps, by design).
fn on_conn_close(gens: List[GenRow], gen: int, aborted: bool, mut el: ELog) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen {
            let nlive = g.live - 1
            assert(nlive >= 0, "generation {gen} live-connection count went negative")
            var nd = g.drained
            var na = g.aborted
            if g.state == "draining" {
                if aborted {
                    na = na + 1
                } else {
                    nd = nd + 1
                }
                ev_event(mut el, "notice", shell.ev_connection_retired(gen, nlive))
            }
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: nlive,
                state: g.state,
                loaded_ms: g.loaded_ms,
                since_ms: g.since_ms,
                drained: nd,
                aborted: na,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                mem_rt_hw: g.mem_rt_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Retire every DRAINING generation that has reached zero connections:
/// emit `generation-retired` with its accounting and drop it from the
/// table. Total.
fn retire_zero(gens: List[GenRow], now: int, mut el: ELog) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.state == "draining" && g.live == 0 {
            let age = now - g.since_ms
            ev_event(
                mut el,
                "notice",
                shell.ev_generation_retired(g.gen, g.drained, g.aborted, age),
            )
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Begin a reload: mark the current generation draining (as of `now`)
/// and append the freshly frozen `newconf` as the new current
/// generation `newgen`. Total.
fn start_reload(
    gens: List[GenRow],
    curgen: int,
    newconf: config.Conf,
    newgen: int,
    newhash: str,
    now: int,
) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == curgen {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                mem_rt_hw: g.mem_rt_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    let nlim = serve.resolve_limits(newconf)
    (mut out).push(GenRow {
        conf: newconf,
        gen: newgen,
        live: 0,
        state: "current",
        loaded_ms: now,
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: newhash,
        lim: nlim,
        mem_hw: 0,
        mem_rt_hw: 0,
        bud_hits: 0,
    })
    out
}

/// Mark `gen` draining (as of `now`) without creating a successor — the
/// quit path (drain everything, then exit). Total.
fn mark_draining(gens: List[GenRow], gen: int, now: int) -> List[GenRow] {
    var out = List[GenRow]()
    for g in gens {
        if g.gen == gen && g.state == "current" {
            (mut out).push(GenRow {
                conf: g.conf,
                gen: g.gen,
                live: g.live,
                state: "draining",
                loaded_ms: g.loaded_ms,
                since_ms: now,
                drained: g.drained,
                aborted: g.aborted,
                shash: g.shash,
                lim: g.lim,
                mem_hw: g.mem_hw,
                mem_rt_hw: g.mem_rt_hw,
                bud_hits: g.bud_hits,
            })
        } else {
            (mut out).push(g)
        }
    }
    out
}

/// Build the status stanza (contract §1): the generation table with
/// per-generation live counts, ages, ids, and worker_shutdown_timeout
/// remaining, plus the quit posture. `json` selects the versioned
/// single-line JSON (ws07 convention, ws12 reuses it); otherwise the
/// human, one-fact-per-line text. The read races the generation swap by
/// design — a torn read across generations is acceptable and each
/// count is monotone-correct per generation (documented in docs/). The
/// snapshot is one pass over the table reference. Total.
// ------------------------------------------------------------------
// the counters (ws12) — the numbers the exposition serves
//
// They live HERE, as plain ints in the poll loop's frame, and
// src/metrics/metrics.lu's header carries the argument for why that is
// the measured hot-path answer rather than a shortcut: lobo is
// spawn-free (D7), so there is exactly one mutator, and an increment
// is `n = n + 1` on a local — zero allocation, zero synchronisation,
// checked arithmetic. Per-task shards would aggregate one shard; an
// atomic would take a fence no other thread can observe. When the D24
// stepper gives lobo a second serving task, this struct is what moves.
// The per-GENERATION numbers are not here: they live in GenRow, where
// the drain accounting already keeps them, and the renderer reads them
// out. That is deliberate — a generation's counters must die with the
// generation, and a flat process counter cannot do that.
// ------------------------------------------------------------------

/// The process-wide counter block. Rebuilt only by `note_served`, and
/// only by whole-struct replacement, which is how a `var` of this
/// shape stays a set of scalar writes.
struct Counters {
    accepted: int,
    req_2xx: int,
    req_3xx: int,
    req_4xx: int,
    req_5xx: int,
    req_bytes: int,
    resp_bytes: int,
    up_2xx: int,
    up_3xx: int,
    up_4xx: int,
    up_5xx: int,
    up_err: int,
    tls_ok: int,
    tls_refused: int,
    tls_timeout: int,
    tls_io: int,
    dropped: int,
    res_ok: int,
    res_failed: int,
    rdur: metrics.Hist,
    udur: metrics.Hist,
}

/// A zeroed counter block, built ONCE at start (the histograms
/// allocate their slot lists here and never again). Total.
fn counters_new() -> Counters {
    Counters {
        accepted: 0,
        req_2xx: 0,
        req_3xx: 0,
        req_4xx: 0,
        req_5xx: 0,
        req_bytes: 0,
        resp_bytes: 0,
        up_2xx: 0,
        up_3xx: 0,
        up_4xx: 0,
        up_5xx: 0,
        up_err: 0,
        tls_ok: 0,
        tls_refused: 0,
        tls_timeout: 0,
        tls_io: 0,
        dropped: 0,
        res_ok: 0,
        res_failed: 0,
        rdur: metrics.hist_new(),
        udur: metrics.hist_new(),
    }
}

/// The Prometheus status class of a code: 2xx/3xx/4xx/5xx. A code
/// outside those ranges (there are none lobo writes) reads as "5xx" —
/// the class an operator would want an unknown to page as. Total.
fn status_class(code: int) -> str {
    if code >= 500 {
        return "5xx"
    }
    if code >= 400 {
        return "4xx"
    }
    if code >= 300 {
        return "3xx"
    }
    if code >= 200 {
        return "2xx"
    }
    "5xx"
}

/// Fold one finished access record into the counters: the status
/// class, the byte totals, the duration observation, and — when the
/// request was proxied — the upstream leg's class and time. Every
/// write is a scalar add on a local. Total (the histogram's own
/// checked arithmetic traps on an impossible overflow, by design).
fn note_served(mut ct: Counters, a: obs.Access, admitted: int) {
    let cls = status_class(a.status)
    if cls == "2xx" {
        ct.req_2xx = ct.req_2xx + 1
    } else if cls == "3xx" {
        ct.req_3xx = ct.req_3xx + 1
    } else if cls == "4xx" {
        ct.req_4xx = ct.req_4xx + 1
    } else {
        ct.req_5xx = ct.req_5xx + 1
    }
    ct.req_bytes = ct.req_bytes + admitted
    ct.resp_bytes = ct.resp_bytes + a.body_bytes
    metrics.hist_observe(mut ct.rdur, a.req_ms)
    if a.proxied {
        if a.up_status <= 0 {
            ct.up_err = ct.up_err + 1
        } else {
            let ucls = status_class(a.up_status)
            if ucls == "2xx" {
                ct.up_2xx = ct.up_2xx + 1
            } else if ucls == "3xx" {
                ct.up_3xx = ct.up_3xx + 1
            } else if ucls == "4xx" {
                ct.up_4xx = ct.up_4xx + 1
            } else {
                ct.up_5xx = ct.up_5xx + 1
            }
        }
        var ums = a.up_ms
        if ums < 0 {
            ums = 0
        }
        metrics.hist_observe(mut ct.udur, ums)
    }
}

/// THE EXPOSITION. Every line comes from `metrics`' builders, which
/// read the registry — so a family that is not registered cannot be
/// written, a label this call site invented traps in-process, and the
/// `# HELP` text is the same string `docs/metrics.md` carries. The
/// scrape is an ordinary request: it appears in these counters and in
/// the access log on its NEXT scrape, one behind, which is the correct
/// and only honest ordering for a counter that includes itself.
fn render_metrics(ct: Counters, gens: List[GenRow], shutdown_ms: int, events: int, worker: int) -> str {
    let now = time_unix_ms()
    var out = metrics.header("lobo_build_info")
    out = "{out}{metrics.sample1("lobo_build_info", "version", shell.version_token(), 1)}"
    // ws16: WHICH process answered this scrape — 0 for the single
    // process, the hand's ordinal under a master. A scrape reaches one
    // hand at this pin (the one holding the listener); the master's
    // `status` is the sum (docs/WORKERS.md)
    out = "{out}{metrics.header("lobo_worker_id")}"
    out = "{out}{metrics.sample0("lobo_worker_id", worker)}"

    out = "{out}{metrics.header("lobo_config_generation_current")}"
    out = "{out}{metrics.sample0("lobo_config_generation_current", current_gen(gens))}"

    var n_current: int = 0
    var n_draining: int = 0
    for g in gens {
        if g.state == "current" {
            n_current = n_current + 1
        } else {
            n_draining = n_draining + 1
        }
    }
    out = "{out}{metrics.header("lobo_config_generations")}"
    out = "{out}{metrics.sample1("lobo_config_generations", "state", "current", n_current)}"
    out = "{out}{metrics.sample1("lobo_config_generations", "state", "draining", n_draining)}"

    out = "{out}{metrics.header("lobo_config_generation_info")}"
    for g in gens {
        var ks = List[str]()
        (mut ks).push("gen")
        (mut ks).push("id")
        (mut ks).push("state")
        var vs = List[str]()
        (mut vs).push("{g.gen}")
        (mut vs).push(g.shash)
        (mut vs).push(g.state)
        out = "{out}{metrics.sample("lobo_config_generation_info", ks, vs, 1)}"
    }

    out = "{out}{metrics.header("lobo_connections_accepted_total")}"
    out = "{out}{metrics.sample0("lobo_connections_accepted_total", ct.accepted)}"
    out = "{out}{metrics.header("lobo_connections_active")}"
    for g in gens {
        out = "{out}{metrics.sample1("lobo_connections_active", "gen", "{g.gen}", g.live)}"
    }
    out = "{out}{metrics.header("lobo_connections_retired_total")}"
    for g in gens {
        out = "{out}{retired_row(g, "drained", g.drained)}"
        out = "{out}{retired_row(g, "aborted", g.aborted)}"
    }

    out = "{out}{metrics.header("lobo_requests_total")}"
    out = "{out}{metrics.sample1("lobo_requests_total", "class", "2xx", ct.req_2xx)}"
    out = "{out}{metrics.sample1("lobo_requests_total", "class", "3xx", ct.req_3xx)}"
    out = "{out}{metrics.sample1("lobo_requests_total", "class", "4xx", ct.req_4xx)}"
    out = "{out}{metrics.sample1("lobo_requests_total", "class", "5xx", ct.req_5xx)}"
    out = "{out}{metrics.header("lobo_request_bytes_total")}"
    out = "{out}{metrics.sample0("lobo_request_bytes_total", ct.req_bytes)}"
    out = "{out}{metrics.header("lobo_response_bytes_total")}"
    out = "{out}{metrics.sample0("lobo_response_bytes_total", ct.resp_bytes)}"
    out = "{out}{metrics.render_hist("lobo_request_duration_seconds", ct.rdur)}"

    out = "{out}{metrics.header("lobo_upstream_requests_total")}"
    out = "{out}{metrics.sample1("lobo_upstream_requests_total", "class", "2xx", ct.up_2xx)}"
    out = "{out}{metrics.sample1("lobo_upstream_requests_total", "class", "3xx", ct.up_3xx)}"
    out = "{out}{metrics.sample1("lobo_upstream_requests_total", "class", "4xx", ct.up_4xx)}"
    out = "{out}{metrics.sample1("lobo_upstream_requests_total", "class", "5xx", ct.up_5xx)}"
    out = "{out}{metrics.sample1("lobo_upstream_requests_total", "class", "error", ct.up_err)}"
    out = "{out}{metrics.render_hist("lobo_upstream_duration_seconds", ct.udur)}"

    out = "{out}{metrics.header("lobo_tls_handshakes_total")}"
    out = "{out}{metrics.sample0("lobo_tls_handshakes_total", ct.tls_ok)}"
    out = "{out}{metrics.header("lobo_tls_handshake_failures_total")}"
    out = "{out}{metrics.sample1("lobo_tls_handshake_failures_total", "reason", "refused", ct.tls_refused)}"
    out = "{out}{metrics.sample1("lobo_tls_handshake_failures_total", "reason", "timeout", ct.tls_timeout)}"
    out = "{out}{metrics.sample1("lobo_tls_handshake_failures_total", "reason", "io", ct.tls_io)}"

    out = "{out}{metrics.header("lobo_budget_refusals_total")}"
    for g in gens {
        out = "{out}{metrics.sample1("lobo_budget_refusals_total", "gen", "{g.gen}", g.bud_hits)}"
    }
    out = "{out}{metrics.header("lobo_request_admitted_bytes_high_water")}"
    for g in gens {
        out = "{out}{metrics.sample1("lobo_request_admitted_bytes_high_water", "gen", "{g.gen}", g.mem_hw)}"
    }
    out = "{out}{metrics.header("lobo_request_region_bytes_high_water")}"
    for g in gens {
        out = "{out}{metrics.sample1("lobo_request_region_bytes_high_water", "gen", "{g.gen}", g.mem_rt_hw)}"
    }
    out = "{out}{metrics.header("lobo_live_region_bytes")}"
    out = "{out}{metrics.sample0("lobo_live_region_bytes", live_region_bytes())}"
    // ws13: the resolver — both series always present (a fixed
    // two-value label set; the reason lives in the log event)
    out = "{out}{metrics.header("lobo_upstream_resolutions_total")}"
    out = "{out}{metrics.sample1("lobo_upstream_resolutions_total", "result", "ok", ct.res_ok)}"
    out = "{out}{metrics.sample1("lobo_upstream_resolutions_total", "result", "failed", ct.res_failed)}"

    out = "{out}{metrics.header("lobo_log_lines_dropped_total")}"
    out = "{out}{metrics.sample0("lobo_log_lines_dropped_total", ct.dropped)}"
    out = "{out}{metrics.header("lobo_events_total")}"
    out = "{out}{metrics.sample0("lobo_events_total", events)}"
    // `now` and `shutdown_ms` are read by the status object beside
    // this one; the exposition deliberately publishes no wall clock
    // (a scraper stamps its own).
    let _unused = now + shutdown_ms
    out
}

/// One `lobo_connections_retired_total` series. Factored so the
/// two-label ceremony appears once. Total.
fn retired_row(g: GenRow, outcome: str, value: int) -> str {
    var ks = List[str]()
    (mut ks).push("gen")
    (mut ks).push("outcome")
    var vs = List[str]()
    (mut vs).push("{g.gen}")
    (mut vs).push(outcome)
    metrics.sample("lobo_connections_retired_total", ks, vs, value)
}

fn status_stanza(
    gens: List[GenRow],
    shutdown_ms: int,
    quitting: bool,
    json: bool,
    events: int,
    worker: int,
    listening: bool,
    accepted: int,
) -> str {
    let now = time_unix_ms()
    let cur = current_gen(gens)
    // ws12: the process-wide live-region total, read HERE — once per
    // stanza, on the control path, never on the serve path
    // ([mem.region.account.2]). Its value is the runtime's, not an
    // estimate of lobo's.
    let live_bytes = live_region_bytes()
    if json {
        // ws16: a hand's stanza carries `worker` and `listening` ahead
        // of the generations (additive on schema 1); the single
        // process's is unchanged
        var s = if worker > 0 {
            shell.
                status_json_open_worker(
                cur,
                quitting,
                events,
                live_bytes,
                worker,
                listening,
                accepted,
            )
        } else {
            shell.status_json_open(cur, quitting, events, live_bytes)
        }
        var first = true
        for g in gens {
            let sep = if first { "" } else { "," }
            first = false
            let obj = shell.
                status_json_obj(
                g.gen,
                g.state,
                g.live,
                gen_age(g, now),
                g.shash,
                gen_remaining(g, shutdown_ms, now),
                g.mem_hw,
                g.bud_hits,
                g.mem_rt_hw,
            )
            s = "{s}{sep}{obj}"
        }
        return "{s}{shell.status_json_close()}"
    }
    var s = shell.status_head_text(cur, quitting, events, live_bytes)
    if worker > 0 {
        s = "{s}{shell.status_worker_head(worker, listening, accepted)}"
    }
    for g in gens {
        s = "{s}{shell.status_line_text(g.gen, g.live, g.state, gen_age(g, now), g.shash, gen_remaining(g, shutdown_ms, now), g.mem_hw, g.bud_hits, g.mem_rt_hw)}"
    }
    s
}

// ------------------------------------------------------------------
// serve — bind, write the pid file, and run the poll loop
// ------------------------------------------------------------------

/// The serving verb. Loads and freezes the config (generation 1),
/// refuses to start if a live master already holds the pid file
/// (stale-pid detection), writes the pid file (its content is the
/// control endpoint at this pin), then runs the DRAIN-AWARE poll loop
/// (ws08): one spawn-free loop multiplexes the http listener, the
/// control channel, and every open connection, keeping a per-generation
/// live counter so an operator can WATCH an old generation drain while a
/// new one serves. Returns 1 on a config error, a failed bind, or a
/// refused start; the loop runs until `stop`, or until `quit` has
/// drained everything. Loopback only.
/// The bind address of the first `listen ... ssl` directive (the TLS
/// listener; a bare port becomes a loopback bind — loopback-only,
/// forever). "" when no ssl listen exists. Total.
fn ssl_listen_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var has_ssl = false
            var j: int = 0
            while j < nn {
                if c.argp[at + j] == "ssl" {
                    has_ssl = true
                }
                j = j + 1
            }
            if has_ssl && nn >= 1 {
                let a = c.argp[at]
                if a.contains(":") {
                    return a
                }
                return "127.0.0.1:{a}"
            }
        }
        i = i + 1
    }
    ""
}

// ------------------------------------------------------------------
// the log sinks (ws09) — the entry owns the outputs: per-output
// bounded sinks built from the frozen model, pumped once per poll
// pass (emit never blocks; a pass does ONE bounded append per sink),
// cycled by `reopen`, flushed on quit/stop. The rows are LOCAL
// structs over obs values (the checked tier refuses List[<imported
// struct>]() — the GenRow pattern), rebuilt on mutation, never
// index-assigned.
// ------------------------------------------------------------------

/// One access-log output: the sink plus its rendering door (the
/// compat format text + escape mode, or the native JSON line).
struct SinkRow {
    s: obs.Sink,
    json: bool,
    fmttext: str,
    esc: str,
}

/// One finished request awaiting the pass's pump (the local-wrapper
/// List shape).
struct AccRow {
    a: obs.Access,
}

/// The error-log output (`have` false = stderr only, as before ws09).
/// `seq` (ws11) is the vocabulary-event counter: the ordinal stamped
/// onto every frozen-vocabulary event by `ev_event` — 1-based,
/// monotone for the life of the process. It rides HERE (not the sink)
/// so a reload's rebuilt outputs never reset it.
struct ELog {
    s: obs.Sink,
    have: bool,
    json: bool,
    level: str,
    seq: int,
    worker: int,
}

/// A config log path against the prefix (absolute carries). Total.
fn resolve_log_path(prefix: str, p: str) -> str {
    if p.starts_with("/") {
        return p
    }
    "{prefix}/{p}"
}

/// The access-output rows of a frozen model. Total (nothing opens
/// until the first flush). A reload rebuilds — nginx's old workers
/// keep old-config logs, lobo's one process logs through the CURRENT
/// generation's outputs (named delta, docs/LOGGING.md).
fn build_sinks(c: config.Conf, prefix: str) -> List[SinkRow] {
    var out = List[SinkRow]()
    var i: int = 0
    let n = config.access_out_count(c)
    while i < n {
        let path = resolve_log_path(prefix, config.access_out_path(c, i))
        (mut out).push(SinkRow {
            s: obs.sink_new(path, config.access_out_buffer(c, i)),
            json: config.access_out_json(c, i),
            fmttext: config.access_out_fmt(c, i),
            esc: config.access_out_esc(c, i),
        })
        i = i + 1
    }
    out
}

/// The error-log output of a frozen model ("" path = none). `seq`
/// carries the caller's running event count across a rebuild (0 at
/// start; a reload passes the live counter — the stamp never resets).
/// Total.
fn build_elog(c: config.Conf, prefix: str, seq: int, worker: int) -> ELog {
    let p = config.errlog_path(c)
    if p.is_empty() {
        return ELog {
            s: obs.sink_new("", 0),
            have: false,
            json: false,
            level: "error",
            seq: seq,
            worker: worker,
        }
    }
    ELog {
        s: obs.sink_new(resolve_log_path(prefix, p), 0),
        have: true,
        json: config.errlog_json(c),
        level: config.errlog_level(c),
        seq: seq,
        worker: worker,
    }
}

/// The ws09 event seam: STDERR keeps every line exactly as before
/// (the ws02 seam — the rig and the signal witness read it), and the
/// configured error_log receives the level-gated copy in its door's
/// shape (nginx text or JSON lines). ws16: a WORKER stamps every line
/// with the trailing `worker=N` field here — one seam, vocabulary and
/// prose alike, appended after everything (a vocabulary event's `seq`
/// included), so every prefix pin still matches and N hands appending
/// to one file stay separable; the single process stamps nothing.
/// Total (emit never blocks).
fn ev_log(mut el: ELog, level: str, rawbody: str) {
    let body = if el.worker > 0 { shell.ev_worker_field(rawbody, el.worker) } else { rawbody }
    eprint("lobo: [{level}] {body}")
    if el.have && obs.level_passes(level, el.level) {
        let ms = time_unix_ms()
        let line = if el.json { obs.render_error_jsonl(level, body, ms) } else {
            obs.render_error(level, body, ms)
        }
        obs.sink_emit(mut el.s, line)
    }
}

/// The ws11 vocabulary seam: a FROZEN-vocabulary event goes through
/// here, which stamps the next `seq` ordinal (shell.ev_seq — appended,
/// nothing renamed) and emits through `ev_log` as ever. Prose notices
/// keep calling `ev_log` directly and are never stamped: the seq
/// stream is the vocabulary stream, the loop's own event order made
/// quotable in a bug report (docs/REPLAY.md). Total.
fn ev_event(mut el: ELog, level: str, body: str) {
    el.seq = el.seq + 1
    ev_log(mut el, level, shell.ev_seq(body, el.seq))
}

/// Pump the access sinks: render this pass's records through each
/// output's door, one bounded flush per sink, drops reported LOUDLY
/// through the event seam. Returns the rebuilt rows. fs tier.
fn pump_sinks(rows: List[SinkRow], accs: List[AccRow], optin: str, mut el: ELog) -> List[SinkRow] {
    var out = List[SinkRow]()
    for r in rows {
        var sk = r.s
        if accs.len > 0 {
            let f = obs.compile(r.fmttext)
            for ar in accs {
                let line = if r.json { obs.render_access_jsonl(ar.a, optin.words()) } else {
                    obs.render_access(f, ar.a, r.esc)
                }
                obs.sink_emit(mut sk, line)
            }
        }
        let _ = obs.sink_flush(mut sk)
        let note = obs.sink_drop_note(mut sk)
        if !note.is_empty() {
            ev_log(mut el, "warn", note)
        }
        (mut out).push(SinkRow { s: sk, json: r.json, fmttext: r.fmttext, esc: r.esc })
    }
    out
}

/// Flush the error-log sink (its own drop note goes to stderr only —
/// never recurse into the seam that overflowed). fs tier.
fn flush_elog(el: ELog) -> ELog {
    var sk = el.s
    if el.have {
        let _ = obs.sink_flush(mut sk)
        let note = obs.sink_drop_note(mut sk)
        if !note.is_empty() {
            eprint("lobo: [warn] {note}")
        }
    }
    ELog { s: sk, have: el.have, json: el.json, level: el.level, seq: el.seq, worker: el.worker }
}

/// Close every access output (flushing first) so the NEXT flush
/// reopens at the configured paths — the `reopen` verb's action, and
/// the quit path's final flush. Returns the rebuilt rows. fs tier.
fn reopen_sinks(rows: List[SinkRow]) -> List[SinkRow] {
    var out = List[SinkRow]()
    for r in rows {
        var sk = r.s
        obs.sink_reopen(mut sk)
        (mut out).push(SinkRow { s: sk, json: r.json, fmttext: r.fmttext, esc: r.esc })
    }
    out
}

/// The error-log twin of reopen_sinks. fs tier.
fn reopen_elog(el: ELog) -> ELog {
    var sk = el.s
    if el.have {
        obs.sink_reopen(mut sk)
    }
    ELog { s: sk, have: el.have, json: el.json, level: el.level, seq: el.seq, worker: el.worker }
}

fn serve_main(prefix: str, conf: str, worker: int, wctrl: str, inherit: int, hands: int) -> int {
    let c0 = config.load(prefix, conf)
    if !config.ok(c0) {
        eprint("lobo: [emerg] configuration file {conf} test failed")
        return 1
    }
    // ws16: a HAND takes its control endpoint from the master's argv
    // (the config's `control` is the master's) and never touches the
    // pid file (the master's rendezvous)
    let ctrl = if worker > 0 { wctrl } else { shell.control_addr(c0) }
    let pidp = shell.pid_path(c0, prefix)

    // stale-pid detection: an existing pid file whose endpoint is
    // alive means a master is already running (refuse, nginx-shaped);
    // a dead endpoint is a stale file (replace with a warning).
    let existing = if worker > 0 { "" } else { shell.pid_read(pidp) else |_| "" }
    if !existing.is_empty() {
        if shell.control_alive(existing) {
            eprint("lobo: [emerg] a lobo master is already running (control {existing})")
            return 1
        }
        eprint(
            "lobo: [warn] removing stale pid file \"{pidp}\" (control {existing} not responding)",
        )
    }

    // the plaintext listener binds the first NON-ssl listen; a config
    // whose only listen carries `ssl` has no plaintext socket (the
    // TLS-only server). `hport` is the port a directory redirect's
    // absolute Location uses — the plaintext port when there is one,
    // else the TLS port (set below).
    let addr = serve.listen_addr_plain(c0)
    let want_http = !addr.is_empty()
    var have_http = false
    var hl: int = 0
    var hport: int = 0
    // ws16: a hand whose bind FAILS stands by rather than dying — at
    // this pin another hand holds the port (no SO_REUSEPORT, no
    // inheritance: wolf-lang#234/#235) and the loop below retries
    // every pass, taking the listener the moment its holder is gone.
    // The single process keeps refusing at once (a bind that fails
    // with no sibling is an operator's error, said out loud).
    var standby_http = false
    // ws17: a hand with `--inherit N` does not BIND — the master bound
    // the socket and `os_spawn_with` handed it down as descriptor 3
    // (then 4), in the config's own order: plaintext first, then TLS.
    // The numbering is `[os.proc.inherit]`'s contract, so the ordinal
    // is derived, never told. Every hand accepting on ONE socket is
    // what makes the kernel's accept queue distribute the work — the
    // nginx shape, reachable at this pin for the first time.
    // `next_fd` walks the positions the master actually handed.
    var next_fd = 3
    let adopting = inherit > 0
    if want_http {
        var bound = true
        var cand: int = 0
        if adopting {
            cand = net_adopt_listener(next_fd) else |e| match e {
                unsupported => {
                    bound = false
                    0
                },
                io => {
                    bound = false
                    0
                },
            }
            next_fd = next_fd + 1
        } else {
            cand = net_listen(addr) else |_| {
                bound = false
                0
            }
        }
        if bound {
            hl = cand
            arm_accept(hl)
            hport = net_port(hl) else |_| {
                eprint("lobo: [emerg] could not read the listen port")
                return 1
            }
            have_http = true
        } else if worker > 0 {
            // the adopt failed (a host that refuses it by name, or a
            // number the kernel did not answer for) — fall back to
            // ws16's bind-and-stand-by shape rather than die, and say
            // which posture this hand is in
            if adopting {
                eprint(
                    "lobo: [notice] worker {worker}: net_adopt_listener refused the inherited plaintext listener — standing by on a bind of {addr} instead (docs/WORKERS.md)",
                )
            }
            standby_http = true
        } else {
            eprint("lobo: [emerg] bind() to {addr} failed")
            return 1
        }
    }

    // ws05: the TLS listener. `listen ... ssl` opens a second socket;
    // the SslConf (certs, keys, SNI table) is resolved and FROZEN per
    // generation beside the Conf (the same freeze-and-swap the model
    // rides — a reload rebuilds it, cert-reload atomicity for free).
    // TLS connections are served BLOCKING to completion in the poll
    // loop below. The upstream gate retired at the wsm02 pin
    // (wolf-lang#144 fixed: a List row mixing bool/int/List — the
    // Sess shape — now tiles on the native tier, probed at wsm02
    // including an imported-struct field); what remains is lobo's own
    // work — a Conn-based conn_step (serve_request re-plumbed over
    // the conn seam), a session-carrying row table, and a TLS-holder
    // drain witness — a NAMED follow-on rider (ledger D24), the
    // least critical of wsm02's three retirements. The plaintext
    // drain is untouched.
    var have_tls = false
    var tls_l: int = 0
    var ssl0 = config.ssl_resolve(c0, prefix)
    let tls_addr = ssl_listen_addr(c0)
    let want_tls = !tls_addr.is_empty()
    var standby_tls = false
    if !tls_addr.is_empty() {
        if !config.ssl_ok(ssl0) {
            eprint("lobo: [emerg] TLS configuration invalid: {ssl0.err}")
            return 1
        }
        // wsm02 entropy probe (s118): TLS session keys come from
        // os_random, which has no error row and never falls back — a
        // host whose CSPRNG cannot serve TRAPS. Draw once HERE so an
        // entropy-less host dies loudly at startup, never
        // mid-handshake. The probe bytes are discarded (never logged,
        // never reused); every handshake draws its own fresh bytes.
        if os_random(32).len != 32 {
            eprint("lobo: [emerg] entropy probe short (impossible per [os.random])")
            return 1
        }
        var tbound = true
        var tcand: int = 0
        if adopting {
            tcand = net_adopt_listener(next_fd) else |e| match e {
                unsupported => {
                    tbound = false
                    0
                },
                io => {
                    tbound = false
                    0
                },
            }
            next_fd = next_fd + 1
        } else {
            tcand = net_listen(tls_addr) else |_| {
                tbound = false
                0
            }
        }
        if tbound {
            tls_l = tcand
            arm_accept(tls_l)
            let tport = net_port(tls_l) else |_| {
                return 1
            }
            if !have_http {
                hport = tport
            }
            have_tls = true
            eprint(
                "lobo: [notice] TLS serving on {tls_addr} (port {tport}); TLS 1.3, TLS_CHACHA20_POLY1305_SHA256, certificate entries loaded: {ssl0.names.len}",
            )
        } else if worker > 0 {
            if adopting {
                eprint(
                    "lobo: [notice] worker {worker}: net_adopt_listener refused the inherited TLS listener — standing by on a bind of {tls_addr} instead (docs/WORKERS.md)",
                )
            }
            standby_tls = true
        } else {
            eprint("lobo: [emerg] bind() to TLS {tls_addr} failed")
            return 1
        }
    }

    // the control endpoint is what the pid file records (so -s and the
    // next start's stale-check can reach us). No control directive →
    // no channel; the pid file still records the http addr as identity.
    var have_ctrl = false
    var cl: int = 0
    var ctrl_ep = addr
    // ws15: the endpoint's optional second auth arm — a shared secret
    // READ from an operator-owned file (never written: std has no
    // permission surface at this pin, wolf-std#5, so a token lobo
    // generated would land at the umask's mode). A config that names
    // a token file lobo cannot read refuses HERE, at startup, rather
    // than serving an endpoint whose auth silently does nothing.
    var ctok = ""
    if !ctrl.is_empty() {
        let tokp = shell.control_token_path(c0, prefix)
        if !tokp.is_empty() {
            ctok = shell.control_token_read(tokp) else |e| match e {
                none => {
                    eprint(
                        "lobo: [emerg] control token file \"{tokp}\" does not exist (create it with the mode you want — lobo reads it, never writes it)",
                    )
                    return 1
                },
                io => {
                    eprint("lobo: [emerg] control token file \"{tokp}\" could not be read")
                    return 1
                },
            }
            if ctok.is_empty() {
                eprint("lobo: [emerg] control token file \"{tokp}\" is empty")
                return 1
            }
        }
        let cb = bind_control(ctrl)
        if cb.0 < 0 {
            eprint("lobo: [emerg] {cb.1}")
            return 1
        }
        cl = cb.0
        ctrl_ep = cb.1
        have_ctrl = true
    }

    if worker == 0 {
        shell.pid_write(pidp, ctrl_ep) else |_| {
            eprint("lobo: [emerg] could not write pid file \"{pidp}\"")
            return 1
        }
    }

    // ws12: the metrics switch, resolved once at start with every
    // other ServerOpts knob. HONEST LIMIT, named rather than implied:
    // ServerOpts is process-wide, not per-generation — `token`,
    // `keepalive_*`, `challenge_dir` and now `metrics_on` are all
    // start-time, so a reload that FLIPS the endpoint on or off does
    // not take effect until a restart. Only `lim` (ws10) and the
    // config model itself freeze per generation. Making the whole of
    // ServerOpts a per-generation freeze is one rework of its own and
    // is routed as such in the wsc03 closeout; nothing here pretends
    // otherwise.
    let d0 = serve.default_opts()
    // ws13: the self-pipe a budgeted request's body proc reports
    // through (docs/BUDGET.md, "what comes back"); a host that
    // refuses a loopback pair runs without one, said out loud
    var pipe_w = -1
    var pipe_r = -1
    let sp = serve.open_self_pipe() else |_| {
        eprint(
            "lobo: [warn] no loopback self-pipe: budgeted requests still enforce the cap, but the measured region bytes stay inside the body proc (mem-rt-hw reads 0 for them)",
        )
        (-1, -1)
    }
    pipe_w = sp.0
    pipe_r = sp.1
    var opts = serve.ServerOpts {
        token: d0.token,
        keepalive_timeout_ms: d0.keepalive_timeout_ms,
        keepalive_requests: d0.keepalive_requests,
        read_timeout_ms: d0.read_timeout_ms,
        challenge_dir: d0.challenge_dir,
        metrics_on: config.metrics_on(c0),
        pipe_w: pipe_w,
        pipe_r: pipe_r,
    }
    // ws10: the effective Limits (fence + budget) freeze PER
    // GENERATION beside the model — resolved here for gen 1, by
    // start_reload for successors, and read back per connection
    // through lim_for (a draining generation keeps serving under ITS
    // numbers, the frozen-model discipline).
    let lim1 = serve.resolve_limits(c0)
    let shutdown_ms = shell.shutdown_timeout_ms(c0)

    // ws09: the log outputs — per-output bounded sinks off the frozen
    // model (nothing opens until the first flush), the error-log
    // mirror (stderr keeps every line — the ws02 seam the rig reads),
    // and the JSON door's header opt-in list.
    var asinks = build_sinks(c0, prefix)
    var elog = build_elog(c0, prefix, 0, worker)
    // ws12: the counter block, allocated ONCE (the histograms' slot
    // lists are built here and never again — an observation is an
    // index write, never an allocation)
    var counters = counters_new()
    var optin = config.log_headers_join(c0)

    // ws06: the ACME renewal daemon. When `cert auto` is on, arm the
    // challenge webroot (the http-01 route serves from it) and build
    // the issuance flow, ticked spawn-free in the poll loop below. The
    // flow is entirely async to the accept path — a server with `cert
    // auto` and no cert yet serves the challenge and the pending-TLS
    // posture ssl_resolve set (the never-block-serving pitfall).
    var have_auto = config.auto_on(c0)
    var chall_dir = ""
    if have_auto {
        chall_dir = config.auto_challenge_dir(c0, prefix)
        fs_create_dir_all(chall_dir) else |_| {}
        opts = serve.ServerOpts {
            token: opts.token,
            keepalive_timeout_ms: opts.keepalive_timeout_ms,
            keepalive_requests: opts.keepalive_requests,
            read_timeout_ms: opts.read_timeout_ms,
            challenge_dir: chall_dir,
            metrics_on: opts.metrics_on,
            pipe_w: opts.pipe_w,
            pipe_r: opts.pipe_r,
        }
    }
    let auto_primary = config.auto_primary(c0)
    var flow = acme.
        flow_new(
        config.auto_store(c0, prefix),
        config.auto_names(c0),
        config.auto_contact(c0),
        config.auto_ca(c0),
        config.auto_ca_root(c0),
        config.auto_renew_before_s(c0),
        config.auto_check_interval_s(c0),
    )
    // announce the BOUND plaintext port (not the configured addr,
    // which may carry :0) so a client — the ACME challenge dial-back
    // included — can find the http listener. The TLS notice already
    // prints its bound port.
    let where = if have_http { "127.0.0.1:{hport} (port {hport})" } else if standby_http {
        "STANDBY for {addr} (held by another worker — retrying each pass; wolf-lang#234/#235, docs/WORKERS.md)"
    } else {
        "(no plaintext listener)"
    }
    // ws17: what actually authorizes this endpoint. A unix socket is a
    // uid boundary by its directory's permissions; a loopback port is
    // not one at all, and the notice has always said which.
    let ctrl_auth = if !have_ctrl { "off" } else if shell.is_unix_addr(ctrl_ep) {
        if ctok.is_empty() { "socket permissions" } else { "socket permissions + token" }
    } else if ctok.is_empty() {
        "loopback only"
    } else {
        "loopback + token"
    }
    ev_log(
        mut elog,
        "notice",
        "serving on {where}, control {ctrl_ep} (auth: {ctrl_auth}), pid file {pidp}",
    )

    // signal reception (wsm01, s114 in the pin): register interest in
    // RELOAD|TERMINATE|QUIT by MEANING, plus the probe bit (UPGRADE —
    // the self-raise poll below). Where delivery is not wired (s114 is
    // Linux-full; non-Linux follows the task-layer port) the listen
    // answers `io` and the control channel stays the only trigger —
    // the NAMED platform gap, said out loud at startup.
    let sprobe = shell.sig_probe()
    var sig_on = true
    os_signal_listen(shell.sig_mask() + sprobe) else |_| {
        sig_on = false
    }
    if sig_on {
        ev_log(
            mut elog,
            "notice",
            "signal reception armed by meaning (reload, terminate=stop, quit): unix HUP/TERM/QUIT; windows CTRL_C/CTRL_CLOSE=terminate, CTRL_BREAK=quit, no external reload — there the control channel is reload's only trigger ([os.signal.platform])",
        )
    } else {
        ev_log(
            mut elog,
            "notice",
            "signal reception unavailable on this platform; the control channel is the trigger",
        )
    }

    // generation 1 is current
    let h1 = shell.conf_hash(c0)
    var gens = List[GenRow]()
    (mut gens).push(GenRow {
        conf: c0,
        gen: 1,
        live: 0,
        state: "current",
        loaded_ms: time_unix_ms(),
        since_ms: 0,
        drained: 0,
        aborted: 0,
        shash: h1,
        lim: lim1,
        mem_hw: 0,
        mem_rt_hw: 0,
        bud_hits: 0,
    })
    ev_event(mut elog, "notice", shell.ev_generation_loaded(1, h1))
    ev_event(mut elog, "notice", shell.ev_generation_activated(1))

    // the connection table (parallel primitive lists — a List of a
    // local/primitive type constructs on every lane; rebuilt each pass)
    var cfds = List[int]()
    var cgens = List[int]()
    var ccarry = List[str]()
    var cserved = List[int]()
    var cidle = List[int]()
    var cstart = List[int]()
    // ws13: the name a connection is PARKED on ("" = not parked): the
    // loop skips its step until the resolver settles that name
    var cwait = List[str]()

    // ws13: the resolver — the cache and the pending query table the
    // loop ticks once per pass like every other socket it owns
    var rs = resolver.new()

    var running = true
    var quitting = false
    while running {
        let now = time_unix_ms()

        // 0a. ws16: a standing-by hand retries its bind — the failover
        // half of this pin's accept-distribution posture (the holder
        // died: the port is free within its kernel teardown, and the
        // first hand to retry serves)
        if standby_http && running && !quitting && !adopting {
            var got = true
            let cand = net_listen(addr) else |_| {
                got = false
                0
            }
            if got {
                hl = cand
                arm_accept(hl)
                hport = net_port(hl) else |_| { 0 }
                have_http = true
                standby_http = false
                ev_log(mut elog, "notice", "listener {addr} acquired (port {hport}) — serving")
            }
        }
        if standby_tls && running && !quitting && !adopting {
            var tgot = true
            let tcand = net_listen(tls_addr) else |_| {
                tgot = false
                0
            }
            if tgot {
                tls_l = tcand
                arm_accept(tls_l)
                let tport = net_port(tls_l) else |_| { 0 }
                if !have_http {
                    hport = tport
                }
                have_tls = true
                standby_tls = false
                ev_log(
                    mut elog,
                    "notice",
                    "TLS listener {tls_addr} acquired (port {tport}) — serving",
                )
            }
        }
        let listening = (!want_http || have_http) && (!want_tls || have_tls)

        // 0a2. ws17: THE WAIT. One `net_wait` over every socket this
        // process owns — the control listener, the http listener, the
        // TLS listener and every open connection that is not parked on
        // a name — replaces the deadline ws16 armed on each of them
        // (25 ms in the control accept, 25 in each listener's, 12 per
        // connection, every idle pass: wolf-lang#127's customer report
        // was this loop). Readiness is level-triggered, so asking
        // consumes nothing and a socket this pass declines to service
        // is still ready next pass; an EMPTY answer is the deadline
        // expiring with nothing ready, which is an ANSWER and not a
        // failure ([os.net.wait]) — the loop falls through and does
        // its timer work. A peer that closed reads as READY: the
        // `net_read` behind it is what reports `closed`, which is how
        // a connection leaves the table instead of being parked on.
        var wfds = List[int]()
        if have_ctrl {
            (mut wfds).push(cl)
        }
        // ws17: the listener joins the wait set only on this hand's
        // ACCEPT TURN (shell.accept_turn — nginx's accept_mutex without
        // a mutex; the clause there carries the measured reason). A
        // single process and a hand whose siblings are gone always
        // have the turn.
        let myturn = shell.accept_turn(worker, hands, now)
        if have_http && running && !quitting && myturn {
            (mut wfds).push(hl)
        }
        if have_tls && running && !quitting && myturn {
            (mut wfds).push(tls_l)
        }
        var wi: int = 0
        var parked = false
        while wi < cfds.len {
            if cwait[wi].is_empty() {
                (mut wfds).push(cfds[wi])
            } else {
                parked = true
            }
            wi = wi + 1
        }
        var wms = wait_budget(sig_on, parked)
        if have_http || have_tls {
            wms = shell.accept_wait_ms(worker, hands, now, wms)
        }
        var ready = List[int]()
        if wfds.len > 0 {
            ready = net_wait(wfds, wms) else |_| {
                List[int]()
            }
        } else {
            // nothing to wait ON (a standing-by hand with no endpoint,
            // or a wound-down loop): the pass still has to end, and
            // `net_wait` refuses an empty set with an unbounded
            // deadline by name — `time_sleep_ms` is the call that
            // means to sleep, and the clause says so.
            time_sleep_ms(wms)
        }

        // 0. ws13: one resolver pass — every pending query socket
        // gets a 1 ms read under its deadline; settled names become
        // vocabulary events through the ws09 seam (stamped seq=) and
        // counter movement
        resolver.tick(mut rs, now)
        let revs = resolver.take_events(mut rs)
        var ri: int = 0
        while ri < revs.len {
            let body = revs[ri]
            if body.starts_with("upstream-resolved ") {
                counters.res_ok = counters.res_ok + 1
                ev_event(mut elog, "notice", body)
            } else {
                counters.res_failed = counters.res_failed + 1
                ev_event(mut elog, "error", body)
            }
            ri = ri + 1
        }

        // 1. collect ONE trigger for the verb dispatch: a control-
        // channel line (with a reply socket) or a received signal
        // (reply-less; a real SIGHUP lands here). Both flow through
        // the SAME dispatch below — ws04's one-layer design,
        // flipped real by s114. A control verb wins the pass; a
        // signal waits buffered for the next pass, so neither is
        // lost.
        var verb = ""
        var cc = -1
        var denied = false
        if have_ctrl && ready_has(ready, cl) {
            var got_ctrl = true
            let cand = net_accept(cl) else |_| {
                got_ctrl = false
                0
            }
            if got_ctrl {
                cc = cand
                net_deadline(cc, 2000) else |_| {}
                let line = read_command(cc)
                if shell.control_authorized(line, ctok) {
                    verb = shell.control_verb_of(line, ctok)
                } else {
                    denied = true
                }
            }
        }
        // an unauthorized line dispatches NOTHING and emits no
        // vocabulary event — the refusal is a prose notice at `warn`,
        // so the frozen event stream stays the stream of decisions the
        // loop actually took (docs/CONTROL.md)
        if denied {
            ev_log(mut elog, "warn", "control: unauthorized command rejected")
            reply(cc, "unauthorized\n")
            net_close(cc) else |_| {}
            cc = -1
        }
        if sig_on && cc < 0 {
            // The self-raise poll: enqueue the probe meaning, then
            // wait ONCE. The runtime queue is FIFO, so a real
            // pending signal comes back before the probe and the
            // probe bounds the wait — a spawn-free, non-blocking
            // signal check (see the header note; flips to the
            // parked forwarder when the upstream cluster fix
            // lands). A failed raise skips the wait: without a
            // probe in the queue the wait could park forever.
            var m = 0
            os_signal_raise(sprobe) else |_| {
                m = -1
            }
            if m == 0 {
                m = os_signal_wait(shell.sig_mask() + sprobe) else |_| { sprobe }
            }
            if m > 0 && m != sprobe {
                verb = shell.signal_verb(m)
            }
        }
        if cc >= 0 || !verb.is_empty() {
            let curgen = current_gen(gens)
            // ws15: ONE emission site for the trigger event, reached
            // by BOTH doors. A control verb and a real signal run the
            // same dispatch below, so the vocabulary line — and every
            // generation event that follows it — is byte-identical
            // but for `source`. The verbs with no signal twin
            // (status, reopen, ping, upgrade) emit nothing: `sig`'s
            // value set stays the frozen reload|terminate|quit.
            let mtrig = shell.signal_meaning(verb)
            if mtrig > 0 {
                let src = if cc >= 0 { "control" } else { "signal" }
                ev_event(mut elog, "notice", shell.ev_signal_received(mtrig, src))
            }
            if verb == "ping" {
                reply(cc, "pong\n")
            } else if verb == "status" {
                let body = status_stanza(
                    gens,
                    shutdown_ms,
                    quitting,
                    false,
                    elog.seq,
                    worker,
                    listening,
                    counters.accepted,
                )
                reply(cc, "{body}\n")
            } else if verb == "status json" {
                let body = status_stanza(
                    gens,
                    shutdown_ms,
                    quitting,
                    true,
                    elog.seq,
                    worker,
                    listening,
                    counters.accepted,
                )
                reply(cc, "{body}\n")
            } else if verb == "stop" {
                reply(cc, "stop: shutting down (generation {curgen})\n")
                running = false
            } else if verb == "quit" {
                reply(cc, "quit: draining then exiting (generation {curgen})\n")
                quitting = true
                let held = held_of(gens, curgen)
                gens = mark_draining(gens, curgen, now)
                ev_event(mut elog, "notice", shell.ev_generation_draining(curgen, held))
                gens = retire_zero(gens, now, mut elog)
            } else if verb == "reopen" {
                asinks = reopen_sinks(asinks)
                elog = reopen_elog(elog)
                ev_log(mut elog, "notice", "reopening log files")
                reply(cc, "reopen: log outputs cycled (generation {curgen})\n")
            } else if verb == "reload" {
                let ci = index_of(gens, curgen)
                let prev = shell.Gen {
                    conf: copy gens[ci].conf,
                    gen: curgen,
                    ok: true,
                    note: "",
                }
                let ng = shell.reload(prefix, conf, prev)
                if ng.ok && ng.gen > curgen {
                    let held = gens[ci].live
                    let nhash = shell.conf_hash(ng.conf)
                    // cert-reload atomicity (ws05): rebuild the frozen
                    // SslConf from the new model. ssl_resolve validates
                    // the PAIR; a reload whose certs fail keeps serving
                    // (the ng.ok gate already held the config valid, and
                    // TLS conns are served to completion, so in-flight
                    // ones finish under the old cert — the ws04 rule).
                    let nssl = config.ssl_resolve(ng.conf, prefix)
                    if config.ssl_ok(nssl) {
                        ssl0 = nssl
                    } else {
                        eprint(
                            "lobo: [error] reloaded config has invalid TLS ({nssl.err}); keeping the previous certificates",
                        )
                    }
                    gens = start_reload(gens, curgen, ng.conf, ng.gen, nhash, now)
                    ev_event(mut elog, "notice", shell.ev_generation_draining(curgen, held))
                    ev_event(mut elog, "notice", shell.ev_generation_loaded(ng.gen, nhash))
                    ev_event(mut elog, "notice", shell.ev_generation_activated(ng.gen))
                    gens = retire_zero(gens, now, mut elog)
                    // ws09: the log outputs follow the CURRENT
                    // generation (named delta — nginx's old workers
                    // keep old-config logs; lobo's one process logs
                    // through the live model's outputs)
                    asinks = reopen_sinks(asinks)
                    asinks = build_sinks(ng.conf, prefix)
                    elog = reopen_elog(elog)
                    elog = build_elog(ng.conf, prefix, elog.seq, worker)
                    optin = config.log_headers_join(ng.conf)
                }
                reply(cc, "{ng.note}\n")
            } else if verb == "upgrade" {
                // ws15: the binary-swap verb EXISTS on the endpoint
                // and answers by name. It is unclaimed on every
                // platform at this pin — and it is the one verb the
                // control channel reaches that no signal does: on
                // unix UPGRADE's bit is lobo's own poll probe (an
                // outside SIGUSR2 is indistinguishable from it), and
                // on windows RELOAD/UPGRADE have no analog at all
                // ([os.signal.platform]). Naming it here is what
                // makes the endpoint the place it will land.
                reply(
                    cc,
                    "upgrade: not implemented at this pin — the binary-swap verb is unclaimed on every platform; when it lands it lands HERE, on the control endpoint (docs/CONTROL.md)\n",
                )
            } else {
                reply(cc, "unknown verb \"{verb}\"\n")
            }
            if cc >= 0 {
                net_close(cc) else |_| {}
            }
        }

        // 2. accept a new http connection (unless winding down) — it is
        // tagged with the CURRENT generation and bumps that counter
        if have_http &&
            running &&
            !quitting &&
            myturn &&
            shell.accept_turn(worker, hands, time_unix_ms()) &&
            ready_has(ready, hl) {
            // ws17: DRAIN the accept queue while the turn is ours,
            // bounded. One accept per pass was ws16's shape and it is
            // what held a connection-per-request load to one accept
            // per poll; with the turn in hand no sibling can take the
            // queue out from under us, so the honest thing is to take
            // what is there. Every accept after the first is guarded
            // by a ZERO-deadline `net_wait` on the listener alone —
            // the ask that cannot block ([os.net.wait]) — so the loop
            // never reaches an accept the kernel has nothing for,
            // which is the syscall that would park
            // (shell.accept_turn's note).
            var burst: int = 0
            var draining = true
            var probe = List[int]()
            (mut probe).push(hl)
            while draining && burst < 64 {
                if burst > 0 {
                    let again = net_wait(probe, 0) else |_| {
                        List[int]()
                    }
                    if again.len == 0 {
                        draining = false
                        continue
                    }
                }
                var got_conn = true
                let conn = net_accept(hl) else |_| {
                    got_conn = false
                    0
                }
                if !got_conn {
                    draining = false
                    continue
                }
                let curgen = current_gen(gens)
                counters.accepted = counters.accepted + 1
                gens = bump_live(gens, curgen, 1)
                (mut cfds).push(conn)
                (mut cgens).push(curgen)
                (mut ccarry).push("")
                (mut cserved).push(0)
                (mut cidle).push(now)
                (mut cstart).push(now)
                (mut cwait).push("")
                burst = burst + 1
            }
        }

        // 2b. TLS: accept and serve BLOCKING to completion (ws05).
        // A TLS connection is handshaked and served here, start to
        // finish, under the current generation's frozen SslConf. It is
        // tagged to the current gen for the live counter (a reload
        // while a TLS conn serves waits for it — acceptable on
        // loopback). The #144 layout gate retired at the wsm02 pin;
        // joining the drain table is now lobo's own stepper refactor,
        // the NAMED D24 rider (see the listener comment above). A
        // stalled handshake is bounded by the read deadline, never a
        // hang.
        if have_tls &&
            running &&
            !quitting &&
            myturn &&
            shell.accept_turn(worker, hands, time_unix_ms()) &&
            ready_has(ready, tls_l) {
            var got_tls = true
            let tconn = net_accept(tls_l) else |_| {
                got_tls = false
                0
            }
            if got_tls {
                let tgen = current_gen(gens)
                gens = bump_live(gens, tgen, 1)
                let tconf = conf_for(gens, tgen)
                var aborted_t = false
                counters.accepted = counters.accepted + 1
                var z = tls.accept(tconn, ssl0, opts.read_timeout_ms) else |e| match e {
                    refused => {
                        aborted_t = true
                        counters.tls_refused = counters.tls_refused + 1
                        tls.no_sess()
                    },
                    timeout => {
                        aborted_t = true
                        counters.tls_timeout = counters.tls_timeout + 1
                        tls.no_sess()
                    },
                    io => {
                        aborted_t = true
                        counters.tls_io = counters.tls_io + 1
                        tls.no_sess()
                    },
                }
                if aborted_t {
                    net_close(tconn) else |_| {}
                } else {
                    counters.tls_ok = counters.tls_ok + 1
                    var tcn = conn.tls_conn(tconn, z)
                    serve.serve_conn_cn(mut tcn, tconf, opts, lim_for(gens, tgen), hport, mut rs)
                }
                gens = on_conn_close(gens, tgen, false, mut elog)
            }
        }

        // 3. give every open connection ONE short poll step, rebuilding
        // the table without the ones that finished. A close decrements
        // the owning generation; a draining generation past its
        // worker_shutdown_timeout has its remainder aborted.
        var nfds = List[int]()
        var ngens = List[int]()
        var ncarry = List[str]()
        var nserved = List[int]()
        var nidle = List[int]()
        var ncstart = List[int]()
        var nwait = List[str]()
        var pass_accs = List[AccRow]()
        var k: int = 0
        let ktot = cfds.len
        while k < ktot {
            let fd = cfds[k]
            let cg = cgens[k]
            let car = ccarry[k]
            let sv = cserved[k]
            let idle0 = cidle[k]
            let cs0 = cstart[k]
            let waiting = cwait[k]
            // ws13: a PARKED connection is not stepped while its name
            // is still in flight — the row rides forward untouched
            // (its idle clock too: waiting on the resolver is work,
            // not idleness; resolver_timeout bounds it)
            if !waiting.is_empty() && resolver.is_pending(rs, waiting) {
                (mut nfds).push(fd)
                (mut ngens).push(cg)
                (mut ncarry).push(car)
                (mut nserved).push(sv)
                (mut nidle).push(now)
                (mut ncstart).push(cs0)
                (mut nwait).push(waiting)
                k = k + 1
                continue
            }
            let cconf = conf_for(gens, cg)
            // ws17: a connection is STEPPED only when the wait named
            // it. A socket the poll did not name has nothing to read,
            // so ws16's 12 ms deadline-and-read on it was the loop
            // paying to learn what it already knew — a hand holding
            // twelve idle keepalive connections spent 144 ms of every
            // pass on them. The row still rides the idle and drain
            // clocks below, which is the work a timer, not a socket,
            // has to do.
            let st = if ready_has(ready, fd) {
                serve.conn_step(fd, cconf, opts, lim_for(gens, cg), hport, car, sv, 12, mut rs)
            } else {
                serve.conn_idle(car, sv)
            }
            var close_it = st.close
            var new_idle = idle0
            if st.active {
                new_idle = now
            }
            // ws13: serve asked to WAIT on a name — park the row and
            // make sure a query is in flight (start is a no-op while
            // one is, or while the cache is fresh)
            var new_wait = ""
            if !st.resolve.is_empty() {
                new_wait = st.resolve
                new_idle = now
                resolver.
                    start(
                    mut rs,
                    st.resolve,
                    st.resolve_addr,
                    st.resolve_timeout_ms,
                    st.resolve_valid_ms,
                    now,
                )
            }
            // ws12: the admin endpoint's SECOND PHASE. serve
            // recognised /metrics or /status.json and handed the
            // request back unanswered because the numbers live here;
            // this is where the body is rendered and written. Every
            // fence and every ws10 budget site already ran inside
            // serve, and the generated body takes the `file` site's
            // rule — a scrape whose exposition would blow the budget
            // is a 503 with a name, which is the CORRECT answer and a
            // rig case. The `admin` site name joins head|body|
            // body-chunked|file as an additive value in a frozen field
            // (docs/BUDGET.md carries it).
            var st_acc = st.acc
            var adm_hit = false
            var adm_would = 0
            if !st.admin.is_empty() {
                let alim = lim_for(gens, cg).memory_budget
                let body = if st.admin == "metrics" {
                    render_metrics(counters, gens, shutdown_ms, elog.seq, worker)
                } else {
                    status_stanza(
                        gens,
                        shutdown_ms,
                        quitting,
                        true,
                        elog.seq,
                        worker,
                        listening,
                        counters.accepted,
                    )
                }
                let would = st.mem_hw + body.len
                if alim > 0 && would > alim {
                    serve.write_admin_503(fd, opts.token)
                    st_acc.status = 503
                    st_acc.body_bytes = serve.admin_err_len(opts.token)
                    adm_hit = true
                    adm_would = would
                    close_it = true
                } else {
                    let ctype = if st.admin == "metrics" {
                        metrics.content_type()
                    } else {
                        "application/json"
                    }
                    var wrote = 0
                    var wfail = false
                    wrote = serve.write_admin(fd, body, ctype, opts.token, !st.close) else |_| {
                        wfail = true
                        0
                    }
                    st_acc.status = 200
                    st_acc.body_bytes = wrote
                    if wfail {
                        close_it = true
                    }
                }
            }
            // ws09: a served request becomes an access record — the
            // entry stamps the times serve cannot know (wall clock,
            // and the span since this request's first byte)
            var new_start = cs0
            if st.logged {
                var a2 = st_acc
                a2.unix_ms = now
                var span = now - cs0
                if span < 0 {
                    span = 0
                }
                a2.req_ms = span
                (mut pass_accs).push(AccRow { a: copy a2 })
                new_start = now
                // ws10: the budget observability — a refusal is a LOUD
                // error event (the ws09 seam) and the generation's
                // counters move; every served request feeds the
                // high-water aggregate
                let hit = !st.bud_site.is_empty() || adm_hit
                if st.bud_site == "region" {
                    // ws13: the runtime's own refusal — the cap in
                    // ledger units rides as the appended field
                    ev_event(
                        mut elog,
                        "error",
                        shell.
                            ev_budget_exceeded_cap(
                            cg,
                            st.bud_site,
                            st.bud_limit,
                            st.bud_would,
                            st.bud_cap,
                        ),
                    )
                } else if !st.bud_site.is_empty() {
                    ev_event(
                        mut elog,
                        "error",
                        shell.ev_budget_exceeded(cg, st.bud_site, st.bud_limit, st.bud_would),
                    )
                } else if adm_hit {
                    ev_event(
                        mut elog,
                        "error",
                        shell.
                            ev_budget_exceeded(
                            cg,
                            "admin",
                            lim_for(gens, cg).memory_budget,
                            adm_would,
                        ),
                    )
                }
                var admitted = st.mem_hw
                if adm_hit {
                    admitted = adm_would
                }
                gens = note_request(gens, cg, admitted, st.mem_rt, hit)
                // ws12: the same record that becomes an access line
                // becomes counter movement — one fold, no second pass
                note_served(mut counters, a2, admitted)
            } else if !st.active && st.carry.is_empty() {
                new_start = now
            }
            var aborted_flag = false
            if !close_it && !st.active && now - new_idle >= opts.keepalive_timeout_ms {
                close_it = true
            }
            if !close_it && shutdown_ms > 0 {
                let gi = index_of(gens, cg)
                if gi >= 0 && gens[gi].state == "draining" && now - gens[gi].since_ms >= shutdown_ms {
                    close_it = true
                    aborted_flag = true
                }
            }
            if close_it {
                net_close(fd) else |_| {}
                gens = on_conn_close(gens, cg, aborted_flag, mut elog)
            } else {
                (mut nfds).push(fd)
                (mut ngens).push(cg)
                (mut ncarry).push(st.carry)
                (mut nserved).push(st.served)
                (mut nidle).push(new_idle)
                (mut ncstart).push(new_start)
                (mut nwait).push(new_wait)
            }
            k = k + 1
        }
        cfds = nfds
        cgens = ngens
        ccarry = ncarry
        cserved = nserved
        cidle = nidle
        cstart = ncstart
        cwait = nwait

        // ws09: pump the pass's records through every access output
        // (ONE bounded append per sink per pass — emit never blocked
        // the serve path) and flush the error mirror
        asinks = pump_sinks(asinks, pass_accs, optin, mut elog)
        elog = flush_elog(elog)

        // 3b. ws06: the renewal daemon tick — spawn-free, in the loop's
        // own bookkeeping (D7). Acts only when the flow's schedule is
        // due (a comparison otherwise), so the accept path never waits
        // on ACME. On issuance the running server REBUILDS its frozen
        // SslConf from the store and swaps it — no reload, no deploy
        // hook: certbot's dance eliminated (the "finally"). Every
        // failure is LOUD (an error log line per attempt) with the
        // named reason the flow carries.
        if have_auto && running && !quitting {
            let ev = acme.tick(mut flow, now)
            if ev == "issued" {
                let rssl = config.ssl_resolve(conf_for(gens, current_gen(gens)), prefix)
                if config.ssl_ok(rssl) {
                    ssl0 = rssl
                    ev_log(
                        mut elog,
                        "notice",
                        "cert auto: issued/renewed {auto_primary}; new TLS connections serve the fresh certificate (no reload)",
                    )
                } else {
                    ev_log(
                        mut elog,
                        "error",
                        "cert auto: issued a certificate the server cannot load ({rssl.err}); keeping the previous certificates",
                    )
                }
            } else if ev == "failed" {
                ev_log(
                    mut elog,
                    "error",
                    "cert auto: issuance/renewal attempt failed: {flow.err} (will retry with backoff)",
                )
            }
        }

        // 4. retire drained generations, 5. finish a quit once empty
        gens = retire_zero(gens, now, mut elog)
        if quitting && cfds.len == 0 {
            running = false
        }
    }

    // shutdown: flush-and-close the log outputs FIRST (the ws09
    // flush-on-quit rule: the last request of a quit run is in the
    // log), then close connections, listeners, pid
    asinks = reopen_sinks(asinks)
    elog = reopen_elog(elog)
    for fd in cfds {
        net_close(fd) else |_| {}
    }
    if have_http {
        net_close(hl) else |_| {}
    }
    if have_tls {
        net_close(tls_l) else |_| {}
    }
    if have_ctrl {
        net_close(cl) else |_| {}
    }
    if worker == 0 {
        shell.pid_remove(pidp) else |_| {}
    }
    0
}

// ------------------------------------------------------------------
// ws17: readiness. The loop stops time-slicing (wolf-lang#127 landed
// `net_wait` at this pin) — one wait over every socket the process
// owns replaces a deadline on each. Two small helpers say what a
// wait answered and how long the next one may last.
// ------------------------------------------------------------------

/// Arm the bounded accept every listener in a many-hands lobo needs
/// (ws17), and say nothing when the host declines — a listener whose
/// deadline could not be armed still works, it just blocks longer on a
/// lost race.
///
/// THE REASON, and it is the first thing a shared listener teaches:
/// **readiness is not exclusivity.** `net_wait` says a socket CAN be
/// accepted without blocking; with N hands polling ONE inherited
/// listener, one SYN wakes all N and exactly one wins the `accept(2)`.
/// The other N-1 then call `net_accept` on a queue that is empty
/// again, and an accept with no deadline armed PARKS THERE — a hand
/// that stops answering its own control endpoint until the next
/// connection arrives, which the master reads as gone and reaps. That
/// is the thundering herd, and it is not a bug in `net_wait`
/// ([os.net.wait] is level-triggered and says exactly what it saw);
/// it is the thing a program that shares a listener owes the kernel.
/// ws16 never met it because ws16's listener had one holder and the
/// loop re-armed 25 ms on it every pass.
///
/// 5 ms, not 25: a losing accept is the common case under load, so it
/// is the cost of every contended pass. The deadline is armed ONCE, at
/// acquisition — the socket keeps it.
fn arm_accept(l: int) {
    net_deadline(l, 5) else |_| {}
}

/// Bind a control endpoint, TCP or unix, by the shape of its address
/// (ws17, wolf-lang#227). The answer is an ordinary net listener
/// either way; `net_port` is `io` on the unix one, which is why the
/// caller takes the ENDPOINT STRING back rather than a port.
///
/// A unix bind that finds something already at the path is `exists`
/// and lobo REFUSES rather than unlinking: the path may be another
/// master's live socket, or an operator's own file, and a library
/// cannot make that call ([os.net.unix]'s own note; the stale-socket
/// case is handled one layer up, where the pid file already says
/// whether a master is alive). A host with no unix family refuses BY
/// NAME here — that is the whole reason the row is `unsupported` and
/// not a bare `io` (ws15 filed #227 because it could not tell the two
/// apart).
///
/// Answers (fd, endpoint-string) or (-1, reason) — the caller prints
/// the reason as an `emerg` and exits 1.
fn bind_control(addr: str) -> (int, str) {
    if shell.is_unix_addr(addr) {
        let path = shell.unix_path_of(addr)
        if path.is_empty() {
            return (-1, "the \"control\" address \"{addr}\" names an empty socket path")
        }
        let l = net_listen_unix(path) else |e| match e {
            unsupported => {
                return (
                    -1,
                    "this host has no unix-domain sockets, so \"control {addr}\" cannot be served (refused by name, not by silence — [os.net.unix]); use a loopback address with the token arm instead",
                )
            },
            exists => {
                return (
                    -1,
                    "something already exists at \"{path}\" — lobo never clobbers a path it did not bind (a live master, a stale socket, or an ordinary file: remove it yourself if you know which)",
                )
            },
            not_found => {
                return (-1, "the directory holding \"{path}\" does not exist")
            },
            denied => {
                return (-1, "permission denied creating the control socket \"{path}\"")
            },
            io => {
                // the row is coarse by design ([os.net.unix] keeps the
                // NAMED rows for the conditions a program can act on),
                // so lobo names the one cause an operator hits and
                // cannot see: `sun_path` is about a hundred bytes on
                // every unix — 104 on macOS, 108 on linux — and a
                // control socket under a long prefix silently exceeds
                // it. MEASURED at ws17 with a 126-byte scratch path.
                if path.len > 100 {
                    return (
                        -1,
                        "bind() to control {addr} failed — the path is {path.len} bytes and a unix socket address holds about a hundred (sun_path: 104 on macOS, 108 on linux); put the socket somewhere shorter",
                    )
                }
                return (-1, "bind() to control {addr} failed")
            },
        }
        arm_accept(l)
        return (l, addr)
    }
    let l = net_listen(addr) else |_| {
        return (-1, "bind() to control {addr} failed")
    }
    arm_accept(l)
    let port = net_port(l) else |_| {
        return (-1, "could not read the control port")
    }
    (l, "127.0.0.1:{port}")
}

/// Was `fd` in the readiness answer? `net_wait` answers the SUBSET in
/// the caller's order, so a walk is the membership test (the sets are
/// a listener or three plus the open connections). Pure and total.
fn ready_has(ready: List[int], fd: int) -> bool {
    for r in ready {
        if r == fd {
            return true
        }
    }
    false
}

/// How long this pass's `net_wait` may block, in milliseconds.
///
/// The floor is the SIGNAL POLL's, and it is the honest limit on how
/// much of #127's win a server that must notice a SIGHUP can take:
/// signals have no readiness handle in the language — the loop learns
/// about one by raising a probe and waiting on the runtime's queue
/// ([os.signal.wait], the self-raise poll in the header) — so while
/// signal reception is armed the wait cannot outlast the latency an
/// operator's `kill -HUP` may see. 25 ms is ws16's own number (the
/// control listener's accept deadline), so signal latency IMPROVES:
/// ws16 polled once per pass and a pass was three stacked accepts.
/// With reception unavailable the control channel is the only trigger
/// and the wait stretches to 250 ms.
///
/// `busy` shortens it to 5 ms: a connection parked on a name needs the
/// resolver ticked, and the resolver's sockets are not in the wait set
/// (its own 1 ms reads are its clock). Pure and total.
fn wait_budget(sig_on: bool, busy: bool) -> int {
    if busy {
        return 5
    }
    if sig_on {
        return 25
    }
    250
}

/// Write a control reply when the trigger carried a reply socket (a
/// signal trigger has none — `cc` is -1). Write trouble is swallowed:
/// the peer is closing anyway. Total.
fn reply(cc: int, s: str) {
    if cc >= 0 {
        net_write(cc, s) else |_| {}
    }
}

/// The live-connection count `gen` currently holds, or 0. Total.
fn held_of(gens: List[GenRow], gen: int) -> int {
    for g in gens {
        if g.gen == gen {
            return g.live
        }
    }
    0
}

// ------------------------------------------------------------------
// ws16: the master — many hands (D73, D7 kept). With `worker_processes
// N` (N >= 2) the process that ran `lobo serve` binds NO http listener:
// it starts N workers through `os_spawn` (this executable, `serve`,
// the same prefix and config, `--worker i --worker-control <ep>`),
// each of which is today's one spawn-free poll loop in its own os
// process, and it supervises them over their loopback control
// endpoints — the ws15 order desk, one per hand. Every operator verb
// the master takes FANS OUT: `reload` rolls through the hands one at
// a time (each swaps its own generation and drains the old one in
// place — the ws08 drain, per process), `quit` drains every hand then
// exits, `stop` stops them fast, `reopen` cycles every hand's outputs,
// `status` folds each hand's stanza into per-worker rows. A hand that
// stops answering is reaped and replaced; the count is in its row.
//
// THE ACCEPT-DISTRIBUTION POSTURE AT THIS PIN IS MEASURED, NOT WISHED
// (docs/WORKERS.md): the runtime binds `std::net::TcpListener` with
// SO_REUSEADDR only and never SO_REUSEPORT, so two processes cannot
// hold one port (measured: a child's bind of the parent's port
// answers `io` on macOS; the same call on linux answers EADDRINUSE);
// every socket the runtime opens is CLOEXEC and `os_spawn` passes no
// descriptor, so a worker cannot inherit the master's listener
// either (measured: a spawned child's descriptor table holds ZERO
// TCP sockets); and std.net has no surface that adopts a descriptor
// even if one arrived. Filed as wolf-lang#234 (SO_REUSEPORT / a
// listener option) and wolf-lang#235 (descriptor inheritance and
// adoption). So at this pin every worker RETRIES the bind each pass:
// the first to win it serves, the others STAND BY and take the
// listener the moment its holder dies — failover in one poll
// interval, with the master's respawn behind it. The day #234 lands,
// every hand's bind succeeds and the same loop distributes accepts
// with no lobo change; until then `worker_processes N` is
// supervision, not throughput, and the sprint's measurement says so
// with a number rather than a promise.
//
// A master that is SIGKILLed leaves its hands serving (nginx's
// workers notice a dead master through their channel; lobo's have
// none at this pin — named delta). `kill -TERM` on the master is the
// orderly path: TERMINATE is `stop`, and `stop` fans out first.
// ------------------------------------------------------------------

/// Rebuild `xs` with element `i` replaced by `v` (index assignment is
/// a one-lane shape; a worker table holds a handful of rows). Total.
fn replace_int(xs: List[int], i: int, v: int) -> List[int] {
    var out = List[int]()
    var k: int = 0
    let n = xs.len
    while k < n {
        if k == i {
            (mut out).push(v)
        } else {
            (mut out).push(xs[k])
        }
        k = k + 1
    }
    out
}

/// The `List[str]` twin of `replace_int`. Total.
fn replace_str(xs: List[str], i: int, v: str) -> List[str] {
    var out = List[str]()
    var k: int = 0
    let n = xs.len
    while k < n {
        if k == i {
            (mut out).push(v)
        } else {
            (mut out).push(xs[k])
        }
        k = k + 1
    }
    out
}

/// The `List[bool]` twin of `replace_int`. Total.
fn replace_bool(xs: List[bool], i: int, v: bool) -> List[bool] {
    var out = List[bool]()
    var k: int = 0
    let n = xs.len
    while k < n {
        if k == i {
            (mut out).push(v)
        } else {
            (mut out).push(xs[k])
        }
        k = k + 1
    }
    out
}

/// The endpoint a hand's control listener will bind, given the
/// MASTER's own address and the hand's ordinal.
///
/// ws17: when the master's endpoint is a unix socket, so are its
/// hands' — `unix:/run/lobo/control.sock` gives each hand
/// `…/control.sock.wN`, a sibling in the operator's own directory, so
/// a HAND's order desk is a uid boundary too (ws16 could only offer it
/// a loopback port, reachable by every local user on the box). The
/// path is one the master's configuration NAMES, which is exactly the
/// case `[os.net.unix]` says a program may unlink unconditionally —
/// so a replacement hand does not trip over the socket file a
/// SIGKILLed predecessor left behind. That removal is the master's,
/// never a hand's: the process that BOUND a path owns it.
///
/// Otherwise it is ws16's loopback probe, and the release-to-rebind
/// window is real (wolf-lang#121's lesson): a hand whose endpoint was
/// taken in the gap fails its own bind and exits 1, and the master
/// replaces it with a fresh one — the supervision path IS the retry.
/// "" when the host refuses the probe. Total.
fn worker_endpoint(master_ctrl: str, i: int) -> str {
    if shell.is_unix_addr(master_ctrl) {
        let ep = shell.unix_worker_addr(master_ctrl, i)
        let path = shell.unix_path_of(ep)
        if fs_exists(path) {
            fs_remove(path) else |_| {}
        }
        return ep
    }
    free_endpoint()
}

/// A free loopback endpoint: bind :0, read the port, release it.
/// "" when the host refuses the probe. Total.
fn free_endpoint() -> str {
    let l = net_listen("127.0.0.1:0") else |_| {
        return ""
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return ""
    }
    net_close(l) else |_| {}
    "127.0.0.1:{p}"
}

/// Start worker `i` (1-based): pick its endpoint, spawn this
/// executable as a hand WITH THE MASTER'S LISTENERS IN ITS INHERIT SET
/// (ws17), log `worker-started`, and answer the child handle with the
/// endpoint — or (-1, "") with the reason logged as an error (the loop
/// retries on its next pass).
///
/// `lfds` is the master's listening handles in the config's own order
/// (plaintext first, then TLS). `os_spawn_with` hands them to the
/// child as descriptors 3, 4, … in that order — the numbering IS the
/// contract ([os.proc.inherit]), so the hand is told only HOW MANY
/// rode down, never a descriptor number, and it adopts them by
/// position. Both processes then hold their own descriptor for the
/// same socket: the master closing its copy would not disturb a hand,
/// and a REPLACEMENT hand inherits the same listener, which is why
/// the master keeps them open for its whole life.
///
/// A host that answers `unsupported` to a non-empty set (windows —
/// handle inheritance exists there but a SOCKET is not a small stable
/// number a parent can name by position) falls back to ws16's shape:
/// `os_spawn` with no descriptors, and the hand binds and stands by.
/// The fallback is named out loud, once per spawn. Total.
fn spawn_worker(
    exe: str,
    prefix: str,
    conf: str,
    i: int,
    restarts: int,
    lfds: List[int],
    mctrl: str,
    hands: int,
    mut el: ELog,
) -> (int, str) {
    let ep = worker_endpoint(mctrl, i)
    if ep.is_empty() {
        ev_log(mut el, "error", "worker {i}: no free endpoint for its control listener")
        return (-1, "")
    }
    var handed = lfds.len
    var h: int = -1
    if handed > 0 {
        var ok = true
        let hh = os_spawn_with(exe, shell.worker_args(prefix, conf, i, ep, handed, hands), lfds) else |e| match e {
            unsupported => {
                ok = false
                ev_log(
                    mut el,
                    "warn",
                    "worker {i}: this host does not hand descriptors to a child (os_spawn_with unsupported) — falling back to the bind-and-stand-by shape (docs/WORKERS.md)",
                )
                -1
            },
            not_found => {
                ev_log(mut el, "error", "worker {i}: spawn failed — executable not found ({exe})")
                return (-1, "")
            },
            denied => {
                ev_log(
                    mut el,
                    "error",
                    "worker {i}: spawn failed — the host refused to execute {exe}",
                )
                return (-1, "")
            },
            io => {
                ev_log(
                    mut el,
                    "error",
                    "worker {i}: spawn failed (io) with {handed} listener(s) in the inherit set",
                )
                return (-1, "")
            },
        }
        if ok {
            h = hh
        } else {
            handed = 0
        }
    }
    if h < 0 {
        let argv = shell.worker_argv(exe, prefix, conf, i, ep, 0, hands)
        h = os_spawn(argv) else |e| match e {
            not_found => {
                ev_log(mut el, "error", "worker {i}: spawn failed — executable not found ({exe})")
                return (-1, "")
            },
            denied => {
                ev_log(
                    mut el,
                    "error",
                    "worker {i}: spawn failed — the host refused to execute {exe}",
                )
                return (-1, "")
            },
            io => {
                ev_log(mut el, "error", "worker {i}: spawn failed (io)")
                return (-1, "")
            },
        }
    }
    ev_event(mut el, "notice", shell.ev_worker_started(i, restarts))
    (h, ep)
}

/// Reap a worker the master has decided is gone: kill (harmless on a
/// child that already exited — `io`), then wait, which is what reaps
/// on every unix, and log `worker-exited`. `reason` is the master's
/// verdict (`unreachable` for a hand it killed for silence); a hand
/// that died on its own reads `exit` or `signal` off the reap. Answers
/// the exit code, -1 for a signal. Total.
fn reap_worker(h: int, i: int, reason: str, mut el: ELog) -> int {
    os_kill(h) else |_| {}
    var sig = false
    let code = os_wait(h) else |e| match e {
        signal => {
            sig = true
            -1
        },
        io => {
            -1
        },
    }
    var r = reason
    if r.is_empty() {
        r = if sig { "signal" } else { "exit" }
    }
    ev_event(mut el, "notice", shell.ev_worker_exited(i, r, code))
    code
}

/// Send `verb` to every reachable hand, in order (a `reload` is
/// therefore ROLLING: hand 1 swaps and starts draining before hand 2
/// is told), and answer how many replied with something other than
/// a refusal or a rejection. A hand with no endpoint yet is skipped.
/// Total.
fn fan_out(verb: str, wctl: List[str], ctok: str) -> int {
    var ok: int = 0
    for ep in wctl {
        if ep.is_empty() {
            continue
        }
        let line = shell.control_line(ctok, verb)
        let r = shell.control_send(ep, line) else |_| {
            continue
        }
        if r == "unauthorized" || r.starts_with("reload rejected") || r.starts_with("unknown verb") {
            continue
        }
        ok = ok + 1
    }
    ok
}

/// The master's status stanza: `status_head_text`'s facts with the
/// master's own numbers (`live-region-bytes` is the SUM over the
/// hands), the configured count, and one row per hand folded from
/// that hand's own stanza over its endpoint — `serving` when it holds
/// every listener the config asks for, `standby` when another hand
/// does, `unreachable` when it answered nothing. Text or schema-1
/// JSON (docs/DRAIN.md, docs/WORKERS.md). fs/net tier.
fn master_stanza(
    n: int,
    wctl: List[str],
    wrest: List[int],
    mgen: int,
    quitting: bool,
    json: bool,
    events: int,
    ctok: str,
) -> str {
    var sum_bytes: int = 0
    var rows = ""
    var first = true
    var i: int = 0
    while i < n {
        let ep = wctl[i]
        var state = "unreachable"
        var gen: int = -1
        var live: int = 0
        var ev: int = -1
        var lb: int = 0
        var b503: int = 0
        var acc: int = 0
        if !ep.is_empty() {
            let body = shell.control_fetch(ep, shell.control_line(ctok, "status")) else |_| { "" }
            if !body.is_empty() {
                let listening = shell.stanza_word(body, "listening")
                state = if listening == "true" { "serving" } else { "standby" }
                gen = shell.stanza_int(body, "current generation")
                ev = shell.stanza_int(body, "events")
                lb = shell.stanza_int(body, "live-region-bytes")
                if lb < 0 {
                    lb = 0
                }
                live = shell.stanza_field_sum(body, "live")
                b503 = shell.stanza_field_sum(body, "budget-503s")
                acc = shell.stanza_int(body, "accepted")
                if acc < 0 {
                    acc = 0
                }
            }
        }
        sum_bytes = sum_bytes + lb
        if json {
            let sep = if first { "" } else { "," }
            rows = "{rows}{sep}{shell.status_worker_json(i + 1, state, ep, gen, live, ev, lb, b503, wrest[i], acc)}"
        } else {
            rows = "{rows}{shell.status_worker_text(i + 1, state, ep, gen, live, ev, lb, b503, wrest[i], acc)}"
        }
        first = false
        i = i + 1
    }
    if json {
        return "{shell.status_json_master_open(mgen, quitting, events, sum_bytes, n)}{rows}{shell.status_json_close()}"
    }
    "{shell.status_head_text(mgen, quitting, events, sum_bytes)}{shell.status_workers_line(n)}{rows}"
}

/// The master's serving verb (`worker_processes N`, N >= 2): load the
/// config, refuse a second master, own the pid file and the config's
/// control endpoint, start N hands, then run the SUPERVISION loop —
/// the same trigger collection as `serve_main` (a control line or a
/// real signal, one dispatch, one emission site for
/// `signal-received`), every verb fanned out, every hand probed each
/// pass and replaced when it is gone. Exits 0 after `stop`, or after
/// `quit` has drained every hand; 1 on a config error, a failed bind
/// or a refused start. Loopback only.
fn master_main(prefix: str, conf: str, n: int) -> int {
    let c0 = config.load(prefix, conf)
    if !config.ok(c0) {
        eprint("lobo: [emerg] configuration file {conf} test failed")
        return 1
    }
    let exe = os_exe() else |_| {
        eprint(
            "lobo: [emerg] cannot learn this executable's path (os_exe), so no worker can be started",
        )
        return 1
    }
    let ctrl = shell.control_addr(c0)
    let pidp = shell.pid_path(c0, prefix)
    let existing = shell.pid_read(pidp) else |_| ""
    if !existing.is_empty() {
        if shell.control_alive(existing) {
            eprint("lobo: [emerg] a lobo master is already running (control {existing})")
            return 1
        }
        eprint(
            "lobo: [warn] removing stale pid file \"{pidp}\" (control {existing} not responding)",
        )
    }
    // the token arm is read HERE too: the master authorizes its own
    // endpoint with it and addresses every hand with it (each hand
    // reads the same file at its own start, so no secret ever crosses
    // an argv)
    var ctok = ""
    let tokp = shell.control_token_path(c0, prefix)
    if !tokp.is_empty() {
        ctok = shell.control_token_read(tokp) else |e| match e {
            none => {
                eprint(
                    "lobo: [emerg] control token file \"{tokp}\" does not exist (create it with the mode you want — lobo reads it, never writes it)",
                )
                return 1
            },
            io => {
                eprint("lobo: [emerg] control token file \"{tokp}\" could not be read")
                return 1
            },
        }
        if ctok.is_empty() {
            eprint("lobo: [emerg] control token file \"{tokp}\" is empty")
            return 1
        }
    }
    var have_ctrl = false
    var cl: int = 0
    var ctrl_ep = serve.listen_addr_plain(c0)
    if !ctrl.is_empty() {
        let cb = bind_control(ctrl)
        if cb.0 < 0 {
            eprint("lobo: [emerg] {cb.1}")
            return 1
        }
        cl = cb.0
        ctrl_ep = cb.1
        have_ctrl = true
    }
    shell.pid_write(pidp, ctrl_ep) else |_| {
        eprint("lobo: [emerg] could not write pid file \"{pidp}\"")
        return 1
    }

    // ws17: THE MASTER BINDS THE LISTENERS. This is nginx's shape and
    // it is reachable at this pin for the first time: `os_spawn_with`
    // hands a child the master's net handles as descriptors 3, 4, …
    // and `net_adopt_listener` takes them by position
    // (`[os.proc.inherit]`, wolf-lang#235). Every hand then accepts on
    // ONE socket and the kernel's accept queue distributes the work —
    // which is the shape that distributes on BOTH serving hosts.
    //
    // The other shape the language now offers is `net_listen_with(
    // addr, reuse_port, backlog)` (#234): N separate sockets sharing
    // one port. lobo does NOT take it, and the reason is measured
    // rather than preferred — on macOS a SO_REUSEPORT group hands
    // every SYN to the NEWEST bound socket, so N hands would be one
    // server and N-1 idle sockets again, exactly ws16's posture with a
    // different cause. linux distributes it by a 4-tuple hash, so
    // there `reuse_port` would work too; a server that picks its
    // architecture per host is a server with two architectures.
    // docs/WORKERS.md carries lobo's own re-measurement of both.
    //
    // The master ACCEPTS on nothing: these handles are never in its
    // wait set. It holds them for its whole life because a REPLACEMENT
    // hand must inherit the same socket — a socket that closed with
    // its holder is the gap ws16's failover had to cover.
    let maddr = serve.listen_addr_plain(c0)
    let mtls = ssl_listen_addr(c0)
    var lfds = List[int]()
    var mhl: int = -1
    var mtl: int = -1
    if !maddr.is_empty() {
        mhl = net_listen(maddr) else |_| {
            eprint("lobo: [emerg] bind() to {maddr} failed")
            shell.pid_remove(pidp) else |_| {}
            return 1
        }
        (mut lfds).push(mhl)
    }
    if !mtls.is_empty() {
        mtl = net_listen(mtls) else |_| {
            eprint("lobo: [emerg] bind() to TLS {mtls} failed")
            shell.pid_remove(pidp) else |_| {}
            return 1
        }
        (mut lfds).push(mtl)
    }

    var elog = build_elog(c0, prefix, 0, 0)
    let ctrl_auth = if !have_ctrl { "off" } else if shell.is_unix_addr(ctrl_ep) {
        if ctok.is_empty() { "socket permissions" } else { "socket permissions + token" }
    } else if ctok.is_empty() {
        "loopback only"
    } else {
        "loopback + token"
    }
    ev_log(
        mut elog,
        "notice",
        "master: {n} workers (worker_processes), control {ctrl_ep} (auth: {ctrl_auth}), pid file {pidp}; accept distribution: {lfds.len} listener(s) bound here and handed down (os_spawn_with + net_adopt_listener) — every hand accepts on the same socket (docs/WORKERS.md)",
    )
    let sprobe = shell.sig_probe()
    var sig_on = true
    os_signal_listen(shell.sig_mask() + sprobe) else |_| {
        sig_on = false
    }
    if sig_on {
        ev_log(
            mut elog,
            "notice",
            "signal reception armed by meaning (reload, terminate=stop, quit): every meaning fans out to the workers",
        )
    } else {
        ev_log(
            mut elog,
            "notice",
            "signal reception unavailable on this platform; the control channel is the trigger",
        )
    }
    var mgen = 1
    var mconf = copy c0
    ev_event(mut elog, "notice", shell.ev_generation_loaded(1, shell.conf_hash(c0)))
    ev_event(mut elog, "notice", shell.ev_generation_activated(1))

    // the worker table (parallel primitive lists, rebuilt on change):
    // child handle (-1 = none yet), control endpoint, replacements,
    // start time, consecutive unreachable passes, reaped-under-quit
    var wslot = List[int]()
    var wctl = List[str]()
    var wrest = List[int]()
    var wup = List[int]()
    var wfail = List[int]()
    var wgone = List[bool]()
    // ws17: when the master last PROBED each hand. The probe is a
    // fresh TCP connection every time (there is no channel between a
    // master and its hands at this pin — nginx has a socketpair;
    // wolf-lang#235's inherited descriptor is what would give lobo
    // one), so probing every pass is 3 connections per 25 ms per hand,
    // each leaving the master's side in TIME_WAIT. Under load that is
    // ephemeral-port pressure the master creates for itself, and a
    // transient `connect` failure on a HEALTHY hand is read as
    // silence — three of them reap a hand that was serving fine
    // (MEASURED: an e2e run reaped a hand mid-load before this
    // interval existed). 200 ms is the rate a supervisor needs: since
    // ws17 the hands share one socket, so a dead hand costs no
    // availability at all — the survivors are already accepting —
    // and the probe governs how fast the slot is REFILLED, not how
    // fast service returns.
    var wprobe = List[int]()
    var i: int = 0
    while i < n {
        let s = spawn_worker(exe, prefix, conf, i + 1, 0, lfds, ctrl_ep, n, mut elog)
        (mut wslot).push(s.0)
        (mut wctl).push(s.1)
        (mut wrest).push(0)
        (mut wup).push(time_unix_ms())
        (mut wfail).push(0)
        (mut wgone).push(false)
        (mut wprobe).push(0)
        i = i + 1
    }

    var running = true
    var quitting = false
    while running {
        let now = time_unix_ms()
        // 1. one trigger — the serve loop's collection, verbatim
        var verb = ""
        var cc = -1
        var denied = false
        if have_ctrl {
            // ws17: the master waits on its ONE socket the same way a
            // hand waits on its set ([os.net.wait]); the supervision
            // pass below is this loop's timer work
            var cready = List[int]()
            var cwf = List[int]()
            (mut cwf).push(cl)
            cready = net_wait(cwf, wait_budget(sig_on, false)) else |_| {
                List[int]()
            }
            var got_ctrl = ready_has(cready, cl)
            if got_ctrl {
                let cand = net_accept(cl) else |_| {
                    got_ctrl = false
                    0
                }
                if got_ctrl {
                    cc = cand
                    net_deadline(cc, 2000) else |_| {}
                    let line = read_command(cc)
                    if shell.control_authorized(line, ctok) {
                        verb = shell.control_verb_of(line, ctok)
                    } else {
                        denied = true
                    }
                }
            }
        }
        if denied {
            ev_log(mut elog, "warn", "control: unauthorized command rejected")
            reply(cc, "unauthorized\n")
            net_close(cc) else |_| {}
            cc = -1
        }
        if sig_on && cc < 0 {
            var m = 0
            os_signal_raise(sprobe) else |_| {
                m = -1
            }
            if m == 0 {
                m = os_signal_wait(shell.sig_mask() + sprobe) else |_| { sprobe }
            }
            if m > 0 && m != sprobe {
                verb = shell.signal_verb(m)
            }
        }
        if !have_ctrl && !sig_on {
            // nothing can ever reach this master: park a little so the
            // supervision pass below does not spin
            time_sleep_ms(25)
        }
        if cc >= 0 || !verb.is_empty() {
            let mtrig = shell.signal_meaning(verb)
            if mtrig > 0 {
                let src = if cc >= 0 { "control" } else { "signal" }
                ev_event(mut elog, "notice", shell.ev_signal_received(mtrig, src))
            }
            if verb == "ping" {
                reply(cc, "pong\n")
            } else if verb == "status" {
                reply(
                    cc,
                    "{master_stanza(n, wctl, wrest, mgen, quitting, false, elog.seq, ctok)}\n",
                )
            } else if verb == "status json" {
                reply(cc, "{master_stanza(n, wctl, wrest, mgen, quitting, true, elog.seq, ctok)}\n")
            } else if verb == "stop" {
                let k = fan_out("stop", wctl, ctok)
                reply(cc, "stop: shutting down (generation {mgen}) workers={k}/{n}\n")
                running = false
            } else if verb == "quit" {
                let k = fan_out("quit", wctl, ctok)
                reply(cc, "quit: draining then exiting (generation {mgen}) workers={k}/{n}\n")
                quitting = true
            } else if verb == "reopen" {
                let k = fan_out("reopen", wctl, ctok)
                elog = reopen_elog(elog)
                ev_log(mut elog, "notice", "reopening log files")
                reply(cc, "reopen: log outputs cycled (generation {mgen}) workers={k}/{n}\n")
            } else if verb == "reload" {
                // the master parses FIRST (D2: the verdict is answered on
                // the wire, and a rejected config reaches no hand), then
                // rolls the verb through the hands one at a time
                let prev = shell.Gen { conf: copy mconf, gen: mgen, ok: true, note: "" }
                let ng = shell.reload(prefix, conf, prev)
                if ng.ok && ng.gen > mgen {
                    let nhash = shell.conf_hash(ng.conf)
                    ev_event(mut elog, "notice", shell.ev_generation_draining(mgen, 0))
                    ev_event(mut elog, "notice", shell.ev_generation_loaded(ng.gen, nhash))
                    ev_event(mut elog, "notice", shell.ev_generation_activated(ng.gen))
                    ev_event(mut elog, "notice", shell.ev_generation_retired(mgen, 0, 0, 0))
                    mgen = ng.gen
                    mconf = copy ng.conf
                    elog = reopen_elog(elog)
                    elog = build_elog(ng.conf, prefix, elog.seq, 0)
                    let k = fan_out("reload", wctl, ctok)
                    reply(cc, "reload complete (generation {mgen}) workers={k}/{n}\n")
                } else {
                    reply(cc, "{ng.note}\n")
                }
            } else if verb == "upgrade" {
                reply(
                    cc,
                    "upgrade: not implemented at this pin — the binary-swap verb is unclaimed on every platform; when it lands it lands HERE, on the control endpoint (docs/CONTROL.md)\n",
                )
            } else {
                reply(cc, "unknown verb \"{verb}\"\n")
            }
            if cc >= 0 {
                net_close(cc) else |_| {}
            }
        }

        // 2. supervise: probe every hand's endpoint (a connect, never a
        // round trip — a busy hand still answers from its backlog);
        // three silent passes after a 3 s start grace is "gone" — reap
        // and replace (a hand that dies inside a second of starting is
        // replaced after a 250 ms pause, so a broken config cannot
        // spin the master). Under a quit a gone hand is reaped and
        // NOT replaced; the master exits once every hand is gone.
        var alldone = quitting
        var j: int = 0
        while j < n {
            if wgone[j] {
                j = j + 1
                continue
            }
            alldone = false
            if wslot[j] < 0 {
                if !quitting {
                    let s = spawn_worker(
                        exe,
                        prefix,
                        conf,
                        j + 1,
                        wrest[j],
                        lfds,
                        ctrl_ep,
                        n,
                        mut elog,
                    )
                    wslot = replace_int(wslot, j, s.0)
                    wctl = replace_str(wctl, j, s.1)
                    wup = replace_int(wup, j, now)
                    wfail = replace_int(wfail, j, 0)
                    wprobe = replace_int(wprobe, j, now)
                }
                j = j + 1
                continue
            }
            if now - wprobe[j] < 200 {
                j = j + 1
                continue
            }
            wprobe = replace_int(wprobe, j, now)
            let ep = wctl[j]
            if shell.control_reachable(ep) {
                wfail = replace_int(wfail, j, 0)
                j = j + 1
                continue
            }
            // grace: a hand gets 3 s to come up; past that, three silent
            // passes is gone
            let fails = wfail[j] + 1
            wfail = replace_int(wfail, j, fails)
            if now - wup[j] < 3000 || fails < 3 {
                j = j + 1
                continue
            }
            let reason = if quitting { "" } else { "unreachable" }
            let _code = reap_worker(wslot[j], j + 1, reason, mut elog)
            if quitting {
                wgone = replace_bool(wgone, j, true)
                wslot = replace_int(wslot, j, -1)
                j = j + 1
                continue
            }
            if now - wup[j] < 1000 {
                time_sleep_ms(250)
            }
            let s = spawn_worker(exe, prefix, conf, j + 1, wrest[j] + 1, lfds, ctrl_ep, n, mut elog)
            wslot = replace_int(wslot, j, s.0)
            wctl = replace_str(wctl, j, s.1)
            wrest = replace_int(wrest, j, wrest[j] + 1)
            wup = replace_int(wup, j, time_unix_ms())
            wfail = replace_int(wfail, j, 0)
            wprobe = replace_int(wprobe, j, time_unix_ms())
            j = j + 1
        }
        elog = flush_elog(elog)
        if alldone {
            running = false
        }
    }

    // shutdown: after `stop` every hand was told; give each a moment,
    // then reap what is left (kill first — a hand still draining under
    // `stop` is stopped fast, nginx's meaning of the word)
    var k: int = 0
    while k < n {
        if !wgone[k] && wslot[k] >= 0 {
            var waited: int = 0
            while waited < 20 && shell.control_reachable(wctl[k]) {
                time_sleep_ms(50)
                waited = waited + 1
            }
            let _c = reap_worker(wslot[k], k + 1, "", mut elog)
        }
        k = k + 1
    }
    elog = reopen_elog(elog)
    if have_ctrl {
        net_close(cl) else |_| {}
    }
    // ws17: the master owns the listeners it bound; every hand owns
    // its own descriptor for the same socket, so these closes are the
    // master's copies and nothing else's ([os.proc.inherit]'s
    // ownership clause). The hands are already gone by here.
    if mhl >= 0 {
        net_close(mhl) else |_| {}
    }
    if mtl >= 0 {
        net_close(mtl) else |_| {}
    }
    shell.pid_remove(pidp) else |_| {}
    0
}

// ------------------------------------------------------------------
// signal-send — `-s verb` reaches the running master through the
// control channel (the pin has no arbitrary-pid signal send; #126)
// ------------------------------------------------------------------

/// The client half of the endpoint, shared by `-s`, `status` and
/// `control` (ws15): resolve the running master's endpoint from the
/// pid file and the secret to address it with from the configured
/// token file. Answers ("", "") after printing the diagnostic — the
/// caller returns 1.
///
/// This is where "`-s` PREFERS the endpoint when configured" is
/// expressed. At this pin the preference has nothing to fall back TO:
/// there is no getpid and no arbitrary-pid signal send (wolf-lang#126's
/// unlanded half), so a config with no `control` directive cannot be
/// reached by any means and lobo says exactly that instead of dialling
/// the http port and printing a 400 at the operator. That refusal is
/// the windows sentence made operational on EVERY host
/// (docs/CONTROL.md, docs/DRAIN.md).
fn control_target(cli: shell.Cli) -> (str, str) {
    let c = config.load(cli.prefix, cli.conf)
    // a config that did not load keeps nginx's shape: the pid path
    // falls back to the default and the missing file is the alert
    if config.ok(c) && shell.control_addr(c).is_empty() {
        eprint(
            "lobo: [error] no \"control\" directive in {cli.conf}: a running lobo is reached ONLY over its control endpoint at this pin (there is no arbitrary-pid signal send — wolf-lang#126), so add `control 127.0.0.1:<port>;` and restart",
        )
        return ("", "")
    }
    let pidp = shell.pid_path(c, cli.prefix)
    let ep = shell.pid_read(pidp) else |e| match e {
        none => {
            eprint("lobo: [alert] open() \"{pidp}\" failed (2: No such file or directory)")
            return ("", "")
        },
        io => {
            eprint("lobo: [alert] could not read pid file \"{pidp}\"")
            return ("", "")
        },
    }
    var tok = ""
    let tokp = shell.control_token_path(c, cli.prefix)
    if !tokp.is_empty() {
        tok = shell.control_token_read(tokp) else |e| match e {
            none => {
                eprint(
                    "lobo: [error] control token file \"{tokp}\" does not exist — the running master expects it",
                )
                return ("", "")
            },
            io => {
                eprint("lobo: [error] control token file \"{tokp}\" could not be read")
                return ("", "")
            },
        }
    }
    (ep, tok)
}

/// The exit code a control reply earns. nginx's `-s reload` parses
/// the config in the CLIENT and exits 1 when it does not load, so an
/// operator's `&&` never runs on a reload that did not happen; lobo
/// parses in the MASTER (which is what lets it answer the verdict and
/// name the generation that kept serving), and this is where that
/// answer becomes the same exit code — the ws15 control differential
/// found the gap. A refusal, a rejection, an unknown verb and the
/// named `upgrade` answer are all exit 1; everything else is 0.
/// Total.
fn control_exit(reply: str) -> int {
    if reply == "unauthorized" {
        return 1
    }
    if reply.starts_with("reload rejected") {
        return 1
    }
    if reply.starts_with("unknown verb") {
        return 1
    }
    if reply.starts_with("upgrade: not implemented") {
        return 1
    }
    0
}

/// The one diagnostic for a dead or unreachable endpoint, shared by
/// the three client paths. Total.
fn control_dead(ep: str) {
    eprint(
        "lobo: [error] the master at {ep} is not responding (stale pid file, or no lobo is running there)",
    )
}

/// `-s <verb>`: read the pid file for the running master's control
/// endpoint (nginx reads it for the pid), connect, send the verb, and
/// print the reply. nginx exit codes: a missing pid file is exit 1
/// with the open() diagnostic; a refused endpoint (stale file, dead
/// master) is exit 1. Loads the config first, as nginx does, to
/// resolve the pid path — and, since ws15, the token file too.
fn signal_main(cli: shell.Cli) -> int {
    let t = control_target(cli)
    if t.0.is_empty() {
        return 1
    }
    let ep = t.0
    let reply = shell.control_send(ep, shell.control_line(t.1, cli.signal)) else |e| match e {
        refused => {
            control_dead(ep)
            return 1
        },
        io => {
            eprint("lobo: [error] control channel error to {ep}")
            return 1
        },
    }
    print(reply)
    control_exit(reply)
}

/// `lobo control <verb>`: the endpoint's own CLI door (ws15). nginx's
/// `-s` takes exactly four words and lobo's takes exactly the same
/// four — the parity `tools/lobo-shell` probes against the oracle — so
/// the verbs nginx has no word for (`status`, `upgrade`, `ping`) get a
/// lobo-native subcommand rather than a widened `-s`. Sends one verb,
/// prints the reply, exits 1 on a refusal so a script can gate.
fn control_main(cli: shell.Cli) -> int {
    let t = control_target(cli)
    if t.0.is_empty() {
        return 1
    }
    let ep = t.0
    let line = shell.control_line(t.1, cli.signal)
    // `status` answers a multi-line stanza; every other verb answers
    // one line. `control_fetch` reads to close, so it serves both.
    let reply = shell.control_fetch(ep, line) else |e| match e {
        refused => {
            control_dead(ep)
            return 1
        },
        io => {
            eprint("lobo: [error] control channel error to {ep}")
            return 1
        },
    }
    print_raw("{reply}\n")
    control_exit(reply)
}

// ------------------------------------------------------------------
// status — `lobo status [--format json]` reads the drain you can watch
// off the running master's control channel (ws08)
// ------------------------------------------------------------------

/// `lobo status [--format json]`: read the running master's control
/// endpoint from the pid file, fetch the status stanza over the control
/// channel (read to close — the stanza is multi-line), and print it.
/// nginx has no status command; this is lobo-native, the observable
/// drain's operator surface. Exit codes mirror `-s`: a missing pid file
/// or a refused/dead endpoint is exit 1 with an nginx-shaped alert.
fn status_main(cli: shell.Cli) -> int {
    let t = control_target(cli)
    if t.0.is_empty() {
        return 1
    }
    let ep = t.0
    let verb = if cli.format == "json" {
        "status json"
    } else {
        "status"
    }
    let reply = shell.control_fetch(ep, shell.control_line(t.1, verb)) else |e| match e {
        refused => {
            control_dead(ep)
            return 1
        },
        io => {
            eprint("lobo: [error] control channel error to {ep}")
            return 1
        },
    }
    print_raw("{reply}\n")
    control_exit(reply)
}

// ------------------------------------------------------------------
// cert status — `lobo cert status` reads the renewal daemon's own
// record off the store (ws06 §4): the domain, its certificate expiry,
// and the last attempt/result — the operator's one-glance answer.
// nginx has no analogue; lobo-native. Exit is nonzero (a `-t`-style
// failure signal) when a cert-auto config's certificate is MISSING or
// the last renewal attempt FAILED, so a monitor can gate on it.
// ------------------------------------------------------------------

/// `lobo cert status`: read the store's status file and the stored
/// leaf's expiry, print one fact per line, exit nonzero on a missing
/// certificate or a failed last attempt. Offline — the only fs is the
/// store, never a socket.
fn cert_status_main(cli: shell.Cli) -> int {
    let c = config.load(cli.prefix, cli.conf)
    if !config.auto_on(c) {
        eprint("lobo: [error] cert status: no \"cert auto\" server block in {cli.conf}")
        return 1
    }
    let store = config.auto_store(c, cli.prefix)
    let primary = config.auto_primary(c)
    let now_s = time_unix_ms() / 1000
    let expiry = acme.cert_expiry(store, primary)
    print_raw("domain: {primary}\n")
    print_raw("store: {store}\n")
    if expiry == 0 {
        print_raw("certificate: NONE (not yet issued — the challenge route serves meanwhile)\n")
    } else {
        let remaining = expiry - now_s
        let days = remaining / 86400
        print_raw("certificate: present\n")
        print_raw("expires_unix: {expiry}\n")
        print_raw("expires_in_days: {days}\n")
    }
    // the daemon's last-attempt record, if any
    let rec = fs_read_text(acme.status_path(store)) else |_| ""
    var failed = false
    if !rec.is_empty() {
        for line in rec.lines() {
            if line.starts_with("last_result ") {
                let r = line[12..line.len]
                print_raw("last_result: {r}\n")
                if r.starts_with("failed") {
                    failed = true
                }
            } else if line.starts_with("last_attempt_ms ") {
                print_raw("last_attempt_ms: {line[16..line.len]}\n")
            }
        }
    } else {
        print_raw("last_result: (no attempt recorded yet)\n")
    }
    if expiry == 0 || failed {
        return 1
    }
    0
}

// ------------------------------------------------------------------
// the -g feed and the main dispatch
// ------------------------------------------------------------------

/// Validate `-g "directives"` through the ws01 parser (same table,
/// same named errors). v0 delta: the globals are VALIDATED but not
/// merged into the served model (recorded — a full merge is a later
/// sprint). Returns 0 when clean, 1 with an nginx-shaped diagnostic
/// otherwise.
fn check_globals(globals: str) -> int {
    if globals.is_empty() {
        return 0
    }
    let g = config.parse_str("{globals}\n", "command-line")
    if !config.ok(g) {
        eprint("lobo: [emerg] {g.err} in the -g command-line directives")
        return 1
    }
    0
}

/// The ws07 dry-run: `-t --request` answers what the config would DO
/// with each probe — matched server, matched location with the
/// why-it-lost trace, effective directives with provenance, terminal
/// decision — offline (the ONLY fs is the -t surface itself: config
/// files and, under --stat, the one mapped path; no socket ever
/// opens — dryrun/ imports no io module, and its pure core runs on
/// the fs-less, socket-less interpreter lane as the standing proof).
/// Exit is the -t verdict: a config that fails -t fails here, with
/// the same [emerg] lines; probes answer on stdout (text stanzas or
/// the schema-versioned JSON twin).
fn dryrun_main(cli: shell.Cli) -> int {
    // the -t half first, verbatim (stderr verdict lines included)
    let verdict = config.check(cli.prefix, cli.conf, false)
    if verdict != 0 {
        return verdict
    }
    let c = config.load(cli.prefix, cli.conf)
    let plain_addr = serve.listen_addr_plain(c)
    let tls_addr = ssl_listen_addr(c)
    // TLS-selection inputs: certificates are config files — the -t
    // fs surface, nothing beyond it
    var s = config.ssl_none()
    if !tls_addr.is_empty() {
        s = config.ssl_resolve(c, cli.prefix)
    }
    let json = cli.format == "json"
    var out = ""
    if json {
        out = dryrun.json_open()
    }
    var first = true
    for spec in cli.requests {
        let p = dryrun.probe_request(spec)
        if !p.input_err.is_empty() {
            eprint("lobo: {p.input_err}")
            return 1
        }
        var tr = http.trace_new()
        var listener = plain_addr
        if p.scheme == "https" {
            listener = tls_addr
        }
        let v = dryrun.decide(c, p, plain_addr, tls_addr, mut tr)
        var tls_line = ""
        if p.scheme == "https" && !tls_addr.is_empty() {
            tls_line = dryrun.tls_note(s, cli.sni)
        }
        var stat_line = ""
        if cli.stat {
            stat_line = dryrun.stat_note(v, p.path)
        }
        if json {
            let obj = dryrun.stanza_json(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                out = "{out}{obj}"
                first = false
            } else {
                out = "{out},{obj}"
            }
        } else {
            let st = dryrun.stanza(c, p, tr, v, listener, tls_line, stat_line, cli.client)
            if first {
                first = false
            } else {
                print("")
            }
            print_raw(st)
        }
    }
    if json {
        out = "{out}{dryrun.json_close()}"
        print(out)
    }
    0
}

fn main() -> int {
    let cli = shell.parse_cli(env_args())
    if cli.mode == "error" {
        eprint("lobo: {cli.err_msg}")
        return cli.exit_code
    }
    if cli.mode == "banner" {
        banner()
        return 0
    }
    if cli.mode == "version" {
        eprint(shell.version_report())
        return 0
    }
    if cli.mode == "version_verbose" {
        eprint_raw(shell.version_verbose())
        return 0
    }
    if cli.mode == "help" {
        eprint_raw(shell.usage_text())
        return 0
    }
    let gbad = check_globals(cli.globals)
    if gbad != 0 {
        return gbad
    }
    if cli.mode == "check" {
        if cli.requests.len > 0 {
            return dryrun_main(cli)
        }
        return config.check(cli.prefix, cli.conf, false)
    }
    if cli.mode == "dump" {
        return config.check(cli.prefix, cli.conf, true)
    }
    if cli.mode == "docs" {
        print_raw(config.directives_markdown())
        return 0
    }
    if cli.mode == "logvars" {
        print_raw(obs.vars_markdown())
        return 0
    }
    if cli.mode == "metricsdocs" {
        print_raw(metrics.docs_markdown())
        return 0
    }
    if cli.mode == "signal" {
        return signal_main(cli)
    }
    if cli.mode == "status" {
        return status_main(cli)
    }
    if cli.mode == "control" {
        return control_main(cli)
    }
    if cli.mode == "cert_status" {
        return cert_status_main(cli)
    }
    if cli.mode == "serve" {
        if cli.worker > 0 {
            return serve_main(
                cli.prefix,
                cli.conf,
                cli.worker,
                cli.worker_control,
                cli.inherit,
                cli.hands,
            )
        }
        // ws16/ws17: how many hands? `worker_processes` off the
        // config — 1 (the default) is today's one process; `auto`
        // resolves through `os_cpus()` (`[os.cpus]`, wolf-lang#233,
        // landed at this pin). The count is SCHEDULABLE cores, not
        // installed ones: it honours a cgroup cpu quota and an
        // affinity mask, so a container given two cpus of quota on a
        // sixty-four-core host answers 2 — where ws16's
        // `/proc/cpuinfo` row count answered 64 and started
        // sixty-two hands that would never get a core between them.
        // The `io` row is NOT swallowed into a default: a host that
        // cannot answer says so and lobo runs one worker, which is a
        // different sentence from "this host has one core". macOS's
        // ws16 notice retires — the call answers there.
        let c = config.load(cli.prefix, cli.conf)
        var n = 1
        if config.ok(c) {
            n = shell.worker_processes(c)
            if n == 0 {
                var known = true
                let cpus = os_cpus() else |_| {
                    known = false
                    1
                }
                if known {
                    n = cpus
                } else {
                    eprint(
                        "lobo: [notice] worker_processes auto: this host could not answer os_cpus ([os.cpus] io); running 1 worker",
                    )
                    n = 1
                }
            }
        }
        if n > 1 {
            return master_main(cli.prefix, cli.conf, n)
        }
        return serve_main(cli.prefix, cli.conf, 0, "", 0, 1)
    }
    banner()
    0
}
