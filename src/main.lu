//! wws — a production web server in wolf (working name). Entry file:
//! version print and argument dispatch. ws01 adds the nginx shell's
//! config half: `-t`/`-T` with `-c <conf>` and `-p <prefix>`, exit
//! codes per the oracle (0 ok / 1 failed), plus the maintenance verb
//! `directives-md` the gauntlet's docs generator drives. `main`'s
//! legal shapes are E0414's: no parameters — arguments come through
//! `env_args`, which drops argv[0].
//! Defaults: prefix "." and conf "conf/nginx.conf" under it (nginx
//! defaults to its compile-time prefix; wws has no compile-time
//! paths by design — recorded shell delta, harnesses always pass
//! -p/-c explicitly).

use config
use http
use obs
use proxy
use serve
use shell

/// The package version. Matches wolf.pkg; the release ritual (far
/// future) bumps both in one commit. Total; never traps.
fn version() -> str {
    "0.0.1"
}

/// The no-argument banner: identity plus every module's frozen
/// interface version, which is also what keeps each stub import
/// honestly used (E0305).
fn banner() {
    print("wws {version()} — a web server in wolf (working name)")
    let mods = "config {config.version()} · http {http.version()} · obs {obs.version()} · proxy {proxy.version()} · serve {serve.version()} · shell {shell.version()}"
    print("modules: {mods}")
}

/// One usage line; grows with shell/ at ws04.
fn usage() {
    print(
        "usage: wws [-V | --version | help | -t | -T | serve] [-c <conf>] [-p <prefix>] [directives-md]",
    )
}

/// The serving verb: load the config through the include graph, bind
/// its first `listen`, and serve. The per-connection UNIT is
/// serve.serve_conn (the full keepalive lifecycle); the shipped binary
/// drives it through serve.accept_loop, which serves connections
/// sequentially. Task-per-connection (scope + spawn per accept) is the
/// intended concurrent posture and is proven on the DEBUG tier and the
/// native rig lane (tests/serve/keepalive.lu spawns serve_conn), but
/// the LLVM RELEASE tier currently refuses this task entry's func.addr
/// ("the conservatism ledger, not a bug in your program"), and the
/// gauntlet builds BOTH tiers — so the release binary is sequential at
/// v0. Deferral D7 owns the gap (filed upstream). Loopback only.
/// Returns 1 on a config error or a failed bind; the serve loop itself
/// does not return — it is the server.
fn serve_main(prefix: str, conf: str) -> int {
    let c = config.load(prefix, conf)
    if !config.ok(c) {
        eprint("wws: configuration file test failed")
        return 1
    }
    let addr = serve.listen_addr(c)
    let opts = serve.default_opts()
    let lim = http.default_limits()
    serve.accept_loop(c, addr, opts, lim) else |_| {
        eprint("wws: could not bind {addr}")
        return 1
    }
    0
}

fn main() -> int {
    var mode = "banner"
    var bad = ""
    var prefix = "."
    var conf = "conf/nginx.conf"
    var want = ""
    for a in env_args() {
        if want == "c" {
            conf = a
            want = ""
        } else if want == "p" {
            prefix = a
            want = ""
        } else if a == "-V" {
            mode = "version"
        } else if a == "--version" {
            mode = "version"
        } else if a == "help" {
            mode = "help"
        } else if a == "-t" {
            mode = "check"
        } else if a == "-T" {
            mode = "dump"
        } else if a == "-c" {
            want = "c"
        } else if a == "-p" {
            want = "p"
        } else if a == "directives-md" {
            mode = "docs"
        } else if a == "serve" {
            mode = "serve"
        } else {
            mode = "bad"
            bad = a
        }
    }
    if !want.is_empty() {
        eprint("wws: option -{want} requires an argument")
        usage()
        return 2
    }
    if mode == "banner" {
        banner()
        return 0
    }
    if mode == "version" {
        print("wws {version()}")
        return 0
    }
    if mode == "help" {
        usage()
        return 0
    }
    if mode == "check" {
        return config.check(prefix, conf, false)
    }
    if mode == "dump" {
        return config.check(prefix, conf, true)
    }
    if mode == "docs" {
        print_raw(config.directives_markdown())
        return 0
    }
    if mode == "serve" {
        return serve_main(prefix, conf)
    }
    eprint("wws: unknown argument `{bad}`")
    usage()
    2
}
