//! member: true
//! shell — the operator contract: nginx's CLI grammar, the pid-file
//! lifecycle, the lifecycle verbs (stop/quit/reload/reopen), and the
//! platform-independent reload path — a loopback CONTROL CHANNEL the
//! running server listens on. ws04's territory.
//!
//! The split (ws04 contract §3, settled at wsm01/ws15). Signal
//! RECEPTION landed (s114, wolf-lang#126's first half), so a real
//! SIGHUP/SIGTERM/SIGQUIT reaches the same verb dispatch the control
//! channel drives. What did NOT land is the SEND side: the pin
//! exposes neither a getpid nor an arbitrary-pid signal send (os_kill
//! terminates a CHILD by handle only), so `-s` drives the control
//! channel and the pid file records the control ENDPOINT, not an os
//! pid — the named residue, flipping the sprint after #126's second
//! half lands. The control channel is therefore the working path AND
//! the Windows reload story, and ws15 makes it the SERVER'S ORDER
//! DESK rather than a reload pipe: the whole verb set
//! (`reload`/`quit`/`stop`/`reopen`/`status`/`upgrade`/`ping`) is
//! reachable over it, `lobo control <verb>` is its CLI door, and an
//! optional shared secret read from an operator-owned token file is
//! its second auth arm beside the loopback bind. docs/CONTROL.md is
//! the page. ws29 (lobo#4): this paragraph was written at ws15, when
//! wolf had no unix-domain socket on any host and every spelling
//! answered a bare `io` (wolf-lang#227) — which is why it said the
//! listener is loopback TCP everywhere. `[os.net.unix]` landed at the
//! ws17 pin (s136) and there are TWO transports now: `unix:<path>`,
//! nginx's own spelling and the RECOMMENDED default where the host
//! has the family, because file permissions are a uid boundary and a
//! loopback port is not; and loopback TCP, which keeps the token arm
//! and is the fallback where the family is missing. This module's own
//! `is_unix_addr`/`unix_path_of` below are that form.
//!
//! Design (contract §3 sketch): every trigger — a control command
//! today, a real signal when #126 lands — flows through the SAME verb
//! dispatch (in the entry's poll loop), so the paths are
//! interchangeable and join the same tests. The config model is FROZEN
//! after parse (ws01): a reload builds a NEW model and SWAPS the
//! reference; serving code never mutates config state, so an in-flight
//! request finishing on the old generation and a new request routing
//! the new one is data, not a race (contract pitfall — the
//! frozen-model discipline).
//!
//! ws08 lives here as the PURE reporting surface for the drain the
//! entry's loop counts: the generation-id content hash, the
//! worker_shutdown_timeout parse, the FROZEN log-event vocabulary
//! (ws09/ws12 reuse the names), and the status stanza builders (human
//! text + versioned JSON), plus `control_fetch` for the multi-line
//! status reply. The counter itself is the loop's; the words are here.
//!
//! Lane note: the CLI grammar and the text builders are PURE and run
//! on all three lanes; the pid lifecycle is fs (native+checked); the
//! control client is net (all three). File-header note (F-0016):
//! comments never sit directly above a dotted call — `wolf fmt`
//! splits the call at the dot.

use config

/// This module's interface version. Bumped from the ws00 stub's
/// "0.0.1" as ws04 lands its real surface. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ------------------------------------------------------------------
// the release stamp — lobo's own provenance (ws19). FIVE constants,
// and with wolf.pkg and the wire token in serve.default_opts the ONLY
// version sites in the tree: tools/lobo-stamp --check (a gauntlet
// step) holds them all equal, holds toolchain_version/toolchain_pin/
// std_rev equal to wolf-toolchain.toml, and holds the channel against
// git's tags. wolf's own `--version` is the model (D57: the bare
// version exactly at the release tag, a dev suffix anywhere else) —
// but a wolf PROGRAM cannot read a compile-time env, `wolf build`
// takes no define, and D33 forbids the build script that would write
// one, so the stamp is SOURCE and the gate is what keeps it true.
// The upstream answer is wolf-lang#247 (a builtin naming the
// compiling toolchain); toolchain_version/toolchain_pin become that
// call the day it lands. The release ritual: release_version,
// wolf.pkg, the wire token and the CHANGELOG entry move in ONE commit
// with the channel ""; the orchestrator tags it; the first commit
// after the tag flips the channel to "+dev", and the gate is RED
// until it does — that red is the design, not an accident. Every fn
// here is pure and total.
// ------------------------------------------------------------------

/// The package version — MAJOR.MINOR.PATCH, wolf.pkg's `version`.
pub fn release_version() -> str {
    "0.1.0"
}

/// The channel: "" exactly at the tree a `v<release_version>` tag
/// points at (or is about to), "+dev" at every other tree. Printed
/// after the version by `-v`, carried in the archive's name.
pub fn release_channel() -> str {
    "+dev"
}

/// The wolf this binary was built with — wolf-toolchain.toml [wolf]'s
/// version (bare at a release tag; `0.2.5+dev.32f66bf` at a trunk pin).
pub fn toolchain_version() -> str {
    "0.2.10+dev.fc07cc5"
}

/// …and its commit: the short sha `wolf --version` names as `pin`.
pub fn toolchain_pin() -> str {
    "fc07cc5"
}

/// The wolf-std tree compiled in — wolf-toolchain.toml [std]'s rev,
/// short. A tree has no --version; its sha is its identity.
pub fn std_rev() -> str {
    "bd12ef5"
}

/// The pin file's [wolf] version_line, reassembled: what `wolf
/// --version` printed on the machine that built this binary.
pub fn toolchain_line() -> str {
    "wolf {toolchain_version()} (wolfgang, pin {toolchain_pin()})"
}

// ------------------------------------------------------------------
// the CLI grammar — a PURE parse of argv into a decision, so the
// whole flag table is testable off the socket, on every lane.
// nginx's shape: `nginx [-?hvVtTq] [-s signal] [-p prefix]
//                       [-e filename] [-c filename] [-g directives]`
// ------------------------------------------------------------------

/// The parsed command line. `mode` is the verb the entry dispatches:
/// banner | version | version_verbose | help | check | dump | docs |
/// serve | signal | status | control | error. `signal` carries the
/// validated verb when `mode == "signal"` — and, when `mode ==
/// "control"`, the control-endpoint verb `lobo control <verb>` names
/// (ws15: the whole verb set, `status`/`upgrade`/`ping` included,
/// reachable from the CLI without widening nginx's `-s`, whose four
/// words stay exactly four — the parity the shell differential
/// probes). `format` is the `--format` value
/// (default "text", "json" for the machine-readable `lobo status`).
/// `err_msg` is the nginx-shaped diagnostic (own identity: "lobo: …" for
/// "nginx: …") and `exit_code` the code to return when `mode ==
/// "error"` (or a terminal mode's code). The path knobs (`prefix`,
/// `conf`, `errlog`, `globals`) and `quiet` carry through to the acting
/// modes. The ws07 dry-run knobs ride `-t`: `requests` is the
/// repeatable `--request` probe batch, `sni`/`client` feed the
/// TLS-selection and client-address decision inputs, `stat` the fs
/// opt-in — each REQUIRES `-t` (spelled anywhere else they are the
/// named error, so the surface cannot silently mean nothing).
pub struct Cli {
    mode: str,
    signal: str,
    prefix: str,
    conf: str,
    errlog: str,
    globals: str,
    quiet: bool,
    err_msg: str,
    exit_code: int,
    format: str,
    requests: List[str],
    sni: str,
    client: str,
    stat: bool,
    worker: int,
    worker_control: str,
    inherit: int,
}

/// True when `name` is one of nginx's four signal words. Total.
pub fn signal_ok(name: str) -> bool {
    name == "stop" || name == "quit" || name == "reload" || name == "reopen"
}

/// The unix signal a verb maps to (stop=TERM, quit=QUIT, reload=HUP,
/// reopen=USR1) — reported by `-V`/docs and the note the deferred
/// receiver will honor; the control channel carries the verb WORD, so
/// this is documentation, not a send today. "" for an unknown verb.
pub fn signal_unix(name: str) -> str {
    if name == "stop" {
        return "TERM"
    }
    if name == "quit" {
        return "QUIT"
    }
    if name == "reload" {
        return "HUP"
    }
    if name == "reopen" {
        return "USR1"
    }
    ""
}

/// Parse argv (env_args order — argv[0] already dropped) into a `Cli`.
/// PURE and total: never touches fs/net, never traps. Mirrors nginx's
/// getopt discipline — mode flags (`-v -V -t -T -h -?`), the quiet
/// modifier (`-q`), the arg-taking options (`-s -p -c -e -g`), and
/// lobo's own verbs (`serve`, `directives-md`). An option missing its
/// argument, an unknown option, or an invalid signal word is
/// `mode == "error"` with the oracle-shaped message and exit 1.
pub fn parse_cli(args: List[str]) -> Cli {
    var mode = "banner"
    var signal = ""
    var prefix = "."
    var conf = "conf/nginx.conf"
    var errlog = ""
    var globals = ""
    var quiet = false
    var format = "text"
    var requests = List[str]()
    var sni = ""
    var client = ""
    var stat = false
    var worker: int = 0
    var worker_control = ""
    var inherit: int = 0
    var want = ""
    var want_kind = ""
    var err_msg = ""
    var errored = false
    for a in args {
        if errored {
            // first error is terminal (nginx stops at the first)
        } else if !want.is_empty() {
            if want == "s" {
                if signal_ok(a) {
                    mode = "signal"
                    signal = a
                } else {
                    errored = true
                    err_msg = "invalid option: \"-s {a}\""
                }
            } else if want == "p" {
                prefix = a
            } else if want == "c" {
                conf = a
            } else if want == "e" {
                errlog = a
            } else if want == "g" {
                globals = a
            } else if want == "format" {
                format = a
            } else if want == "request" {
                (mut requests).push(a)
            } else if want == "sni" {
                sni = a
            } else if want == "client" {
                client = a
            } else if want == "worker" {
                // ws16: the master's internal flags — a hand's ordinal
                // (digits, >= 1) and the endpoint it must listen on.
                // Not on the usage page: an operator never types them
                worker = digits_val(a)
                if worker < 1 {
                    errored = true
                    err_msg = "option \"--worker\" requires a positive ordinal (internal: the master's flag)"
                }
            } else if want == "worker-control" {
                worker_control = a
            } else if want == "inherit" {
                // ws17: how many LISTENERS the master handed this hand
                // through `os_spawn_with` — 0, 1 (plaintext or TLS
                // alone) or 2 (both). The hand adopts descriptors 3,
                // 4, … in the config's own order; the numbering is
                // `[os.proc.inherit]`'s contract, so the count is all
                // that has to cross the argv. A third internal flag,
                // never on the usage page.
                inherit = digits_val(a)
                if inherit < 0 || inherit > 2 {
                    errored = true
                    err_msg = "option \"--inherit\" takes 0, 1 or 2 (internal: the master's flag)"
                }
            } else if want == "control" {
                if control_verb_ok(a) {
                    mode = "control"
                    signal = a
                } else {
                    errored = true
                    err_msg = "invalid \"control\" verb: \"{a}\" (expected: reload, quit, stop, reopen, status, upgrade, ping)"
                }
            } else if want == "cert" {
                if a == "status" {
                    mode = "cert_status"
                } else {
                    errored = true
                    err_msg = "invalid \"cert\" subcommand: \"{a}\" (expected: status)"
                }
            }
            want = ""
            want_kind = ""
        } else if a == "-v" {
            mode = "version"
        } else if a == "-V" {
            mode = "version_verbose"
        } else if a == "-t" {
            mode = "check"
        } else if a == "-T" {
            mode = "dump"
        } else if a == "-q" {
            quiet = true
        } else if a == "-h" || a == "-?" || a == "help" {
            mode = "help"
        } else if a == "-s" {
            want = "s"
            want_kind = "parameter"
        } else if a == "-p" {
            want = "p"
            want_kind = "directory name"
        } else if a == "-c" {
            want = "c"
            want_kind = "file name"
        } else if a == "-e" {
            want = "e"
            want_kind = "file name"
        } else if a == "-g" {
            want = "g"
            want_kind = "parameter"
        } else if a == "--version" {
            mode = "version"
        } else if a == "--format" {
            want = "format"
            want_kind = "parameter"
        } else if a == "--request" {
            want = "request"
            want_kind = "parameter"
        } else if a == "--sni" {
            want = "sni"
            want_kind = "parameter"
        } else if a == "--client" {
            want = "client"
            want_kind = "parameter"
        } else if a == "--stat" {
            stat = true
        } else if a == "--worker" {
            want = "worker"
            want_kind = "parameter"
        } else if a == "--worker-control" {
            want = "worker-control"
            want_kind = "parameter"
        } else if a == "--inherit" {
            want = "inherit"
            want_kind = "parameter"
        } else if a == "directives-md" {
            mode = "docs"
        } else if a == "logvars-md" {
            mode = "logvars"
        } else if a == "metrics-md" {
            mode = "metricsdocs"
        } else if a == "serve" {
            mode = "serve"
        } else if a == "status" {
            mode = "status"
        } else if a == "control" {
            want = "control"
            want_kind = "verb"
        } else if a == "cert" {
            want = "cert"
            want_kind = "subcommand"
        } else if a.starts_with("-") {
            errored = true
            let letter = a[1..a.len]
            err_msg = "invalid option: \"{letter}\""
        } else {
            errored = true
            err_msg = "invalid option: \"{a}\""
        }
    }
    // a trailing arg-taking option with no argument (nginx: "option
    // \"-c\" requires file name", exit 1). The long options spell
    // their own name in the diagnostic.
    if !errored && !want.is_empty() {
        errored = true
        if want.len > 1 {
            err_msg = "option \"--{want}\" requires {want_kind}"
        } else {
            err_msg = "option \"-{want}\" requires {want_kind}"
        }
    }
    // the dry-run knobs require -t (ws07): anywhere else they would
    // silently mean nothing, and this surface never means nothing
    if !errored && mode != "check" {
        if requests.len > 0 {
            errored = true
            err_msg = "option \"--request\" requires -t (the dry-run rides the config check)"
        } else if !sni.is_empty() {
            errored = true
            err_msg = "option \"--sni\" requires -t --request"
        } else if !client.is_empty() {
            errored = true
            err_msg = "option \"--client\" requires -t --request"
        } else if stat {
            errored = true
            err_msg = "option \"--stat\" requires -t --request"
        }
    }
    if !errored && mode == "check" && requests.len == 0 {
        if !sni.is_empty() || !client.is_empty() || stat {
            errored = true
            err_msg = "options \"--sni\"/\"--client\"/\"--stat\" shape --request probes; add --request"
        }
    }
    // the worker flags come as a PAIR, and only with `serve`;
    // `--inherit` (ws17) rides with them and never alone. `--hands`
    // rode here too until ws18 deleted the accept turn that read it —
    // it is not a retired flag with a kind refusal, it is GONE, and an
    // argv carrying it takes the ordinary `invalid option` road.
    if !errored && inherit > 0 && (worker == 0 || mode != "serve") {
        errored = true
        err_msg = "option \"--inherit\" rides the master's worker flags (internal)"
    }
    if !errored && (worker > 0 || !worker_control.is_empty()) {
        if mode != "serve" {
            errored = true
            err_msg = "options \"--worker\"/\"--worker-control\" are the master's flags for `serve` (internal)"
        } else if worker == 0 || worker_control.is_empty() {
            errored = true
            err_msg = "options \"--worker\" and \"--worker-control\" come together (internal: the master's flags)"
        }
    }
    if errored {
        mode = "error"
    }
    let code = if errored { 1 } else { 0 }
    Cli {
        mode: mode,
        signal: signal,
        prefix: prefix,
        conf: conf,
        errlog: errlog,
        globals: globals,
        quiet: quiet,
        err_msg: err_msg,
        exit_code: code,
        format: format,
        requests: requests,
        sni: sni,
        client: client,
        stat: stat,
        worker: worker,
        worker_control: worker_control,
        inherit: inherit,
    }
}

// ------------------------------------------------------------------
// the text builders — nginx's one-fact-per-line shapes, lobo identity.
// nginx prints all of these to STDERR (measured against the oracle);
// the entry follows suit.
// ------------------------------------------------------------------

/// The server identity token, "lobo/<ver>" (nginx: "nginx/1.30.4") —
/// the WIRE identity: the Server header and the build_info metric.
/// Bare on every channel, the way nginx's is; provenance is `-v`'s.
/// Total.
pub fn version_token() -> str {
    "lobo/{release_version()}"
}

/// The one-line version report (`-v`): the version, the channel, and
/// the toolchain pin the binary was built with — W7's acceptance
/// criterion (D57: a binary that cannot name its own provenance is
/// one nobody can debug). nginx's prefix (`nginx version:
/// nginx/1.30.4`) with wolf's parenthetical: "lobo version: lobo/0.1.0
/// (built with wolf 0.2.6, pin 398e5f5)". Total.
pub fn version_report() -> str {
    "lobo version: {version_token()}{release_channel()} (built with wolf {toolchain_version()}, pin {toolchain_pin()})"
}

/// The `-V` build metadata, nginx's one-line-per-fact shape: the
/// report, the toolchain's own version line, the std tree, the tier
/// posture and the module set. The tier line names what the release
/// path builds; the binary cannot tell which tier built it (the
/// second hole wolf-lang#247 names). Total.
pub fn version_verbose() -> str {
    var s = "{version_report()}\n"
    s = "{s}built with {toolchain_line()}\n"
    s = "{s}std: wolf-std {std_rev()}\n"
    s = "{s}tier: two-tier (owned debug + LLVM release; the archive is the release tier, WOLF_MIDEND=0 while wolf-lang#146 stands)\n"
    s = "{s}modules: config {config.version()} · http · serve · proxy · obs · shell {version()}\n"
    s
}

/// The usage text (`-h`/`-?`/`help`), nginx's Usage shape plus lobo's
/// own verbs on a trailing line. Total.
pub fn usage_text() -> str {
    var s = "{version_report()}\n"
    s = "{s}Usage: lobo [-?hvVtTq] [-s signal] [-p prefix]\n"
    s = "{s}           [-e filename] [-c filename] [-g directives]\n"
    s = "{s}       lobo -t --request '<method> <scheme>://<host>/<path>' ...\n"
    s = "{s}           [--sni name] [--client addr] [--stat] [--format json]\n"
    s = "{s}           (the config dry-run: what would this config DO — ws07)\n"
    s = "{s}       lobo [serve | directives-md | logvars-md | metrics-md]\n"
    s = "{s}           (lobo-native verbs)\n"
    s = "{s}       lobo status [--format json] | cert status\n"
    s = "{s}       lobo control <reload|quit|stop|reopen|status|upgrade|ping>\n"
    s = "{s}           (the control endpoint's verbs — docs/CONTROL.md)\n"
    s
}

// ------------------------------------------------------------------
// the pid file — the running master's rendezvous. At this pin the
// content is the CONTROL ENDPOINT (a loopback address), not an os pid
// (no getpid; #126): `-s` and stale-detection reach the master by
// CONNECTING to it, which is a liveness probe the pin can express and
// a real signal is not. Write-rename so a reader never sees a torn
// file (contract pitfall). Flips to the os pid when #126 lands.
// ------------------------------------------------------------------

/// The pid file path: the `pid` directive's argument resolved under
/// `prefix`, else nginx's default "logs/nginx.pid" under the prefix.
/// An absolute directive value is honored verbatim. Total.
pub fn pid_path(c: config.Conf, prefix: str) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "pid" && c.args_n[i] >= 1 {
            let p = c.argp[c.args_at[i]]
            if p.starts_with("/") {
                return p
            }
            return "{prefix}/{p}"
        }
        i = i + 1
    }
    "{prefix}/logs/nginx.pid"
}

/// Write `endpoint` to the pid file atomically: create the parent
/// directory if absent (lobo owns its runtime dirs — nginx's logs/ is
/// there by its install), write a sibling temp file, then rename over
/// the target, so a concurrent reader sees either the old file or the
/// whole new one, never a partial write. Rows: fs `io` (a write or
/// rename that failed). Total otherwise.
pub fn pid_write(path: str, endpoint: str) -> () ! {io} {
    let slash = path.rfind("/") else -1
    if slash > 0 {
        let dir = path[0..slash]
        fs_create_dir_all(dir) else |_| {}
    }
    let tmp = "{path}.new"
    fs_write_text(tmp, "{endpoint}\n") else |_| {
        return io
    }
    fs_rename(tmp, path) else |_| {
        return io
    }
}

/// Read the pid file's endpoint (the first line, trimmed). Rows:
/// `none` when the file does not exist (nginx's "No such file or
/// directory" on `-s` with no master), `io` on a read failure — two
/// tags a caller acts on differently (allow w0602: the row is
/// deliberate API, one tag per distinct failure).
#[allow(w0602)]
pub fn pid_read(path: str) -> str ! {none, io} {
    if !fs_exists(path) {
        return none
    }
    let raw = fs_read_text(path) else |_| {
        return io
    }
    raw.trim()
}

/// Remove the pid file (the master's shutdown step, and the stale-file
/// replacement). Swallows a missing file; rows `io` on a real failure.
pub fn pid_remove(path: str) -> () ! {io} {
    if !fs_exists(path) {
        return
    }
    fs_remove(path) else |_| {
        return io
    }
}

// ------------------------------------------------------------------
// the control channel — a loopback command listener the running
// server owns. One-line commands, one-line replies. Off by default
// (no `control` directive → no listener), loopback-bound, linted as
// non-nginx surface (ws14's security pass audits it — kept minimal).
// ------------------------------------------------------------------

/// The control address: the `control` directive's argument, or "" when
/// the directive is absent (the channel is OFF by default). A bare
/// port becomes a loopback bind (loopback-only, forever); a `unix:`
/// address is kept whole and dialled by `control_dial` (ws17). Total.
pub fn control_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "control" && c.args_n[i] >= 1 {
            let a = c.argp[c.args_at[i]]
            if is_unix_addr(a) {
                return a
            }
            if a.contains(":") {
                return a
            }
            return "127.0.0.1:{a}"
        }
        i = i + 1
    }
    ""
}

// ------------------------------------------------------------------
// ws17: the endpoint's UNIX TRANSPORT (wolf-lang#227, landed at this
// pin as `[os.net.unix]`; std wraps it as `std.net.unix`, sc36). ws15
// filed the issue after measuring that wolf had no unix-domain socket
// on ANY host and shipping loopback TCP everywhere; ws16 deferred the
// consumption; this is it.
//
// What it buys is the thing a loopback port cannot be: a UID
// BOUNDARY. A control port on 127.0.0.1 is reachable by every local
// user, which is why ws15 grew the token-file arm at all. A socket in
// a directory the operator owns is permissioned by the filesystem, so
// `control unix:/run/lobo/control.sock;` needs no shared secret to
// keep another user off it — the token arm stays for the TCP form and
// for a host with no unix family.
//
// The spelling is `unix:<path>` — nginx's own `listen unix:/path`
// spelling, so an operator who knows nginx already knows it. Note
// lobo calls the BUILTINS (`net_listen_unix`, `net_connect_unix`)
// rather than `std.net.unix`: std has no wrap for the ws17 listener
// surfaces either (wolf-std#6 stands, sc37's), and using std for one
// half of the control channel and a builtin for the other would be
// two seams where the repo has always had one.
// ------------------------------------------------------------------

/// True when `addr` names a unix-domain socket path — the `unix:`
/// prefix, nginx's own spelling. Pure and total.
pub fn is_unix_addr(addr: str) -> bool {
    addr.starts_with("unix:")
}

/// The path inside a `unix:` address; "" for a TCP one. Pure and
/// total.
pub fn unix_path_of(addr: str) -> str {
    if !is_unix_addr(addr) {
        return ""
    }
    addr["unix:".len..addr.len]
}

/// A SIBLING unix address for worker `w` beside the master's own —
/// `unix:/run/lobo/control.sock` gives `unix:/run/lobo/control.sock.w2`.
/// The hands' endpoints then live in the master's own directory and
/// inherit its permissions, which makes a HAND's order desk a uid
/// boundary too (ws16 could only offer a loopback port there). Pure
/// and total.
pub fn unix_worker_addr(master: str, w: int) -> str {
    if !is_unix_addr(master) {
        return ""
    }
    "{master}.w{w}"
}

/// Dial a control endpoint, TCP or unix, by the shape of its address.
/// The answer is an ordinary socket either way — `[os.net.unix]`'s
/// whole point is that the family is the only difference. Rows are
/// `net_connect`'s: `refused` (nobody listening, or a stale socket
/// file with no server behind it), `timeout`, `io`.
///
/// **A host with no unix family answers `io` here, not a named row**,
/// because that is what the coarsening of `net_connect_unix`'s
/// `unsupported` costs at the call site; the STARTUP path is where the
/// refusal is named (a `control unix:` config on windows refuses by
/// name rather than serving nothing).
fn control_dial(addr: str) -> int ! {refused, timeout, io} {
    if is_unix_addr(addr) {
        let p = unix_path_of(addr)
        return net_connect_unix(p) else |e| match e {
            unsupported => {
                return io
            },
            not_found => {
                return refused
            },
            refused => {
                return refused
            },
            denied => {
                return io
            },
            io => {
                return io
            },
        }
    }
    net_connect(addr)?
}

/// The control endpoint's TOKEN FILE: the `control` directive's
/// `token <file>` argument, resolved against the prefix like every
/// other configured path, or "" when the directive names none (the
/// channel is then loopback-only, ws04's posture). Total.
pub fn control_token_path(c: config.Conf, prefix: str) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "control" && c.args_n[i] >= 3 {
            let kw = c.argp[c.args_at[i] + 1]
            if kw == "token" {
                let p = c.argp[c.args_at[i] + 2]
                if p.starts_with("/") {
                    return p
                }
                return "{prefix}/{p}"
            }
        }
        i = i + 1
    }
    ""
}

/// Read the shared secret from the token file: its first line,
/// trimmed. lobo READS this file and never writes it — std has no
/// file-permission surface at this pin (wolf-std#5), so a token lobo
/// generated would land at whatever the umask says, and a
/// world-readable secret is worse than no secret at all. The operator
/// creates the file with the mode they want; docs/CONTROL.md says so
/// out loud. Rows: `none` when the file is absent (a config error the
/// startup path names), `io` on a read failure (allow w0602: two tags
/// a caller acts on differently).
#[allow(w0602)]
pub fn control_token_read(path: str) -> str ! {none, io} {
    if !fs_exists(path) {
        return none
    }
    let raw = fs_read_text(path) else |_| {
        return io
    }
    let nl = raw.find("\n") else -1
    if nl >= 0 {
        return raw[0..nl].trim()
    }
    raw.trim()
}

/// The wire line a control client sends: the verb, prefixed with the
/// shared secret when one is configured. PURE, so the whole auth
/// shape is testable off the socket on every lane. Total.
pub fn control_line(token: str, verb: str) -> str {
    if token.is_empty() {
        return verb
    }
    "{token} {verb}"
}

/// Whether a received command line carries the configured secret.
/// With no token configured every line is authorized — loopback is
/// the boundary, ws04's posture, kept. `ping` is ALWAYS authorized:
/// it is the liveness probe `-s` and the startup stale-pid check
/// use, it reveals nothing but existence, and gating it would let a
/// rotated token make a LIVE master look dead — which would replace
/// a running server's pid file. The named delta lives in
/// docs/CONTROL.md. Total.
pub fn control_authorized(line: str, token: str) -> bool {
    if token.is_empty() {
        return true
    }
    if line.trim() == "ping" {
        return true
    }
    line.starts_with("{token} ")
}

/// The verb inside a received command line: the line itself when no
/// token is configured, the text after the secret when one is.
/// Answers "" for a line that is not authorized, so a caller that
/// forgets `control_authorized` still dispatches nothing. Total.
pub fn control_verb_of(line: str, token: str) -> str {
    if token.is_empty() {
        return line.trim()
    }
    if line.trim() == "ping" {
        return "ping"
    }
    if line.starts_with("{token} ") {
        return line[token.len + 1..line.len].trim()
    }
    ""
}

/// The control endpoint's VERB SET: nginx's four signal words
/// (`stop`, `quit`, `reload`, `reopen`) plus lobo's own three —
/// `status` (the ws08 drain surface, which also takes the `json`
/// argument), `upgrade` (the binary-swap verb, unclaimed at this pin
/// and answering a named refusal) and `ping` (the liveness probe).
/// Reads the FIRST word, so `status json` passes. Total.
pub fn control_verb_ok(verb: str) -> bool {
    let sp = verb.find(" ") else -1
    let head = if sp > 0 { verb[0..sp] } else { verb }
    if signal_ok(head) {
        return true
    }
    head == "status" || head == "upgrade" || head == "ping"
}

/// Send one command line to the control endpoint and read the one-line
/// reply. Dials, arms a short deadline, writes "`line`\n", reads the
/// reply to a newline, closes. Rows: `refused` (nobody listening — a
/// dead/absent master, which `-s` and stale-detection read as "not
/// alive"), `io` for every other net trouble. The reply is trimmed
/// (allow w0602: deliberate API — refused and other failures differ).
#[allow(w0602)]
pub fn control_send(addr: str, line: str) -> str ! {refused, io} {
    let c = control_dial(addr) else |e| match e {
        refused => {
            return refused
        },
        timeout => {
            return io
        },
        io => {
            return io
        },
    }
    net_deadline(c, 2000) else |_| {
        net_close(c) else |_| {}
        return io
    }
    net_write(c, "{line}\n") else |_| {
        net_close(c) else |_| {}
        return io
    }
    var buf = ""
    var reading = true
    while reading {
        let nl = buf.find("\n") else -1
        if nl >= 0 {
            reading = false
        } else {
            let piece = net_read(c, 4096) else |_| {
                reading = false
                ""
            }
            if piece.is_empty() {
                reading = false
            } else {
                buf = "{buf}{piece}"
            }
        }
    }
    net_close(c) else |_| {}
    buf.trim()
}

/// True when the endpoint answers a `ping` — the liveness probe the
/// pin can express (a real kill(pid, 0) is #126). Used by `-s` and by
/// startup stale-detection. Total: any failure reads as "not alive".
pub fn control_alive(addr: str) -> bool {
    if addr.is_empty() {
        return false
    }
    let r = control_send(addr, "ping") else |_| {
        return false
    }
    r == "pong"
}

// ------------------------------------------------------------------
// the verb layer — one dispatch every trigger flows through, so a
// control command today and a signal when #126 lands are the same
// call. A verb is serialized by construction: the server processes
// control connections one at a time, so a second reload arriving mid-
// reload gets the `busy` answer (contract pitfall — nginx queues
// HUPs; one-at-a-time with a named busy answer is the honest v0).
// ------------------------------------------------------------------

/// A server generation: the frozen config model, the generation
/// number (ws08 surfaces old-generation connection counts against it —
/// the counter lands here, the reporting there), whether the last
/// reload succeeded, and the human note the control reply carries.
pub struct Gen {
    conf: config.Conf,
    gen: int,
    ok: bool,
    note: str,
}

/// The initial generation from a loaded config. `gen` starts at 1
/// (nginx's first master is generation 1). Total (the load already
/// happened; this just tags it).
pub fn gen_new(c: config.Conf) -> Gen {
    Gen { conf: c, gen: 1, ok: true, note: "started (generation 1)" }
}

/// Reload: parse the config FRESH through the full ws01 pipeline. On
/// ANY error keep the OLD generation serving and answer a non-zero
/// notice (the nginx contract — the reason `-t` exists); on success
/// freeze the new model, bump the generation, and hand it back for the
/// caller to SWAP the routing reference to. The listen-set diff is the
/// caller's (`listen_addrs`): a surviving address reuses its live
/// listener, a removed one drains, a new one opens. Total.
pub fn reload(prefix: str, conf_rel: str, prev: Gen) -> Gen {
    let c = config.load(prefix, conf_rel)
    if config.ok(c) {
        let g = prev.gen + 1
        return Gen { conf: c, gen: g, ok: true, note: "reload complete (generation {g})" }
    }
    Gen {
        conf: prev.conf,
        gen: prev.gen,
        ok: false,
        note: "reload rejected: configuration test failed; keeping generation {prev.gen}",
    }
}

// ------------------------------------------------------------------
// the listen-set diff — a reload reuses a surviving listener's live
// fd (never close-and-reopen: that loses queued SYNs, the contract's
// hammer-connects-across-a-reload catches it), opens the new, and
// drains the removed. These pure set ops name which is which.
// ------------------------------------------------------------------

/// The normalized bind addresses of every `listen` directive (a bare
/// port becomes a loopback bind — loopback-only, forever). Total; the
/// order is the config's. Duplicates are kept (nginx's own posture).
pub fn listen_addrs(c: config.Conf) -> List[str] {
    var out = List[str]()
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" && c.args_n[i] >= 1 {
            let a = c.argp[c.args_at[i]]
            if a.contains(":") {
                (mut out).push(a)
            } else {
                (mut out).push("127.0.0.1:{a}")
            }
        }
        i = i + 1
    }
    out
}

/// True when `addr` is in `xs`. Total (argument reads are free).
fn addr_in(xs: List[str], addr: str) -> bool {
    for x in xs {
        if x == addr {
            return true
        }
    }
    false
}

/// The addresses in `new` that also appear in `old` — the listeners a
/// reload REUSES (live fd carried across the generation). Total.
pub fn listen_reused(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in new {
        if addr_in(old, a) {
            (mut out).push(a)
        }
    }
    out
}

/// The addresses in `new` not in `old` — the listeners a reload OPENS.
/// Total.
pub fn listen_added(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in new {
        if !addr_in(old, a) {
            (mut out).push(a)
        }
    }
    out
}

/// The addresses in `old` not in `new` — the listeners a reload CLOSES
/// (connections on them drain per the quit rules). Total.
pub fn listen_removed(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in old {
        if !addr_in(new, a) {
            (mut out).push(a)
        }
    }
    out
}

// ------------------------------------------------------------------
// ws08 — the drain you can watch. The generation id (a content hash of
// the frozen model), the worker_shutdown_timeout knob, the log-event
// vocabulary (FROZEN — ws09's JSON logs and ws12's metrics reuse these
// names), and the status surface (text + versioned JSON). All PURE and
// total — they run on all three lanes; the counting itself lives in the
// entry's poll loop (a per-generation live counter, spawn-free).
// ------------------------------------------------------------------

/// A non-negative int as zero-padded 8-digit lowercase hex. Total for
/// `0 <= n < 2^32`.
fn hex8(n: int) -> str {
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    var i: int = 0
    while i < 8 {
        let d = v % 16
        out = "{digits[d..d + 1]}{out}"
        v = v / 16
        i = i + 1
    }
    out
}

/// The generation id: a content hash of the FROZEN config model
/// (`render_conf`'s canonical text), rendered as 16 hex chars. Two
/// checked-arithmetic polynomial rolls (no bit ops — the checked tier
/// refuses `&`/`^`/`>>` on plain int, and `wrapping[u64]` is refused at
/// this pin, F-WS08-clock's sibling) folded to 8 hex each. A reload to
/// an IDENTICAL config yields the SAME id — an operator can see a reload
/// changed nothing — and any content change changes it. Total.
pub fn conf_hash(c: config.Conf) -> str {
    let text = config.render_conf(c)
    var a: int = 0
    var b: int = 0
    for x_raw in text.bytes() {
        let x = x_raw as int
        a = (a * 131 + x) % 2147483647
        b = (b * 1000003 + x + 7) % 2147483647
    }
    "{hex8(a)}{hex8(b)}"
}

/// Parse an nginx-style duration into milliseconds: a trailing `ms` is
/// milliseconds, a trailing `s` is seconds, a bare number is seconds
/// (nginx's default unit for time directives). A malformed value is 0.
/// Total.
fn parse_dur_ms(raw: str) -> int {
    let s = raw.trim()
    if s.is_empty() {
        return 0
    }
    if s.ends_with("ms") {
        return digits_val(s.strip_suffix("ms") else "")
    }
    if s.ends_with("s") {
        return digits_val(s.strip_suffix("s") else "") * 1000
    }
    digits_val(s) * 1000
}

/// A run of ASCII digits as a non-negative int; any non-digit byte
/// stops the scan (so `30s` already stripped to `30` parses, and junk
/// yields what parsed so far). Total.
fn digits_val(s: str) -> int {
    var v: int = 0
    for x_raw in s.bytes() {
        let x = x_raw as int
        if x < 48 || x > 57 {
            return v
        }
        v = v * 10 + (x - 48)
    }
    v
}

/// The `worker_shutdown_timeout` in milliseconds — the deadline a
/// DRAINING generation gets before its remaining connections are
/// aborted and it retires anyway (contract §3). 0 (the nginx default,
/// and the absence of the directive) means NO forced timeout: a
/// generation drains fully, however long that takes. Total.
pub fn shutdown_timeout_ms(c: config.Conf) -> int {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "worker_shutdown_timeout" && c.args_n[i] >= 1 {
            return parse_dur_ms(c.argp[c.args_at[i]])
        }
        i = i + 1
    }
    0
}

// ---- the signal surface (wsm01, s114 in the pin) --------------------
// Real signal reception exists as of the s115 pin: the s114 builtins
// (os_signal_listen/os_signal_wait/os_signal_raise) deliver OS signals
// as events by MEANING ([os.signal.set] — a bitmask, mapped to
// platform signal numbers only at the runtime boundary). These helpers
// are the pure half: the meaning constants and the meaning→verb map.
// The entry owns the listen/wait/forward wiring; BOTH triggers — a
// real SIGHUP and a control-channel line — flow through the ONE verb
// dispatch (the flip ws04 §3 designed for). The UPGRADE meaning (8,
// SIGUSR2 — binary swap) is deliberately not listened yet: that path
// is a later sprint. Zero-arg fns are the portable constant spelling.

/// The RELOAD meaning (bit 1; SIGHUP on unix). Total.
pub fn sig_reload() -> int {
    1
}

/// The TERMINATE meaning (bit 2; SIGTERM on unix — fast shutdown).
/// Total.
pub fn sig_terminate() -> int {
    2
}

/// The QUIT meaning (bit 4; SIGQUIT on unix — graceful drain-then-
/// exit). Total.
pub fn sig_quit() -> int {
    4
}

/// The interest mask of the OPERATOR meanings: RELOAD | TERMINATE |
/// QUIT. Total.
pub fn sig_mask() -> int {
    7
}

/// The probe meaning (bit 8 — UPGRADE, SIGUSR2 on unix). Through ws28
/// the serve loop self-raised this bit on a cadence and waited once,
/// the runtime queue being FIFO so a real pending operator signal came
/// back first and the probe bounded the wait. ws29 (lobo#8) retired
/// that poll for a parked forwarder, and the bit's remaining job is
/// its TEARDOWN: the loop raises it exactly once on its way out and
/// the forwarder, seeing it, retires. NAMED residue, unchanged: until
/// the binary-swap sprint claims UPGRADE, an outside SIGUSR2 is
/// indistinguishable from the probe and is ignored — an operator who
/// sends one now retires a forwarder, and the loop is on its way out
/// or will simply stop hearing signals; the control channel still
/// reaches it. Total.
pub fn sig_probe() -> int {
    8
}

/// The meaning's stable lowercase name (for log events and docs) —
/// the MEANING vocabulary, not the platform signal name. Unknown
/// meanings answer "unknown". Total.
pub fn signal_name(m: int) -> str {
    if m == 1 {
        return "reload"
    }
    if m == 2 {
        return "terminate"
    }
    if m == 4 {
        return "quit"
    }
    "unknown"
}

/// The operator verb a received signal meaning drives: SIGHUP→reload,
/// SIGTERM→stop (nginx's fast shutdown), SIGQUIT→quit (graceful).
/// The SAME verbs the control channel accepts — one dispatch layer.
/// An unknown meaning maps to "" (the entry ignores it). Total.
pub fn signal_verb(m: int) -> str {
    if m == 1 {
        return "reload"
    }
    if m == 2 {
        return "stop"
    }
    if m == 4 {
        return "quit"
    }
    ""
}

/// The signal MEANING a control verb corresponds to — the inverse of
/// `signal_verb`, so ONE emission site can stamp the same
/// `signal-received` event whichever trigger arrived and a verb and a
/// signal are indistinguishable in the log but for their `source`
/// field (ws15). 0 for a verb with no signal twin: `status`, `reopen`
/// and `ping` never had one, and `upgrade` has none at this pin —
/// UPGRADE's bit is lobo's own poll probe on unix and has no windows
/// analog at all ([os.signal.platform]), which is why it is the one
/// verb the control channel reaches and no signal does
/// (docs/CONTROL.md). Total.
pub fn signal_meaning(verb: str) -> int {
    if verb == "reload" {
        return sig_reload()
    }
    if verb == "stop" {
        return sig_terminate()
    }
    if verb == "quit" {
        return sig_quit()
    }
    0
}

// ---- the log-event vocabulary (FROZEN; documented in docs/) ---------
// Each builder returns the event BODY: a stable name then space-
// separated key=value fields. The entry prefixes "lobo: [notice] " and
// emits through the logging seam (eprint, ws02); ws09 reformats these
// names into JSON and ws12 into metrics, so the NAMES and FIELD KEYS
// are a contract, not decoration.

/// A new config generation was parsed and frozen (a reload succeeded).
pub fn ev_generation_loaded(gen: int, hash: str) -> str {
    "generation-loaded gen={gen} id={hash}"
}

/// A generation became the live, accepting one.
pub fn ev_generation_activated(gen: int) -> str {
    "generation-activated gen={gen}"
}

/// A generation stopped accepting and began draining, still holding
/// `held` connections.
pub fn ev_generation_draining(gen: int, held: int) -> str {
    "generation-draining gen={gen} held={held}"
}

/// One connection on a draining generation closed; `remaining` are the
/// connections that generation still holds.
pub fn ev_connection_retired(gen: int, remaining: int) -> str {
    "connection-retired gen={gen} remaining={remaining}"
}

/// A draining generation reached zero connections (or its
/// worker_shutdown_timeout expired): `drained` closed cleanly,
/// `aborted` were force-closed by the timeout, over `age_ms`.
pub fn ev_generation_retired(gen: int, drained: int, aborted: int, age_ms: int) -> str {
    "generation-retired gen={gen} drained={drained} aborted={aborted} age-ms={age_ms}"
}

/// An operator TRIGGER was received and mapped to a verb (the wsm01
/// vocabulary extension; ws15 appends `source`, nothing renamed):
/// `sig` is the meaning's name (reload|terminate|quit), `verb` the
/// dispatched verb, `source` which door it came through — `signal`
/// for a real OS signal, `control` for a verb on the control
/// endpoint. The two triggers run the SAME dispatch and emit through
/// this ONE builder, so the line — and every generation event that
/// follows it — is byte-identical but for that field: `source` is
/// the whole of the difference, which is the point (docs/CONTROL.md
/// carries the paired logs). Every earlier prefix pin still matches.
pub fn ev_signal_received(m: int, source: str) -> str {
    "signal-received sig={signal_name(m)} verb={signal_verb(m)} source={source}"
}

/// A request was refused by its vhost's `memory_budget` (ws10 — the
/// vocabulary's seventh event, appended, nothing renamed): `gen` the
/// generation that served it, `site` the deterministic exceed-site
/// (head|body|body-chunked|file|admin; `region` rides the ws13/ws14
/// twin below with its `cap`), `budget` the configured bytes,
/// `would` what admitting the request would have charged. Level
/// `error` (a shed request is an operator's signal, not a notice).
/// The refused request also writes an ordinary 503 access line.
pub fn ev_budget_exceeded(gen: int, site: str, budget: int, would: int) -> str {
    "budget-exceeded gen={gen} site={site} budget={budget} would={would}"
}

/// The same event for the ws13 `region` site — the RUNTIME refused
/// the body (the region cap, s132/D68) — with one more trailing
/// field, `cap`: the cap in LEDGER units the breach crossed
/// (docs/BUDGET.md's arithmetic: 16× the directive). Appended,
/// nothing renamed; every prefix pin on the seven-field shape still
/// matches. `would` reports `budget+1` — the crossing point — because
/// a killed proc's charge is unobservable at the join
/// ([mem.region.cap.3]: free-then-deliver). Total.
pub fn ev_budget_exceeded_cap(gen: int, site: str, budget: int, would: int, cap: int) -> str {
    "budget-exceeded gen={gen} site={site} budget={budget} would={would} cap={cap}"
}

/// The ws11 sequence stamp: every vocabulary event the server emits
/// carries a trailing `seq=N` — the event's ordinal in the ONE poll
/// loop's emission order (1-based, monotone, never reset while the
/// process lives). Appended by the EMISSION SEAM, not the builders, so
/// every builder shape above is unchanged (the extension discipline:
/// appended, nothing renamed; every existing `contains`/grep pin still
/// matches its prefix). The stamp is what makes an attached log a
/// SCHEDULE: the stream's order is the loop's own decision order, and
/// a gap in `seq` is a visible hole (a level-gated mirror or a counted
/// drop), never a silent one — docs/REPLAY.md is the workflow. Total.
pub fn ev_seq(body: str, seq: int) -> str {
    "{body} seq={seq}"
}

// ---- the status surface --------------------------------------------
// SCALAR builders, not List-of-struct: the checked tier refuses a
// `List[<imported struct>]()` construction (generic data across a
// module boundary), so the generation TABLE is built in the entry over
// its own local row type and formatted one line at a time here. Every
// builder is pure and total, so the shape is unit-tested off the socket
// on all three lanes.

/// The JSON status schema version (the ws07 convention — a versioned,
/// machine-readable surface ws12's metrics endpoint serves too). Bumped
/// only on a breaking shape change. Total.
pub fn status_schema() -> int {
    1
}

/// The human status stanza's header (`lobo status`): the identity line,
/// the current generation, the quit posture, and (ws11, appended —
/// every earlier fact keeps its place) `events:` — the count of
/// vocabulary events emitted so far, i.e. the highest `seq` stamped.
/// The completeness anchor for a bug report's attached log: a stream
/// whose top seq matches `events` has no trailing hole. ws12 appends
/// `live-region-bytes:` — `live_region_bytes()` at the moment the
/// stanza was built ([mem.region.account.2], wolf-lang s131): the
/// process-wide total the RUNTIME holds for live regions. It is not
/// an RSS figure and must not be read as one — the process-root arena
/// (where every str materialization still lands, wolf-lang#191) is
/// never counted. One fact per line, nginx's shape. The entry appends
/// one `status_line_text` per generation. Read over the control
/// channel to the peer's close (the stanza is multi-line), so
/// `control_fetch` reads it. Total.
pub fn status_head_text(current: int, quitting: bool, events: int, live_bytes: int) -> str {
    var s = "lobo status\n"
    s = "{s}current generation: {current}\n"
    s = "{s}quitting: {bool_word(quitting)}\n"
    s = "{s}events: {events}\n"
    s = "{s}live-region-bytes: {live_bytes}\n"
    s
}

/// One generation's line in the human status table. `remaining_ms` is
/// the worker_shutdown_timeout remaining for a draining generation, or
/// -1 when none applies (a current generation, or no timeout). ws10
/// appends the budget aggregates (additive — every earlier fact keeps
/// its place): `mem-hw` is the high-water admitted bytes of any single
/// request served under the generation, `budget-503s` its refusal
/// count (0 0 when no budget is armed — the facts stay printed so a
/// parser never branches). ws12 appends `mem-rt-hw` — the high-water
/// MEASURED region bytes of any single request the generation served
/// ([mem.region.account.1]). `mem-hw` is what lobo's admission meter
/// counted; `mem-rt-hw` is what the runtime charged. They are
/// different units answering different questions and the docs refuse
/// to subtract one from the other. Includes the trailing newline.
/// Total.
pub fn status_line_text(
    gen: int,
    live: int,
    state: str,
    age_ms: int,
    hash: str,
    remaining_ms: int,
    mem_hw: int,
    budget_503s: int,
    mem_rt_hw: int,
) -> str {
    var line = "generation {gen}: {state} live={live} age-ms={age_ms} id={hash} mem-hw={mem_hw} budget-503s={budget_503s} mem-rt-hw={mem_rt_hw}"
    if remaining_ms >= 0 {
        line = "{line} shutdown-in-ms={remaining_ms}"
    }
    "{line}\n"
}

/// The JSON status stanza's open: `{"schema":1,"current":N,
/// "quitting":b,"events":N,"generations":[` (no newlines). `events`
/// is ws11's ADDITIVE member (the vocabulary-event count — the highest
/// `seq` emitted; schema stays 1, nothing renamed or moved, the ws07
/// convention for a widening). The entry appends comma-separated
/// `status_json_obj`s then `status_json_close`. ws12's metrics
/// endpoint serves this same object at `/status.json` and adds
/// `live_region_bytes` (additive; schema stays 1). Total.
pub fn status_json_open(current: int, quitting: bool, events: int, live_bytes: int) -> str {
    "{{\"schema\":{status_schema()},\"current\":{current},\"quitting\":{bool_word(quitting)},\"events\":{events},\"live_region_bytes\":{live_bytes},\"generations\":["
}

/// One generation as a JSON object (no leading comma, no newline) — the
/// entry joins these with commas. ws10 adds `mem_high_water` and
/// `budget_503s`; ws12 adds `mem_rt_high_water`, the measured region
/// figure (additive members; schema stays 1 — nothing renamed or
/// moved, the ws07 convention for a widening). Total.
pub fn status_json_obj(
    gen: int,
    state: str,
    live: int,
    age_ms: int,
    hash: str,
    remaining_ms: int,
    mem_hw: int,
    budget_503s: int,
    mem_rt_hw: int,
) -> str {
    "{{\"gen\":{gen},\"state\":\"{state}\",\"live\":{live},\"age_ms\":{age_ms},\"id\":\"{hash}\",\"mem_high_water\":{mem_hw},\"budget_503s\":{budget_503s},\"mem_rt_high_water\":{mem_rt_hw},\"shutdown_remaining_ms\":{remaining_ms}}}"
}

/// The JSON status stanza's close: `]}`. Total.
pub fn status_json_close() -> str {
    "]}}"
}

/// "true"/"false" — the shared spelling for the human stanza and the
/// JSON wire (JSON's booleans are the same two words). Total.
fn bool_word(b: bool) -> str {
    if b {
        return "true"
    }
    "false"
}

// ------------------------------------------------------------------
// control_fetch — the read-to-close variant of control_send, for a
// MULTI-LINE reply (the status stanza). control_send stops at the first
// newline (a one-line verb reply); status needs the whole body, which
// the server writes and then closes, so the client reads to the close.
// ------------------------------------------------------------------

/// Send one command line and read the reply until the peer closes
/// (ignoring interior newlines — the status stanza is multi-line). Rows
/// mirror control_send: `refused` (no master), `io` otherwise. The
/// reply keeps its interior newlines; the trailing newline is trimmed.
#[allow(w0602)]
pub fn control_fetch(addr: str, line: str) -> str ! {refused, io} {
    let c = control_dial(addr) else |e| match e {
        refused => {
            return refused
        },
        timeout => {
            return io
        },
        io => {
            return io
        },
    }
    net_deadline(c, 2000) else |_| {
        net_close(c) else |_| {}
        return io
    }
    net_write(c, "{line}\n") else |_| {
        net_close(c) else |_| {}
        return io
    }
    var buf = ""
    var reading = true
    while reading {
        let piece = net_read(c, 4096) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    net_close(c) else |_| {}
    buf.trim()
}

// ------------------------------------------------------------------
// ws16: many hands — the prefork surface (D73, D7 kept). A running
// lobo with `worker_processes N` (N >= 2) is a MASTER that starts N
// workers through `os.process` — each worker is today's one poll
// loop in its own os process, spawn-free inside — and supervises
// them over per-worker loopback control endpoints (the ws15 order
// desk, one per hand). The pure half lives here: the directive's
// value, the cpu count `auto` resolves through, the worker argv, the
// worker events (appended to the frozen vocabulary, nothing
// renamed), the `worker=` trailing field, the master's status rows
// and the readers that fold a worker's stanza back into them.
// docs/WORKERS.md is the page; the accept-distribution posture at
// this pin is MEASURED there, not assumed.
// ------------------------------------------------------------------

/// The `worker_processes` directive's value: absent → 1 (nginx's
/// default); `auto` → 0, the sentinel the entry resolves through
/// `os_cpus`; a digit run → its value, with `0` read as 1 — a NAMED
/// delta: nginx accepts `worker_processes 0` (a master with no hands,
/// serving nothing), which lobo declines to imitate. Total.
pub fn worker_processes(c: config.Conf) -> int {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "worker_processes" && c.args_n[i] >= 1 {
            let raw = c.argp[c.args_at[i]].trim()
            if raw == "auto" {
                return 0
            }
            let v = digits_val(raw)
            if v < 1 {
                return 1
            }
            return v
        }
        i = i + 1
    }
    1
}

// ws17: the cpu count RETIRES from this module. ws16 resolved
// `worker_processes auto` by counting `processor` rows in
// `/proc/cpuinfo` (linux) with `NUMBER_OF_PROCESSORS` behind it and
// nothing at all on macOS — a startup notice and one worker, filed as
// wolf-lang#233. s137 landed `os_cpus()` (`[os.cpus]`), so the reader
// and its pure twin are GONE rather than kept beside the builtin, and
// `auto` resolves in main's `serve` arm through the call itself. Two
// reasons the call does not live here: this module is on the lupin
// lane in six corpus tests and lupin 0.1.25 predates s137 (the pin
// file's lane-gap note), and `os_cpus`'s `io` row is a decision the
// ENTRY takes — the issue's own instruction is not to swallow it into
// a default. The row-count reader is not merely shorter to replace:
// on a cgroup-quota'd host `/proc/cpuinfo` answered the machine's
// cores and lobo would have started workers that never get one.

/// The ARGUMENTS a master starts a hand with, the program named
/// apart: `serve`, the same prefix and config, and the three internal
/// flags that make the child a hand rather than a master — its
/// ordinal, the control endpoint the master will reach it on (ws16),
/// and how many listeners rode down with it (ws17). A fourth,
/// `--hands N`, rode here from ws17 until ws18: it existed only so a
/// hand could compute its accept TURN, and the turn retired with
/// wolf-lang#242. A free-for-all hand has no reason to know how many
/// siblings it has. One value
/// per element, no quoting anywhere (the spawn takes a vector;
/// std.process's whole reason is that there is no shell). This is the
/// shape `os_spawn_with(exe, args, inherit)` wants — the executable is
/// its own parameter there, so a master never splices its own path
/// into a list it also builds options in. Pure and total.
pub fn worker_args(prefix: str, conf: str, worker: int, ctrl: str, inherit: int) -> List[str] {
    var a = List[str]()
    (mut a).push("serve")
    (mut a).push("-p")
    (mut a).push(prefix)
    (mut a).push("-c")
    (mut a).push(conf)
    (mut a).push("--worker")
    (mut a).push("{worker}")
    (mut a).push("--worker-control")
    (mut a).push(ctrl)
    (mut a).push("--inherit")
    (mut a).push("{inherit}")
    a
}

/// `worker_args` with the executable at the head — the single-vector
/// shape `os_spawn` takes, which is the FALLBACK path (a host that
/// answers `unsupported` to a non-empty inherit set, and the
/// zero-listener case). Pure and total.
pub fn worker_argv(exe: str, prefix: str, conf: str, worker: int, ctrl: str, inherit: int) -> List[
    str,
] {
    var a = List[str]()
    (mut a).push(exe)
    for w in worker_args(prefix, conf, worker, ctrl, inherit) {
        (mut a).push(w)
    }
    a
}

/// `worker-started worker=N restarts=R` — the master started (or
/// restarted: `restarts` counts the replacements of this slot) a
/// worker. The tenth vocabulary event (ws16, appended). Total.
pub fn ev_worker_started(worker: int, restarts: int) -> str {
    "worker-started worker={worker} restarts={restarts}"
}

/// `worker-exited worker=N reason=R code=C` — the master reaped a
/// worker: `reason` is `exit` (it returned a code, in `code`),
/// `signal` (it died without one — killed, or crashed; `code` is -1)
/// or `unreachable` (its control endpoint refused for longer than the
/// supervision grace and the master killed it; `code` is what the
/// reap then answered, -1 for a signal). The eleventh vocabulary
/// event (ws16, appended). Total.
pub fn ev_worker_exited(worker: int, reason: str, code: int) -> str {
    "worker-exited worker={worker} reason={reason} code={code}"
}

/// The `worker=N` trailing field a WORKER stamps on every line it
/// emits — vocabulary events after their `seq`, prose notices at
/// their end — so N processes appending to one error log stay
/// separable. Appended, nothing renamed: every prefix pin ws02
/// through ws15 wrote still matches, and the JSON door types it as a
/// number member through the same k=v decode. A single-process lobo
/// (the default) stamps nothing — its lines are byte-identical to
/// ws15's. Total.
pub fn ev_worker_field(body: str, worker: int) -> str {
    "{body} worker={worker}"
}

/// The master stanza's `workers:` line — the configured count,
/// appended to `status_head_text`'s facts (every earlier fact keeps
/// its place). Includes the trailing newline. Total.
pub fn status_workers_line(n: int) -> str {
    "workers: {n}\n"
}

/// One worker's row in the master's human stanza: its ordinal, its
/// posture (`serving` holds every listener the config asks for,
/// `standby` is waiting for one another worker holds — this pin's
/// accept-distribution posture, docs/WORKERS.md — `unreachable`
/// answered nothing), its control endpoint (so an operator can reach
/// ONE hand), its current generation, the connections it holds, its
/// own event count (its seq stream's top — seq is per PROCESS), its
/// live region bytes, its budget refusals and how many times the
/// master has replaced it. Includes the trailing newline. Total.
pub fn status_worker_text(
    worker: int,
    state: str,
    ctrl: str,
    gen: int,
    live: int,
    events: int,
    live_bytes: int,
    budget_503s: int,
    restarts: int,
    accepted: int,
) -> str {
    "worker {worker}: {state} control={ctrl} generation={gen} live={live} accepted={accepted} events={events} live-region-bytes={live_bytes} budget-503s={budget_503s} restarts={restarts}\n"
}

/// One worker as a JSON object in the master's stanza (no leading
/// comma, no newline) — the same facts as `status_worker_text`, the
/// same key spellings as the generation objects (`live_region_bytes`,
/// `budget_503s`). Total.
pub fn status_worker_json(
    worker: int,
    state: str,
    ctrl: str,
    gen: int,
    live: int,
    events: int,
    live_bytes: int,
    budget_503s: int,
    restarts: int,
    accepted: int,
) -> str {
    "{{\"worker\":{worker},\"state\":\"{state}\",\"control\":\"{ctrl}\",\"generation\":{gen},\"live\":{live},\"accepted\":{accepted},\"events\":{events},\"live_region_bytes\":{live_bytes},\"budget_503s\":{budget_503s},\"restarts\":{restarts}}}"
}

/// The MASTER's JSON stanza open: schema 1's members with the master's
/// own numbers (`current` its configuration generation, `events` its
/// own seq top, `live_region_bytes` the SUM over its workers), an
/// EMPTY `generations` array (a master serves nothing and holds no
/// generation table — the array is kept so a schema-1 reader never
/// branches), `workers_configured`, and the `workers` array the entry
/// fills with `status_worker_json` objects and closes with
/// `status_json_close`. Additive on schema 1 (nothing renamed or
/// moved). Total.
pub fn status_json_master_open(current: int, quitting: bool, events: int, live_bytes: int, n: int) -> str {
    "{{\"schema\":{status_schema()},\"current\":{current},\"quitting\":{bool_word(quitting)},\"events\":{events},\"live_region_bytes\":{live_bytes},\"workers_configured\":{n},\"generations\":[],\"workers\":["
}

/// A WORKER's three extra head lines — `worker: N`, `listening:
/// true|false` and (ws17) `accepted: N` — appended after
/// `status_head_text`'s facts, so the master (and an operator dialling
/// one hand) can read which process answered, whether it holds the
/// listeners, and HOW MANY CONNECTIONS IT HAS TAKEN. The third line is
/// the sprint's own instrument: with every hand accepting on one
/// inherited socket, the only way to see the kernel distributing the
/// work is to ask each hand what it did. Appended, nothing renamed:
/// the ws16 head is a prefix of this one. Only a worker prints them;
/// the single-process stanza is unchanged. Total.
pub fn status_worker_head(worker: int, listening: bool, accepted: int) -> str {
    "worker: {worker}\nlistening: {bool_word(listening)}\naccepted: {accepted}\n"
}

/// A WORKER's JSON stanza open: `status_json_open`'s members plus
/// `worker` and `listening`, ahead of the `generations` array.
/// Additive on schema 1. Total.
pub fn status_json_open_worker(
    current: int,
    quitting: bool,
    events: int,
    live_bytes: int,
    worker: int,
    listening: bool,
    accepted: int,
) -> str {
    "{{\"schema\":{status_schema()},\"current\":{current},\"quitting\":{bool_word(quitting)},\"events\":{events},\"live_region_bytes\":{live_bytes},\"worker\":{worker},\"listening\":{bool_word(listening)},\"accepted\":{accepted},\"generations\":["
}

/// The value after `{key}: ` on the line that starts with it, as a
/// non-negative int; -1 when no such line exists or its value does not
/// start with a digit. The master folds a worker's HUMAN stanza with
/// this (the JSON builtins are one lane at this pin; the text stanza
/// is the one wire both master and worker already speak). Total.
pub fn stanza_int(body: str, key: str) -> int {
    let w = stanza_word(body, key)
    if w.is_empty() {
        return -1
    }
    for b_raw in w.bytes() {
        let b = b_raw as int
        if b < 48 || b > 57 {
            return -1
        }
    }
    digits_val(w)
}

/// The first whitespace-delimited word after `{key}: ` on the line
/// that starts with it; "" when absent. Total.
pub fn stanza_word(body: str, key: str) -> str {
    let probe = "{key}: "
    for line in body.lines() {
        if line.starts_with(probe) {
            let rest = line[probe.len..line.len].trim()
            let sp = rest.find(" ") else rest.len
            return rest[0..sp]
        }
    }
    ""
}

/// The sum of every `{field}=N` occurrence across `body`'s lines — how
/// the master reads `live=` (held connections over every generation a
/// worker holds) and `budget-503s=` off a worker's stanza. A value
/// that is not a digit run counts 0. Total.
pub fn stanza_field_sum(body: str, field: str) -> int {
    let probe = "{field}="
    var sum: int = 0
    for line in body.lines() {
        for w in line.words() {
            if w.starts_with(probe) {
                let v = w[probe.len..w.len]
                var ok = !v.is_empty()
                for b_raw in v.bytes() {
                    let b = b_raw as int
                    if b < 48 || b > 57 {
                        ok = false
                    }
                }
                if ok {
                    sum = sum + digits_val(v)
                }
            }
        }
    }
    sum
}

/// True when something ACCEPTS on `addr` — a connect that succeeds,
/// closed at once. The master's liveness probe for a worker: a dead
/// process's endpoint refuses immediately, a live-but-busy one still
/// completes the handshake from its backlog, so the probe never
/// parks on a hand that is serving a long connection (which `ping`,
/// a round trip under a deadline, would). Total: any failure reads
/// as "not reachable".
pub fn control_reachable(addr: str) -> bool {
    if addr.is_empty() {
        return false
    }
    let c = control_dial(addr) else |_| {
        return false
    }
    net_close(c) else |_| {}
    true
}
