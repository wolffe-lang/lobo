//! member: true
//! shell — the operator contract: nginx's CLI grammar, the pid-file
//! lifecycle, the lifecycle verbs (stop/quit/reload/reopen), and the
//! platform-independent reload path — a loopback CONTROL CHANNEL the
//! running server listens on. ws04's territory.
//!
//! The split (ws04 contract §3). Signal RECEPTION is the wolf-lang
//! ask #126 (s114), open at the pin this repo is built for — so the
//! four verbs are reached through the control channel here, and the
//! signal receiver is the campaign's one named deferral. The pin also
//! exposes neither a getpid nor an arbitrary-pid signal SEND (os_kill
//! terminates a CHILD by handle only), so `-s` drives the control
//! channel too and the pid file records the control ENDPOINT, not an
//! os pid — the whole signal/pid family is #126, and each half flips
//! to the unix path the sprint after #126 lands. All three are one
//! gate; the control channel is the working path AND the Windows
//! reload story (contract §3).
//!
//! Design (contract §3 sketch): every trigger — a control command
//! today, a real signal when #126 lands — flows through the SAME verb
//! dispatch (in the entry's poll loop), so the paths are
//! interchangeable and join the same tests. The config model is FROZEN
//! after parse (ws01): a reload builds a NEW model and SWAPS the
//! reference; serving code never mutates config state, so an in-flight
//! request finishing on the old generation and a new request routing
//! the new one is data, not a race (contract pitfall — the
//! frozen-model discipline).
//!
//! ws08 lives here as the PURE reporting surface for the drain the
//! entry's loop counts: the generation-id content hash, the
//! worker_shutdown_timeout parse, the FROZEN log-event vocabulary
//! (ws09/ws12 reuse the names), and the status stanza builders (human
//! text + versioned JSON), plus `control_fetch` for the multi-line
//! status reply. The counter itself is the loop's; the words are here.
//!
//! Lane note: the CLI grammar and the text builders are PURE and run
//! on all three lanes; the pid lifecycle is fs (native+checked); the
//! control client is net (all three). File-header note (F-0016):
//! comments never sit directly above a dotted call — `wolf fmt`
//! splits the call at the dot.

use config

/// This module's interface version. Bumped from the ws00 stub's
/// "0.0.1" as ws04 lands its real surface. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ------------------------------------------------------------------
// the CLI grammar — a PURE parse of argv into a decision, so the
// whole flag table is testable off the socket, on every lane.
// nginx's shape: `nginx [-?hvVtTq] [-s signal] [-p prefix]
//                       [-e filename] [-c filename] [-g directives]`
// ------------------------------------------------------------------

/// The parsed command line. `mode` is the verb the entry dispatches:
/// banner | version | version_verbose | help | check | dump | docs |
/// serve | signal | status | error. `signal` carries the validated
/// verb when `mode == "signal"`. `format` is the `--format` value
/// (default "text", "json" for the machine-readable `lobo status`).
/// `err_msg` is the nginx-shaped diagnostic (own identity: "lobo: …" for
/// "nginx: …") and `exit_code` the code to return when `mode ==
/// "error"` (or a terminal mode's code). The path knobs (`prefix`,
/// `conf`, `errlog`, `globals`) and `quiet` carry through to the acting
/// modes. The ws07 dry-run knobs ride `-t`: `requests` is the
/// repeatable `--request` probe batch, `sni`/`client` feed the
/// TLS-selection and client-address decision inputs, `stat` the fs
/// opt-in — each REQUIRES `-t` (spelled anywhere else they are the
/// named error, so the surface cannot silently mean nothing).
pub struct Cli {
    mode: str,
    signal: str,
    prefix: str,
    conf: str,
    errlog: str,
    globals: str,
    quiet: bool,
    err_msg: str,
    exit_code: int,
    format: str,
    requests: List[str],
    sni: str,
    client: str,
    stat: bool,
}

/// True when `name` is one of nginx's four signal words. Total.
pub fn signal_ok(name: str) -> bool {
    name == "stop" || name == "quit" || name == "reload" || name == "reopen"
}

/// The unix signal a verb maps to (stop=TERM, quit=QUIT, reload=HUP,
/// reopen=USR1) — reported by `-V`/docs and the note the deferred
/// receiver will honor; the control channel carries the verb WORD, so
/// this is documentation, not a send today. "" for an unknown verb.
pub fn signal_unix(name: str) -> str {
    if name == "stop" {
        return "TERM"
    }
    if name == "quit" {
        return "QUIT"
    }
    if name == "reload" {
        return "HUP"
    }
    if name == "reopen" {
        return "USR1"
    }
    ""
}

/// Parse argv (env_args order — argv[0] already dropped) into a `Cli`.
/// PURE and total: never touches fs/net, never traps. Mirrors nginx's
/// getopt discipline — mode flags (`-v -V -t -T -h -?`), the quiet
/// modifier (`-q`), the arg-taking options (`-s -p -c -e -g`), and
/// lobo's own verbs (`serve`, `directives-md`). An option missing its
/// argument, an unknown option, or an invalid signal word is
/// `mode == "error"` with the oracle-shaped message and exit 1.
pub fn parse_cli(args: List[str]) -> Cli {
    var mode = "banner"
    var signal = ""
    var prefix = "."
    var conf = "conf/nginx.conf"
    var errlog = ""
    var globals = ""
    var quiet = false
    var format = "text"
    var requests = List[str]()
    var sni = ""
    var client = ""
    var stat = false
    var want = ""
    var want_kind = ""
    var err_msg = ""
    var errored = false
    for a in args {
        if errored {
            // first error is terminal (nginx stops at the first)
        } else if !want.is_empty() {
            if want == "s" {
                if signal_ok(a) {
                    mode = "signal"
                    signal = a
                } else {
                    errored = true
                    err_msg = "invalid option: \"-s {a}\""
                }
            } else if want == "p" {
                prefix = a
            } else if want == "c" {
                conf = a
            } else if want == "e" {
                errlog = a
            } else if want == "g" {
                globals = a
            } else if want == "format" {
                format = a
            } else if want == "request" {
                (mut requests).push(a)
            } else if want == "sni" {
                sni = a
            } else if want == "client" {
                client = a
            } else if want == "cert" {
                if a == "status" {
                    mode = "cert_status"
                } else {
                    errored = true
                    err_msg = "invalid \"cert\" subcommand: \"{a}\" (expected: status)"
                }
            }
            want = ""
            want_kind = ""
        } else if a == "-v" {
            mode = "version"
        } else if a == "-V" {
            mode = "version_verbose"
        } else if a == "-t" {
            mode = "check"
        } else if a == "-T" {
            mode = "dump"
        } else if a == "-q" {
            quiet = true
        } else if a == "-h" || a == "-?" || a == "help" {
            mode = "help"
        } else if a == "-s" {
            want = "s"
            want_kind = "parameter"
        } else if a == "-p" {
            want = "p"
            want_kind = "directory name"
        } else if a == "-c" {
            want = "c"
            want_kind = "file name"
        } else if a == "-e" {
            want = "e"
            want_kind = "file name"
        } else if a == "-g" {
            want = "g"
            want_kind = "parameter"
        } else if a == "--version" {
            mode = "version"
        } else if a == "--format" {
            want = "format"
            want_kind = "parameter"
        } else if a == "--request" {
            want = "request"
            want_kind = "parameter"
        } else if a == "--sni" {
            want = "sni"
            want_kind = "parameter"
        } else if a == "--client" {
            want = "client"
            want_kind = "parameter"
        } else if a == "--stat" {
            stat = true
        } else if a == "directives-md" {
            mode = "docs"
        } else if a == "logvars-md" {
            mode = "logvars"
        } else if a == "metrics-md" {
            mode = "metricsdocs"
        } else if a == "serve" {
            mode = "serve"
        } else if a == "status" {
            mode = "status"
        } else if a == "cert" {
            want = "cert"
            want_kind = "subcommand"
        } else if a.starts_with("-") {
            errored = true
            let letter = a[1..a.len]
            err_msg = "invalid option: \"{letter}\""
        } else {
            errored = true
            err_msg = "invalid option: \"{a}\""
        }
    }
    // a trailing arg-taking option with no argument (nginx: "option
    // \"-c\" requires file name", exit 1). The long options spell
    // their own name in the diagnostic.
    if !errored && !want.is_empty() {
        errored = true
        if want.len > 1 {
            err_msg = "option \"--{want}\" requires {want_kind}"
        } else {
            err_msg = "option \"-{want}\" requires {want_kind}"
        }
    }
    // the dry-run knobs require -t (ws07): anywhere else they would
    // silently mean nothing, and this surface never means nothing
    if !errored && mode != "check" {
        if requests.len > 0 {
            errored = true
            err_msg = "option \"--request\" requires -t (the dry-run rides the config check)"
        } else if !sni.is_empty() {
            errored = true
            err_msg = "option \"--sni\" requires -t --request"
        } else if !client.is_empty() {
            errored = true
            err_msg = "option \"--client\" requires -t --request"
        } else if stat {
            errored = true
            err_msg = "option \"--stat\" requires -t --request"
        }
    }
    if !errored && mode == "check" && requests.len == 0 {
        if !sni.is_empty() || !client.is_empty() || stat {
            errored = true
            err_msg = "options \"--sni\"/\"--client\"/\"--stat\" shape --request probes; add --request"
        }
    }
    if errored {
        mode = "error"
    }
    let code = if errored { 1 } else { 0 }
    Cli {
        mode: mode,
        signal: signal,
        prefix: prefix,
        conf: conf,
        errlog: errlog,
        globals: globals,
        quiet: quiet,
        err_msg: err_msg,
        exit_code: code,
        format: format,
        requests: requests,
        sni: sni,
        client: client,
        stat: stat,
    }
}

// ------------------------------------------------------------------
// the text builders — nginx's one-fact-per-line shapes, lobo identity.
// nginx prints all of these to STDERR (measured against the oracle);
// the entry follows suit.
// ------------------------------------------------------------------

/// The server identity token, "lobo/<ver>" (nginx: "nginx/1.30.4").
/// Total.
pub fn version_token() -> str {
    "lobo/0.1.0"
}

/// The one-line version report (`-v`): "lobo version: lobo/0.1.0"
/// (nginx: "nginx version: nginx/1.30.4"). Total.
pub fn version_report() -> str {
    "lobo version: {version_token()}"
}

/// The `-V` build metadata, nginx's one-line-per-fact shape: identity,
/// the wolf toolchain it was built with, the two-tier posture, and the
/// module set. No compile-time git pin (D33: no build scripts), so the
/// toolchain's own version string is the honest identity. Total.
pub fn version_verbose() -> str {
    var s = "{version_report()}\n"
    s = "{s}built with wolf 0.1.0 (wolfgang)\n"
    s = "{s}tier: two-tier (owned debug + LLVM release)\n"
    s = "{s}modules: config {config.version()} · http · serve · proxy · obs · shell {version()}\n"
    s
}

/// The usage text (`-h`/`-?`/`help`), nginx's Usage shape plus lobo's
/// own verbs on a trailing line. Total.
pub fn usage_text() -> str {
    var s = "{version_report()}\n"
    s = "{s}Usage: lobo [-?hvVtTq] [-s signal] [-p prefix]\n"
    s = "{s}           [-e filename] [-c filename] [-g directives]\n"
    s = "{s}       lobo -t --request '<method> <scheme>://<host>/<path>' ...\n"
    s = "{s}           [--sni name] [--client addr] [--stat] [--format json]\n"
    s = "{s}           (the config dry-run: what would this config DO — ws07)\n"
    s = "{s}       lobo [serve | directives-md | logvars-md | metrics-md]\n"
    s = "{s}           (lobo-native verbs)\n"
    s
}

// ------------------------------------------------------------------
// the pid file — the running master's rendezvous. At this pin the
// content is the CONTROL ENDPOINT (a loopback address), not an os pid
// (no getpid; #126): `-s` and stale-detection reach the master by
// CONNECTING to it, which is a liveness probe the pin can express and
// a real signal is not. Write-rename so a reader never sees a torn
// file (contract pitfall). Flips to the os pid when #126 lands.
// ------------------------------------------------------------------

/// The pid file path: the `pid` directive's argument resolved under
/// `prefix`, else nginx's default "logs/nginx.pid" under the prefix.
/// An absolute directive value is honored verbatim. Total.
pub fn pid_path(c: config.Conf, prefix: str) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "pid" && c.args_n[i] >= 1 {
            let p = c.argp[c.args_at[i]]
            if p.starts_with("/") {
                return p
            }
            return "{prefix}/{p}"
        }
        i = i + 1
    }
    "{prefix}/logs/nginx.pid"
}

/// Write `endpoint` to the pid file atomically: create the parent
/// directory if absent (lobo owns its runtime dirs — nginx's logs/ is
/// there by its install), write a sibling temp file, then rename over
/// the target, so a concurrent reader sees either the old file or the
/// whole new one, never a partial write. Rows: fs `io` (a write or
/// rename that failed). Total otherwise.
pub fn pid_write(path: str, endpoint: str) -> () ! {io} {
    let slash = path.rfind("/") else -1
    if slash > 0 {
        let dir = path[0..slash]
        fs_create_dir_all(dir) else |_| {}
    }
    let tmp = "{path}.new"
    fs_write_text(tmp, "{endpoint}\n") else |_| {
        return io
    }
    fs_rename(tmp, path) else |_| {
        return io
    }
}

/// Read the pid file's endpoint (the first line, trimmed). Rows:
/// `none` when the file does not exist (nginx's "No such file or
/// directory" on `-s` with no master), `io` on a read failure — two
/// tags a caller acts on differently (allow w0602: the row is
/// deliberate API, one tag per distinct failure).
#[allow(w0602)]
pub fn pid_read(path: str) -> str ! {none, io} {
    if !fs_exists(path) {
        return none
    }
    let raw = fs_read_text(path) else |_| {
        return io
    }
    raw.trim()
}

/// Remove the pid file (the master's shutdown step, and the stale-file
/// replacement). Swallows a missing file; rows `io` on a real failure.
pub fn pid_remove(path: str) -> () ! {io} {
    if !fs_exists(path) {
        return
    }
    fs_remove(path) else |_| {
        return io
    }
}

// ------------------------------------------------------------------
// the control channel — a loopback command listener the running
// server owns. One-line commands, one-line replies. Off by default
// (no `control` directive → no listener), loopback-bound, linted as
// non-nginx surface (ws14's security pass audits it — kept minimal).
// ------------------------------------------------------------------

/// The control address: the `control` directive's argument, or "" when
/// the directive is absent (the channel is OFF by default). A bare
/// port becomes a loopback bind (loopback-only, forever). Total.
pub fn control_addr(c: config.Conf) -> str {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "control" && c.args_n[i] >= 1 {
            let a = c.argp[c.args_at[i]]
            if a.contains(":") {
                return a
            }
            return "127.0.0.1:{a}"
        }
        i = i + 1
    }
    ""
}

/// Send one command line to the control endpoint and read the one-line
/// reply. Dials, arms a short deadline, writes "`line`\n", reads the
/// reply to a newline, closes. Rows: `refused` (nobody listening — a
/// dead/absent master, which `-s` and stale-detection read as "not
/// alive"), `io` for every other net trouble. The reply is trimmed
/// (allow w0602: deliberate API — refused and other failures differ).
#[allow(w0602)]
pub fn control_send(addr: str, line: str) -> str ! {refused, io} {
    let c = net_connect(addr) else |e| match e {
        refused => {
            return refused
        },
        timeout => {
            return io
        },
        io => {
            return io
        },
    }
    net_deadline(c, 2000) else |_| {
        net_close(c) else |_| {}
        return io
    }
    net_write(c, "{line}\n") else |_| {
        net_close(c) else |_| {}
        return io
    }
    var buf = ""
    var reading = true
    while reading {
        let nl = buf.find("\n") else -1
        if nl >= 0 {
            reading = false
        } else {
            let piece = net_read(c, 4096) else |_| {
                reading = false
                ""
            }
            if piece.is_empty() {
                reading = false
            } else {
                buf = "{buf}{piece}"
            }
        }
    }
    net_close(c) else |_| {}
    buf.trim()
}

/// True when the endpoint answers a `ping` — the liveness probe the
/// pin can express (a real kill(pid, 0) is #126). Used by `-s` and by
/// startup stale-detection. Total: any failure reads as "not alive".
pub fn control_alive(addr: str) -> bool {
    if addr.is_empty() {
        return false
    }
    let r = control_send(addr, "ping") else |_| {
        return false
    }
    r == "pong"
}

// ------------------------------------------------------------------
// the verb layer — one dispatch every trigger flows through, so a
// control command today and a signal when #126 lands are the same
// call. A verb is serialized by construction: the server processes
// control connections one at a time, so a second reload arriving mid-
// reload gets the `busy` answer (contract pitfall — nginx queues
// HUPs; one-at-a-time with a named busy answer is the honest v0).
// ------------------------------------------------------------------

/// A server generation: the frozen config model, the generation
/// number (ws08 surfaces old-generation connection counts against it —
/// the counter lands here, the reporting there), whether the last
/// reload succeeded, and the human note the control reply carries.
pub struct Gen {
    conf: config.Conf,
    gen: int,
    ok: bool,
    note: str,
}

/// The initial generation from a loaded config. `gen` starts at 1
/// (nginx's first master is generation 1). Total (the load already
/// happened; this just tags it).
pub fn gen_new(c: config.Conf) -> Gen {
    Gen { conf: c, gen: 1, ok: true, note: "started (generation 1)" }
}

/// Reload: parse the config FRESH through the full ws01 pipeline. On
/// ANY error keep the OLD generation serving and answer a non-zero
/// notice (the nginx contract — the reason `-t` exists); on success
/// freeze the new model, bump the generation, and hand it back for the
/// caller to SWAP the routing reference to. The listen-set diff is the
/// caller's (`listen_addrs`): a surviving address reuses its live
/// listener, a removed one drains, a new one opens. Total.
pub fn reload(prefix: str, conf_rel: str, prev: Gen) -> Gen {
    let c = config.load(prefix, conf_rel)
    if config.ok(c) {
        let g = prev.gen + 1
        return Gen { conf: c, gen: g, ok: true, note: "reload complete (generation {g})" }
    }
    Gen {
        conf: prev.conf,
        gen: prev.gen,
        ok: false,
        note: "reload rejected: configuration test failed; keeping generation {prev.gen}",
    }
}

// ------------------------------------------------------------------
// the listen-set diff — a reload reuses a surviving listener's live
// fd (never close-and-reopen: that loses queued SYNs, the contract's
// hammer-connects-across-a-reload catches it), opens the new, and
// drains the removed. These pure set ops name which is which.
// ------------------------------------------------------------------

/// The normalized bind addresses of every `listen` directive (a bare
/// port becomes a loopback bind — loopback-only, forever). Total; the
/// order is the config's. Duplicates are kept (nginx's own posture).
pub fn listen_addrs(c: config.Conf) -> List[str] {
    var out = List[str]()
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "listen" && c.args_n[i] >= 1 {
            let a = c.argp[c.args_at[i]]
            if a.contains(":") {
                (mut out).push(a)
            } else {
                (mut out).push("127.0.0.1:{a}")
            }
        }
        i = i + 1
    }
    out
}

/// True when `addr` is in `xs`. Total (argument reads are free).
fn addr_in(xs: List[str], addr: str) -> bool {
    for x in xs {
        if x == addr {
            return true
        }
    }
    false
}

/// The addresses in `new` that also appear in `old` — the listeners a
/// reload REUSES (live fd carried across the generation). Total.
pub fn listen_reused(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in new {
        if addr_in(old, a) {
            (mut out).push(a)
        }
    }
    out
}

/// The addresses in `new` not in `old` — the listeners a reload OPENS.
/// Total.
pub fn listen_added(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in new {
        if !addr_in(old, a) {
            (mut out).push(a)
        }
    }
    out
}

/// The addresses in `old` not in `new` — the listeners a reload CLOSES
/// (connections on them drain per the quit rules). Total.
pub fn listen_removed(old: List[str], new: List[str]) -> List[str] {
    var out = List[str]()
    for a in old {
        if !addr_in(new, a) {
            (mut out).push(a)
        }
    }
    out
}

// ------------------------------------------------------------------
// ws08 — the drain you can watch. The generation id (a content hash of
// the frozen model), the worker_shutdown_timeout knob, the log-event
// vocabulary (FROZEN — ws09's JSON logs and ws12's metrics reuse these
// names), and the status surface (text + versioned JSON). All PURE and
// total — they run on all three lanes; the counting itself lives in the
// entry's poll loop (a per-generation live counter, spawn-free).
// ------------------------------------------------------------------

/// A non-negative int as zero-padded 8-digit lowercase hex. Total for
/// `0 <= n < 2^32`.
fn hex8(n: int) -> str {
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    var i: int = 0
    while i < 8 {
        let d = v % 16
        out = "{digits[d..d + 1]}{out}"
        v = v / 16
        i = i + 1
    }
    out
}

/// The generation id: a content hash of the FROZEN config model
/// (`render_conf`'s canonical text), rendered as 16 hex chars. Two
/// checked-arithmetic polynomial rolls (no bit ops — the checked tier
/// refuses `&`/`^`/`>>` on plain int, and `wrapping[u64]` is refused at
/// this pin, F-WS08-clock's sibling) folded to 8 hex each. A reload to
/// an IDENTICAL config yields the SAME id — an operator can see a reload
/// changed nothing — and any content change changes it. Total.
pub fn conf_hash(c: config.Conf) -> str {
    let text = config.render_conf(c)
    var a: int = 0
    var b: int = 0
    for x in text.bytes() {
        a = (a * 131 + x) % 2147483647
        b = (b * 1000003 + x + 7) % 2147483647
    }
    "{hex8(a)}{hex8(b)}"
}

/// Parse an nginx-style duration into milliseconds: a trailing `ms` is
/// milliseconds, a trailing `s` is seconds, a bare number is seconds
/// (nginx's default unit for time directives). A malformed value is 0.
/// Total.
fn parse_dur_ms(raw: str) -> int {
    let s = raw.trim()
    if s.is_empty() {
        return 0
    }
    if s.ends_with("ms") {
        return digits_val(s.strip_suffix("ms") else "")
    }
    if s.ends_with("s") {
        return digits_val(s.strip_suffix("s") else "") * 1000
    }
    digits_val(s) * 1000
}

/// A run of ASCII digits as a non-negative int; any non-digit byte
/// stops the scan (so `30s` already stripped to `30` parses, and junk
/// yields what parsed so far). Total.
fn digits_val(s: str) -> int {
    var v: int = 0
    for x in s.bytes() {
        if x < 48 || x > 57 {
            return v
        }
        v = v * 10 + (x - 48)
    }
    v
}

/// The `worker_shutdown_timeout` in milliseconds — the deadline a
/// DRAINING generation gets before its remaining connections are
/// aborted and it retires anyway (contract §3). 0 (the nginx default,
/// and the absence of the directive) means NO forced timeout: a
/// generation drains fully, however long that takes. Total.
pub fn shutdown_timeout_ms(c: config.Conf) -> int {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "worker_shutdown_timeout" && c.args_n[i] >= 1 {
            return parse_dur_ms(c.argp[c.args_at[i]])
        }
        i = i + 1
    }
    0
}

// ---- the signal surface (wsm01, s114 in the pin) --------------------
// Real signal reception exists as of the s115 pin: the s114 builtins
// (os_signal_listen/os_signal_wait/os_signal_raise) deliver OS signals
// as events by MEANING ([os.signal.set] — a bitmask, mapped to
// platform signal numbers only at the runtime boundary). These helpers
// are the pure half: the meaning constants and the meaning→verb map.
// The entry owns the listen/wait/forward wiring; BOTH triggers — a
// real SIGHUP and a control-channel line — flow through the ONE verb
// dispatch (the flip ws04 §3 designed for). The UPGRADE meaning (8,
// SIGUSR2 — binary swap) is deliberately not listened yet: that path
// is a later sprint. Zero-arg fns are the portable constant spelling.

/// The RELOAD meaning (bit 1; SIGHUP on unix). Total.
pub fn sig_reload() -> int {
    1
}

/// The TERMINATE meaning (bit 2; SIGTERM on unix — fast shutdown).
/// Total.
pub fn sig_terminate() -> int {
    2
}

/// The QUIT meaning (bit 4; SIGQUIT on unix — graceful drain-then-
/// exit). Total.
pub fn sig_quit() -> int {
    4
}

/// The interest mask of the OPERATOR meanings: RELOAD | TERMINATE |
/// QUIT. Total.
pub fn sig_mask() -> int {
    7
}

/// The probe meaning (bit 8 — UPGRADE, SIGUSR2 on unix). The serve
/// loop's spawn-free signal poll self-raises this bit each pass and
/// waits once: the runtime queue is FIFO, so a real pending operator
/// signal comes back first and the probe bounds the wait. NAMED
/// residue: until the binary-swap sprint claims UPGRADE, an outside
/// SIGUSR2 is indistinguishable from the probe and is ignored. Total.
pub fn sig_probe() -> int {
    8
}

/// The meaning's stable lowercase name (for log events and docs) —
/// the MEANING vocabulary, not the platform signal name. Unknown
/// meanings answer "unknown". Total.
pub fn signal_name(m: int) -> str {
    if m == 1 {
        return "reload"
    }
    if m == 2 {
        return "terminate"
    }
    if m == 4 {
        return "quit"
    }
    "unknown"
}

/// The operator verb a received signal meaning drives: SIGHUP→reload,
/// SIGTERM→stop (nginx's fast shutdown), SIGQUIT→quit (graceful).
/// The SAME verbs the control channel accepts — one dispatch layer.
/// An unknown meaning maps to "" (the entry ignores it). Total.
pub fn signal_verb(m: int) -> str {
    if m == 1 {
        return "reload"
    }
    if m == 2 {
        return "stop"
    }
    if m == 4 {
        return "quit"
    }
    ""
}

// ---- the log-event vocabulary (FROZEN; documented in docs/) ---------
// Each builder returns the event BODY: a stable name then space-
// separated key=value fields. The entry prefixes "lobo: [notice] " and
// emits through the logging seam (eprint, ws02); ws09 reformats these
// names into JSON and ws12 into metrics, so the NAMES and FIELD KEYS
// are a contract, not decoration.

/// A new config generation was parsed and frozen (a reload succeeded).
pub fn ev_generation_loaded(gen: int, hash: str) -> str {
    "generation-loaded gen={gen} id={hash}"
}

/// A generation became the live, accepting one.
pub fn ev_generation_activated(gen: int) -> str {
    "generation-activated gen={gen}"
}

/// A generation stopped accepting and began draining, still holding
/// `held` connections.
pub fn ev_generation_draining(gen: int, held: int) -> str {
    "generation-draining gen={gen} held={held}"
}

/// One connection on a draining generation closed; `remaining` are the
/// connections that generation still holds.
pub fn ev_connection_retired(gen: int, remaining: int) -> str {
    "connection-retired gen={gen} remaining={remaining}"
}

/// A draining generation reached zero connections (or its
/// worker_shutdown_timeout expired): `drained` closed cleanly,
/// `aborted` were force-closed by the timeout, over `age_ms`.
pub fn ev_generation_retired(gen: int, drained: int, aborted: int, age_ms: int) -> str {
    "generation-retired gen={gen} drained={drained} aborted={aborted} age-ms={age_ms}"
}

/// A real OS signal was received and mapped to an operator verb (the
/// wsm01 vocabulary EXTENSION — appended, nothing renamed): `sig` is
/// the meaning's name (reload|terminate|quit), `verb` the dispatched
/// verb. The event that lets an operator (and the signal witness
/// harness) tell a signal-driven reload from a control-channel one.
pub fn ev_signal_received(m: int) -> str {
    "signal-received sig={signal_name(m)} verb={signal_verb(m)}"
}

/// A request was refused by its vhost's `memory_budget` (ws10 — the
/// vocabulary's seventh event, appended, nothing renamed): `gen` the
/// generation that served it, `site` the deterministic exceed-site
/// (head|body|body-chunked|file), `budget` the configured bytes,
/// `would` what admitting the request would have charged. Level
/// `error` (a shed request is an operator's signal, not a notice).
/// The refused request also writes an ordinary 503 access line.
pub fn ev_budget_exceeded(gen: int, site: str, budget: int, would: int) -> str {
    "budget-exceeded gen={gen} site={site} budget={budget} would={would}"
}

/// The ws11 sequence stamp: every vocabulary event the server emits
/// carries a trailing `seq=N` — the event's ordinal in the ONE poll
/// loop's emission order (1-based, monotone, never reset while the
/// process lives). Appended by the EMISSION SEAM, not the builders, so
/// every builder shape above is unchanged (the extension discipline:
/// appended, nothing renamed; every existing `contains`/grep pin still
/// matches its prefix). The stamp is what makes an attached log a
/// SCHEDULE: the stream's order is the loop's own decision order, and
/// a gap in `seq` is a visible hole (a level-gated mirror or a counted
/// drop), never a silent one — docs/REPLAY.md is the workflow. Total.
pub fn ev_seq(body: str, seq: int) -> str {
    "{body} seq={seq}"
}

// ---- the status surface --------------------------------------------
// SCALAR builders, not List-of-struct: the checked tier refuses a
// `List[<imported struct>]()` construction (generic data across a
// module boundary), so the generation TABLE is built in the entry over
// its own local row type and formatted one line at a time here. Every
// builder is pure and total, so the shape is unit-tested off the socket
// on all three lanes.

/// The JSON status schema version (the ws07 convention — a versioned,
/// machine-readable surface ws12's metrics endpoint serves too). Bumped
/// only on a breaking shape change. Total.
pub fn status_schema() -> int {
    1
}

/// The human status stanza's header (`lobo status`): the identity line,
/// the current generation, the quit posture, and (ws11, appended —
/// every earlier fact keeps its place) `events:` — the count of
/// vocabulary events emitted so far, i.e. the highest `seq` stamped.
/// The completeness anchor for a bug report's attached log: a stream
/// whose top seq matches `events` has no trailing hole. ws12 appends
/// `live-region-bytes:` — `live_region_bytes()` at the moment the
/// stanza was built ([mem.region.account.2], wolf-lang s131): the
/// process-wide total the RUNTIME holds for live regions. It is not
/// an RSS figure and must not be read as one — the process-root arena
/// (where every str materialization still lands, wolf-lang#191) is
/// never counted. One fact per line, nginx's shape. The entry appends
/// one `status_line_text` per generation. Read over the control
/// channel to the peer's close (the stanza is multi-line), so
/// `control_fetch` reads it. Total.
pub fn status_head_text(current: int, quitting: bool, events: int, live_bytes: int) -> str {
    var s = "lobo status\n"
    s = "{s}current generation: {current}\n"
    s = "{s}quitting: {bool_word(quitting)}\n"
    s = "{s}events: {events}\n"
    s = "{s}live-region-bytes: {live_bytes}\n"
    s
}

/// One generation's line in the human status table. `remaining_ms` is
/// the worker_shutdown_timeout remaining for a draining generation, or
/// -1 when none applies (a current generation, or no timeout). ws10
/// appends the budget aggregates (additive — every earlier fact keeps
/// its place): `mem-hw` is the high-water admitted bytes of any single
/// request served under the generation, `budget-503s` its refusal
/// count (0 0 when no budget is armed — the facts stay printed so a
/// parser never branches). ws12 appends `mem-rt-hw` — the high-water
/// MEASURED region bytes of any single request the generation served
/// ([mem.region.account.1]). `mem-hw` is what lobo's admission meter
/// counted; `mem-rt-hw` is what the runtime charged. They are
/// different units answering different questions and the docs refuse
/// to subtract one from the other. Includes the trailing newline.
/// Total.
pub fn status_line_text(
    gen: int,
    live: int,
    state: str,
    age_ms: int,
    hash: str,
    remaining_ms: int,
    mem_hw: int,
    budget_503s: int,
    mem_rt_hw: int,
) -> str {
    var line = "generation {gen}: {state} live={live} age-ms={age_ms} id={hash} mem-hw={mem_hw} budget-503s={budget_503s} mem-rt-hw={mem_rt_hw}"
    if remaining_ms >= 0 {
        line = "{line} shutdown-in-ms={remaining_ms}"
    }
    "{line}\n"
}

/// The JSON status stanza's open: `{"schema":1,"current":N,
/// "quitting":b,"events":N,"generations":[` (no newlines). `events`
/// is ws11's ADDITIVE member (the vocabulary-event count — the highest
/// `seq` emitted; schema stays 1, nothing renamed or moved, the ws07
/// convention for a widening). The entry appends comma-separated
/// `status_json_obj`s then `status_json_close`. ws12's metrics
/// endpoint serves this same object at `/status.json` and adds
/// `live_region_bytes` (additive; schema stays 1). Total.
pub fn status_json_open(current: int, quitting: bool, events: int, live_bytes: int) -> str {
    "{{\"schema\":{status_schema()},\"current\":{current},\"quitting\":{bool_word(quitting)},\"events\":{events},\"live_region_bytes\":{live_bytes},\"generations\":["
}

/// One generation as a JSON object (no leading comma, no newline) — the
/// entry joins these with commas. ws10 adds `mem_high_water` and
/// `budget_503s`; ws12 adds `mem_rt_high_water`, the measured region
/// figure (additive members; schema stays 1 — nothing renamed or
/// moved, the ws07 convention for a widening). Total.
pub fn status_json_obj(
    gen: int,
    state: str,
    live: int,
    age_ms: int,
    hash: str,
    remaining_ms: int,
    mem_hw: int,
    budget_503s: int,
    mem_rt_hw: int,
) -> str {
    "{{\"gen\":{gen},\"state\":\"{state}\",\"live\":{live},\"age_ms\":{age_ms},\"id\":\"{hash}\",\"mem_high_water\":{mem_hw},\"budget_503s\":{budget_503s},\"mem_rt_high_water\":{mem_rt_hw},\"shutdown_remaining_ms\":{remaining_ms}}}"
}

/// The JSON status stanza's close: `]}`. Total.
pub fn status_json_close() -> str {
    "]}}"
}

/// "true"/"false" — the shared spelling for the human stanza and the
/// JSON wire (JSON's booleans are the same two words). Total.
fn bool_word(b: bool) -> str {
    if b {
        return "true"
    }
    "false"
}

// ------------------------------------------------------------------
// control_fetch — the read-to-close variant of control_send, for a
// MULTI-LINE reply (the status stanza). control_send stops at the first
// newline (a one-line verb reply); status needs the whole body, which
// the server writes and then closes, so the client reads to the close.
// ------------------------------------------------------------------

/// Send one command line and read the reply until the peer closes
/// (ignoring interior newlines — the status stanza is multi-line). Rows
/// mirror control_send: `refused` (no master), `io` otherwise. The
/// reply keeps its interior newlines; the trailing newline is trimmed.
#[allow(w0602)]
pub fn control_fetch(addr: str, line: str) -> str ! {refused, io} {
    let c = net_connect(addr) else |e| match e {
        refused => {
            return refused
        },
        timeout => {
            return io
        },
        io => {
            return io
        },
    }
    net_deadline(c, 2000) else |_| {
        net_close(c) else |_| {}
        return io
    }
    net_write(c, "{line}\n") else |_| {
        net_close(c) else |_| {}
        return io
    }
    var buf = ""
    var reading = true
    while reading {
        let piece = net_read(c, 4096) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    net_close(c) else |_| {}
    buf.trim()
}
