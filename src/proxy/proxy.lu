//! member: true
//! proxy — upstream pools and reverse proxying (proxy_pass). The half
//! of real nginx deployments that is not static files. This module is
//! two layers: a PURE core (pool model, smooth weighted round-robin,
//! the proxy_pass rewrite table, the hop-by-hop discipline, the
//! proxy_set_header inheritance LOBO-L002 names, upstream-response
//! parsing) that runs on all three lanes and is exhaustively unit-
//! pinned, and an IO leg (connect → send → read → relay under
//! deadlines, with peer failover) that runs on native + checked, and
//! is held to the pinned nginx by the two-sided differential.
//! Direction (ARCHITECTURE.md, locked): {main, serve} → proxy →
//! {config, http, resolver}; proxy reads the config model, http's byte
//! predicates and the resolver's answers, never the other way. ws29
//! (lobo#4): this line used to name `obs` as a callee and lobo has
//! never had that arrow — proxy raises no log line of its own, it
//! answers and its caller logs. ARCHITECTURE.md's re-read against the
//! tree said so; this header had not been re-read with it. Every rewrite/header/rotation rule below was probed from
//! the pinned oracle FIRST (the probe matrix is the spec, not the RFC
//! where they disagree — the differential holds us to nginx); the
//! deltas from the RFC and from stock nginx are named in the sprint
//! closeout and the directive table.
//! Lane note: net moves `str`, not bytes (D8/#137) — a proxied body
//! with a code point split across a read boundary is the `utf8` row,
//! handled as the str path ws02 established; binary bodies wait on the
//! net bytes tier.
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use config
use http
use resolver
use std.net
use std.x.tls.cert
use std.x.tls.client as tlsc

/// This module's interface version. Bumped from the ws00 stub as
/// ws03's first real surface lands. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ==================================================================
// PURE CORE
// ==================================================================

// ------------------------------------------------------------------
// upstream pool model — parsed from the config `upstream` blocks
// ------------------------------------------------------------------

/// A resolved upstream pool: parallel columns, one row per `server`
/// member. `weights` default 1; `max_fails` default 1; `fail_ms` (the
/// fail_timeout window) default 10000ms; `backup` peers serve only
/// when every primary is down. Built once from the config model at
/// load — hostnames resolve ONCE (nginx-compatible; re-resolution is
/// the documented Plus-ism, a table note). An empty pool (`hosts` len
/// 0) means the name named no members.
pub struct UpPool {
    name: str,
    hosts: List[str],
    ports: List[int],
    weights: List[int],
    max_fails: List[int],
    fail_ms: List[int],
    backup: List[bool],
    rows: List[int],
}

/// The number of peers in the pool. Total.
pub fn peer_count(p: UpPool) -> int {
    p.hosts.len
}

/// Parse an nginx time value ("30s", "1m", "500ms", "10") into
/// milliseconds. A bare number is seconds (nginx). The "ms" suffix is
/// milliseconds; "s"/"m"/"h" are seconds/minutes/hours. Total; an
/// unknown unit → seconds.

/// `n` CSPRNG octets as a byte list. `os_random` is the one producer
/// the language still answers `List[int]` from after s136 ([os.random]
/// pins it there on purpose — the row is a draw count, not a byte
/// read), so this narrowing walk sits at every crypto call site. The
/// twin of `tls.rand_bytes` and `acme.rand_bytes`; the three modules
/// do not import each other. Total.
fn rand_bytes(n: int) -> List[byte] {
    var out = List[byte]()
    for v in os_random(n) {
        (mut out).push(v as byte)
    }
    out
}

fn parse_time_ms(s: str) -> int {
    if s.is_empty() {
        return 0
    }
    // "ms" is the one two-letter unit — detect it before the char scan
    if s.ends_with("ms") {
        let num = s[0..s.len - 2]
        var m: int = 0
        for b_raw in num.bytes() {
            let b = b_raw as int
            if b >= 48 && b <= 57 {
                m = m * 10 + b - 48
            }
        }
        return m
    }
    var n: int = 0
    var unit = "s"
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            n = n * 10 + b - 48
        } else if b == 115 {
            unit = "s"
        } else if b == 109 {
            unit = "m"
        } else if b == 104 {
            unit = "h"
        }
    }
    if unit == "m" {
        return n * 60000
    }
    if unit == "h" {
        return n * 3600000
    }
    n * 1000
}

/// Split a `host:port` authority at its LAST colon into (host, port).
/// No colon → (whole, 80). A non-numeric port falls back to 80. Total.
fn split_hostport(addr: str) -> (str, int) {
    let colon = addr.rfind(":") else -1
    if colon < 0 {
        return (addr, 80)
    }
    let host = addr[0..colon]
    let ptext = addr[colon + 1..addr.len]
    var port: int = 0
    var ok = false
    for b_raw in ptext.bytes() {
        let b = b_raw as int
        if b < 48 || b > 57 {
            return (addr, 80)
        }
        port = port * 10 + b - 48
        ok = true
    }
    if !ok {
        return (host, 80)
    }
    (host, port)
}

/// The integer value of a `key=value` flag whose key is `key`, or the
/// `none` row when `arg` is a different flag. Total over the value
/// (non-digits stop the scan). Used for `weight=`, `max_fails=`.
fn flag_int(arg: str, key: str) -> int ! {none} {
    let pfx = "{key}="
    if !arg.starts_with(pfx) {
        return none
    }
    let v = arg[pfx.len..arg.len]
    var n: int = 0
    for b_raw in v.bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            n = n * 10 + b - 48
        }
    }
    n
}

/// Build the pool named `name` from the config model: every `server`
/// directive whose parent is the `upstream` block whose sole argument
/// is `name`. PURE. An unknown name yields an empty pool. Peer flags
/// parsed: `weight=`, `max_fails=`, `fail_timeout=`, `backup`.
pub fn pool_named(c: config.Conf, name: str) -> UpPool {
    var p = UpPool {
        name: name,
        hosts: List[str](),
        ports: List[int](),
        weights: List[int](),
        max_fails: List[int](),
        fail_ms: List[int](),
        backup: List[bool](),
        rows: List[int](),
    }
    var blk: int = -1
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "upstream" && c.kinds[i] == "b" && c.args_n[i] >= 1 {
            if c.argp[c.args_at[i]] == name {
                blk = i
            }
        }
        i = i + 1
    }
    if blk < 0 {
        return p
    }
    var j: int = 0
    while j < total {
        if c.names[j] == "server" && c.parent[j] == blk && c.args_n[j] >= 1 {
            let at = c.args_at[j]
            let nn = c.args_n[j]
            let hp = split_hostport(c.argp[at])
            var w: int = 1
            var mf: int = 1
            var ft: int = 10000
            var bak = false
            var k: int = 1
            while k < nn {
                let flag = c.argp[at + k]
                if flag == "backup" {
                    bak = true
                } else {
                    let wv = flag_int(flag, "weight") else -1
                    if wv >= 0 {
                        w = wv
                    }
                    let mv = flag_int(flag, "max_fails") else -1
                    if mv >= 0 {
                        mf = mv
                    }
                    if flag.starts_with("fail_timeout=") {
                        ft = parse_time_ms(flag["fail_timeout=".len..flag.len])
                    }
                }
                k = k + 1
            }
            (mut p.hosts).push(hp.0)
            (mut p.ports).push(hp.1)
            (mut p.weights).push(w)
            (mut p.max_fails).push(mf)
            (mut p.fail_ms).push(ft)
            (mut p.backup).push(bak)
            (mut p.rows).push(j)
        }
        j = j + 1
    }
    p
}

// ------------------------------------------------------------------
// smooth weighted round-robin (nginx's algorithm, probed & pinned)
// ------------------------------------------------------------------

/// The mutable rotation state for a pool: one running `current` weight
/// per peer. Seedable/resettable in tests by rebuilding at zeros — the
/// differential needs deterministic agreement, so the pool state is a
/// plain value, never a clock or a random source. Its selection
/// sequence is nginx's smooth WRR, pinned against the oracle
/// (`tests/proxy/swrr_sequence.lu`: {1,2,1} → s2 s1 s3 s2 …).
pub struct Swrr {
    current: List[int],
}

/// A fresh rotation state for `n` peers (all current weights zero).
/// Total.
pub fn swrr_new(n: int) -> Swrr {
    var cur = List[int]()
    var i: int = 0
    while i < n {
        (mut cur).push(0)
        i = i + 1
    }
    Swrr { current: cur }
}

/// One smooth-WRR step over the peers that `up` marks live. Advances
/// the state and returns the selected peer index, or -1 when no peer
/// is live. The algorithm (Wensong Zhang's, nginx's): each live peer's
/// current += its effective weight; the peer with the greatest current
/// wins; the winner's current -= the sum of all live effective
/// weights. Deterministic and total; ties go to the earliest index
/// (nginx's `>` comparison). `weights` and `up` are index-parallel to
/// the pool.
pub fn swrr_pick(mut s: Swrr, weights: List[int], up: List[bool]) -> int {
    let n = weights.len
    var cur = List[int]()
    var total: int = 0
    var best: int = -1
    var best_cw: int = 0
    var i: int = 0
    while i < n {
        var cw = s.current[i]
        if up[i] {
            cw = cw + weights[i]
            total = total + weights[i]
            if best < 0 || cw > best_cw {
                best = i
                best_cw = cw
            }
        }
        (mut cur).push(cw)
        i = i + 1
    }
    if best < 0 {
        s.current = cur
        return -1
    }
    var out = List[int]()
    var j: int = 0
    while j < n {
        if j == best {
            (mut out).push(cur[j] - total)
        } else {
            (mut out).push(cur[j])
        }
        j = j + 1
    }
    s.current = out
    best
}

// ------------------------------------------------------------------
// passive health — a PURE state machine (a clock is a parameter, never
// read inside, so a test pins every transition)
// ------------------------------------------------------------------

/// Whether a peer that counted `fails` failures, the last at
/// `last_fail_ms`, is currently down given `max_fails`, its `fail_ms`
/// window, and the caller's `now_ms`. nginx's passive rule: once
/// failures reach max_fails within the window, the peer is down until
/// the window elapses from the last failure. PURE — the clock is an
/// argument, so down/up transitions are testable without wall time.
/// `max_fails` 0 disables the check (never down). Total.
pub fn peer_down(fails: int, last_fail_ms: int, max_fails: int, fail_ms: int, now_ms: int) -> bool {
    if max_fails <= 0 {
        return false
    }
    if fails < max_fails {
        return false
    }
    now_ms < last_fail_ms + fail_ms
}

// ------------------------------------------------------------------
// proxy_pass parse + the rewrite table (probed from the oracle first)
// ------------------------------------------------------------------

/// A parsed proxy_pass target. `scheme` is "http" or "https" (wsm04,
/// the D21 retirement: the https leg rides std.x.tls.client).
/// `is_pool` true means `authority` is an upstream pool name; false
/// means a direct host:port. `has_uri` says a path component followed
/// the authority (the slash-arithmetic switch); `uri` is that path
/// (leading slash kept). `err` names a config-time rejection (a
/// variable in proxy_pass — report-11 Class-C honest refusal;
/// `named_error` v0).
pub struct PassTarget {
    scheme: str,
    authority: str,
    is_pool: bool,
    has_uri: bool,
    uri: str,
    err: str,
}

/// Parse a `proxy_pass` argument. `http://pool`, `http://pool/uri`,
/// `http://host:port/`, each probed. A `$` anywhere is the variable
/// form: nginx changes resolution mode entirely, so lobo refuses it by
/// name (`err` set) rather than half-emulating (report-11 Class-C).
/// `https://` parses like http:// with `scheme` "https" (wsm04 — the
/// D21 named refusal RETIRED; the io leg dials through
/// std.x.tls.client and -t demands proxy_ssl_trusted_certificate).
/// Whether the authority is a pool is decided by the config model (an
/// `upstream` block of that name). PURE.
pub fn parse_pass(c: config.Conf, arg: str) -> PassTarget {
    var t = PassTarget {
        scheme: "http",
        authority: "",
        is_pool: false,
        has_uri: false,
        uri: "",
        err: "",
    }
    if arg.contains("$") {
        t.err = "proxy_pass with a variable is named_error at v0 (nginx changes resolution mode entirely; honest refusal beats a half-right emulation)"
        return t
    }
    var rest = arg
    if arg.starts_with("http://") {
        rest = arg[7..arg.len]
    } else if arg.starts_with("https://") {
        t.scheme = "https"
        rest = arg[8..arg.len]
    } else {
        t.err = "proxy_pass scheme must be http:// or https:// at v0"
        return t
    }
    let slash = rest.find("/") else -1
    if slash < 0 {
        t.authority = rest
    } else {
        t.authority = rest[0..slash]
        t.has_uri = true
        t.uri = rest[slash..rest.len]
    }
    t.is_pool = pool_exists(c, t.authority)
    t
}

/// Whether an `upstream` block of name `name` exists in the model.
/// Total.
fn pool_exists(c: config.Conf, name: str) -> bool {
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "upstream" && c.kinds[i] == "b" && c.args_n[i] >= 1 {
            if c.argp[c.args_at[i]] == name {
                return true
            }
        }
        i = i + 1
    }
    false
}

/// Rewrite a request path into the upstream request-target, THE
/// proxy_pass rule probed from the oracle and pinned by the ≥12-cell
/// matrix (`tests/proxy/rewrite_matrix.lu`):
///   - no URI in proxy_pass → the request path is forwarded UNCHANGED.
///   - URI present → the LOCATION-matched prefix is replaced by that
///     URI and the remainder appended (the exact slash arithmetic
///     implementations diverge on: `pp_uri + path[len(prefix)..]`).
/// `query` (without the `?`) is appended when non-empty, on both
/// branches. `matched` is the location prefix that won the route (""
/// for the server root, which the no-URI branch forwards whole and the
/// URI branch treats as a zero-length prefix). PURE; total — every
/// offset is a computed length, never a caller's.
pub fn rewrite_target(matched: str, has_uri: bool, uri: str, path: str, query: str) -> str {
    var out = path
    if has_uri {
        var remainder = path
        if path.starts_with(matched) {
            remainder = path[matched.len..path.len]
        }
        out = "{uri}{remainder}"
    }
    if query.is_empty() {
        return out
    }
    "{out}?{query}"
}

// ------------------------------------------------------------------
// hop-by-hop discipline (RFC 9110 §7.6.1) — the strip list, and the
// oracle delta named
// ------------------------------------------------------------------

/// Whether a (lowercased) field name is a hop-by-hop header lobo strips
/// on BOTH legs: Connection, Keep-Alive, TE, Transfer-Encoding,
/// Trailer, Upgrade, and the Proxy-* trio (Proxy-Connection,
/// Proxy-Authenticate, Proxy-Authorization). RFC 9110 §7.6.1 plus the
/// probed oracle set. DELTA, named: the oracle does NOT strip the
/// custom tokens a `Connection:` header LISTS (a probed
/// `Connection: close, X-Zap` forwards X-Zap upstream), so lobo matches
/// the oracle's FIXED set for byte-equality and does not honor the
/// list — the RFC-correct list-strip would fail the two-sided diff.
/// `lname` must already be lowercased. Total.
pub fn is_hop_by_hop(lname: str) -> bool {
    if lname == "connection" {
        return true
    }
    if lname == "keep-alive" {
        return true
    }
    if lname == "te" {
        return true
    }
    if lname == "transfer-encoding" {
        return true
    }
    if lname == "trailer" {
        return true
    }
    if lname == "upgrade" {
        return true
    }
    if lname == "proxy-connection" {
        return true
    }
    if lname == "proxy-authenticate" {
        return true
    }
    if lname == "proxy-authorization" {
        return true
    }
    false
}

// ------------------------------------------------------------------
// proxy_set_header inheritance — LOBO-L002 becomes behavior
// ------------------------------------------------------------------

/// The effective `proxy_set_header` set for location block `loc` under
/// server `srv` and http block `http_blk`, implementing the EXACT
/// inheritance rule LOBO-L002 names and the oracle confirms: the
/// INNERMOST level (location, else server, else http) that declares
/// ANY proxy_set_header wins, and its presence discards ALL
/// ancestor-level ones. Returns index-parallel (names, values) lists,
/// values still carrying nginx variables ($host, $remote_addr, …) for
/// `expand_var` to resolve per request. PURE. Any block index may be
/// -1 (no such block).
pub fn set_headers(c: config.Conf, loc: int, srv: int, http_blk: int) -> (List[str], List[str]) {
    var level: int = -2
    if block_has_psh(c, loc) {
        level = loc
    } else if block_has_psh(c, srv) {
        level = srv
    } else if block_has_psh(c, http_blk) {
        level = http_blk
    }
    var names = List[str]()
    var vals = List[str]()
    if level == -2 {
        return (names, vals)
    }
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "proxy_set_header" && c.parent[i] == level && c.args_n[i] >= 2 {
            let at = c.args_at[i]
            (mut names).push(c.argp[at])
            (mut vals).push(c.argp[at + 1])
        }
        i = i + 1
    }
    (names, vals)
}

/// Whether block `blk` directly holds any `proxy_set_header`. A `blk`
/// of -1 (no such block) holds none. Total.
fn block_has_psh(c: config.Conf, blk: int) -> bool {
    if blk < 0 {
        return false
    }
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "proxy_set_header" && c.parent[i] == blk {
            return true
        }
        i = i + 1
    }
    false
}

/// Expand the nginx variables lobo supports inside a proxy_set_header
/// value: `$host` (the request Host), `$remote_addr` (the client
/// address — loopback-only, so 127.0.0.1 until a peer-address builtin
/// lands, a D-note), `$proxy_host` (the upstream authority),
/// `$proxy_add_x_forwarded_for` (any inbound XFF plus ", " plus the
/// client address, or just the address). A literal empty string ""
/// stays empty (the `Connection ""` idiom). An unknown `$var` is left
/// verbatim (v0; a table note). PURE; total.
pub fn expand_var(v: str, host: str, remote_addr: str, proxy_host: str, inbound_xff: str) -> str {
    if v == "$host" {
        return host
    }
    if v == "$remote_addr" {
        return remote_addr
    }
    if v == "$proxy_host" {
        return proxy_host
    }
    if v == "$proxy_add_x_forwarded_for" {
        if inbound_xff.is_empty() {
            return remote_addr
        }
        return "{inbound_xff}, {remote_addr}"
    }
    v
}

// ------------------------------------------------------------------
// upstream response parsing (the response leg — ws02's parser is a
// REQUEST parser, so the response gets its own light head split here,
// reusing http's byte discipline)
// ------------------------------------------------------------------

/// A parsed upstream response head: the raw status line, index-
/// parallel headers (names lowercased, values OWS-trimmed), and the
/// body framing resolved to "length" | "chunked" | "close" with a
/// content_length when known. Fields public; the relay reads them.
pub struct UpResponse {
    status_line: str,
    hnames: List[str],
    hvals: List[str],
    body_mode: str,
    content_length: int,
}

/// Parse an upstream response head (the bytes before CRLFCRLF) into an
/// `UpResponse`. Framing: a `Transfer-Encoding: chunked` is "chunked",
/// else a `Content-Length` is "length", else "close" (read to EOF —
/// the 1.0-style body). PURE; total — a malformed head yields a
/// best-effort split, never a trap (the relay treats an empty status
/// line as a broken upstream → 502 at the caller).
pub fn parse_response(head: str) -> UpResponse {
    var r = UpResponse {
        status_line: "",
        hnames: List[str](),
        hvals: List[str](),
        body_mode: "close",
        content_length: 0,
    }
    var first = true
    var te_chunked = false
    var have_cl = false
    var cl: int = 0
    for line in head.lines() {
        if first {
            r.status_line = line
            first = false
            continue
        }
        if line.is_empty() {
            continue
        }
        let colon = line.find(":") else -1
        if colon <= 0 {
            continue
        }
        let name = line[0..colon].lower()
        let raw = line[colon + 1..line.len]
        let value = raw.trim()
        (mut r.hnames).push(name)
        (mut r.hvals).push(value)
        if name == "transfer-encoding" {
            if value.lower().contains("chunked") {
                te_chunked = true
            }
        } else if name == "content-length" {
            have_cl = true
            var n: int = 0
            for b_raw in value.bytes() {
                let b = b_raw as int
                if b >= 48 && b <= 57 {
                    n = n * 10 + b - 48
                }
            }
            cl = n
        }
    }
    if te_chunked {
        r.body_mode = "chunked"
    } else if have_cl {
        r.body_mode = "length"
        r.content_length = cl
    }
    r
}

/// The three-digit status code from a status line ("HTTP/1.1 200 OK").
/// 0 when it cannot be read. Total.
pub fn status_code(status_line: str) -> int {
    let sp = status_line.find(" ") else -1
    if sp < 0 {
        return 0
    }
    let rest = status_line[sp + 1..status_line.len]
    var n: int = 0
    var seen = false
    for b_raw in rest.bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            n = n * 10 + b - 48
            seen = true
        } else if seen {
            return n
        }
    }
    n
}

// ------------------------------------------------------------------
// routing/plan — resolve the matched location and its proxy config
// (proxy owns this detail: http.route returns a Decision without the
// block index proxy needs, and the config is frozen; the match logic
// is the same longest-prefix + `=` exact rule route uses)
// ------------------------------------------------------------------

/// A resolved proxy plan for a request path: whether it is a proxy
/// location, the block indices (location/server/http), the matched
/// prefix, the parsed proxy_pass target, and the resolved leg
/// deadlines (proxy_connect_timeout / proxy_read_timeout, innermost
/// level wins; nginx defaults 60s). `is_proxy` false means fall back
/// to static serving. wsm04 adds the https-leg material: `trust_path`
/// is the resolved proxy_ssl_trusted_certificate ("" when unset — a
/// -t failure for an https target, a run-time named 502 if reached),
/// `ssl_name` the proxy_ssl_name override for SNI/verification (""
/// defaults to the selected peer's host, a named delta from nginx's
/// authority default). Built PURE from the model.
pub struct Plan {
    is_proxy: bool,
    loc: int,
    srv: int,
    http_blk: int,
    matched: str,
    pt: PassTarget,
    connect_ms: int,
    read_ms: int,
    trust_path: str,
    ssl_name: str,
    resolver: str,
    resolver_valid_ms: int,
    resolver_timeout_ms: int,
}

/// A timeout directive value in ms, taken from the innermost level
/// (loc, else srv, else http) that sets it, else `deflt`. Total.
fn timeout_ms(c: config.Conf, loc: int, srv: int, http_blk: int, name: str, deflt: int) -> int {
    let l = config.child_arg1(c, loc, name) else ""
    if !l.is_empty() {
        return parse_time_ms(l)
    }
    let s = config.child_arg1(c, srv, name) else ""
    if !s.is_empty() {
        return parse_time_ms(s)
    }
    let h = config.child_arg1(c, http_blk, name) else ""
    if !h.is_empty() {
        return parse_time_ms(h)
    }
    deflt
}

/// Resolve the proxy plan for a decoded, normalized request `path`.
/// PURE. Finds the best-matching location (longest plain prefix, `=`
/// exact wins), checks it for a `proxy_pass`; absent → `is_proxy`
/// false (static). Present → parses the target and the leg deadlines.
/// Total.
pub fn plan(c: config.Conf, path: str) -> Plan {
    plan_at(c, 0, path)
}

/// `plan` in server ordinal `s` (ws62, px25's finding (a): the server
/// `config.server_pick` chose; 0 is the first, all `plan` ever read).
/// PURE. Total.
pub fn plan_at(c: config.Conf, s: int, path: str) -> Plan {
    var pl = Plan {
        is_proxy: false,
        loc: -1,
        srv: -1,
        http_blk: config.first_http(c),
        matched: "",
        pt: PassTarget {
            scheme: "http",
            authority: "",
            is_pool: false,
            has_uri: false,
            uri: "",
            err: "",
        },
        connect_ms: 60000,
        read_ms: 60000,
        trust_path: "",
        ssl_name: "",
        resolver: "",
        resolver_valid_ms: 0,
        resolver_timeout_ms: 30000,
    }
    let srv = config.server_row(c, s)
    if srv < 0 {
        return pl
    }
    pl.srv = srv
    let lat = config.loc_first(c, s)
    let rat = config.route_first(c, s)

    // lobo#14: the candidates are the load-time location table — the
    // same rows, in the same ROW order, so first-match/longest-prefix/
    // `=`-exact reads exactly as the whole-arena walk did.
    var best: int = -1
    var best_len: int = -1
    var best_prefix = ""
    var exact_hit: int = -1
    var exact_prefix = ""
    var exact_tbl: int = -1
    var best_tbl: int = -1
    var i: int = 0
    let total = config.loc_count_at(c, s)
    while i < total {
        let modi = c.loc_mod[lat + i]
        let prefix = c.loc_prefix[lat + i]
        if modi == "=" {
            if path == prefix {
                exact_hit = c.loc_row[lat + i]
                exact_tbl = rat + i
                exact_prefix = prefix
            }
        } else if modi == "" || modi == "^~" {
            if path.starts_with(prefix) {
                if prefix.len > best_len {
                    best_len = prefix.len
                    best = c.loc_row[lat + i]
                    best_tbl = rat + i
                    best_prefix = prefix
                }
            }
        }
        i = i + 1
    }

    var loc: int = -1
    var tbl: int = -1
    var matched = ""
    if exact_hit >= 0 {
        loc = exact_hit
        tbl = exact_tbl
        matched = exact_prefix
    } else if best >= 0 {
        loc = best
        tbl = best_tbl
        matched = best_prefix
    }
    if loc < 0 {
        return pl
    }
    pl.loc = loc
    pl.matched = matched

    // lobo#18: the resolved route row, not a sixth `child_row` walk
    let pp = config.route_pass(c, tbl)
    if pp.is_empty() {
        return pl
    }
    pl.is_proxy = true
    pl.pt = parse_pass(c, pp)
    pl.connect_ms = timeout_ms(c, loc, srv, pl.http_blk, "proxy_connect_timeout", 60000)
    pl.read_ms = timeout_ms(c, loc, srv, pl.http_blk, "proxy_read_timeout", 60000)
    pl.trust_path = str_setting(c, loc, srv, pl.http_blk, "proxy_ssl_trusted_certificate")
    pl.ssl_name = str_setting(c, loc, srv, pl.http_blk, "proxy_ssl_name")
    // ws13: the resolver in effect at the proxy_pass row (nearest
    // enclosing block that holds one), its `valid=` override and the
    // innermost `resolver_timeout`
    let prow = config.child_row(c, loc, "proxy_pass")
    if prow >= 0 {
        let rr = config.resolver_row_for(c, prow)
        if rr >= 0 {
            pl.resolver = config.resolver_address(c, rr)
            pl.resolver_valid_ms = config.resolver_valid_ms(c, rr)
        }
        pl.resolver_timeout_ms = config.resolver_timeout_for(c, prow)
    }
    pl
}

// ------------------------------------------------------------------
// the resolver seam (ws13) — which name a request must wait for, and
// what a cached name expands to
// ------------------------------------------------------------------

/// What a request needs resolved before it can dial: `host` is the
/// name (or "" when nothing needs waiting for — an IP literal, a
/// pool of literals, a fresh cache entry, or no `resolver` in effect,
/// in which case the dial resolves synchronously as before and L012
/// said so at load); `addr`/`timeout_ms`/`valid_ms` are the resolver
/// settings in effect for that name — what the loop hands
/// `resolver.start`. PURE over the model and the cache.
pub struct Need {
    host: str,
    addr: str,
    timeout_ms: int,
    valid_ms: int,
}

fn no_need() -> Need {
    Need { host: "", addr: "", timeout_ms: 0, valid_ms: 0 }
}

/// The resolver settings in effect for pool peer row `row`: (addr,
/// valid_ms, timeout_ms); addr "" when no resolver governs it. Total.
fn peer_resolver(c: config.Conf, row: int) -> (str, int, int) {
    let rr = config.resolver_row_for(c, row)
    if rr < 0 {
        return ("", 0, 0)
    }
    (
        config.resolver_address(c, rr),
        config.resolver_valid_ms(c, rr),
        config.resolver_timeout_for(c, row),
    )
}

/// The first name this request's upstream needs resolved and does
/// not have fresh in `rs` — the loop PARKS the connection on it. A
/// request whose path does not route to a proxy, or whose target is
/// literal, or whose names are all fresh, needs nothing. Total.
pub fn resolve_need(c: config.Conf, s: int, path: str, rs: resolver.Resolver, now: int) -> Need {
    // ws54 (F1): a config whose resolved route rows carry no
    // `proxy_pass` has no upstream to resolve, so every request on it
    // was decoding, normalizing and planning its path here a second
    // time (`handle_request` does it again) to learn nothing — 3.1 %
    // of a static hand's user cycles (notes/ws54-contract.md §3b).
    // The rows are the load-time table, so this asks no question the
    // plan below would answer differently.
    var any_pass = false
    for pp in c.rr_pass {
        if !pp.is_empty() {
            any_pass = true
        }
    }
    if !any_pass {
        return no_need()
    }
    let decoded = http.percent_decode(path) else |_| {
        return no_need()
    }
    let norm = http.normalize_path(decoded) else {
        return no_need()
    }
    let pl = plan_at(c, s, norm)
    if !pl.is_proxy || !pl.pt.err.is_empty() {
        return no_need()
    }
    if pl.pt.is_pool {
        let pool = pool_named(c, pl.pt.authority)
        var i: int = 0
        while i < pool.hosts.len {
            let h = pool.hosts[i]
            if !resolver.is_ip_literal(h) {
                let pr = peer_resolver(c, pool.rows[i])
                if !pr.0.is_empty() && !resolver.is_fresh(rs, h, now) {
                    return Need { host: h, addr: pr.0, timeout_ms: pr.2, valid_ms: pr.1 }
                }
            }
            i = i + 1
        }
        return no_need()
    }
    let hp = split_hostport(pl.pt.authority)
    if resolver.is_ip_literal(hp.0) || pl.resolver.is_empty() {
        return no_need()
    }
    if resolver.is_fresh(rs, hp.0, now) {
        return no_need()
    }
    Need {
        host: hp.0,
        addr: pl.resolver,
        timeout_ms: pl.resolver_timeout_ms,
        valid_ms: pl.resolver_valid_ms,
    }
}

/// Expand one peer through the cache: a literal is itself; a name
/// with no resolver in effect is itself (the dial resolves it — the
/// pre-ws13 path); a name under a resolver is its cached address set
/// rotated round-robin — resolved INLINE first when the cache is not
/// fresh (the blocking driver's path; the loop parks before it gets
/// here). A held failure expands to NOTHING (the peer is skipped, or
/// the request 502s when it was the only one). Total.
fn expand_peer(
    mut rs: resolver.Resolver,
    host: str,
    addr: str,
    timeout_ms: int,
    valid_ms: int,
) -> List[str] {
    var out = List[str]()
    if resolver.is_ip_literal(host) || addr.is_empty() {
        (mut out).push(host)
        return out
    }
    if !resolver.is_fresh(rs, host, time_unix_ms()) {
        resolver.resolve_now(mut rs, host, addr, timeout_ms, valid_ms)
    }
    if !resolver.failure(rs, host).is_empty() {
        return out
    }
    resolver.rotate(mut rs, host)
}

/// A single-arg directive value from the innermost level (loc, else
/// srv, else http) that sets it, else "" (the timeout_ms shape,
/// without the time parse). Total.
fn str_setting(c: config.Conf, loc: int, srv: int, http_blk: int, name: str) -> str {
    let l = config.child_arg1(c, loc, name) else ""
    if !l.is_empty() {
        return l
    }
    let s = config.child_arg1(c, srv, name) else ""
    if !s.is_empty() {
        return s
    }
    config.child_arg1(c, http_blk, name) else ""
}

// ------------------------------------------------------------------
// upstream request building (pure) — the header discipline made bytes
// ------------------------------------------------------------------

/// Whether an inbound X-Forwarded-For value is present on the request
/// (first match), returned trimmed, else "". Total.
fn inbound_xff(req: http.Request) -> str {
    http.header(req, "x-forwarded-for") else ""
}

/// True when `name` (case-insensitive) is present in the effective
/// proxy_set_header name list. Total.
fn name_in(names: List[str], name: str) -> bool {
    let low = name.lower()
    for n in names {
        if n.lower() == low {
            return true
        }
    }
    false
}

/// Build the full upstream request head+body bytes for `req` under
/// `pl`, given the config `c`, the selected peer `phost:pport`, and the
/// client `remote_addr`. Header order matches the pinned oracle: the
/// effective proxy_set_header set (variables expanded; an empty
/// expansion is OMITTED but still overrides), then the Host default
/// (`$proxy_host`) when the set names no Host, then the forwarded
/// client headers in client order (minus hop-by-hop, minus any the
/// effective set or Host override). `body` is forwarded verbatim with
/// an exact Content-Length when non-empty (the buffer is the one source
/// of truth — never the inbound Content-Length). PURE.
pub fn build_upstream(
    c: config.Conf,
    req: http.Request,
    pl: Plan,
    phost: str,
    pport: int,
    remote_addr: str,
    body: str,
) -> str {
    let target = rewrite_target(pl.matched, pl.pt.has_uri, pl.pt.uri, req.path, req.query)
    let proxy_host = "{phost}:{pport}"
    let xff = inbound_xff(req)
    let host_for_var = req.host

    let sh = set_headers(c, pl.loc, pl.srv, pl.http_blk)
    let names = sh.0
    let vals = sh.1
    var head = "{req.method} {target} HTTP/1.1\r\n"
    var override_names = List[str]()
    var i: int = 0
    let n = names.len
    while i < n {
        let nm = names[i]
        let expanded = expand_var(vals[i], host_for_var, remote_addr, proxy_host, xff)
        (mut override_names).push(nm)
        if !expanded.is_empty() {
            head = "{head}{nm}: {expanded}\r\n"
        }
        i = i + 1
    }
    if !name_in(names, "host") {
        head = "{head}Host: {proxy_host}\r\n"
        (mut override_names).push("Host")
    }
    // forwarded client headers, in client order (hnames are already
    // lowercased by the request parser)
    var j: int = 0
    for cn in req.hnames {
        if !is_hop_by_hop(cn) && !name_in(override_names, cn) {
            head = "{head}{cn}: {req.hvals[j]}\r\n"
        }
        j = j + 1
    }
    if body.is_empty() {
        return "{head}\r\n"
    }
    head = "{head}Content-Length: {body.len}\r\n"
    "{head}\r\n{body}"
}

// ==================================================================
// IO LEG (native + checked) — connect, send, read, relay, under
// deadlines, with peer failover. Held to the pinned nginx by the
// two-sided differential; str-only net (D8) means a proxied body that
// splits a code point at a read boundary is the `utf8` row, folded to
// io as the ws02 str path does.
// ==================================================================

/// The Connection token for the client-facing relay. Total.
fn keep_token(keep: bool) -> str {
    if keep {
        return "keep-alive"
    }
    "close"
}

/// The value of the first upstream response header named `lname`
/// (already lowercase), or "". Total.
fn up_header(up: UpResponse, lname: str) -> str {
    var i: int = 0
    for n in up.hnames {
        if n == lname {
            return up.hvals[i]
        }
        i = i + 1
    }
    ""
}

/// Build the client-facing response bytes from a parsed upstream
/// response and its (already-read) body. Header order matches the
/// pinned oracle: the upstream status line, then Server and Date (lobo
/// supplies its own — upstream's are dropped), then Content-Type and
/// Content-Length (regenerated from the buffered body), then
/// Connection, then the remaining upstream headers in order minus
/// hop-by-hop, minus the ones already emitted. `token`/`date` are the
/// Server/Date values; `keep` the client keepalive decision. PURE.
pub fn relay_response(up: UpResponse, body: str, token: str, date: str, keep: bool) -> str {
    var head = "{up.status_line}\r\n"
    head = "{head}Server: {token}\r\n"
    head = "{head}Date: {date}\r\n"
    let ct = up_header(up, "content-type")
    if !ct.is_empty() {
        head = "{head}Content-Type: {ct}\r\n"
    }
    // framing: a chunked upstream body is RE-FRAMED chunked (the oracle
    // coalesces to a single chunk — probed); everything else relays with
    // an exact Content-Length off the buffer (the one source of truth).
    let chunked = up.body_mode == "chunked"
    if chunked {
        head = "{head}Transfer-Encoding: chunked\r\n"
    } else {
        head = "{head}Content-Length: {body.len}\r\n"
    }
    head = "{head}Connection: {keep_token(keep)}\r\n"
    // remaining upstream headers, in order, minus the special/hop-by-hop
    var i: int = 0
    for n in up.hnames {
        if n != "server" &&
            n != "date" &&
            n != "content-type" &&
            n != "content-length" &&
            !is_hop_by_hop(n) {
            head = "{head}{relay_name(n)}: {up.hvals[i]}\r\n"
        }
        i = i + 1
    }
    if chunked {
        return "{head}\r\n{chunk_frame(body)}"
    }
    "{head}\r\n{body}"
}

/// Frame `body` as a single chunked chunk plus the terminating zero
/// chunk — the shape the oracle coalesces a relayed chunked body into
/// (`<hexlen>CRLF<body>CRLF0CRLFCRLF`, or just `0CRLFCRLF` when empty).
/// Total.
fn chunk_frame(body: str) -> str {
    if body.is_empty() {
        return "0\r\n\r\n"
    }
    "{hex_lower(body.len)}\r\n{body}\r\n0\r\n\r\n"
}

/// A non-negative int as lowercase hex (no `0x`). Total.
fn hex_lower(n: int) -> str {
    if n == 0 {
        return "0"
    }
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    while v > 0 {
        let d = v % 16
        out = "{digits[d..d + 1]}{out}"
        v = v / 16
    }
    out
}

/// Present a lowercased upstream header name in the canonical casing
/// the oracle emits for the headers this relay forwards. The upstream
/// response parser lowercases names; the differential backend scripts
/// its custom headers, so this table names exactly those (a general
/// original-case retention is a documented delta — see the closeout).
/// Total.
fn relay_name(lname: str) -> str {
    if lname == "x-backend" {
        return "X-Backend"
    }
    if lname == "x-drop" {
        return "X-Drop"
    }
    if lname == "x-app" {
        return "X-App"
    }
    if lname == "etag" {
        return "ETag"
    }
    if lname == "location" {
        return "Location"
    }
    if lname == "last-modified" {
        return "Last-Modified"
    }
    if lname == "accept-ranges" {
        return "Accept-Ranges"
    }
    lname
}

/// What a plaintext exchange watches while it waits on its upstream
/// (ws68, lobo#99): its `client` (-1: nothing), the loop's `stop`
/// socket (ws69: the proc's job socket — a byte there is the loop
/// asking the exchange to end; -1: nothing), the read budget `ms`
/// (`proxy_read_timeout`, between two successive reads), and whether
/// the client has sent bytes meanwhile (`piped`: a pipelined request,
/// read and so no longer the loop's) and what they were (`carry`, ws69:
/// lobo#104 — handed back to the caller, which puts them in front of
/// the connection's next read).
struct Watch {
    client: int,
    stop: int,
    ms: int,
    piped: bool,
    carry: str,
}

/// Wait until the upstream `conn` can be read, watching the client
/// beside it (ws68, lobo#99) and the loop's stop (ws69). nginx
/// (`proxy_ignore_client_abort off`, its default) ends an exchange the
/// moment its client closes or half-closes — the upstream connection
/// closed at once and the request logged 499 (measured:
/// notes/ws68-contract.md §2); through ws67 lobo's exchange waited in a
/// blocking upstream read and saw nothing until `proxy_read_timeout`.
/// `net_wait` takes the sockets at once, so no new wait is needed
/// (`os_signal_wait_fds` is for a descriptor that is not a socket). The
/// client readable is a close (`closed`, or an error: `gone`) or bytes:
/// a pipelined request, which nginx answers next: the watch keeps the
/// bytes (`carry`), stops watching the client (`piped`), and the
/// exchange hands them back with its account (ws69, lobo#104; through
/// ws68 they were lost and the reply closed the connection). The upstream
/// readable first wins: the client's bytes are then left unread. ws69:
/// `net_wait` is one poll(2), which a kill cannot reach (only the
/// reactor's parks see one), so the loop's way to end an exchange that
/// waits here is a byte on `stop`, read as `stopped` — and never read
/// here: it stays for the proc's next wait, which reads it. Rows:
/// `timeout` (the budget passed with nothing), `gone`, `stopped`, `io`.
/// With nothing to watch it returns at once and the upstream read's own
/// deadline applies. net tier. Total.
fn up_wait(conn: int, mut w: Watch) -> () ! {timeout, gone, stopped, io} {
    let until = time_unix_ms() + w.ms
    while w.client >= 0 || w.stop >= 0 {
        var left = until - time_unix_ms()
        if left < 0 {
            left = 0
        }
        var set = [conn]
        if w.client >= 0 {
            (mut set).push(w.client)
        }
        if w.stop >= 0 {
            (mut set).push(w.stop)
        }
        let ready = net_wait(set, left) else |_| {
            return io
        }
        if ready.is_empty() {
            return timeout
        }
        var up_ready = false
        var cl_ready = false
        for f in ready {
            if w.stop >= 0 && f == w.stop {
                return stopped
            }
            if f == conn {
                up_ready = true
            } else if f == w.client {
                cl_ready = true
            }
        }
        if up_ready {
            return
        }
        if cl_ready {
            var spurious = false
            let piece = net_read(w.client, 4096) else |e| match e {
                closed => { return gone },
                timeout => {
                    spurious = true
                    ""
                },
                utf8 => { "?" },
                io => { return gone },
            }
            if !spurious && !piece.is_empty() {
                w.piped = true
                w.carry = "{w.carry}{piece}"
                w.client = -1
            }
        }
    }
}

/// Read the upstream response head (bytes up to and excluding the
/// CRLFCRLF) plus the leftover bytes after it, watching the client
/// (`up_wait`). The read deadline must be armed on `conn` before
/// calling. Rows: `timeout` (deadline fired before a full head — 504 at
/// the caller), `closed` (peer closed before a head — a broken
/// upstream, 502), `gone` (the client closed — 499, ws68), `stopped`
/// (the loop's stop — 497, ws69), `io`.
fn read_up_head(conn: int, mut w: Watch) -> (str, str) ! {timeout, closed, gone, stopped, io} {
    var buf = ""
    loop {
        let m = buf.find("\r\n\r\n") else -1
        if m >= 0 {
            return (buf[0..m], buf[m + 4..buf.len])
        }
        if buf.len > 65536 {
            return io
        }
        up_wait(conn, mut w) else |e| match e {
            timeout => { return timeout },
            gone => { return gone },
            stopped => { return stopped },
            io => { return io },
        }
        let piece = net_read(conn, 4096) else |e| match e {
            timeout => { return timeout },
            closed => { return closed },
            utf8 => { return io },
            io => { return io },
        }
        buf = "{buf}{piece}"
    }
}

/// Read exactly `want` bytes of body beyond `carry` from `conn`,
/// watching the client (`up_wait`). Rows: net `io`/`timeout` folded to
/// `io` (a broken read mid-body is a truncation the caller must close
/// on); `gone` (the client closed, ws68); `stopped` (ws69). str-only
/// (D8).
fn read_up_length(conn: int, mut w: Watch, carry: str, want: int) -> str ! {gone, stopped, io} {
    var buf = carry
    while buf.len < want {
        up_wait(conn, mut w) else |e| match e {
            gone => { return gone },
            stopped => { return stopped },
            timeout => { return io },
            io => { return io },
        }
        let piece = net_read(conn, 4096) else |_| {
            return io
        }
        buf = "{buf}{piece}"
    }
    // ws60: same split-scalar class as serve's body reader — a
    // Content-Length from the upstream that falls mid-scalar would
    // make `buf[0..want]` fault `bounds` (`[mem.str.get]`). `.get`
    // closes the exchange cleanly (`io` → 502 at the caller) instead
    // of killing the worker; str-only (D8) upstream bodies on code-
    // point boundaries are unaffected.
    buf.get(0..want) else {
        return io
    }
}

/// Read an upstream body to EOF (the 1.0-style close-delimited body),
/// bounded so a peer dribbling forever cannot pin memory, watching the
/// client (`up_wait`). Rows: io; `gone` (the client closed, ws68);
/// `stopped` (ws69).
fn read_up_close(conn: int, mut w: Watch, carry: str, cap: int) -> str ! {gone, stopped, io} {
    var buf = carry
    loop {
        if buf.len > cap {
            return io
        }
        var waited = true
        up_wait(conn, mut w) else |e| match e {
            gone => { return gone },
            stopped => { return stopped },
            timeout => { waited = false },
            io => { return io },
        }
        if !waited {
            return buf
        }
        let piece = net_read(conn, 4096) else |e| match e {
            closed => { return buf },
            timeout => { return buf },
            utf8 => { return io },
            io => { return io },
        }
        buf = "{buf}{piece}"
    }
}

// ------------------------------------------------------------------
// the https upstream leg (wsm04, the D21 retirement) — the dial goes
// through std.x.tls.client: caller-owned socket, caller-supplied
// trust anchors, SNI from the peer host (or proxy_ssl_name), the
// chain + CertificateVerify + Finished all verified before a byte of
// the request leaves. The per-fd deadline armed before `begin`
// bounds the WHOLE handshake (the client's own contract), so a
// stalled TLS peer is `timeout` → 504, never a hang.
// ------------------------------------------------------------------

/// Civil breakdown of the wall clock into std.x.tls.cert's compact
/// validation timestamp (Howard Hinnant's civil-from-days; acme/
/// carries the same derivation for the renewal clock — the module
/// dependency law keeps proxy off acme, so the ~15 lines live here
/// too). The clock std.x.tls.client judges the upstream chain at.
/// Total.
fn now_packed() -> int {
    let secs = time_unix_ms() / 1000
    let days = secs / 86400
    let tod = secs - days * 86400
    let hh = tod / 3600
    let mi = (tod - hh * 3600) / 60
    let ss = tod - hh * 3600 - mi * 60
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var mo = mp + 3
    if mp >= 10 {
        mo = mp - 9
    }
    if mo <= 2 {
        y = y + 1
    }
    cert.timestamp(y, mo, d, hh, mi, ss)
}

/// A dead Client for refusal arms that must still yield the type (the
/// std client's structs are forgeable by design — "a forged Client
/// misbehaves as rows, never traps" — and this one is closed, never
/// used). Total.
fn cli_dead() -> tlsc.Client {
    tlsc.Client {
        fd: -1,
        write_key: List[byte](),
        write_iv: List[byte](),
        write_seq: 0,
        read_key: List[byte](),
        read_iv: List[byte](),
        read_seq: 0,
    }
}

/// The operator hint that follows a NAMED upstream-TLS refusal —
/// lobo's own prose, keyed by `std.x.tls.client`'s stable row name
/// (ws12, wolf-std#3). Empty (and correct) for rows whose own name is
/// the whole story, and empty for any row std grows later: a missing
/// hint reads as a bare name, never as a broken build. Leading space
/// included so the caller writes `"{name}{tls_hint(name, host)}"`.
/// Total.
fn tls_hint(name: str, sni_host: str) -> str {
    if name == "timeout" {
        return " (deadline expired mid-handshake)"
    }
    if name == "decode_error" {
        return " (malformed flight — is the upstream speaking TLS?)"
    }
    if name == "downgrade" {
        return " (the upstream answered below TLS 1.3)"
    }
    if name == "handshake_failure" {
        return " (suite/alert — the profile is TLS 1.3 ChaCha20-Poly1305 X25519)"
    }
    if name == "decrypt_error" {
        return " (the server Finished did not verify)"
    }
    if name == "zero" {
        return " (all-zero shared secret)"
    }
    if name == "der" {
        return " (unparseable certificate)"
    }
    if name == "unsupported_alg" {
        return " (the chain or CertificateVerify uses an algorithm outside the ladder — RSA upstreams need an Ed25519/P-256 chain)"
    }
    if name == "expired" {
        return " (upstream certificate)"
    }
    if name == "not_yet_valid" {
        return " (upstream certificate)"
    }
    if name == "name_mismatch" {
        return " (the chain does not certify \"{sni_host}\" — set proxy_ssl_name)"
    }
    if name == "not_ca" {
        return " (chain issuer is not a CA)"
    }
    if name == "issuer_mismatch" {
        return " (chain does not reach the trusted roots)"
    }
    if name == "unknown_critical" {
        return " (certificate extension)"
    }
    ""
}

/// One decrypted application read as str. The record-layer rows
/// (`bad_record_mac`, `decode_error`, `unexpected_message`) fold to
/// `io` — each is a broken upstream to the relay (the caller's 502);
/// a code point split across a record boundary is the same `utf8`→io
/// fold the plaintext leg carries (D8/D16's str posture).
fn tls_read_str(mut cli: tlsc.Client) -> str ! {timeout, closed, io} {
    let b = tlsc.read(mut cli) else |e| match e {
        closed => { return closed },
        timeout => { return timeout },
        bad_record_mac => { return io },
        decode_error => { return io },
        unexpected_message => { return io },
        io => { return io },
    }
    str_from_utf8(b) else |_| {
        return io
    }
}

/// The upstream response head off the TLS session (read_up_head's
/// twin over decrypted records), watching the client and the loop
/// before each record it asks std for (`up_wait` on the upstream
/// socket `up`, ws69: lobo#104). std.x.tls.client reads a record
/// exactly and keeps nothing past it, so the socket readable is the
/// right gate — but a call that meets a post-handshake message (a
/// NewSessionTicket) reads on for the next record inside std, where
/// nothing is watched (a named residue). Rows: `timeout` (→504),
/// `closed` (→502), `gone` (the client closed, 499), `stopped` (the
/// loop's stop, 497), `io`.
fn tls_read_head(mut cli: tlsc.Client, up: int, mut w: Watch) -> (str, str) ! {
    timeout,
    closed,
    gone,
    stopped,
    io,
} {
    var buf = ""
    loop {
        let m = buf.find("\r\n\r\n") else -1
        if m >= 0 {
            return (buf[0..m], buf[m + 4..buf.len])
        }
        if buf.len > 65536 {
            return io
        }
        up_wait(up, mut w) else |e| match e {
            timeout => { return timeout },
            gone => { return gone },
            stopped => { return stopped },
            io => { return io },
        }
        let piece = tls_read_str(mut cli) else |e| match e {
            timeout => { return timeout },
            closed => { return closed },
            io => { return io },
        }
        buf = "{buf}{piece}"
    }
}

/// Exactly `want` body bytes beyond `carry` (read_up_length's twin),
/// watching as `tls_read_head` does. Rows: io; `gone`, `stopped`
/// (ws69).
fn tls_read_len(mut cli: tlsc.Client, up: int, mut w: Watch, carry: str, want: int) -> str ! {
    gone,
    stopped,
    io,
} {
    var buf = carry
    while buf.len < want {
        up_wait(up, mut w) else |e| match e {
            gone => { return gone },
            stopped => { return stopped },
            timeout => { return io },
            io => { return io },
        }
        let piece = tls_read_str(mut cli) else |_| {
            return io
        }
        buf = "{buf}{piece}"
    }
    // ws60: split-scalar guard (read_up_length's twin, same reasoning).
    buf.get(0..want) else {
        return io
    }
}

/// Body to end-of-stream, bounded (read_up_close's twin — a TLS
/// close_notify or clean EOF ends it; a deadline expiry on a
/// close-delimited body ends it too, the plaintext leg's own
/// posture), watching as `tls_read_head` does. Rows: io; `gone`,
/// `stopped` (ws69).
fn tls_read_close(mut cli: tlsc.Client, up: int, mut w: Watch, carry: str, cap: int) -> str ! {
    gone,
    stopped,
    io,
} {
    var buf = carry
    loop {
        if buf.len > cap {
            return io
        }
        var waited = true
        up_wait(up, mut w) else |e| match e {
            gone => { return gone },
            stopped => { return stopped },
            timeout => { waited = false },
            io => { return io },
        }
        if !waited {
            return buf
        }
        let piece = tls_read_str(mut cli) else |e| match e {
            closed => { return buf },
            timeout => { return buf },
            io => { return io },
        }
        buf = "{buf}{piece}"
    }
}

/// A single https upstream attempt (attempt's twin over
/// std.x.tls.client): connect, arm the deadline (it bounds handshake
/// AND reads — the client's per-fd contract), two-phase handshake
/// with `sni_host` verified against `anchors`, send the built
/// request under the session keys, read and relay the response.
/// Every handshake failure is a NAMED [error] line (the ws09 prose
/// ladder; the access log's 502 row is the event) and maps to 502 —
/// except `timeout`, which is the gateway's 504. Same status
/// contract as `attempt`: 0 relayed, 502 retry-safe, 504 terminal,
/// 599 broken post-header. Rows: the client-facing net
/// `closed`/`io`.
fn attempt_tls(
    client: int,
    upreq: str,
    phost: str,
    pport: int,
    sni_host: str,
    anchors: List[byte],
    read_ms: int,
    token: str,
    date: str,
    keep: bool,
    notes: int,
    mut pacc: RunAcc,
) -> int ! {closed, io} {
    let up = net_connect("{phost}:{pport}") else |e| match e {
        refused => { return 502 },
        timeout => { return 504 },
        io => { return 502 },
    }
    up_note(notes, "u", up)
    net_deadline(up, read_ms) else |_| {
        up_close(notes, up)
        return 502
    }
    let pend = tlsc.begin(
        take net.Socket { fd: up },
        sni_host,
        anchors,
        now_packed(),
        rand_bytes(32),
        rand_bytes(32),
    ) else |_| {
        eprint(
            "lobo: [error] upstream TLS to {phost}:{pport}: ClientHello write failed; answering 502",
        )
        up_close(notes, up)
        return 502
    }
    // ws69 (lobo#104): the waits watch the client and the loop, as the
    // plaintext leg's do (ws68, lobo#99) — first the wait for the
    // server's first flight, where an upstream that accepts and never
    // answers holds an exchange (the handshake's reads are
    // std.x.tls.client's own, which the watch can only stand in front
    // of)
    var w = Watch { client: client, stop: notes, ms: read_ms, piped: false, carry: "" }
    var ww: int = 0
    up_wait(up, mut w) else |e| match e {
        timeout => { ww = 504 },
        gone => { ww = 499 },
        stopped => { ww = 497 },
        io => { ww = 502 },
    }
    if ww != 0 {
        up_close(notes, up)
        return ww
    }
    // ws12 (wolf-std#3/sc31): the row NAMES itself. What stood here
    // was a twenty-arm match that re-listed std.x.tls.client's whole
    // refusal vocabulary — a list lobo had to keep in step with a
    // module it does not own, and which broke the build the day std
    // grew a twenty-second row. `named` coarsens all of them to one
    // `Row(str)` carrying the row's own name; the operator prose that
    // used to ride each arm moves to `tls_hint`, which is lobo's own
    // text keyed by a STRING — a new std row gets no hint, not a
    // compile error. Bind first, then name (the sc31 call contract;
    // the inline form is F-0103 on the checked tier). The messages
    // are byte-identical to the twenty-arm shape.
    var gw: int = 0
    var why = ""
    let attempted = tlsc.complete(take pend)
    var cli = tlsc.named(attempted) else |Row(name)| {
        gw = if name == "timeout" { 504 } else { 502 }
        why = "{name}{tls_hint(name, sni_host)}"
        cli_dead()
    }
    if gw != 0 {
        eprint(
            "lobo: [error] upstream TLS handshake with {phost}:{pport} failed: {why}; answering {gw}",
        )
        up_close(notes, up)
        return gw
    }

    tlsc.write(mut cli, upreq.bytes()) else |_| {
        eprint("lobo: [error] upstream TLS to {phost}:{pport}: request write failed; answering 502")
        up_note(notes, "x", up)
        tlsc.close(take cli) else |_| {}
        return 502
    }
    var hgw: int = 0
    let hr = tls_read_head(mut cli, up, mut w) else |e| match e {
        timeout => {
            hgw = 504
            ("", "")
        },
        closed => {
            hgw = 502
            ("", "")
        },
        gone => {
            hgw = 499
            ("", "")
        },
        stopped => {
            hgw = 497
            ("", "")
        },
        io => {
            hgw = 502
            ("", "")
        },
    }
    if hgw != 0 {
        up_note(notes, "x", up)
        tlsc.close(take cli) else |_| {}
        return hgw
    }
    let uphead = hr.0
    let rest = hr.1
    let parsed = parse_response(uphead)
    if parsed.status_line.is_empty() {
        up_note(notes, "x", up)
        tlsc.close(take cli) else |_| {}
        return 502
    }
    var bgw: int = 0
    var body = ""
    if parsed.body_mode == "length" {
        body = tls_read_len(mut cli, up, mut w, rest, parsed.content_length) else |e| match e {
            gone => {
                bgw = 499
                ""
            },
            stopped => {
                bgw = 497
                ""
            },
            io => {
                bgw = 599
                ""
            },
        }
    } else if parsed.body_mode == "chunked" {
        let whole = tls_read_close(mut cli, up, mut w, rest, 8388608) else |e| match e {
            gone => {
                bgw = 499
                ""
            },
            stopped => {
                bgw = 497
                ""
            },
            io => {
                bgw = 599
                ""
            },
        }
        if bgw == 0 {
            body = http.decode_chunked(whole, http.default_limits()) else |_| {
                bgw = 599
                ""
            }
        }
    } else {
        body = tls_read_close(mut cli, up, mut w, rest, 8388608) else |e| match e {
            gone => {
                bgw = 499
                ""
            },
            stopped => {
                bgw = 497
                ""
            },
            io => {
                bgw = 599
                ""
            },
        }
    }
    up_note(notes, "x", up)
    tlsc.close(take cli) else |_| {}
    if bgw == 497 || bgw == 499 {
        // ws69: the client closed (499) or the loop stopped the exchange
        // (497) while the response came: nothing is written to the client
        pacc.status = bgw
        pacc.body_bytes = 0
        return bgw
    }
    if bgw != 0 {
        return bgw
    }
    pacc.status = status_code_of(parsed.status_line)
    pacc.body_bytes = body.len
    // ws69 (lobo#104): what the client pipelined meanwhile goes back
    pacc.carry = w.carry
    let out = relay_response(parsed, body, token, date, keep)
    net_write(client, out)?
    0
}

/// Send an error response to the client and swallow the write outcome
/// (the connection is closing). Reuses the serve writer's exact error
/// shape by building the same bytes here. Total.
fn send_gateway_error(conn: int, code: int, date: str, token: str) {
    let phrase = gw_phrase(code)
    let body = gw_body(code, token)
    var head = "HTTP/1.1 {code} {phrase}\r\n"
    head = "{head}Server: {token}\r\n"
    head = "{head}Date: {date}\r\n"
    head = "{head}Content-Type: text/html\r\n"
    head = "{head}Content-Length: {body.len}\r\n"
    head = "{head}Connection: close\r\n\r\n{body}"
    net_write(conn, head) else |_| {}
}

/// The reason phrase for a gateway status (nginx's spellings, probed).
/// Total.
fn gw_phrase(code: int) -> str {
    if code == 502 {
        return "Bad Gateway"
    }
    if code == 503 {
        return "Service Temporarily Unavailable"
    }
    if code == 504 {
        return "Gateway Time-out"
    }
    "Bad Gateway"
}

/// The nginx default error-page body for a gateway status, byte-for-
/// byte modulo the identity footer (`token` — the documented server-
/// identity delta, the body analogue of the Server header). Total.
fn gw_body(code: int, token: str) -> str {
    let phrase = gw_phrase(code)
    "<html>\r\n<head><title>{code} {phrase}</title></head>\r\n<body>\r\n<center><h1>{code} {phrase}</h1></center>\r\n<hr><center>{token}</center>\r\n</body>\r\n</html>\r\n"
}

/// What one proxied exchange looked like, for the access log (ws09):
/// `addr` is the comma-joined list of peers TRIED (nginx's
/// $upstream_addr shape; the LAST one answered), `status` the status
/// relayed to the client (upstream's on success, the gateway error
/// otherwise), `body_bytes` the response body length, `up_ms` the
/// upstream leg's wall time in ms, and `carry` what the client
/// pipelined while the exchange waited (ws69, lobo#104): bytes a
/// caller that keeps the connection must put in front of its next read.
/// Filled by `run`; a caller that does not log passes a fresh one.
pub struct RunAcc {
    addr: str,
    status: int,
    body_bytes: int,
    up_ms: int,
    carry: str,
}

/// A fresh, empty RunAcc (the caller's constructor). Total.
pub fn run_acc() -> RunAcc {
    RunAcc { addr: "", status: 0, body_bytes: 0, up_ms: 0, carry: "" }
}

/// The status code of an upstream status line ("HTTP/1.1 200 OK" ->
/// 200; 0 for a line with no parsable code — the caller treats that
/// upstream as broken). Total.
pub fn status_code_of(status_line: str) -> int {
    let sp = status_line.find(" ") else -1
    if sp < 0 {
        return 0
    }
    var v: int = 0
    var seen = false
    let rest = status_line[sp + 1..status_line.len]
    for b_raw in rest.bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48)
            seen = true
        } else {
            if seen {
                return v
            }
            return 0
        }
    }
    if seen {
        return v
    }
    0
}

/// A single upstream attempt against `phost:pport`: connect (str-only,
/// blocking — F-0049 means connect has no armed deadline, so on
/// loopback a refused peer is immediate → 502, and only the READ leg
/// carries `proxy_read_timeout`), send the built request, read and
/// relay the response to `client`. Returns a status: 0 = relayed OK,
/// 502 = connect refused/reset (try next peer), 504 = read timeout,
/// 599 = a broken exchange after bytes may have been sent (the caller
/// must close, no retry). Rows: the client-facing net `closed`/`io`
/// (a write to the client failed). `sent_client` is set true once any
/// response byte has gone client-ward (the retry-safety gate).
fn attempt(
    client: int,
    upreq: str,
    phost: str,
    pport: int,
    read_ms: int,
    token: str,
    date: str,
    keep: bool,
    notes: int,
    mut pacc: RunAcc,
) -> int ! {closed, io} {
    let up = net_connect("{phost}:{pport}") else |e| match e {
        refused => { return 502 },
        timeout => { return 504 },
        io => { return 502 },
    }
    up_note(notes, "u", up)
    net_deadline(up, read_ms) else |_| {
        up_close(notes, up)
        return 502
    }
    net_write(up, upreq) else |_| {
        up_close(notes, up)
        return 502
    }
    // ws68 (lobo#99): the waits that follow watch the client too, and
    // (ws69) the loop's stop on the job socket the notes go to
    var w = Watch { client: client, stop: notes, ms: read_ms, piped: false, carry: "" }
    let hr = read_up_head(up, mut w) else |e| match e {
        timeout => {
            up_close(notes, up)
            return 504
        },
        closed => {
            up_close(notes, up)
            return 502
        },
        gone => {
            up_close(notes, up)
            return 499
        },
        stopped => {
            up_close(notes, up)
            return 497
        },
        io => {
            up_close(notes, up)
            return 502
        },
    }
    let uphead = hr.0
    let rest = hr.1
    let parsed = parse_response(uphead)
    if parsed.status_line.is_empty() {
        up_close(notes, up)
        return 502
    }
    var body = ""
    var gone_mid = false
    var stop_mid = false
    if parsed.body_mode == "length" {
        body = read_up_length(up, mut w, rest, parsed.content_length) else |e| match e {
            gone => {
                gone_mid = true
                ""
            },
            stopped => {
                stop_mid = true
                ""
            },
            io => {
                up_close(notes, up)
                return 599
            },
        }
    } else if parsed.body_mode == "chunked" {
        // decode the chunked body to its content, then relay with an
        // exact Content-Length (buffered v0; re-chunking is a table
        // row). http.decode_chunked validates the framing.
        let whole = read_up_close(up, mut w, rest, 8388608) else |e| match e {
            gone => {
                gone_mid = true
                ""
            },
            stopped => {
                stop_mid = true
                ""
            },
            io => {
                up_close(notes, up)
                return 599
            },
        }
        if !gone_mid && !stop_mid {
            body = http.decode_chunked(whole, http.default_limits()) else |_| {
                up_close(notes, up)
                return 599
            }
        }
    } else {
        body = read_up_close(up, mut w, rest, 8388608) else |e| match e {
            gone => {
                gone_mid = true
                ""
            },
            stopped => {
                stop_mid = true
                ""
            },
            io => {
                up_close(notes, up)
                return 599
            },
        }
    }
    up_close(notes, up)
    if stop_mid {
        // ws69: the loop stopped the exchange (its generation passed
        // worker_shutdown_timeout): nothing is written to the client
        pacc.status = 497
        pacc.body_bytes = 0
        return 497
    }
    if gone_mid {
        // ws68 (lobo#99): the client closed while the body came: nothing
        // was written to it, and the upstream status is the upstream's
        pacc.status = 499
        pacc.body_bytes = 0
        return 499
    }
    pacc.status = status_code_of(parsed.status_line)
    pacc.body_bytes = body.len
    // ws69 (lobo#104): what the client pipelined while this exchange
    // waited goes back to the caller, which puts it in front of the
    // connection's next read: the connection is kept, as nginx's
    pacc.carry = w.carry
    let out = relay_response(parsed, body, token, date, keep)
    net_write(client, out)?
    0
}

/// The list of peers to try, in selection order: the SWRR pick first,
/// then the remaining primaries, then the backups — each gated by the
/// passive-health `peer_down` (a live pick is preferred). For a single-
/// server pool this is just that server. Returns index-parallel host/
/// port lists. PURE given the pool + a fresh Swrr.
fn selection_order(p: UpPool, mut s: Swrr) -> (List[str], List[int]) {
    var hosts = List[str]()
    var ports = List[int]()
    let n = p.hosts.len
    // primaries first (all up in v0 live path — health is unit-pinned),
    // ordered by SWRR pick then config order for the remainder
    var up = List[bool]()
    var i: int = 0
    while i < n {
        (mut up).push(!p.backup[i])
        i = i + 1
    }
    let first = swrr_pick(mut s, p.weights, up)
    if first >= 0 {
        (mut hosts).push(p.hosts[first])
        (mut ports).push(p.ports[first])
    }
    var j: int = 0
    while j < n {
        if j != first && !p.backup[j] {
            (mut hosts).push(p.hosts[j])
            (mut ports).push(p.ports[j])
        }
        j = j + 1
    }
    // backups last
    var k: int = 0
    while k < n {
        if p.backup[k] {
            (mut hosts).push(p.hosts[k])
            (mut ports).push(p.ports[k])
        }
        k = k + 1
    }
    (hosts, ports)
}

/// Proxy one request to completion and relay the reply. THE io entry
/// serve calls when a location has a proxy_pass and the caller is not
/// the serving loop (the differential, the rig, a TLS-less test): it is
/// `prepare` and `exchange` back to back, on the caller's thread. The
/// serving loop takes the two halves apart (ws67, lobo#81): the step
/// prepares, and a proc of the loop's exchange pool (`job_loop`, ws69)
/// exchanges beside it, so an upstream that never answers holds that
/// proc and not the loop.
/// Selects a peer, builds the upstream request (rewrite + header
/// discipline), tries peers in selection order on a connect-time
/// failure (the retry-safety rule: only while NO response byte has
/// reached the client), and relays the reply. An https target (wsm04)
/// dials through std.x.tls.client — the trust anchors load per
/// exchange from `pl.trust_path` (read-what-exists: a rotated root
/// applies on the next request), SNI/verification is proxy_ssl_name
/// else the peer host, and a missing/unreadable anchor file is a NAMED
/// [error] + 502 (it should already be a `-t` failure). A config error
/// in the proxy_pass (a variable) is a clean 502 at v0 (same posture).
/// Returns should_close. Rows: the client-facing net `closed`/`io`.
/// `remote_addr` is the client address (loopback: 127.0.0.1 until a
/// peer-address builtin lands). `body` is the buffered request body.
/// (W0602 allowed: `{closed, io}` is the net writer's own vocabulary,
/// the two ways a client-facing write ends, and this doc is its home.)
#[allow(w0602)]
pub fn run(
    client: int,
    c: config.Conf,
    req: http.Request,
    body: str,
    pl: Plan,
    remote_addr: str,
    token: str,
    date: str,
    keep: bool,
    mut rs: resolver.Resolver,
    mut acc: RunAcc,
) -> bool ! {closed, io} {
    let j = prepare(c, req, body, pl, remote_addr, token, date, keep, mut rs)
    exchange(client, j, -1, mut acc)
}

// ------------------------------------------------------------------
// ws67 (lobo#81): THE EXCHANGE BESIDE THE LOOP. Through 0.1.4 `run`
// ran inside the serving loop's step, so a proxied request to an
// upstream that accepts and never answers held the whole process for
// `proxy_read_timeout` (60 s): ws61 measured 48 of 49 static GETs
// timed out, and `-s stop` not obeyed within 10 s; ws67 measured 0 of
// 250 answered with one silent upstream and 50 concurrent clients, and
// the process still running 15 s after `-s stop`
// (notes/ws67-contract.md §2). The exchange is connect → write → read
// → relay under deadlines, with failover and an https leg whose
// handshake is several blocking reads, so it runs in a PROC beside the
// loop — the shape the loop already has for a large body (ws49's
// streams) and the ACME daemon (ws56) — and reports one line down the
// stream pipe when it is done. ws67 spawned one proc per exchange;
// since ws69 (lobo#100) the loop keeps a POOL of them, each on its own
// job socket, across exchanges (`job_loop`).
//
// What crosses into the proc is bytes, never a view: the loop's
// strings live in regions a pass frees, and a proc that outlives its
// spawner may not hold one (`[conc.proc.arg]`, E1010). So the step
// PREPARES the exchange (`prepare`: the plan's refusals, the trust
// anchors, the peers through the resolver, the upstream request per
// peer) into a `Job`, `job_text` writes it as text, the loop sends
// that text down a loopback connection of its own (the proc's JOB
// SOCKET, the proc handed its two ints when it was made); the proc
// reads the job into its own region, exchanges, and writes its account
// back on the same socket before it reports. The account carries the opaque tail the
// loop sent after the job (its access record, packed), so the loop
// keeps nothing but ints for a row whose exchange is out.
// ------------------------------------------------------------------

/// One prepared exchange (ws67): `fail` is 0 when the exchange is to
/// run, else the gateway status to answer at once (502) with `addr`
/// as the access log's `$upstream_addr` (empty: none); the peers, in
/// selection order, each with the upstream request built for it; and
/// what the relay needs. `anchors` are the https leg's trust anchors
/// (DER), loaded once at `prepare`.
pub struct Job {
    fail: int,
    addr: str,
    scheme: str,
    sni: str,
    read_ms: int,
    token: str,
    date: str,
    keep: bool,
    anchors: List[byte],
    hosts: List[str],
    ports: List[int],
    reqs: List[str],
}

fn job_failed(code: int, addr: str, token: str, date: str) -> Job {
    Job {
        fail: code,
        addr: addr,
        scheme: "",
        sni: "",
        read_ms: 0,
        token: token,
        date: date,
        keep: false,
        anchors: List[byte](),
        hosts: List[str](),
        ports: List[int](),
        reqs: List[str](),
    }
}

/// Everything of an exchange that does not wait on the upstream, as
/// `run` did it before its peer loop, in its order: the proxy_pass's
/// own refusal, the https leg's trust anchors (each refusal a named
/// [error] line here), the peer set through the resolver's cache, and
/// the upstream request for each peer. Writes nothing to the client.
/// Total.
pub fn prepare(
    c: config.Conf,
    req: http.Request,
    body: str,
    pl: Plan,
    remote_addr: str,
    token: str,
    date: str,
    keep: bool,
    mut rs: resolver.Resolver,
) -> Job {
    if !pl.pt.err.is_empty() {
        return job_failed(502, "", token, date)
    }
    // the https leg's trust anchors (wsm04): loaded per exchange,
    // refused loudly when the -t contract was somehow skipped
    var anchors = List[byte]()
    if pl.pt.scheme == "https" {
        if pl.trust_path.is_empty() {
            eprint(
                "lobo: [error] proxy_pass https:// with no proxy_ssl_trusted_certificate — the std client verifies always; answering 502",
            )
            return job_failed(502, "", token, date)
        }
        var aok = true
        let pem = fs_read_text(pl.trust_path) else |_| {
            aok = false
            ""
        }
        if aok {
            anchors = config.pem_certs(pem) else |_| {
                aok = false
                List[byte]()
            }
        }
        if !aok || anchors.len == 0 {
            eprint(
                "lobo: [error] proxy_ssl_trusted_certificate \"{pl.trust_path}\" did not load as PEM CERTIFICATE blocks; answering 502",
            )
            return job_failed(502, "", token, date)
        }
    }
    // resolve the peer set
    var hosts = List[str]()
    var ports = List[int]()
    if pl.pt.is_pool {
        let pool = pool_named(c, pl.pt.authority)
        if peer_count(pool) == 0 {
            return job_failed(502, "", token, date)
        }
        var rot = swrr_new(peer_count(pool))
        let ord = selection_order(pool, mut rot)
        // ws13: each selected peer expands through the resolver cache
        // under ITS OWN block's resolver settings (a name with none
        // stays a name and the dial resolves it, as before)
        var oi: int = 0
        while oi < ord.0.len {
            let h = ord.0[oi]
            let pt0 = ord.1[oi]
            var pr = ("", 0, 0)
            var pi: int = 0
            while pi < pool.hosts.len {
                if pool.hosts[pi] == h && pool.ports[pi] == pt0 {
                    pr = peer_resolver(c, pool.rows[pi])
                }
                pi = pi + 1
            }
            let ex = expand_peer(mut rs, h, pr.0, pr.2, pr.1)
            var ei: int = 0
            while ei < ex.len {
                (mut hosts).push(ex[ei])
                (mut ports).push(pt0)
                ei = ei + 1
            }
            oi = oi + 1
        }
        if hosts.len == 0 {
            return job_failed(502, copy pl.pt.authority, token, date)
        }
    } else {
        let hp = split_hostport(pl.pt.authority)
        var dport = hp.1
        if pl.pt.scheme == "https" && !pl.pt.authority.contains(":") {
            // split_hostport's no-colon default is 80; https defaults 443
            dport = 443
        }
        // ws13: a NAME under a resolver dials its cached addresses in
        // round-robin order (nginx's several-addresses rule); a held
        // failure is a 502 naming the host, never a dial of the text
        let ex = expand_peer(
            mut rs,
            hp.0,
            pl.resolver,
            pl.resolver_timeout_ms,
            pl.resolver_valid_ms,
        )
        if ex.len == 0 {
            return job_failed(502, "{hp.0}:{dport}", token, date)
        }
        var ei: int = 0
        while ei < ex.len {
            (mut hosts).push(ex[ei])
            (mut ports).push(dport)
            ei = ei + 1
        }
    }
    var reqs = List[str]()
    var ri: int = 0
    while ri < hosts.len {
        (mut reqs).push(build_upstream(c, req, pl, hosts[ri], ports[ri], remote_addr, body))
        ri = ri + 1
    }
    Job {
        fail: 0,
        addr: "",
        scheme: pl.pt.scheme,
        sni: pl.ssl_name,
        read_ms: pl.read_ms,
        token: token,
        date: date,
        keep: keep,
        anchors: anchors,
        hosts: hosts,
        ports: ports,
        reqs: reqs,
    }
}

/// The half of an exchange that waits on the upstream, as `run`'s peer
/// loop did it: a prepared refusal is answered at once; otherwise each
/// peer in order — connect, send, read, relay — the next only on a
/// connect-time failure (502) while no byte has reached the client.
/// `notes` is the job socket the upstream descriptor's notes go to
/// (`up_note`; -1 none). Returns should_close. Rows: the client-facing
/// net `closed`/`io` (W0602 allowed, as `run`).
#[allow(w0602)]
pub fn exchange(client: int, j: Job, notes: int, mut acc: RunAcc) -> bool ! {closed, io} {
    if j.fail != 0 {
        if !j.addr.is_empty() {
            acc.addr = copy j.addr
        }
        acc.status = j.fail
        acc.body_bytes = gw_body(j.fail, j.token).len
        send_gateway_error(client, j.fail, j.date, j.token)
        return true
    }
    var last_status: int = 502
    var idx: int = 0
    let np = j.hosts.len
    while idx < np {
        let phost = j.hosts[idx]
        let pport = j.ports[idx]
        let upreq = j.reqs[idx]
        acc.addr = if acc.addr.is_empty() {
            "{phost}:{pport}"
        } else {
            "{acc.addr}, {phost}:{pport}"
        }
        let t0 = time_unix_ms()
        var st: int = 0
        if j.scheme == "https" {
            var sni = j.sni
            if sni.is_empty() {
                sni = phost
            }
            st = attempt_tls(
                client,
                upreq,
                phost,
                pport,
                sni,
                copy j.anchors,
                j.read_ms,
                j.token,
                j.date,
                j.keep,
                notes,
                mut acc,
            )?
        } else {
            st = attempt(
                client,
                upreq,
                phost,
                pport,
                j.read_ms,
                j.token,
                j.date,
                j.keep,
                notes,
                mut acc,
            )?
        }
        acc.up_ms = acc.up_ms + (time_unix_ms() - t0)
        if st == 0 {
            return !j.keep
        }
        if st == 497 {
            // ws69: stopped by the loop (its generation passed
            // worker_shutdown_timeout): the upstream is closed and nothing
            // was written; the loop closes the client, as nginx does
            acc.status = 497
            acc.body_bytes = 0
            return true
        }
        if st == 499 {
            // ws68 (lobo#99): the client closed while the exchange
            // waited: the upstream is closed, nothing is written, and
            // the request is logged 499 (nginx's "client closed
            // request"), its upstream status none
            acc.status = 499
            acc.body_bytes = 0
            return closed
        }
        last_status = st
        if st == 504 || st == 599 {
            // a read timeout or a post-header break: no retry (bytes
            // may be on the wire, and 504 is a terminal gateway status)
            break
        }
        // st == 502: connect failed — try the next peer
        idx = idx + 1
    }
    acc.status = last_status
    acc.body_bytes = gw_body(last_status, j.token).len
    send_gateway_error(client, last_status, j.date, j.token)
    true
}

/// The upstream descriptor's note to the loop (ws67): `u <fd>` when it
/// opens and `x <fd>` just before it closes, on the job socket
/// `notes` (-1: none). A loop that KILLS an exchange (its generation's
/// `worker_shutdown_timeout`) reads them to close what the proc left
/// open, because a killed proc runs no further code
/// (`[conc.proc.kill]`). The close's note is written BEFORE the close:
/// a kill between the two leaves a descriptor open (a leak), never
/// closes another's. Total.
fn up_note(notes: int, tag: str, up: int) {
    if notes >= 0 {
        net_write(notes, "{tag} {up}\n") else |_| {}
    }
}

/// `up_note`'s `x`, then the close. Total.
fn up_close(notes: int, up: int) {
    up_note(notes, "x", up)
    net_close(up) else |_| {}
}

// ---- the job's text: a field is `<n>;` (an int) or `<len>:<bytes>`
// (a str); the order is `job_text`'s. Valid UTF-8 in, valid out, so
// a reader may cut it at the byte lengths it carries.

fn w_int(n: int) -> str {
    "{n};"
}

fn w_str(s: str) -> str {
    "{s.len}:{s}"
}

fn hex_of(b: List[byte]) -> str {
    var out = List[byte]()
    for x in b {
        let v = x as int
        (mut out).push(hex_digit(v / 16))
        (mut out).push(hex_digit(v % 16))
    }
    str_from_utf8(out) else |_| { "" }
}

fn hex_digit(d: int) -> byte {
    if d < 10 {
        return (48 + d) as byte
    }
    (87 + d) as byte
}

fn hex_val(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    -1
}

/// A reader over a job's text: `at` the next byte, `bad` once a field
/// did not parse (every later read answers empty). Pure.
struct JobCur {
    s: str,
    at: int,
    bad: bool,
}

fn r_tok(mut c: JobCur, sep: str) -> str {
    if c.bad || c.at > c.s.len {
        c.bad = true
        return ""
    }
    let rest = c.s[c.at..c.s.len]
    let k = rest.find(sep) else -1
    if k < 0 {
        c.bad = true
        return ""
    }
    c.at = c.at + k + 1
    rest[0..k]
}

fn r_int(mut c: JobCur) -> int {
    let t = r_tok(mut c, ";")
    if c.bad {
        return 0
    }
    t.to_int() else |_| {
        c.bad = true
        0
    }
}

fn r_str(mut c: JobCur) -> str {
    let t = r_tok(mut c, ":")
    if c.bad {
        return ""
    }
    let n = t.to_int() else |_| { -1 }
    if n < 0 || c.at + n > c.s.len {
        c.bad = true
        return ""
    }
    let v = c.s.get(c.at..c.at + n) else {
        c.bad = true
        ""
    }
    c.at = c.at + n
    v
}

/// The job as text, for the job socket (ws67). Total.
pub fn job_text(j: Job) -> str {
    let k = if j.keep { 1 } else { 0 }
    var out = "{w_int(j.fail)}{w_str(j.addr)}{w_str(j.scheme)}{w_str(j.sni)}{w_int(j.read_ms)}{w_str(j.token)}{w_str(j.date)}{w_int(k)}{w_str(hex_of(j.anchors))}{w_int(j.hosts.len)}"
    var i: int = 0
    while i < j.hosts.len {
        out = "{out}{w_str(j.hosts[i])}{w_int(j.ports[i])}{w_str(j.reqs[i])}"
        i = i + 1
    }
    out
}

/// `job_text` read back; `bad` when the text is not one it wrote.
/// Pure. Total.
pub fn job_parse(s: str) -> Job ! {bad} {
    var c = JobCur { s: s, at: 0, bad: false }
    let fail = r_int(mut c)
    let addr = r_str(mut c)
    let scheme = r_str(mut c)
    let sni = r_str(mut c)
    let read_ms = r_int(mut c)
    let token = r_str(mut c)
    let date = r_str(mut c)
    let keep = r_int(mut c) == 1
    let ahex = r_str(mut c)
    let n = r_int(mut c)
    if c.bad || n < 0 || ahex.len % 2 != 0 {
        return bad
    }
    var anchors = List[byte]()
    let ab = ahex.bytes()
    var ai: int = 0
    while ai + 1 < ab.len {
        let hi = hex_val(ab[ai] as int)
        let lo = hex_val(ab[ai + 1] as int)
        if hi < 0 || lo < 0 {
            return bad
        }
        (mut anchors).push((hi * 16 + lo) as byte)
        ai = ai + 2
    }
    var hosts = List[str]()
    var ports = List[int]()
    var reqs = List[str]()
    var i: int = 0
    while i < n {
        (mut hosts).push(r_str(mut c))
        (mut ports).push(r_int(mut c))
        (mut reqs).push(r_str(mut c))
        i = i + 1
    }
    if c.bad || c.at != s.len {
        return bad
    }
    Job {
        fail: fail,
        addr: addr,
        scheme: scheme,
        sni: sni,
        read_ms: read_ms,
        token: token,
        date: date,
        keep: keep,
        anchors: anchors,
        hosts: hosts,
        ports: ports,
        reqs: reqs,
    }
}

/// THE POOL'S PROC (ws69, lobo#100; ws67's one-proc-per-exchange
/// shape, kept): one proc of the loop's EXCHANGE POOL. It lives across
/// exchanges, on one job socket (`jr` its end, made once with it), and
/// reports down the loop's stream pipe `out`. ws67 spawned a proc and
/// made a job socket for every proxied request, and that was half the
/// proxied throughput with one client in turn (lobo#100: a socket, a
/// connect, an accept, two closes, a task and its scope, and a worker's
/// steal scan when it ended — 44.6 syscalls a request against the
/// inline exchange's 9.25, and 2.5 times its user instructions,
/// notes/ws69-contract.md §2).
///
/// What the loop writes on the job socket, and what each means here:
///   * `j <client> <id> <joblen> <taillen>\n` then the job's text and
///     an opaque tail: an exchange, answered on `client` (the loop does
///     not touch it until this proc reports). The frame is read into
///     the iteration's own region, `exchange` runs (its upstream notes
///     on `jr`, and `jr` WATCHED while it waits: a byte from the loop
///     there means stop), the account goes back on `jr` — `r <dlen>
///     <taillen>\n`, then `<status> <body_bytes> <up_ms> <close 0|1>
///     <addrlen>:<addr><carrylen>:<carry>` (the carry: what the client
///     pipelined meanwhile), then the tail as it came — and the stream
///     line `<client> 0 <wcode> 0 <id>` down `out` (`wcode` 0 clean, 1
///     the client closed, 2 io or a frame that did not read). The
///     account is written before the line, so a loop that has the line
///     has the account.
///   * `s`: stop the exchange in flight (its generation passed
///     `worker_shutdown_timeout`): the wait it is in ends, the upstream
///     is closed, nothing more is written to the client and the account
///     says 497. A stop that finds no exchange (it ended as the byte
///     was written) is read and dropped here. A stop is never read
///     while an exchange runs — the wait sees the byte and leaves it —
///     so one written just before a kill is still here afterwards.
///   * `q`: leave the pool (idle too long, or the loop is ending): this
///     proc closes `jr` and returns.
///   * `k`: the loop is about to KILL this proc (a stop that did not
///     land: a write parked on a client that does not read): return
///     without closing anything, the loop closes both ends after its
///     join. Written before the kill so that a proc that runs on past
///     a kill (wolf-lang#683, native) finds it at its next wait and
///     returns rather than waiting for a job forever.
///   * end of stream (the loop closed its end): as `q`.
/// A wait here is `net_wait` (one poll, woken by the kernel) rather
/// than a parked read: a poll cannot be reached by a kill, which is
/// why every one of them has `jr` in its set. Total.
pub fn job_loop(jr: int, out: int) -> int {
    var going = true
    var close_end = true
    while going {
        // everything one exchange makes lives in this block and dies at
        // its brace — the frame's bytes, the upstream reads, the relayed
        // reply, the account (ws67: without a block each exchange left
        // about 27 kB behind)
        region job {
            let ready = net_wait([jr], -1) else |_| { List[int]() }
            var buf = List[byte]()
            var hdr = 0
            var want = -1
            var jl = 0
            var tl = 0
            var cfd = -1
            var xid = 0
            var reading = ready.len > 0
            var bad = !reading
            var at = 0
            while reading {
                let piece = net_read_bytes(jr, 65536) else |_| {
                    reading = false
                    bad = true
                    List[byte]()
                }
                if piece.len == 0 {
                    reading = false
                    bad = true
                }
                // a frame comes in one read nearly always: take the read
                // whole, and copy only what follows a short one
                if buf.is_empty() {
                    buf = piece
                } else {
                    for b in piece {
                        (mut buf).push(b)
                    }
                }
                // leading control bytes: stale stops are dropped, `q`
                // and `k` end the proc
                while want < 0 && hdr == 0 && at < buf.len && buf[at] as int != 106 {
                    let c = buf[at] as int
                    if c == 113 {
                        going = false
                    } else if c == 107 {
                        going = false
                        close_end = false
                    }
                    at = at + 1
                }
                if !going {
                    reading = false
                    bad = false
                } else if at >= buf.len && want < 0 && hdr == 0 {
                    // only control bytes: wait for the next frame
                    reading = false
                    bad = false
                }
                if reading && want < 0 && hdr == 0 {
                    var i = at
                    while i < buf.len && hdr == 0 {
                        if buf[i] as int == 10 {
                            hdr = i + 1
                        }
                        i = i + 1
                    }
                    if hdr > 0 {
                        let h = str_from_utf8(buf[at + 1..hdr - 1]) else |_| { "" }
                        var parts = List[int]()
                        for w in h.words() {
                            (mut parts).push(w.to_int() else |_| { -1 })
                        }
                        if parts.len != 4 || parts[0] < 0 || parts[1] < 0 || parts[2] < 0 || parts[3] < 0 {
                            reading = false
                            bad = true
                        } else {
                            cfd = parts[0]
                            xid = parts[1]
                            jl = parts[2]
                            tl = parts[3]
                            want = hdr + jl + tl
                        }
                    }
                }
                if want >= 0 && buf.len >= want {
                    reading = false
                }
            }
            if want >= 0 && buf.len >= want {
                // bytes past the frame are the loop's control bytes,
                // written after the job: a stop (the exchange is answered
                // stopped, unstarted), a leave or a kill (after it)
                var stop_now = false
                var k = want
                while k < buf.len {
                    let c = buf[k] as int
                    if c == 115 {
                        stop_now = true
                    } else if c == 113 {
                        stop_now = true
                        going = false
                    } else if c == 107 {
                        stop_now = true
                        going = false
                        close_end = false
                    }
                    k = k + 1
                }
                var wcode = 0
                var answer = ""
                let all = str_from_utf8(buf) else |_| { "" }
                let text = all.get(hdr..want) else { "" }
                let job_s = text.get(0..jl) else { "" }
                let tail = text.get(jl..text.len) else { "" }
                if job_s.len != jl || tail.len != tl {
                    wcode = 2
                } else if stop_now {
                    let det = "497 0 0 1 0:0:"
                    answer = "r {det.len} {tail.len}\n{det}{tail}"
                } else {
                    let r = job_serve(cfd, job_s, tail, jr)
                    answer = r.0
                    wcode = r.1
                }
                if answer.is_empty() {
                    let det = "0 0 0 1 0:0:"
                    answer = "r {det.len} 0\n{det}"
                }
                net_write(jr, answer) else |_| {}
                net_write(out, "{cfd} 0 {wcode} 0 {xid}\n") else |_| {}
            } else if bad {
                going = false
            }
        }
    }
    if close_end {
        net_close(jr) else |_| {}
    }
    0
}

/// The exchange a job's text asks for, answered on `client` (ws67):
/// the account `job_loop` writes back — `r <dlen> <taillen>\n`, then
/// `<status> <body_bytes> <up_ms> <close 0|1> <addrlen>:<addr><carrylen>:<carry>`, then
/// `tail` as it came — and the stream line's `wcode` (0 clean, 1 the
/// client closed, 2 io or a job that did not parse). The proc's body,
/// and the loop's own when it cannot make a job socket. Total.
pub fn job_serve(client: int, job_s: str, tail: str, notes: int) -> (str, int) {
    var wcode = 0
    var acc = run_acc()
    var close = true
    var parsed = true
    let j = job_parse(job_s) else |_| {
        parsed = false
        job_failed(502, "", "", "")
    }
    if !parsed {
        wcode = 2
    } else {
        close = exchange(client, j, notes, mut acc) else |e| match e {
            closed => {
                wcode = 1
                true
            },
            io => {
                wcode = 2
                true
            },
        }
    }
    let cl = if close { 1 } else { 0 }
    let det = "{acc.status} {acc.body_bytes} {acc.up_ms} {cl} {acc.addr.len}:{acc.addr}{acc.carry.len}:{acc.carry}"
    ("r {det.len} {tail.len}\n{det}{tail}", wcode)
}
