//! member: true
//! tls — the server's use of std.x.tls (ws05): the socket
//! conversation. std.x.tls.handshake owns the transcript, key
//! schedule and message builders (its FROZEN HandshakeResult seam);
//! std.x.tls.record owns sealing and opening records (the frozen
//! given-keys seam); std.x.tls.cert owns certificate meaning; THIS
//! module owns what travels on the fd: framing TLS records,
//! parsing the ClientHello, driving the server flight
//! (ServerHello .. Finished), verifying the client Finished, and the
//! application-data session (sess_read/sess_write/sess_close) the
//! conn seam wraps. The server handshake is a state machine fed the
//! bytes that arrive and never reading (lobo#142: `hs_begin`,
//! `hs_feed`, `hs_session`), and the session opens and seals records
//! over buffers (`sess_feed`, `sess_seal`), so the serving loop can
//! own a TLS connection as a row; `accept`, `sess_read` and
//! `sess_write` are their blocking wrappers. Protocol correctness is
//! std.x.tls's suite (RFC 8448-gated); integration is this file's.
//! Scope, honest: TLS 1.3 only (a pre-1.3 client is answered with a
//! protocol_version alert — the ssl_protocols table note), the
//! ChaCha20-Poly1305 suite only (RFC 8446's MTI; the AES-GCM pair is
//! a std.x.tls roadmap row), X25519 key shares only (a ClientHello
//! without one gets handshake_failure — HelloRetryRequest is NAMED
//! RESIDUE), Ed25519 CertificateVerify only (the sc22 ladder),
//! no resumption/tickets/0-RTT (roadmap rows), no client certs
//! (post-v1 table row), no KeyUpdate (answered unexpected_message and
//! closed — named residue until the rekey sprint).
//! close_notify discipline (the ws05 pitfall): every server-initiated
//! close SENDS close_notify (sess_close); on read, an EOF without
//! close_notify is surfaced as `closed` (the pragmatic web posture)
//! but COUNTED on the session (`trunc` — the ws12 metric's hook):
//! silent truncation is how response-injection hides.
//! Never log secrets: nothing in this module prints key material,
//! secrets, or handshake randoms at any level — the rig greps the
//! server's logs after the TLS suite (tools/lobo-tls-interop).
//! RANDOMNESS (wsm02, the #143 retirement): handshake randoms and
//! the X25519 ephemeral are drawn from `os_random` — the OS CSPRNG
//! (s118; [os.random.sole] makes it the only sanctioned source of
//! cryptographic material). os_random has NO error row and never
//! falls back: a host whose CSPRNG cannot serve TRAPS, which is the
//! wanted behavior — main additionally draws a startup probe at TLS
//! bind time so an entropy-less host dies loudly at startup, never
//! mid-handshake. ws05's interim HKDF-derived randomness (and its
//! loopback-only caveat) retired at the wsm02 pin; each handshake's
//! ephemeral is now forward secret.
//! Lane note: net + crypto — the executing lane is native (the
//! checked tier's step budget is exhausted by one scalar mult,
//! measured at ws05); the PURE parsers (ClientHello, records-from-
//! bytes, alert names) run everywhere and are tested on three lanes.
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use config
use std.x.crypto.curve25519
use std.x.tls.cert
use std.x.tls.handshake
use std.x.tls.record

/// This module's interface version. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ------------------------------------------------------------------
// byte helpers (local framing arithmetic — division/modulo, the
// ladder's own convention; no bitwise on plain int)
// ------------------------------------------------------------------

/// Append all of `src` to `out`. Total.
/// `n` CSPRNG octets as a byte list. `os_random` is the one producer
/// the language still answers `List[int]` from after s136 ([os.random]
/// pins it there — the row is a draw count, not a byte read), so this
/// narrowing walk sits at every crypto call site. The twin of
/// `acme.rand_bytes`; the modules do not import each other. Total.
fn rand_bytes(n: int) -> List[byte] {
    var out = List[byte]()
    for v in os_random(n) {
        (mut out).push(v as byte)
    }
    out
}

fn push_all(mut out: List[byte], src: List[byte]) {
    var i: int = 0
    let n = src.len
    while i < n {
        (mut out).push(src[i])
        i = i + 1
    }
}

/// The bytes of `b` from `from` (inclusive) to `to` (exclusive).
/// Offsets are this module's own (validated against lengths before
/// use). Total.
fn bsub(b: List[byte], from: int, to: int) -> List[byte] {
    var out = List[byte]()
    var i = from
    while i < to {
        (mut out).push(b[i])
        i = i + 1
    }
    out
}

/// Big-endian uint16 at `at` (the caller has bounds-checked). Total.
fn be16(b: List[byte], at: int) -> int {
    b[at] * 256 + b[at + 1]
}

/// Big-endian uint24 at `at`. Total.
fn be24(b: List[byte], at: int) -> int {
    b[at] * 65536 + b[at + 1] * 256 + b[at + 2]
}

/// A big-endian uint16 as two bytes. Total for 0..65535.
fn u16b(v: int) -> List[byte] {
    var out = List[byte]()
    (mut out).push((v / 256 % 256) as byte)
    (mut out).push((v % 256) as byte)
    out
}

/// `data` with a one-byte length prefix. Total (data under 256).
fn u8p(data: List[byte]) -> List[byte] {
    var out = List[byte]()
    (mut out).push(data.len as byte)
    push_all(mut out, data)
    out
}

/// `data` with a big-endian uint16 length prefix. Total.
fn u16p(data: List[byte]) -> List[byte] {
    var out = u16b(data.len)
    push_all(mut out, data)
    out
}

/// `data` with a big-endian uint24 length prefix. Total.
fn u24p(data: List[byte]) -> List[byte] {
    var out = List[byte]()
    (mut out).push((data.len / 65536 % 256) as byte)
    (mut out).push((data.len / 256 % 256) as byte)
    (mut out).push((data.len % 256) as byte)
    push_all(mut out, data)
    out
}

/// The bytes of an ASCII string. Total.
fn ascii(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() {
        (mut out).push(b)
    }
    out
}

// ------------------------------------------------------------------
// alert vocabulary (RFC 8446 §6) — names for the log lines
// ------------------------------------------------------------------

/// The RFC 8446 §6 alert name for `code` (the log-line vocabulary —
/// handshake failures are protocol-layer and get log lines with the
/// alert NAME, never an HTTP response). Unknown codes answer
/// "alert_<code>". Total.
pub fn alert_name(code: int) -> str {
    if code == 0 {
        return "close_notify"
    }
    if code == 10 {
        return "unexpected_message"
    }
    if code == 20 {
        return "bad_record_mac"
    }
    if code == 22 {
        return "record_overflow"
    }
    if code == 40 {
        return "handshake_failure"
    }
    if code == 42 {
        return "bad_certificate"
    }
    if code == 46 {
        return "certificate_unknown"
    }
    if code == 47 {
        return "illegal_parameter"
    }
    if code == 50 {
        return "decode_error"
    }
    if code == 51 {
        return "decrypt_error"
    }
    if code == 70 {
        return "protocol_version"
    }
    if code == 71 {
        return "insufficient_security"
    }
    if code == 80 {
        return "internal_error"
    }
    if code == 90 {
        return "user_canceled"
    }
    if code == 109 {
        return "missing_extension"
    }
    if code == 110 {
        return "unsupported_extension"
    }
    if code == 112 {
        return "unrecognized_name"
    }
    if code == 120 {
        return "no_application_protocol"
    }
    "alert_{code}"
}

// ------------------------------------------------------------------
// the ClientHello parse — PURE (three-lane testable): wire bytes in,
// the negotiation facts out
// ------------------------------------------------------------------

/// The facts a server negotiates from (parsed from one ClientHello
/// handshake message, header included). `ok` false means the message
/// did not parse; `alert` is the §6 code the server answers with when
/// a REQUIRED fact is absent (0 when `ok` and servable). `kx` is the
/// client's X25519 key-share point (32 bytes; empty = none offered).
/// `alpn_offered`/`alpn_http11` split "no ALPN at all" (serve
/// without) from "ALPN without an overlap" (no_application_protocol).
pub struct Hello {
    ok: bool,
    alert: int,
    reason: str,
    random: List[byte],
    session_id: List[byte],
    has_chacha: bool,
    has_13: bool,
    has_ed25519: bool,
    kx: List[byte],
    sni: str,
    alpn_offered: bool,
    alpn_http11: bool,
}

fn hello_bad(reason: str) -> Hello {
    Hello {
        ok: false,
        alert: 50,
        reason: reason,
        random: List[byte](),
        session_id: List[byte](),
        has_chacha: false,
        has_13: false,
        has_ed25519: false,
        kx: List[byte](),
        sni: "",
        alpn_offered: false,
        alpn_http11: false,
    }
}

/// Parse one ClientHello (§4.1.2) from its complete handshake message
/// (4-byte header included). Structure errors answer ok=false with
/// alert decode_error(50); the negotiation gates (1.3, the suite, the
/// key share, the signature scheme) are the CALLER's to judge — this
/// function only collects facts. Total over arbitrary bytes (every
/// length is validated before a read). ct: public wire material.
pub fn parse_client_hello(msg: List[byte]) -> Hello {
    let n = msg.len
    if n < 4 {
        return hello_bad("short handshake header")
    }
    if msg[0] as int != 1 {
        return hello_bad("not a ClientHello")
    }
    if be24(msg, 1) != n - 4 {
        return hello_bad("handshake length mismatch")
    }
    var p: int = 4
    if p + 2 + 32 + 1 > n {
        return hello_bad("truncated hello head")
    }
    p = p + 2
    let rnd = bsub(msg, p, p + 32)
    p = p + 32
    let sid_len = msg[p]
    p = p + 1
    if sid_len as int > 32 || p + sid_len > n {
        return hello_bad("bad session id")
    }
    let sid = bsub(msg, p, p + sid_len)
    p = p + sid_len
    if p + 2 > n {
        return hello_bad("truncated cipher suites")
    }
    let cs_len = be16(msg, p)
    p = p + 2
    if cs_len % 2 != 0 || p + cs_len > n {
        return hello_bad("bad cipher suite vector")
    }
    var has_chacha = false
    var q = p
    while q < p + cs_len {
        if be16(msg, q) == 4867 {
            has_chacha = true
        }
        q = q + 2
    }
    p = p + cs_len
    if p + 1 > n {
        return hello_bad("truncated compression")
    }
    let comp_len = msg[p]
    p = p + 1 + comp_len
    if p > n {
        return hello_bad("bad compression vector")
    }
    var has_13 = false
    var has_ed = false
    var kx = List[byte]()
    var sni = ""
    var alpn_offered = false
    var alpn_http = false
    if p < n {
        if p + 2 > n {
            return hello_bad("truncated extensions length")
        }
        let ext_len = be16(msg, p)
        p = p + 2
        if p + ext_len != n {
            return hello_bad("extensions length mismatch")
        }
        while p + 4 <= n {
            let et = be16(msg, p)
            let el = be16(msg, p + 2)
            p = p + 4
            if p + el > n {
                return hello_bad("extension overruns")
            }
            let stop = p + el
            if et == 43 {
                // supported_versions: u8-prefixed list of uint16
                if p < stop {
                    let vl = msg[p]
                    var v = p + 1
                    if v + vl <= stop {
                        while v + 1 < p + 1 + vl {
                            if be16(msg, v) == 772 {
                                has_13 = true
                            }
                            v = v + 2
                        }
                    }
                }
            } else if et == 51 {
                // key_share: u16-prefixed vector of entries
                if p + 2 <= stop {
                    var v = p + 2
                    while v + 4 <= stop {
                        let grp = be16(msg, v)
                        let gl = be16(msg, v + 2)
                        v = v + 4
                        if v + gl > stop {
                            break
                        }
                        if grp == 29 && gl == 32 {
                            kx = bsub(msg, v, v + 32)
                        }
                        v = v + gl
                    }
                }
            } else if et == 13 {
                // signature_algorithms: u16-prefixed list of uint16
                if p + 2 <= stop {
                    var v = p + 2
                    while v + 1 < stop {
                        if be16(msg, v) == 2055 {
                            has_ed = true
                        }
                        v = v + 2
                    }
                }
            } else if et == 0 {
                // server_name: ServerNameList of host_name entries
                if p + 2 <= stop {
                    var v = p + 2
                    while v + 3 <= stop {
                        let ntype = msg[v]
                        let nl = be16(msg, v + 1)
                        v = v + 3
                        if v + nl > stop {
                            break
                        }
                        if ntype as int == 0 && sni.is_empty() {
                            let raw = bsub(msg, v, v + nl)
                            sni = str_from_utf8(raw) else ""
                        }
                        v = v + nl
                    }
                }
            } else if et == 16 {
                // ALPN: u16-prefixed list of u8-prefixed names
                alpn_offered = true
                if p + 2 <= stop {
                    var v = p + 2
                    while v < stop {
                        let nl = msg[v]
                        v = v + 1
                        if v + nl > stop {
                            break
                        }
                        let name_raw = bsub(msg, v, v + nl)
                        let nm = str_from_utf8(name_raw) else ""
                        if nm == "http/1.1" {
                            alpn_http = true
                        }
                        v = v + nl
                    }
                }
            }
            p = stop
        }
    }
    Hello {
        ok: true,
        alert: 0,
        reason: "",
        random: rnd,
        session_id: sid,
        has_chacha: has_chacha,
        has_13: has_13,
        has_ed25519: has_ed,
        kx: kx,
        sni: sni,
        alpn_offered: alpn_offered,
        alpn_http11: alpn_http,
    }
}

// ------------------------------------------------------------------
// the wire: plaintext record framing
// ------------------------------------------------------------------

/// Frame a PLAINTEXT record (`type || 0x0303 || len || body`) — the
/// ServerHello's framing, and pre-key alerts. Total.
fn plain_record(rtype: int, body: List[byte]) -> List[byte] {
    var out = List[byte]()
    (mut out).push(rtype as byte)
    (mut out).push(3 as byte)
    (mut out).push(3 as byte)
    push_all(mut out, u16b(body.len))
    push_all(mut out, body)
    out
}

// ------------------------------------------------------------------
// the session
// ------------------------------------------------------------------

/// An established (or establishing) TLS session over `fd`. Read side
/// is the CLIENT's application traffic (rkey/riv/rseq), write side
/// the SERVER's (wkey/wiv/wseq). `plain` buffers decrypted
/// application bytes the conn seam has not consumed; `buf` buffers
/// raw wire bytes not yet a whole record. `got_close` is a received
/// close_notify (or a client alert); `failed` is a record the session
/// could not take, after which it takes nothing more; `trunc`
/// is an EOF WITHOUT close_notify (counted, the ws12 metric hook —
/// silent truncation is how response-injection hides). `sni` and
/// `alpn` record the negotiation for logs and the Host semantics;
/// `entry` is the SslConf certificate entry served. This pin has no
/// private field, so the struct is forgeable — every consumer treats
/// the fields as data.
pub struct Sess {
    fd: int,
    up: bool,
    rkey: List[byte],
    riv: List[byte],
    rseq: int,
    wkey: List[byte],
    wiv: List[byte],
    wseq: int,
    buf: List[byte],
    plain: List[byte],
    got_close: bool,
    sent_close: bool,
    trunc: bool,
    failed: bool,
    sni: str,
    alpn: str,
    entry: int,
}

fn sess_dead() -> Sess {
    Sess {
        fd: -1,
        up: false,
        rkey: List[byte](),
        riv: List[byte](),
        rseq: 0,
        wkey: List[byte](),
        wiv: List[byte](),
        wseq: 0,
        buf: List[byte](),
        plain: List[byte](),
        got_close: false,
        sent_close: false,
        trunc: false,
        failed: false,
        sni: "",
        alpn: "",
        entry: -1,
    }
}

/// The certificate chain DER (leaf first, concatenated) of SslConf
/// entry `idx`. Total.
fn chain_of(s: config.SslConf, idx: int) -> List[byte] {
    let at = s.der_at[idx]
    bsub(s.der, at, at + s.der_n[idx])
}

/// The 32-byte key seed of SslConf entry `idx`. Total.
fn seed_of(s: config.SslConf, idx: int) -> List[byte] {
    bsub(s.seed, idx * 32, idx * 32 + 32)
}

/// The Certificate message (§4.4.2) for a chain span: an empty
/// request context, then one CertificateEntry per certificate in the
/// span (cert_data + empty extensions). The multi-entry framing is
/// this module's (std's `handshake.certificate` frames one entry);
/// the message header is std's. A malformed span answers the empty
/// list (the resolver validated it at load, so this is defensive).
fn certificate_msg(chain: List[byte]) -> List[byte] {
    var entries = List[byte]()
    var pos: int = 0
    while pos < chain.len {
        let stop = cert.cert_end(chain, pos) else |_| {
            return List[byte]()
        }
        let one = bsub(chain, pos, stop)
        push_all(mut entries, u24p(one))
        push_all(mut entries, u16p(List[byte]()))
        pos = stop
    }
    var body = List[byte]()
    push_all(mut body, u8p(List[byte]()))
    push_all(mut body, u24p(entries))
    handshake.handshake(11, body)
}

/// The ALPN extension (16) selecting exactly `proto` (RFC 7301's
/// ProtocolNameList of one). Total.
fn ext_alpn(proto: str) -> List[byte] {
    handshake.ext(16, u16p(u8p(ascii(proto))))
}

/// Log a handshake failure with the §6 alert NAME (protocol-layer,
/// pre-HTTP — never an HTTP response; the oracle logs these at info).
fn log_hs_fail(code: int, why: str) {
    eprint("lobo: [info] TLS handshake failed: {alert_name(code)} ({why})")
}

/// A server handshake in progress (lobo#142): the state machine the
/// serving loop feeds whatever bytes have arrived, so that a TLS
/// connection is a row of its table and never holds the loop on a
/// read. `st` is 0 awaiting the ClientHello, 1 awaiting the client
/// Finished, 2 open, 3 failed. `wire` holds raw bytes not yet framed
/// into a record (once open, the bytes fed past the Finished, which
/// the session takes); `msgs` holds handshake bytes not yet a whole
/// message. `sc` is the serving generation's certificate model, kept
/// until the ClientHello selects an entry. The rest is what the client
/// Finished and the session need. This pin has no private field, so
/// the struct is forgeable; every consumer treats the fields as data.
pub struct Hs {
    st: int,
    sc: config.SslConf,
    wire: List[byte],
    msgs: List[byte],
    chts: List[byte],
    th_sfin: List[byte],
    chs_key: List[byte],
    chs_iv: List[byte],
    cseq: int,
    shs_key: List[byte],
    shs_iv: List[byte],
    cats: List[byte],
    sats: List[byte],
    sni: str,
    alpn: str,
    entry: int,
}

/// What one feed of a handshake produced. `send` is the bytes for the
/// peer, in order: the whole server flight once the ClientHello has
/// come, or a failure's alert. `done` is the client Finished verified:
/// the session is open (`hs_session`). `failed` is the handshake over
/// without a session: `alert` is the alert sent, logged as `accept`
/// always logged it, or 0 when none was sent (the client's own alert);
/// `io` marks the one failure `accept` answers with its `io` row, a
/// record over the §5.1 ceiling.
pub struct HsOut {
    send: List[byte],
    done: bool,
    failed: bool,
    alert: int,
    io: bool,
}

/// A new server handshake under the certificate model `sc`, nothing
/// read yet. Total.
pub fn hs_begin(sc: config.SslConf) -> Hs {
    Hs {
        st: 0,
        sc: copy sc,
        wire: List[byte](),
        msgs: List[byte](),
        chts: List[byte](),
        th_sfin: List[byte](),
        chs_key: List[byte](),
        chs_iv: List[byte](),
        cseq: 0,
        shs_key: List[byte](),
        shs_iv: List[byte](),
        cats: List[byte](),
        sats: List[byte](),
        sni: "",
        alpn: "",
        entry: -1,
    }
}

/// A feed that sent `send` and goes on. Total.
fn hs_more(send: List[byte]) -> HsOut {
    HsOut { send: copy send, done: false, failed: false, alert: 0, io: false }
}

/// The handshake failed: `sent` so far, then `alert_rec` (empty when
/// no alert is sent) for the alert `code` (0 for none), logged with
/// `why` as `accept` logged it (nothing when `why` is empty). Total.
fn hs_fail(mut h: Hs, sent: List[byte], alert_rec: List[byte], code: int, why: str) -> HsOut {
    h.st = 3
    if !why.is_empty() {
        log_hs_fail(code, why)
    }
    var out = copy sent
    push_all(mut out, alert_rec)
    HsOut { send: out, done: false, failed: true, alert: code, io: false }
}

/// A PLAINTEXT alert record (pre-key failures). Total.
fn plain_alert(code: int) -> List[byte] {
    var body = List[byte]()
    (mut body).push(2 as byte)
    (mut body).push(code as byte)
    plain_record(21, body)
}

/// An alert SEALED under the server's handshake keys, after its four
/// flight records (failures while awaiting the client Finished). Total.
fn sealed_alert(h: Hs, code: int) -> List[byte] {
    var body = List[byte]()
    (mut body).push(2 as byte)
    (mut body).push(code as byte)
    record.seal(h.shs_key, h.shs_iv, 4, 21, body, 0)
}

/// The ClientHello `ch_msg` (one whole handshake message): negotiate
/// (1.3 + ChaCha20-Poly1305 + X25519 + Ed25519, anything less the NAMED
/// alert), select the certificate entry by SNI (exact server_name
/// match; no-SNI and unmatched fall to default_server), build and seal
/// the server flight through std.x.tls.handshake's builders and key
/// schedule, and keep what the client Finished and the session need.
/// Answers the flight to send, or the failure. Both random draws are OS
/// CSPRNG bytes (s118 os_random; traps on an entropy-less host, the
/// module header's retirement note). Total.
fn hs_hello(mut h: Hs, ch_msg: List[byte]) -> HsOut {
    let none = List[byte]()
    let hello = parse_client_hello(ch_msg)
    if !hello.ok {
        return hs_fail(mut h, none, plain_alert(hello.alert), hello.alert, hello.reason)
    }
    if !hello.has_13 {
        return hs_fail(
            mut h,
            none,
            plain_alert(70),
            70,
            "client speaks no TLS 1.3 (1.2 is the std.x.tls roadmap row)",
        )
    }
    if !hello.has_chacha {
        return hs_fail(
            mut h,
            none,
            plain_alert(40),
            40,
            "no TLS_CHACHA20_POLY1305_SHA256 in the offer (AES-GCM is a roadmap row)",
        )
    }
    if hello.kx.len != 32 {
        return hs_fail(
            mut h,
            none,
            plain_alert(40),
            40,
            "no X25519 key share (HelloRetryRequest is named residue)",
        )
    }
    if !hello.has_ed25519 {
        return hs_fail(
            mut h,
            none,
            plain_alert(40),
            40,
            "client accepts no ed25519 signature (the sc22 ladder)",
        )
    }
    if hello.alpn_offered && !hello.alpn_http11 {
        return hs_fail(
            mut h,
            none,
            plain_alert(120),
            120,
            "ALPN offered without http/1.1 (h2 is a documented post-v1 delta)",
        )
    }

    // ---- certificate selection (SNI -> server entry) -------------
    let entry = config.ssl_select(h.sc, hello.sni)
    if entry < 0 {
        return hs_fail(mut h, none, plain_alert(80), 80, "no certificate entry resolved")
    }
    let seedk = seed_of(h.sc, entry)
    let chain = chain_of(h.sc, entry)

    // ---- ServerHello + key schedule ------------------------------
    let eph = rand_bytes(32)
    let spub = curve25519.x25519_base(eph)
    let srand = rand_bytes(32)
    var sh_exts = List[byte]()
    push_all(mut sh_exts, handshake.ext_supported_versions_server())
    push_all(mut sh_exts, handshake.ext_key_share_server_x25519(spub))
    let sh = handshake.server_hello(srand, hello.session_id, 4867, sh_exts)

    var tr = handshake.transcript_new()
    handshake.transcript_add(mut tr, ch_msg)
    handshake.transcript_add(mut tr, sh)
    let th_sh = handshake.transcript_hash(tr)

    var zero = false
    let dh = handshake.ecdhe_shared(eph, hello.kx) else |_| {
        zero = true
        List[byte]()
    }
    if zero {
        return hs_fail(
            mut h,
            none,
            plain_alert(47),
            47,
            "all-zero X25519 shared secret (RFC 8446 §7.4.2)",
        )
    }
    let early = handshake.early_secret()
    let hsec = handshake.handshake_secret(early, dh)
    let chts = handshake.client_handshake_traffic(hsec, th_sh)
    let shts = handshake.server_handshake_traffic(hsec, th_sh)
    let shs_key = record.traffic_key(shts, 32)
    let shs_iv = record.traffic_iv(shts)

    // ---- the server flight ---------------------------------------
    var ee_exts = List[byte]()
    if !hello.sni.is_empty() {
        push_all(mut ee_exts, handshake.ext_server_name_ack())
    }
    var alpn = ""
    if hello.alpn_offered {
        alpn = "http/1.1"
        push_all(mut ee_exts, ext_alpn("http/1.1"))
    }
    let ee = handshake.encrypted_extensions(ee_exts)
    handshake.transcript_add(mut tr, ee)

    let cmsg = certificate_msg(chain)
    if cmsg.is_empty() {
        return hs_fail(mut h, none, plain_alert(80), 80, "certificate chain would not frame")
    }
    handshake.transcript_add(mut tr, cmsg)
    let th_cert = handshake.transcript_hash(tr)

    let cv_content = handshake.certificate_verify_content(
        "TLS 1.3, server CertificateVerify",
        th_cert,
    )
    let sig = curve25519.sign(seedk, cv_content)
    let cv = handshake.certificate_verify(2055, sig)
    handshake.transcript_add(mut tr, cv)
    let th_cv = handshake.transcript_hash(tr)

    let sfin = handshake.finished_for(shts, th_cv)
    handshake.transcript_add(mut tr, sfin)
    let th_sfin = handshake.transcript_hash(tr)

    var flight = List[byte]()
    push_all(mut flight, plain_record(22, sh))
    if hello.session_id.len > 0 {
        // middlebox-compat CCS (§D.4): after ServerHello when the
        // client sent a legacy session id
        var ccs = List[byte]()
        (mut ccs).push(1 as byte)
        push_all(mut flight, plain_record(20, ccs))
    }
    push_all(mut flight, record.seal(shs_key, shs_iv, 0, 22, ee, 0))
    push_all(mut flight, record.seal(shs_key, shs_iv, 1, 22, cmsg, 0))
    push_all(mut flight, record.seal(shs_key, shs_iv, 2, 22, cv, 0))
    push_all(mut flight, record.seal(shs_key, shs_iv, 3, 22, sfin, 0))

    // ---- application secrets (ready before the client Finished) --
    let master = handshake.master_secret(hsec)
    h.chs_key = record.traffic_key(chts, 32)
    h.chs_iv = record.traffic_iv(chts)
    h.cats = handshake.client_application_traffic(master, th_sfin)
    h.sats = handshake.server_application_traffic(master, th_sfin)
    h.chts = chts
    h.th_sfin = th_sfin
    h.cseq = 0
    h.shs_key = shs_key
    h.shs_iv = shs_iv
    h.sni = hello.sni
    h.alpn = alpn
    h.entry = entry
    // the certificate model is not needed past the selection
    h.sc = config.ssl_none()
    h.st = 1
    hs_more(flight)
}

/// One whole client handshake message `msg` while awaiting the client
/// Finished: verify it (a mismatch is decrypt_error, nothing exposed)
/// and open the session, or fail. Total.
fn hs_finished(mut h: Hs, sent: List[byte], msg: List[byte]) -> HsOut {
    if msg[0] as int != 20 {
        return hs_fail(mut h, sent, sealed_alert(h, 10), 10, "expected the client Finished")
    }
    let verify_data = bsub(msg, 4, msg.len)
    var bad = false
    let fin_ok = handshake.accept_finished(h.chts, h.th_sfin, verify_data) else |_| {
        bad = true
        0
    }
    if bad {
        return hs_fail(mut h, sent, sealed_alert(h, 51), 51, "client Finished did not verify")
    }
    if fin_ok != 1 {
        return hs_fail(mut h, sent, List[byte](), 0, "")
    }
    h.st = 2
    HsOut { send: copy sent, done: true, failed: false, alert: 0, io: false }
}

/// Feed the handshake the bytes that arrived; never reads. Each whole
/// record is taken as it completes. The ClientHello's negotiation is
/// `accept`'s, rule for rule and alert for alert, and answers the whole
/// server flight in `send`; the client Finished's verification opens
/// the session (`done`) and stops there, leaving any later bytes in
/// `wire` for the session. A handshake already open or failed takes
/// nothing more. Total.
pub fn hs_feed(mut h: Hs, input: List[byte]) -> HsOut {
    if h.st >= 2 {
        return hs_more(List[byte]())
    }
    var wire = h.wire
    push_all(mut wire, input)
    h.wire = wire
    var sent = List[byte]()
    while h.st < 2 && h.wire.len >= 5 {
        let rlen = be16(h.wire, 3)
        if rlen > 16640 {
            h.st = 3
            return HsOut { send: sent, done: false, failed: true, alert: 0, io: true }
        }
        if h.wire.len < 5 + rlen {
            return hs_more(sent)
        }
        let rtype = h.wire[0] as int
        let raw = bsub(h.wire, 0, 5 + rlen)
        let body = bsub(h.wire, 5, 5 + rlen)
        h.wire = bsub(h.wire, 5 + rlen, h.wire.len)
        var hs_bytes = List[byte]()
        if h.st == 0 {
            if rtype == 21 {
                if body.len >= 2 {
                    log_hs_fail(body[1] as int, "client alert before ClientHello")
                }
                return hs_fail(mut h, sent, List[byte](), 0, "")
            }
            if rtype != 22 {
                return hs_fail(mut h, sent, plain_alert(10), 10, "expected a handshake record")
            }
            hs_bytes = body
        } else {
            if rtype == 20 {
                continue
            }
            if rtype == 21 {
                if body.len >= 2 {
                    log_hs_fail(body[1] as int, "client alert during the handshake")
                }
                return hs_fail(mut h, sent, List[byte](), 0, "")
            }
            if rtype != 23 {
                return hs_fail(
                    mut h,
                    sent,
                    sealed_alert(h, 10),
                    10,
                    "unexpected record type awaiting Finished",
                )
            }
            var opened = true
            let inner = record.open(h.chs_key, h.chs_iv, h.cseq, raw) else |_| {
                opened = false
                List[byte]()
            }
            if !opened {
                return hs_fail(
                    mut h,
                    sent,
                    sealed_alert(h, 20),
                    20,
                    "record failed to deprotect awaiting Finished",
                )
            }
            h.cseq = h.cseq + 1
            let ct = record.content_type_of(inner)
            let content = record.content_of(inner)
            if ct == 21 {
                if content.len >= 2 {
                    log_hs_fail(content[1] as int, "client alert during the handshake")
                }
                return hs_fail(mut h, sent, List[byte](), 0, "")
            }
            if ct != 22 {
                return hs_fail(
                    mut h,
                    sent,
                    sealed_alert(h, 10),
                    10,
                    "non-handshake content awaiting Finished",
                )
            }
            hs_bytes = content
        }
        var msgs = h.msgs
        push_all(mut msgs, hs_bytes)
        h.msgs = msgs
        if h.msgs.len >= 4 && h.msgs.len >= 4 + be24(h.msgs, 1) {
            let msg = bsub(h.msgs, 0, 4 + be24(h.msgs, 1))
            h.msgs = List[byte]()
            if h.st == 0 {
                let o = hs_hello(mut h, msg)
                push_all(mut sent, o.send)
                if o.failed {
                    return HsOut {
                        send: sent,
                        done: false,
                        failed: true,
                        alert: o.alert,
                        io: false,
                    }
                }
            } else {
                return hs_finished(mut h, sent, msg)
            }
        }
    }
    hs_more(sent)
}

/// The session a handshake opened, on `fd` (-1 for none): the client's
/// application traffic keys to read, the server's to write, the bytes
/// fed past the client Finished already in its buffer, and the
/// negotiation (SNI, ALPN, the certificate entry). A handshake that is
/// not open answers a dead session (`up` false). Total.
pub fn hs_session(h: Hs, fd: int) -> Sess {
    if h.st != 2 {
        var dead = sess_dead()
        dead.fd = fd
        return dead
    }
    Sess {
        fd: fd,
        up: true,
        rkey: record.traffic_key(h.cats, 32),
        riv: record.traffic_iv(h.cats),
        rseq: 0,
        wkey: record.traffic_key(h.sats, 32),
        wiv: record.traffic_iv(h.sats),
        wseq: 0,
        buf: copy h.wire,
        plain: List[byte](),
        got_close: false,
        sent_close: false,
        trunc: false,
        failed: false,
        sni: copy h.sni,
        alpn: copy h.alpn,
        entry: h.entry,
    }
}

/// Accept one TLS 1.3 session on `fd`, blocking: the state machine
/// above (`hs_begin`, `hs_feed`, `hs_session`) fed from the socket,
/// for the callers that serve a connection to completion. The caller
/// arms nothing: the read deadline is armed here and spans the
/// handshake (a stalled peer is the `timeout` row, never a hang).
/// Rows: `refused` (a named negotiation or protocol failure, its alert
/// already sent and logged, or the peer's close or alert), `timeout`,
/// `io`.
#[allow(w0602)]
pub fn accept(fd: int, sc: config.SslConf, deadline_ms: int) -> Sess ! {refused, timeout, io} {
    net_deadline(fd, deadline_ms) else |_| {}
    var h = hs_begin(sc)
    loop {
        // the sentinel shape (sess_read): route the read's rows through
        // an int and raise once below
        var errc = 0
        let piece = net_read_bytes(fd, 4096) else |e| match e {
            closed => {
                errc = 1
                List[byte]()
            },
            timeout => {
                errc = 2
                List[byte]()
            },
            io => {
                errc = 3
                List[byte]()
            },
        }
        if errc == 1 {
            return refused
        }
        if errc == 2 {
            return timeout
        }
        if errc == 3 {
            return io
        }
        if piece.is_empty() {
            return refused
        }
        let o = hs_feed(mut h, piece)
        if o.failed {
            // best-effort: the connection is being torn down regardless
            net_write_bytes(fd, o.send) else |_| {}
            if o.io {
                return io
            }
            return refused
        }
        if !o.send.is_empty() {
            net_write_bytes(fd, o.send) else |_| {
                return io
            }
        }
        if o.done {
            return hs_session(h, fd)
        }
    }
}

/// What one feed of a session produced. `plain` is the application
/// bytes of every record the feed completed, in order. `send` is the
/// bytes for the peer: the sealed alert answering a record the session
/// refused, empty otherwise. `closed` is the peer's close_notify or
/// alert, or a post-handshake message refused: the session reads
/// nothing more, and `plain` is still the caller's. `io` is a record
/// the session cannot take (over the §5.1 ceiling, a plaintext record
/// other than change_cipher_spec or close_notify, or one that fails to
/// deprotect): the session is broken and the caller closes it.
pub struct SessOut {
    plain: List[byte],
    send: List[byte],
    closed: bool,
    io: bool,
}

fn sess_out(take plain: List[byte], take send: List[byte], closed: bool, io: bool) -> SessOut {
    SessOut { plain: plain, send: send, closed: closed, io: io }
}

/// Feed the session the bytes that arrived (lobo#142); never reads or
/// writes. Every whole record in its buffer is opened, in order, and
/// the bytes of a record not yet whole wait in `buf`, so a feed of
/// nothing opens what the handshake left there. change_cipher_spec is
/// skipped; a plaintext close_notify closes and any other plaintext
/// record is `io`; a record that fails to deprotect is answered
/// bad_record_mac (20); a client alert closes; a post-handshake
/// message is answered unexpected_message (10) and closes (KeyUpdate
/// is named residue). A closed or broken session takes nothing more.
/// Total.
pub fn sess_feed(mut z: Sess, input: List[byte]) -> SessOut {
    if z.failed {
        return sess_out(take List[byte](), take List[byte](), false, true)
    }
    if z.got_close || !z.up {
        return sess_out(take List[byte](), take List[byte](), true, false)
    }
    if !input.is_empty() {
        var wire = z.buf
        push_all(mut wire, input)
        z.buf = wire
    }
    var got = List[byte]()
    while z.buf.len >= 5 {
        let rlen = be16(z.buf, 3)
        if rlen > 16640 {
            z.failed = true
            return sess_out(take got, take List[byte](), false, true)
        }
        if z.buf.len < 5 + rlen {
            return sess_out(take got, take List[byte](), false, false)
        }
        let rtype = z.buf[0] as int
        let raw = bsub(z.buf, 0, 5 + rlen)
        z.buf = bsub(z.buf, 5 + rlen, z.buf.len)
        if rtype == 20 {
            continue
        }
        if rtype != 23 {
            if rtype == 21 && rlen >= 2 && raw[6] as int == 0 {
                z.got_close = true
                return sess_out(take got, take List[byte](), true, false)
            }
            z.failed = true
            return sess_out(take got, take List[byte](), false, true)
        }
        var opened = true
        let inner = record.open(z.rkey, z.riv, z.rseq, raw) else |_| {
            opened = false
            List[byte]()
        }
        if !opened {
            eprint("lobo: [info] TLS: record failed to deprotect ({alert_name(20)})")
            z.failed = true
            let a = sess_alert(mut z, 20)
            return sess_out(take got, take a, false, true)
        }
        z.rseq = z.rseq + 1
        let ct = record.content_type_of(inner)
        let content = record.content_of(inner)
        if ct == 23 {
            push_all(mut got, content)
        } else if ct == 21 {
            if content.len >= 2 && content[1] as int != 0 {
                eprint("lobo: [info] TLS: client alert {alert_name(content[1] as int)}")
            }
            z.got_close = true
            return sess_out(take got, take List[byte](), true, false)
        } else if ct == 22 {
            // post-handshake message: KeyUpdate is named residue at
            // this pin (the rekey sprint); anything else is equally
            // unexpected here
            eprint(
                "lobo: [info] TLS: post-handshake message refused ({alert_name(10)} — KeyUpdate is named residue)",
            )
            z.got_close = true
            let a = sess_alert(mut z, 10)
            return sess_out(take got, take a, true, false)
        }
    }
    sess_out(take got, take List[byte](), false, false)
}

/// The peer's EOF: without a close_notify first it is truncation,
/// counted on the session (`trunc`) and logged. The session reads
/// nothing more. Total.
pub fn sess_eof(mut z: Sess) {
    if !z.got_close {
        z.trunc = true
        eprint("lobo: [info] TLS: peer EOF without close_notify (truncation, counted)")
    }
    z.buf = List[byte]()
    z.got_close = true
}

/// Seal application bytes for the peer under the session's write keys,
/// in records of at most 2^14 content bytes (§5.1), each taking the
/// next write sequence number; never writes. Nothing to seal is
/// nothing sealed. Total.
pub fn sess_seal(mut z: Sess, data: List[byte]) -> List[byte] {
    let n = data.len
    if n <= 16384 {
        if n == 0 {
            return List[byte]()
        }
        return seal_one(mut z, 23, data)
    }
    var out = List[byte]()
    var at: int = 0
    while at < n {
        var stop = at + 16384
        if stop > n {
            stop = n
        }
        push_all(mut out, seal_one(mut z, 23, bsub(data, at, stop)))
        at = stop
    }
    out
}

/// One record of inner type `ct` under the write keys; the write
/// sequence moves on. Total.
fn seal_one(mut z: Sess, ct: int, content: List[byte]) -> List[byte] {
    let rec = record.seal(z.wkey, z.wiv, z.wseq, ct, content, 0)
    z.wseq = z.wseq + 1
    rec
}

/// A sealed alert record (level 2, `code`; close_notify is code 0).
/// Total.
fn sess_alert(mut z: Sess, code: int) -> List[byte] {
    var body = List[byte]()
    (mut body).push(2 as byte)
    (mut body).push(code as byte)
    seal_one(mut z, 21, body)
}

/// Feed `input`, write any answer (best-effort: a refused record ends
/// the read either way) and keep the plaintext for `sess_read`.
fn sess_pull(mut z: Sess, input: List[byte]) {
    let o = sess_feed(mut z, input)
    if !o.send.is_empty() {
        net_write_bytes(z.fd, o.send) else |_| {}
    }
    if !o.plain.is_empty() {
        var plain = z.plain
        push_all(mut plain, o.plain)
        z.plain = plain
    }
}

/// Read up to `max` decrypted application bytes, blocking: the session
/// fed from the socket until application data arrives, for the callers
/// that serve a connection to completion. A received close_notify (or
/// an EOF — counted as truncation, `z.trunc`) answers `closed` once the
/// buffered plaintext is drained, and a broken session `io`. A client
/// KeyUpdate is NAMED RESIDUE: answered unexpected_message and `closed`
/// (the rekey sprint lifts it). Rows: `closed`, `timeout` (the armed
/// deadline), `io`.
#[allow(w0602)]
pub fn sess_read(mut z: Sess, max: int) -> List[byte] ! {closed, timeout, io} {
    if z.plain.len == 0 && z.buf.len >= 5 {
        // what the handshake fed past the client Finished
        sess_pull(mut z, List[byte]())
    }
    while z.plain.len == 0 {
        if z.failed {
            return io
        }
        if z.got_close || !z.up {
            return closed
        }
        // the sentinel shape (accept): route the read's rows through
        // an int and raise once below
        var errc = 0
        let piece = net_read_bytes(z.fd, 4096) else |e| match e {
            closed => {
                errc = 1
                List[byte]()
            },
            timeout => {
                errc = 2
                List[byte]()
            },
            io => {
                errc = 3
                List[byte]()
            },
        }
        if errc == 2 {
            return timeout
        }
        if errc == 3 {
            return io
        }
        if errc == 1 || piece.is_empty() {
            sess_eof(mut z)
            return closed
        }
        sess_pull(mut z, piece)
    }
    var got = max
    if got > z.plain.len {
        got = z.plain.len
    }
    let out = bsub(z.plain, 0, got)
    let rest = bsub(z.plain, got, z.plain.len)
    z.plain = rest
    out
}

/// Write application bytes, sealed into records of at most 2^14
/// content bytes (§5.1), each written as it is sealed. Rows: `closed`
/// (the peer vanished), `io`.
#[allow(w0602)]
pub fn sess_write(mut z: Sess, data: List[byte]) -> () ! {closed, io} {
    if !z.up {
        return io
    }
    var at: int = 0
    let n = data.len
    while at < n {
        var stop = at + 16384
        if stop > n {
            stop = n
        }
        let rec = sess_seal(mut z, bsub(data, at, stop))
        var errc = 0
        net_write_bytes(z.fd, rec) else |e| match e {
            closed => {
                errc = 1
            },
            invalid => {
                errc = 2
            },
            io => {
                errc = 2
            },
        }
        if errc == 1 {
            return closed
        }
        if errc == 2 {
            return io
        }
        at = stop
    }
}

/// Close the session: send close_notify (EVERY server-initiated
/// close does — the truncation defence's other half), then close the
/// socket. Total; every failure is swallowed (the connection is done
/// either way).
pub fn sess_close(mut z: Sess) {
    if z.up && !z.sent_close {
        let rec = sess_alert(mut z, 0)
        net_write_bytes(z.fd, rec) else |_| {}
        z.sent_close = true
    }
    net_close(z.fd) else |_| {}
    z.up = false
}

/// A placeholder session for a PLAINTEXT conn (the seam's other
/// half): fd -1, nothing armed. Total.
pub fn no_sess() -> Sess {
    sess_dead()
}
