//! member: true
//! http — request/response types and HTTP/1.1 parsing, built as an
//! RFC 9112/9110 MUST checklist. Every rejection is NAMED (a row tag)
//! and cited to its section in the test that exercises it; the parser
//! is PURE (a `str` head in, a `Request` or a tag out — it never
//! touches a socket, an fs, or a clock), which is what lets it run on
//! all three lanes and be tested exhaustively by the corpus.
//! The connection loop that FEEDS it a head and WRITES its outcomes
//! lives in serve/ (the io half); `route`, the path decoders, and the
//! response templates stay here because they are pure — serve/ imports
//! http, never the other way (ARCHITECTURE.md's locked direction, and
//! the ws02 contract's routing-purity rule: route imports no io).
//! File-header note (F-0016): comments never sit directly above a
//! dotted call in this repo; `wolf fmt` splits the call at the dot.

use config

/// This module's interface version. Bumped from the ws00 stub as
/// wsc01's first real surface lands. Total; never traps.
pub fn version() -> str {
    "0.1.0"
}

// ------------------------------------------------------------------
// byte-class predicates (RFC 9110 §5.6.2 tchar, §5.6.3 OWS, digits)
// ------------------------------------------------------------------

/// A visible ASCII digit 0-9. Total.
pub fn is_digit(b: int) -> bool {
    if b < 48 {
        return false
    }
    b <= 57
}

/// RFC 9110 §5.6.2 tchar: the token character set for method and
/// header-field names. `! # $ % & ' * + - . ^ _ \` | ~`, DIGIT,
/// ALPHA. Total; a byte outside 0..255 is simply not a tchar.
pub fn is_tchar(b: int) -> bool {
    if is_digit(b) {
        return true
    }
    // ALPHA
    if b >= 65 {
        if b <= 90 {
            return true
        }
    }
    if b >= 97 {
        if b <= 122 {
            return true
        }
    }
    // the punctuation members, each named rather than range-guessed
    if b == 33 {
        return true
    }
    // !
    if b == 35 {
        return true
    }
    // #
    if b == 36 {
        return true
    }
    // $
    if b == 37 {
        return true
    }
    // %
    if b == 38 {
        return true
    }
    // &
    if b == 39 {
        return true
    }
    // '
    if b == 42 {
        return true
    }
    // *
    if b == 43 {
        return true
    }
    // +
    if b == 45 {
        return true
    }
    // -
    if b == 46 {
        return true
    }
    // .
    if b == 94 {
        return true
    }
    // ^
    if b == 95 {
        return true
    }
    // _
    if b == 96 {
        return true
    }
    // `
    if b == 124 {
        return true
    }
    // |
    if b == 126 {
        return true
    }
    // ~
    false
}

/// True when every byte of `s` is a tchar and `s` is non-empty. Total.
pub fn is_token(s: str) -> bool {
    if s.is_empty() {
        return false
    }
    for b_raw in s.bytes() {
        let b = b_raw as int
        if !is_tchar(b) {
            return false
        }
    }
    true
}

/// A byte that must never appear inside a request-target: SP, HTAB,
/// any C0 control (0..31), DEL (127). Post-decode NUL/control
/// rejection is a separate, stricter gate (see `has_control`). Total.
pub fn is_target_bad(b: int) -> bool {
    if b <= 32 {
        return true
    }
    b == 127
}

/// True when `s` carries any C0 control byte (0..31) or DEL (127) —
/// the post-percent-decode reject gate (a decoded `%00` NUL, a
/// decoded CR/LF response-splitting attempt). Total.
pub fn has_control(s: str) -> bool {
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b < 32 {
            return true
        }
        if b == 127 {
            return true
        }
    }
    false
}

// ------------------------------------------------------------------
// limits (nginx-compatible defaults; serve/ fills these from the
// config model's directives, this is the fallback shape)
// ------------------------------------------------------------------

/// The size gates the parser enforces, each an nginx analogue.
/// `max_request_line` bounds the request line (method+target+version)
/// → 414. `max_header_line` bounds one header field → 400 (nginx's
/// "Request Header Or Cookie Too Large"). `max_headers` caps the
/// field count, `max_header_total` the header block's bytes. Chunk
/// framing bounds live with the decoder (`max_chunk_digits`).
/// `memory_budget` (ws10) is a DIFFERENT instrument riding the same
/// struct: the per-request admitted-bytes budget (0 = off) — the
/// fence bounds inputs with input-shaped statuses (400/413/414), the
/// budget bounds a request's admitted memory with a 503; the fence
/// fires first at every site (docs/BUDGET.md). serve/ enforces it;
/// the parser never reads it. `nodelay` (ws24) is the third rider:
/// `tcp_nodelay` resolved — true (the default, the runtime's own
/// posture since wolf-lang#254) leaves TCP_NODELAY set on every
/// accepted stream, false puts Nagle back on accept. The entry's
/// accept sites read it; nothing in the parser does.
pub struct Limits {
    max_request_line: int,
    max_header_line: int,
    max_headers: int,
    max_header_total: int,
    max_chunk_digits: int,
    max_body: int,
    memory_budget: int,
    nodelay: bool,
}

/// nginx-compatible defaults: 8k request line and header field
/// (large_client_header_buffers 4 8k), 100 fields, 32k total, a
/// 15-hex-digit chunk-size ceiling (the CVE-2013-2028 bound), 1 MiB
/// body (client_max_body_size 1m). The digit bound is 15, not 16, ON
/// PURPOSE: 15 hex digits max is 0xFFF...F = 1.15e18, comfortably
/// inside i64 (9.2e18), so the bound REFUSES (a clean 400) before the
/// checked multiply could ever trap — the bound is the design, the
/// checked arithmetic the backstop, and the corpus asserts the 400.
/// A 16-digit all-`f` value would overflow i64 on the last multiply,
/// which is exactly the trap we keep unreachable. Total.
pub fn default_limits() -> Limits {
    Limits {
        max_request_line: 8192,
        max_header_line: 8192,
        max_headers: 100,
        max_header_total: 32768,
        max_chunk_digits: 15,
        max_body: 1048576,
        memory_budget: 0,
        nodelay: true,
    }
}

// ------------------------------------------------------------------
// the request
// ------------------------------------------------------------------

/// A parsed request. `path` and `query` are the raw (still
/// percent-encoded) split of the target at the first `?`; `host` is
/// the EFFECTIVE host (absolute-form's authority wins over the Host
/// header — RFC 9112 §3.2.2, a smuggling-relevant MUST). `hnames`
/// are lowercased field names, `hvals` the OWS-trimmed values, index-
/// parallel. `body_mode` is "none" | "length" | "chunked".
/// `keepalive` is the resolved persistence intent. Fields are public
/// and read directly by serve/ (structs cross the boundary whole).
pub struct Request {
    method: str,
    target: str,
    version: str,
    host: str,
    path: str,
    query: str,
    hnames: List[str],
    hvals: List[str],
    body_mode: str,
    content_length: int,
    keepalive: bool,
}

fn empty_request() -> Request {
    Request {
        method: "",
        target: "",
        version: "",
        host: "",
        path: "",
        query: "",
        hnames: List[str](),
        hvals: List[str](),
        body_mode: "none",
        content_length: 0,
        keepalive: false,
    }
}

/// The value of header `name` (lowercase), or the `none` row when no
/// such field was sent. First occurrence wins (framing headers are
/// validated for duplicates during the parse; this is for the rest).
pub fn header(r: Request, name: str) -> str ! {none} {
    var i: int = 0
    for h in r.hnames {
        if h == name {
            return r.hvals[i]
        }
        i = i + 1
    }
    none
}

/// The number of header fields parsed. Total.
pub fn header_count(r: Request) -> int {
    r.hnames.len
}

// ------------------------------------------------------------------
// the parser: RFC 9112 as a checklist
// ------------------------------------------------------------------

/// Split a header block into lines on CRLF, STRICTLY: a bare CR (not
/// followed by LF) and a bare LF (not preceded by CR) are each
/// `malformed` (RFC 9112 §2.2 — a recipient MUST NOT recognise a
/// lone CR or LF as a line terminator; the Class-B posture rejects
/// rather than tolerates, the deliberate delta from nginx's lenient
/// bare-LF acceptance). `head` is the bytes BEFORE the terminating
/// blank line (serve/ finds the CRLFCRLF and hands us what precedes
/// it). Offsets are computed at ASCII CR/LF positions, always code-
/// point boundaries, so the slices never trap.
fn split_lines_strict(head: str) -> List[str] ! {malformed} {
    var out = List[str]()
    var start: int = 0
    var i: int = 0
    var prev_cr: int = -2
    for b_raw in head.bytes() {
        let b = b_raw as int
        if b == 13 {
            // CR — the next byte MUST be LF; remember our position
            prev_cr = i
        } else if b == 10 {
            // LF — MUST be immediately preceded by CR at i-1
            if prev_cr != i - 1 {
                return malformed
            }
            let line = head[start..prev_cr]
            (mut out).push(line)
            start = i + 1
        } else
        // any other byte: a CR is only legal immediately before LF
        if prev_cr == i - 1 {
            return malformed
        }
        i = i + 1
    }
    // a trailing CR with no LF is a bare CR
    if prev_cr == i - 1 {
        return malformed
    }
    // the final segment (no trailing CRLF) is the last line
    if start < head.len {
        (mut out).push(head[start..head.len])
    }
    out
}

/// Trim leading and trailing OWS (SP / HTAB) from a header value.
/// Total; walks from both ends by ASCII bytes.
fn trim_ows(s: str) -> str {
    var lo: int = 0
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b == 32 || b == 9 {
            lo = lo + 1
        } else {
            break
        }
    }
    var hi: int = s.len
    while hi > lo {
        let c = s[hi - 1..hi]
        var last: int = 0
        for b_raw in c.bytes() {
            let b = b_raw as int
            last = b
        }
        if last == 32 || last == 9 {
            hi = hi - 1
        } else {
            break
        }
    }
    if lo >= hi {
        return ""
    }
    s[lo..hi]
}

/// The byte at offset `i` of `s` (a one-byte slice read through a
/// view — no materialization), or -1 past the end. Total.
fn byte_at(s: str, i: int) -> int {
    if i < 0 || i >= s.len {
        return -1
    }
    for b_raw in s[i..i + 1].bytes() {
        let b = b_raw as int
        return b
    }
    -1
}

/// One byte, ASCII-folded to lowercase (`A`..`Z` → `a`..`z`, every
/// other byte itself). Total.
fn fold_ascii(b: int) -> int {
    if b >= 65 && b <= 90 {
        return b + 32
    }
    b
}

/// True when every byte of `s` is ASCII — the inputs on which an
/// ASCII fold IS `lower()` (Unicode lowercasing of ASCII text is
/// ASCII lowercasing, and a non-ASCII byte can only be part of a
/// scalar the fold must not touch). Total.
fn is_ascii(s: str) -> bool {
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b >= 128 {
            return false
        }
    }
    true
}

/// True when `s` has no `A`..`Z` byte — `lower()` would answer the
/// receiver's own bytes, so the receiver serves as its own lowercase
/// (an ASCII `s`; the caller guarantees that). Total.
fn has_no_upper(s: str) -> bool {
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b >= 65 && b <= 90 {
            return false
        }
    }
    true
}

/// `s` equals the already-lowercase ASCII literal `lower` under an
/// ASCII fold. Total; reads both through views.
fn eq_fold(s: str, lower: str) -> bool {
    if s.len != lower.len {
        return false
    }
    var i: int = 0
    for b_raw in s.bytes() {
        let b = b_raw as int
        if fold_ascii(b) != byte_at(lower, i) {
            return false
        }
        i = i + 1
    }
    true
}

/// `s` starts with the already-lowercase ASCII literal `lower` under
/// an ASCII fold. Total.
fn starts_with_fold(s: str, lower: str) -> bool {
    if s.len < lower.len {
        return false
    }
    eq_fold(s[0..lower.len], lower)
}

/// `s` (ASCII — the caller checked) contains the already-lowercase
/// ASCII literal `needle` under an ASCII fold. A short-needle scan
/// over views; the values this serves are `Connection` tokens. Total.
fn contains_fold(s: str, needle: str) -> bool {
    if needle.is_empty() {
        return true
    }
    if s.len < needle.len {
        return false
    }
    var at: int = 0
    let last = s.len - needle.len
    while at <= last {
        if eq_fold(s[at..at + needle.len], needle) {
            return true
        }
        at = at + 1
    }
    false
}

/// The lowercase of a header NAME (an ASCII token — `is_token` held
/// before this is called), answered WITHOUT materializing wherever
/// the answer already exists: the name itself when it carries no
/// uppercase byte, a literal for the names a static request carries
/// (each a view into rodata), and `lower()` — the same bytes, built —
/// only for an uppercase name outside that set. ws28: the parser
/// materialized every name of every request (four arena allocations
/// and four `String`s for `ab`'s four headers); the record then
/// lowered them a second time. Total.
fn lower_token(name: str) -> str {
    if has_no_upper(name) {
        return name
    }
    if eq_fold(name, "host") {
        return "host"
    }
    if eq_fold(name, "user-agent") {
        return "user-agent"
    }
    if eq_fold(name, "accept") {
        return "accept"
    }
    if eq_fold(name, "connection") {
        return "connection"
    }
    if eq_fold(name, "content-length") {
        return "content-length"
    }
    if eq_fold(name, "transfer-encoding") {
        return "transfer-encoding"
    }
    if eq_fold(name, "if-modified-since") {
        return "if-modified-since"
    }
    if eq_fold(name, "accept-encoding") {
        return "accept-encoding"
    }
    if eq_fold(name, "cache-control") {
        return "cache-control"
    }
    if eq_fold(name, "pragma") {
        return "pragma"
    }
    if eq_fold(name, "range") {
        return "range"
    }
    if eq_fold(name, "if-none-match") {
        return "if-none-match"
    }
    name.lower()
}

/// Case-insensitive ASCII equality of `s` against an already-lower
/// literal `lower`. An ASCII `s` is folded through views (no
/// materialization — ws28); a non-ASCII `s` takes `lower()`, so the
/// Unicode mapping it always had (a Kelvin sign lowercases to `k`)
/// still holds on that path. Total.
fn eq_ci(s: str, lower: str) -> bool {
    if is_ascii(s) {
        return eq_fold(s, lower)
    }
    let d = s.lower()
    d == lower
}

/// Parse a decimal Content-Length: digits only, no sign, no spaces,
/// non-empty, bounded below `max`. Rows: `malformed` (not all
/// digits, or empty), `too_large` (over `max` — the value, checked
/// on the way in so no accumulator overflows). RFC 9110 §8.6.
fn parse_length(s: str, max: int) -> int ! {malformed, too_large} {
    if s.is_empty() {
        return malformed
    }
    var n: int = 0
    for b_raw in s.bytes() {
        let b = b_raw as int
        if !is_digit(b) {
            return malformed
        }
        n = n * 10 + b - 48
        if n > max {
            return too_large
        }
    }
    n
}

/// True when `s` contains ASCII `needle` after lowercasing (for
/// comma-list token membership on Connection / Transfer-Encoding).
/// Total.
fn ci_contains(s: str, lower_needle: str) -> bool {
    if is_ascii(s) {
        return contains_fold(s, lower_needle)
    }
    let d = s.lower()
    d.contains(lower_needle)
}

/// Split an authority-or-target at the first `/`, returning the part
/// BEFORE it and the part FROM it (the leading slash kept). No `/`
/// means the whole string is the authority and the path is "/".
fn split_authority(rem: str) -> (str, str) {
    let slash = rem.find("/") else -1
    if slash == -1 {
        return (rem, "/")
    }
    (rem[0..slash], rem[slash..rem.len])
}

/// Parse a full request head (everything before the terminating
/// blank line) into a `Request`, enforcing the RFC 9112/9110 MUST
/// checklist. PURE — no socket, no clock. Rows, each a status the
/// caller writes:
///   `malformed`      → 400 (bad syntax: bare CR/LF, obs-fold, space
///                      before colon, bad token, CL+TE, dup CL, dup
///                      Host, missing Host on 1.1, bad version)
///   `uri_too_long`   → 414 (request line over the limit)
///   `too_large`      → 400 "Request Header Or Cookie Too Large"
///                      (a header field or the block over the limit)
///   `unimplemented`  → 501 (a Transfer-Encoding other than chunked)
/// The section citations live in the corpus tests that take each path.
/// The four-tag row is deliberate (W0602 allowed): each tag is a
/// distinct status the caller writes, and the doc above is its home.
#[allow(w0602)]
pub fn parse_request(head: str, limits: Limits) -> Request ! {
    malformed,
    uri_too_long,
    too_large,
    unimplemented,
} {
    if head.len > limits.max_header_total {
        return too_large
    }
    let lines = split_lines_strict(head)?
    if lines.is_empty() {
        return malformed
    }

    var r = empty_request()

    // ---- request line (RFC 9112 §3) ----
    let rl = lines[0]
    if rl.len > limits.max_request_line {
        return uri_too_long
    }
    let sp1 = rl.find(" ") else -1
    if sp1 <= 0 {
        return malformed
    }
    let method = rl[0..sp1]
    let after1 = rl[sp1 + 1..rl.len]
    let sp2 = after1.find(" ") else -1
    if sp2 <= 0 {
        // no second SP: HTTP/0.9-style or a truncated line. lobo
        // requires the three-token line (delta: nginx serves 0.9).
        return malformed
    }
    let target = after1[0..sp2]
    let version = after1[sp2 + 1..after1.len]
    if !is_token(method) {
        return malformed
    }
    if version != "HTTP/1.1" && version != "HTTP/1.0" {
        return malformed
    }
    if target.is_empty() {
        return malformed
    }
    // whitespace / control anywhere in the target is a MUST-reject
    // (RFC 9112 §3.2 — the smuggling-relevant no-WS-in-target rule);
    // a second SP would already have landed here as part of `version`
    for b_raw in target.bytes() {
        let b = b_raw as int
        if is_target_bad(b) {
            return malformed
        }
    }
    r.method = method
    r.version = version
    r.target = target

    let is11 = version == "HTTP/1.1"

    // ---- absolute-form: its authority WINS over Host (§3.2.2) ----
    var host_target = ""
    var origin = target
    if starts_with_fold(target, "http://") {
        let rem = target[7..target.len]
        let parts = split_authority(rem)
        host_target = parts.0
        origin = parts.1
    } else if starts_with_fold(target, "https://") {
        let rem = target[8..target.len]
        let parts = split_authority(rem)
        host_target = parts.0
        origin = parts.1
    }
    // split the origin-form target at the first '?'
    let qmark = origin.find("?") else -1
    if qmark == -1 {
        r.path = origin
        r.query = ""
    } else {
        r.path = origin[0..qmark]
        r.query = origin[qmark + 1..origin.len]
    }

    // ---- header fields ----
    var host_count: int = 0
    var host_val = ""
    var cl_count: int = 0
    var cl_val = ""
    var te_count: int = 0
    var te_val = ""
    var conn_val = ""
    var idx: int = 0
    for line in lines {
        if idx == 0 {
            idx = idx + 1
            continue
        }
        idx = idx + 1
        // a blank line terminates the header section: stop here and
        // treat anything after it as body (defensive — serve/ strips
        // the CRLFCRLF, but a caller that hands us a whole message
        // must not trap on the empty line)
        if line.is_empty() {
            break
        }
        if line.len > limits.max_header_line {
            return too_large
        }
        // obs-fold: a field line starting with SP/HTAB is a folded
        // continuation — reject, never unfold (RFC 9112 §5.2)
        let lead = line[0..1]
        var leadb: int = 0
        for b_raw in lead.bytes() {
            let b = b_raw as int
            leadb = b
        }
        if leadb == 32 || leadb == 9 {
            return malformed
        }
        let colon = line.find(":") else -1
        if colon <= 0 {
            return malformed
        }
        let name = line[0..colon]
        // a space before the colon lands INSIDE `name` and fails the
        // token test — RFC 9112 §5.1 (no whitespace between field
        // name and colon)
        if !is_token(name) {
            return malformed
        }
        let raw_val = line[colon + 1..line.len]
        let value = trim_ows(raw_val)
        let lname = lower_token(name)
        (mut r.hnames).push(lname)
        (mut r.hvals).push(value)
        if r.hnames.len > limits.max_headers {
            return too_large
        }
        if lname == "host" {
            host_count = host_count + 1
            host_val = value
        } else if lname == "content-length" {
            cl_count = cl_count + 1
            cl_val = value
        } else if lname == "transfer-encoding" {
            te_count = te_count + 1
            te_val = value
        } else if lname == "connection" {
            conn_val = value
        }
    }

    // ---- Host (§3.2 / §5.4): exactly one on 1.1, absolute wins ----
    if host_count > 1 {
        return malformed
    }
    if !host_target.is_empty() {
        r.host = host_target
    } else if host_count == 1 {
        r.host = host_val
    } else {
        if is11 {
            return malformed
        }
        r.host = ""
    }

    // ---- body framing (RFC 9110 §8.6, RFC 9112 §6) ----
    // CL + TE together is 400, full stop — the smuggling rule,
    // stricter than "TE wins" (matches the pinned oracle).
    if cl_count > 0 && te_count > 0 {
        return malformed
    }
    if te_count > 0 {
        if te_count > 1 {
            return malformed
        }
        if eq_ci(te_val, "chunked") {
            r.body_mode = "chunked"
        } else {
            // any other Transfer-Encoding is unimplemented (501),
            // matching the oracle's 501 for `Transfer-Encoding: gzip`
            return unimplemented
        }
    } else if cl_count > 0 {
        // a duplicate Content-Length is 400 even when the values
        // agree — the oracle rejects it, and the smuggling posture
        // prefers refusal to reconciliation (delta from RFC 9110's
        // "combine identical", named in the corpus)
        if cl_count > 1 {
            return malformed
        }
        let n = parse_length(cl_val, 999999999999999)?
        r.content_length = n
        r.body_mode = "length"
    }

    // ---- keepalive intent ----
    var alive = is11
    if !conn_val.is_empty() {
        if ci_contains(conn_val, "close") {
            alive = false
        } else if ci_contains(conn_val, "keep-alive") {
            alive = true
        }
    }
    r.keepalive = alive

    r
}

// ------------------------------------------------------------------
// chunked body framing (RFC 9112 §7.1) — the CVE-2013-2028 class
// ------------------------------------------------------------------

/// The value of one hex digit, or -1. Total.
fn hex_val(b: int) -> int {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 97 && b <= 102 {
        return b - 87
    }
    if b >= 65 && b <= 70 {
        return b - 55
    }
    -1
}

/// Parse a chunk-size line's hex digits, BOUNDED at `max_digits`
/// BEFORE the arithmetic (the CVE-2013-2028 design: the digit bound
/// is the defence, the checked multiply the backstop). A chunk
/// extension (`;name=value`) is parsed-and-ignored. Row: `malformed`
/// — no hex digits, a non-hex/non-`;` byte, OR more than `max_digits`
/// hex digits (a bad chunk size is a framing error → 400, refused
/// before it can reach the arithmetic; the corpus asserts the 400,
/// not a trap). RFC 9112 §7.1.1.
fn parse_chunk_size(line: str, max_digits: int) -> int ! {malformed} {
    var n: int = 0
    var digits: int = 0
    var done: bool = false
    for b_raw in line.bytes() {
        let b = b_raw as int
        if done {
            // inside a chunk extension after `;` — ignore the rest
            continue
        }
        if b == 59 {
            // `;` opens the chunk extension; the size is complete
            done = true
            continue
        }
        let v = hex_val(b)
        if v < 0 {
            return malformed
        }
        digits = digits + 1
        if digits > max_digits {
            // over the digit bound: a malformed chunk size (→ 400),
            // caught before the multiply that would overflow
            return malformed
        }
        n = n * 16 + v
    }
    if digits == 0 {
        return malformed
    }
    n
}

/// Decode a complete chunked body into its content. `body` is the raw
/// bytes after the header block. Each chunk is `<hex-size>[;ext]CRLF
/// <data>CRLF`, terminated by a `0CRLF` last chunk; trailers after it
/// are consumed and dropped (v0, documented). The running total is
/// bounded by `max_body` (413-adjacent; here `too_large`). Rows:
/// `malformed` (framing error), `too_large` (a chunk size over the
/// digit bound, or the assembled body over `max_body`).
/// Chunk sizes cross `parse_chunk_size`'s bounded gate, so a
/// CVE-2013-2028-shaped huge size is a clean 400, never arithmetic.
/// (W0602 allowed: two distinct statuses the caller writes.)
#[allow(w0602)]
pub fn decode_chunked(body: str, limits: Limits) -> str ! {malformed, too_large} {
    var out = ""
    var pos: int = 0
    let n = body.len
    var guard: int = 0
    while pos < n {
        guard = guard + 1
        if guard > 1000000 {
            return malformed
        }
        // read the chunk-size line up to CRLF
        let rest = body[pos..n]
        let nl = rest.find("\r\n") else -1
        if nl == -1 {
            return malformed
        }
        let size_line = rest[0..nl]
        let size = parse_chunk_size(size_line, limits.max_chunk_digits)?
        pos = pos + nl + 2
        if size == 0 {
            // last chunk: consume optional trailers up to the final
            // blank line, drop them (v0)
            return out
        }
        if out.len + size > limits.max_body {
            return too_large
        }
        // the data plus its trailing CRLF must be present
        if pos + size + 2 > n {
            return malformed
        }
        let chunk = body[pos..pos + size]
        out = "{out}{chunk}"
        pos = pos + size
        // the CRLF after the chunk data
        let sep = body[pos..pos + 2]
        if sep != "\r\n" {
            return malformed
        }
        pos = pos + 2
    }
    // ran out of bytes without a terminating zero chunk
    malformed
}

// ------------------------------------------------------------------
// path: percent-decode → dot-segment normalize (the traversal
// defence is the ORDER — decode BEFORE normalize, each its own fn)
// ------------------------------------------------------------------

/// Percent-decode a path EXACTLY ONCE (RFC 3986 §2.1). `%XX` with two
/// hex digits becomes the byte; a `%` not followed by two hex digits
/// is `malformed` (400 — nginx rejects a bad escape). The output is a
/// byte sequence reassembled into a `str`; a decoded byte is emitted
/// verbatim, so `%2e` → `.` and `%2f` → `/` (traversal normalization
/// runs AFTER, on the decoded form — that ordering is the defence).
/// Rows: `malformed` (a truncated or non-hex escape), `invalid` (the
/// decoded bytes are not valid UTF-8 — a `str` cannot hold them).
/// Decoding once and only once is the anti-double-decode posture.
/// (W0602 allowed: a bad escape is 400, un-decodable bytes are 400
/// with a distinct cause a caller may log differently.)
#[allow(w0602)]
pub fn percent_decode(s: str) -> str ! {malformed, invalid} {
    // ws28: a target with no `%` decodes to ITSELF — the loop below
    // would push every byte and validate what is already a `str` —
    // so the answer is the input, a view, and nothing materializes.
    // Exact by the function's own definition (only `%xx` changes a
    // byte); tests/http/path_fast.lu pins it beside the slow path.
    var has_pct = false
    for b_raw in s.bytes() {
        let b = b_raw as int
        if b == 37 {
            has_pct = true
        }
    }
    if !has_pct {
        return s
    }
    var raw = List[byte]()
    let n = s.len
    var i: int = 0
    while i < n {
        let ch = s[i..i + 1]
        var b: int = 0
        for bb_raw in ch.bytes() {
            let bb = bb_raw as int
            b = bb
        }
        if b == 37 {
            // `%` — need two hex digits following
            if i + 3 > n {
                return malformed
            }
            let h1 = s[i + 1..i + 2]
            let h2 = s[i + 2..i + 3]
            var d1: int = -1
            var d2: int = -1
            for bb_raw in h1.bytes() {
                let bb = bb_raw as int
                d1 = hex_val(bb)
            }
            for bb_raw in h2.bytes() {
                let bb = bb_raw as int
                d2 = hex_val(bb)
            }
            if d1 < 0 || d2 < 0 {
                return malformed
            }
            (mut raw).push((d1 * 16 + d2) as byte)
            i = i + 3
        } else {
            // a multi-byte code point: push each of its bytes verbatim
            for bb in ch.bytes() {
                (mut raw).push(bb)
            }
            i = i + 1
        }
    }
    str_from_utf8(raw) else |_| {
        return invalid
    }
}

/// Remove `.` and `..` dot-segments from an ALREADY-DECODED absolute
/// path (RFC 3986 §5.2.4 shape). A `..` that would escape the root is
/// `malformed` (400 — the traversal reject; nginx returns 400 on a
/// normalized path that leaves the root). Operates on `/`-split
/// segments, so it only sees traversal the decode step already
/// exposed — which is why decode MUST run first. Preserves a trailing
/// slash. Rows: `malformed` (an escaping `..`).
pub fn normalize_path(p: str) -> str ! {malformed} {
    if p.is_empty() {
        return "/"
    }
    // must be rooted
    if !p.starts_with("/") {
        return malformed
    }
    let trailing = p.ends_with("/")
    let n = p.len
    // ws28: a path that is ALREADY canonical — every `/`-separated
    // segment non-empty and neither `.` nor `..`, with at most one
    // empty segment and only as the last (the preserved trailing
    // slash) — normalizes to itself: the loop below would push each
    // segment and rebuild the same bytes through an interpolation per
    // segment. So the answer is the input, a view. Exact by the
    // function's own rules (`.` and empty drop, `..` pops, everything
    // else is kept in order); tests/http/path_fast.lu pins it beside
    // the slow path on both sides of each rule.
    if is_canonical(p) {
        return p
    }
    var segs = List[str]()
    // split on the ASCII `/` (byte 47) by offsets — slicing at those
    // offsets preserves any multi-byte content inside a segment (a
    // segment is a substring, never rebuilt byte-by-byte)
    var start: int = 0
    var i: int = 0
    for b_raw in p.bytes() {
        let b = b_raw as int
        if b == 47 {
            let seg = p[start..i]
            apply_segment(mut segs, seg)?
            start = i + 1
        }
        i = i + 1
    }
    let last = p[start..n]
    apply_segment(mut segs, last)?
    var out = ""
    for s in segs {
        out = "{out}/{s}"
    }
    if out.is_empty() {
        out = "/"
    } else if trailing {
        out = "{out}/"
    }
    out
}

/// Is the rooted path `p` already in normal form — no empty segment
/// except a trailing one, no `.` and no `..` segment? The scan that
/// lets `normalize_path` answer its input as a view (ws28). Total.
fn is_canonical(p: str) -> bool {
    // `start` is the offset of the current segment; a segment ends at
    // a `/` or at the end of `p`
    var start: int = 1
    var i: int = 1
    var dots: int = 0
    var other: int = 0
    for b_raw in p[1..p.len].bytes() {
        let b = b_raw as int
        if b == 47 {
            if i == start || other == 0 && (dots == 1 || dots == 2) {
                return false
            }
            start = i + 1
            dots = 0
            other = 0
        } else if b == 46 {
            dots = dots + 1
        } else {
            other = other + 1
        }
        i = i + 1
    }
    // the last segment: empty is the trailing slash (kept); `.` and
    // `..` are not canonical
    if i > start && other == 0 && (dots == 1 || dots == 2) {
        return false
    }
    true
}

/// Fold one path segment into the running stack: `.` and empty drop,
/// `..` pops (escaping the root is `malformed` — the traversal
/// reject), anything else pushes. RFC 3986 §5.2.4 shape.
fn apply_segment(mut segs: List[str], seg: str) -> () ! {malformed} {
    if seg == ".." {
        if segs.is_empty() {
            return malformed
        }
        let _ = (mut segs).pop() else {
            return malformed
        }
    } else if seg == "." || seg == "" {
        // drop
    } else {
        (mut segs).push(seg)
    }
}

// ------------------------------------------------------------------
// routing — a PURE function of the config model and the request meta
// (ws02 contract §4: touches no socket, no fs, no clock; ws07's
// dry-run and ws11's replay consume it directly). serve/ EXECUTES the
// decision — the stat, the read, the write — this only decides.
// ------------------------------------------------------------------

/// A routing decision. `status` 0 means "serve `fs_path`" (serve/
/// stats it: a directory with no trailing slash → 301, a directory →
/// try `index`, a file → 200); a non-zero `status` is an immediate
/// response the config named (a bare `return`, a denied method — v0
/// keeps this small). `matched` is the location that won (or "" for
/// the server root), `is_alias` whether alias replaced the prefix.
/// `content_type` is left "" here — serve/ maps the extension through
/// the `types` model, which is io-free but lives with the writer.
pub struct Decision {
    status: int,
    fs_path: str,
    matched: str,
    is_alias: bool,
    index: List[str],
    redirect: str,
}

/// Join a filesystem base and a URI remainder with exactly one `/`
/// between them. Total.
fn join_path(base: str, rel: str) -> str {
    let b_slash = base.ends_with("/")
    let r_slash = rel.starts_with("/")
    if b_slash && r_slash {
        return "{base}{rel[1..rel.len]}"
    }
    if !b_slash && !r_slash {
        return "{base}/{rel}"
    }
    "{base}{rel}"
}

/// The `location` modifier and prefix from a block's args: nginx
/// spells `location [=|~|~*|^~|@] uri` or `location uri`. Returns
/// (modifier, prefix); a nameless/odd block is ("", "").
fn location_key(c: config.Conf, i: int) -> (str, str) {
    let at = c.args_at[i]
    let nn = c.args_n[i]
    if nn == 1 {
        return ("", c.argp[at])
    }
    if nn >= 2 {
        return (c.argp[at], c.argp[at + 1])
    }
    ("", "")
}

/// The first N-argument value of directive `name` whose parent block
/// is `blk` (`blk` -1 is the top level). Returns the value or the
/// `none` row. lobo#14: the config's load-time child index, not a
/// whole-arena scan — the same first match.
fn child_arg1(c: config.Conf, blk: int, name: str) -> str ! {none} {
    config.child_arg1(c, blk, name)
}

/// Collect the `index` file list for block `blk` (its own `index`
/// directive; empty when it declares none — serve/ falls back to the
/// server-level list or the built-in "index.html").
fn index_list(c: config.Conf, blk: int) -> List[str] {
    var out = List[str]()
    let at0 = config.kid_first(c, blk)
    let kn = config.kid_count(c, blk)
    var k: int = 0
    while k < kn {
        let i = c.kids[at0 + k]
        if c.names[i] == "index" {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var j: int = 0
            while j < nn {
                (mut out).push(c.argp[at + j])
                j = j + 1
            }
        }
        k = k + 1
    }
    out
}

/// Find the index of the FIRST `server` block (kind "b") in context
/// "http", or -1. v0 serves the first server; virtual-host selection
/// by `server_name`/Host is a later sprint's matching (the table row
/// says host matching lands ws02 as parse; routing by it is ws03+).
fn first_server(c: config.Conf) -> int {
    config.first_server(c)
}

/// The route trace (ws07): every candidate the matcher CONSIDERED,
/// with the reason it won or lost — the operator's real question.
/// Parallel primitive lists on purpose: a List of a bool-mixing
/// struct is refused on the native tier (wolf-lang#144), and the
/// flat shape is the house Conf idiom anyway. `whys` carries STABLE
/// reason codes (dryrun/ owns the operator prose table, so wording
/// edits never smear routing diffs); `details` carries the
/// per-candidate specifics ("" when there are none).
pub struct RouteTrace {
    kinds: List[str],
    rows: List[int],
    mods: List[str],
    prefixes: List[str],
    outcomes: List[str],
    whys: List[str],
    details: List[str],
}

/// An empty trace collector for `route_traced`. Total.
pub fn trace_new() -> RouteTrace {
    RouteTrace {
        kinds: List[str](),
        rows: List[int](),
        mods: List[str](),
        prefixes: List[str](),
        outcomes: List[str](),
        whys: List[str](),
        details: List[str](),
    }
}

/// Append one candidate row to a trace. Total.
fn trace_push(
    mut tr: RouteTrace,
    kind: str,
    row: int,
    modi: str,
    prefix: str,
    outcome: str,
    why: str,
    detail: str,
) {
    (mut tr.kinds).push(kind)
    (mut tr.rows).push(row)
    (mut tr.mods).push(modi)
    (mut tr.prefixes).push(prefix)
    (mut tr.outcomes).push(outcome)
    (mut tr.whys).push(why)
    (mut tr.details).push(detail)
}

/// The space-joined `server_name` arguments of server block `srv`
/// ("" when the block declares none). Total.
fn server_names_join(c: config.Conf, srv: int) -> str {
    var out = ""
    var i: int = 0
    let total = c.names.len
    while i < total {
        if c.names[i] == "server_name" && c.parent[i] == srv {
            let at = c.args_at[i]
            let nn = c.args_n[i]
            var j: int = 0
            while j < nn {
                if out.is_empty() {
                    out = c.argp[at + j]
                } else {
                    out = "{out} {c.argp[at + j]}"
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    out
}

/// Route a decoded, normalized request `path` against the config
/// model. PURE. Never traps: a config with no root yields a decision
/// whose `fs_path` is empty and `status` 0, which serve/ answers 404
/// (there is nothing to serve), so the absence of configuration is a
/// clean not-found, not a crash. Longest-prefix location match with
/// `=` exact taking precedence; `root` appends the URI, `alias`
/// replaces the matched prefix (the LOBO-L003 slash class applied at
/// runtime).
pub fn route(c: config.Conf, path: str) -> Decision {
    // ws28: the serving path builds NO trace — the first cut delegated
    // to `route_traced` with a fresh collector, which was seven empty
    // lists per request for a trace nobody read
    decide(c, path, match_location(c, path))
}

/// What the location matcher found: the server block, the exact hit
/// and the longest prefix hit (row indices, -1 for none), the block
/// that won (`loc`, the server itself when no location matched) and
/// the prefix it matched. ONE matcher (`match_location`), consumed by
/// `decide` for the decision and by `route_traced` for the trace.
struct LocMatch {
    srv: int,
    best: int,
    exact_hit: int,
    loc: int,
    matched: str,
}

/// The location matcher: `=` exact takes precedence, else the longest
/// plain (or `^~`) prefix; regex modifiers are parse-only at this pin
/// and never win. Allocation-free. Total.
fn match_location(c: config.Conf, path: str) -> LocMatch {
    var m = LocMatch { srv: first_server(c), best: -1, exact_hit: -1, loc: -1, matched: "" }
    if m.srv < 0 {
        return m
    }
    m.loc = m.srv
    var best_len: int = -1
    var best_prefix = ""
    var i: int = 0
    // lobo#14: the load-time location table — the same rows in the
    // same ROW order, so precedence is untouched
    let total = config.loc_count(c)
    while i < total {
        let modi = c.loc_mod[i]
        let prefix = c.loc_prefix[i]
        if modi == "=" {
            if path == prefix {
                m.exact_hit = c.loc_row[i]
                best_prefix = prefix
            }
        } else if modi == "" || modi == "^~" {
            // plain prefix match (regex modifiers are parse-only
            // at ws02 — they never win a route here)
            if path.starts_with(prefix) {
                if prefix.len > best_len {
                    best_len = prefix.len
                    m.best = c.loc_row[i]
                    best_prefix = prefix
                }
            }
        }
        i = i + 1
    }
    if m.exact_hit >= 0 {
        m.loc = m.exact_hit
        m.matched = best_prefix
    } else if m.best >= 0 {
        m.loc = m.best
        let key = location_key(c, m.best)
        m.matched = key.1
    }
    m
}

/// The decision off a match: alias replaces the matched prefix, root
/// appends the path, the index list is the location's else the
/// server's. Total.
fn decide(c: config.Conf, path: str, m: LocMatch) -> Decision {
    var d = Decision {
        status: 0,
        fs_path: "",
        matched: "",
        is_alias: false,
        index: List[str](),
        redirect: "",
    }
    if m.srv < 0 {
        return d
    }
    let srv = m.srv
    let loc = m.loc
    let matched_prefix = m.matched
    d.matched = matched_prefix

    // resolve alias (replaces the matched prefix) or root (appends)
    let alias = child_arg1(c, loc, "alias") else ""
    if !alias.is_empty() {
        d.is_alias = true
        var remainder = path
        if path.starts_with(matched_prefix) {
            remainder = path[matched_prefix.len..path.len]
        }
        d.fs_path = join_path(alias, remainder)
    } else {
        // root: this location's, else the server's, else none
        var root = child_arg1(c, loc, "root") else ""
        if root.is_empty() {
            root = child_arg1(c, srv, "root") else ""
        }
        if !root.is_empty() {
            d.fs_path = join_path(root, path)
        }
    }

    // index list: location's, else server's
    var idx = index_list(c, loc)
    if idx.is_empty() {
        idx = index_list(c, srv)
    }
    d.index = idx
    d
}

/// `route` with its trace collector exposed (ws07's dry-run seam).
/// ONE matcher: `match_location` is the same call `route` makes, so
/// the trace can never disagree with the serving decision. The trace
/// is filled AFTER the decision, classifying every candidate RELATIVE
/// to the matcher's own outcome — probe-shaped from the real
/// precedence implementation, never a parallel re-derivation of the
/// winner.
pub fn route_traced(c: config.Conf, path: str, mut tr: RouteTrace, want: bool) -> Decision {
    let m = match_location(c, path)
    let d = decide(c, path, m)
    let srv = m.srv
    let loc = m.loc
    let best = m.best
    let exact_hit = m.exact_hit
    let matched_prefix = m.matched
    let total = c.names.len

    // ---- the trace (ws07): explain every candidate the matcher saw,
    // relative to the decision ABOVE — the winner is the matcher's,
    // never re-derived here. Skipped entirely on the serving path.
    if want && srv >= 0 {
        // server candidates: the first server block wins at this pin
        // (server_name/Host selection is parse-only — a named delta)
        var si: int = 0
        while si < total {
            if c.names[si] == "server" && c.kinds[si] == "b" && c.ctx[si] == "http" {
                let names = server_names_join(c, si)
                if si == srv {
                    trace_push(mut tr, "server", si, "", names, "won", "first-server", "")
                } else {
                    trace_push(mut tr, "server", si, "", names, "lost", "not-first-server", "")
                }
            }
            si = si + 1
        }
        // location candidates under the winning server
        let won_len = matched_prefix.len
        var li: int = 0
        while li < total {
            if c.names[li] == "location" && c.kinds[li] == "b" && c.parent[li] == srv {
                let key = location_key(c, li)
                let modi = key.0
                let prefix = key.1
                if li == exact_hit {
                    trace_push(mut tr, "location", li, modi, prefix, "won", "exact-match", "")
                } else if li == loc && best >= 0 && exact_hit < 0 {
                    trace_push(
                        mut tr,
                        "location",
                        li,
                        modi,
                        prefix,
                        "won",
                        "longest-prefix",
                        "{prefix.len} bytes",
                    )
                } else if modi == "=" {
                    trace_push(mut tr, "location", li, modi, prefix, "lost", "exact-miss", "")
                } else if modi == "~" || modi == "~*" {
                    trace_push(mut tr, "location", li, modi, prefix, "lost", "regex-parse-only", "")
                } else if modi == "@" {
                    trace_push(mut tr, "location", li, modi, prefix, "lost", "named-location", "")
                } else if !path.starts_with(prefix) {
                    trace_push(mut tr, "location", li, modi, prefix, "lost", "prefix-miss", "")
                } else if exact_hit >= 0 {
                    let ekey = location_key(c, exact_hit)
                    trace_push(
                        mut tr,
                        "location",
                        li,
                        modi,
                        prefix,
                        "lost",
                        "lost-to-exact",
                        "= {ekey.1}",
                    )
                } else if prefix.len < won_len {
                    trace_push(
                        mut tr,
                        "location",
                        li,
                        modi,
                        prefix,
                        "lost",
                        "shorter-prefix",
                        "{prefix.len} < {won_len}",
                    )
                } else {
                    trace_push(
                        mut tr,
                        "location",
                        li,
                        modi,
                        prefix,
                        "lost",
                        "tie-first-wins",
                        "{prefix.len} bytes",
                    )
                }
            }
            li = li + 1
        }
    }

    d
}
