//! budget — the proc boundary the cap needs (ws13, wsc05). s132's
//! region cap traps at the allocating site; D68 contains that trap
//! only at a PROC boundary ([mem.region.cap.3]): so a budgeted
//! request's regioned body work runs inside `spawn proc`, here, and
//! the join maps the exit reason for serve. Why a module of its own
//! and not a corner of serve/: the release tier's s43 cluster
//! partition refused the proc's entry shim when the spawn sat inside
//! serve.serve_file (`func.addr of @serve.serve_file.task0.entry
//! outside this object's subset` — the #136 shape, for a PROC; filed
//! from ws13), and a leaf module whose spawner and body share one
//! small cluster is the placement that builds. The seam is honest
//! either way: serve decides the status, this module runs the body
//! and reports (class, write outcome, measured region bytes).
//! docs/BUDGET.md carries the arithmetic and the self-pipe story.

/// The module's interface version. Total.
pub fn version() -> str {
    "0.1.0"
}

/// A body proc's outcome at the join: `cls` 0 normal / 1 error (the
/// socket broke) / 2 fault(alloc-contract) — THE CAP REFUSED / 3
/// another contained fault / 4 the join timed out; `wcode` the
/// pipe's write outcome (0 clean, 1 closed, 2 io, 3 the read failed);
/// `rt` the measured region bytes the proc reported (0 without a
/// pipe, or after a fault — a killed proc wrote nothing).
pub struct Outcome {
    cls: int,
    wcode: int,
    rt: int,
}

/// The self-pipe line a body proc wrote: (wcode, rt). (0, 0) when
/// there is no pipe; (2, 0) when the pipe is silent (an error exit
/// with nothing written reads as an io break). Total.
fn read_pipe(pipe_r: int, errored: bool) -> (int, int) {
    if pipe_r < 0 {
        return (if errored { 2 } else { 0 }, 0)
    }
    net_deadline(pipe_r, 1000) else |_| {}
    let line = net_read(pipe_r, 64) else |_| {
        ""
    }
    let sp = line.find(" ") else -1
    if sp < 0 {
        return (if errored { 2 } else { 0 }, 0)
    }
    var w: int = 0
    for b_raw in line[0..sp].bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            w = w * 10 + b - 48
        }
    }
    var rt: int = 0
    for b_raw in line[sp + 1..line.len].bytes() {
        let b = b_raw as int
        if b >= 48 && b <= 57 {
            rt = rt * 10 + b - 48
        }
    }
    (w, rt)
}

/// The regioned body work of a budgeted SMALL response (≤ 64 KiB),
/// inside a proc: read the file into a CAPPED region, write head then
/// body to the bare socket, report `<wcode> <rt>` on the pipe (0
/// clean, 1 closed, 2 io, 3 the read failed). A cap breach traps at
/// the read — before any byte is on the wire — and is contained at
/// this proc's boundary. Row: io on any non-clean outcome (the join
/// reads the pipe for which).
///
/// TWO WRITES, on purpose (ws24). The plaintext arm in `serve` now
/// gathers head and body into one `net_writev_head`; this arm does not,
/// because the gather's two-part list must live in the capped region
/// beside the body (a region value cannot be stored outside it,
/// E1010), and D40's envelope leaves that region exactly sixteen
/// ledger units at a power-of-two body — `charge(N) = 16 ×
/// pow2ceil(N) − 16` against a cap of `16 × pow2ceil(budget)`
/// (docs/BUDGET.md, the theorem) — which is less than one list
/// header. The second write stopped costing anything worth a
/// re-derivation at the ws24 pin: `TCP_NODELAY` is the runtime's
/// default (no stall, [os.net.nodelay]) and a write into an empty
/// send buffer parks nowhere ([os.net.io]), so it is one extra
/// syscall on the budgeted path only. Re-deriving D40 with a
/// constant for the gather is a named residue, not this sprint's.
fn body_small(sock: int, path: str, head: str, cap: int, pipe: int) -> int ! {io} {
    var failed = false
    var wcode = 0
    var rt = 0
    region resp(cap: cap) {
        let body = fs_read_bytes(path) else |_| {
            failed = true
            List[byte]()
        }
        rt = region_bytes(resp)
        if !failed {
            net_write(sock, head) else |e| match e {
                closed => {
                    wcode = 1
                },
                io => {
                    wcode = 2
                },
            }
            if wcode == 0 {
                net_write_bytes(sock, body) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    invalid => {
                        wcode = 2
                    },
                    io => {
                        wcode = 2
                    },
                }
            }
        }
        wcode = wcode
    }
    if failed {
        wcode = 3
    }
    if pipe >= 0 {
        net_write(pipe, "{wcode} {rt}\n") else |_| {}
    }
    if wcode != 0 {
        return io
    }
    0
}

/// The regioned body work of a budgeted STREAMED response (> 64 KiB;
/// the head is already on the wire), inside a proc: open the file,
/// stream it in 64 KiB chunks each in its own CAPPED region, report
/// `<wcode> <rt>` (rt = the per-chunk HIGH WATER, ws12's number). A
/// cap breach traps at the first chunk read and is contained here;
/// the join can only close (nginx cannot un-send a head either).
/// Row: io on any non-clean outcome.
fn body_stream(sock: int, path: str, cap: int, pipe: int) -> int ! {io} {
    var rt = 0
    var wcode = 0
    let fd = fs_open(path) else |_| {
        if pipe >= 0 {
            net_write(pipe, "3 0\n") else |_| {}
        }
        return io
    }
    var streaming = true
    while streaming && wcode == 0 {
        region chunkr(cap: cap) {
            let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                eof => {
                    streaming = false
                    List[byte]()
                },
                io => {
                    wcode = 3
                    List[byte]()
                },
            }
            if wcode == 0 && chunk.len > 0 {
                net_write_bytes(sock, chunk) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    invalid => {
                        wcode = 2
                    },
                    io => {
                        wcode = 2
                    },
                }
            }
            let crt = region_bytes(chunkr)
            if crt > rt {
                rt = crt
            }
            wcode = wcode
        }
    }
    fs_close(fd) else |_| {}
    if pipe >= 0 {
        net_write(pipe, "{wcode} {rt}\n") else |_| {}
    }
    if wcode != 0 {
        return io
    }
    0
}

/// Run a budgeted SMALL response's body inside a capped proc and
/// join it. Total (every outcome is a value).
pub fn run_small(sock: int, path: str, head: str, cap: int, pipe_w: int, pipe_r: int) -> Outcome {
    let w = spawn proc body_small(sock, path, head, cap, pipe_w)
    let m = w.monitor()
    var cls = 3
    select {
        exit(reason) from m => {
            if reason.is_normal() {
                cls = 0
            } else if reason.is_error() {
                cls = 1
            } else if reason.is_alloc_contract() {
                cls = 2
            } else {
                cls = 3
            }
        },
        timeout(600.s) => {
            cls = 4
        },
    }
    if cls >= 2 {
        return Outcome { cls: cls, wcode: 0, rt: 0 }
    }
    let rep = read_pipe(pipe_r, cls == 1)
    Outcome { cls: cls, wcode: rep.0, rt: rep.1 }
}

/// Run a budgeted STREAMED response's body (the head already on the
/// wire) inside a capped proc and join it. Total.
pub fn run_stream(sock: int, path: str, cap: int, pipe_w: int, pipe_r: int) -> Outcome {
    let w = spawn proc body_stream(sock, path, cap, pipe_w)
    let m = w.monitor()
    var cls = 3
    select {
        exit(reason) from m => {
            if reason.is_normal() {
                cls = 0
            } else if reason.is_error() {
                cls = 1
            } else if reason.is_alloc_contract() {
                cls = 2
            } else {
                cls = 3
            }
        },
        timeout(600.s) => {
            cls = 4
        },
    }
    if cls >= 2 {
        return Outcome { cls: cls, wcode: 0, rt: 0 }
    }
    let rep = read_pipe(pipe_r, cls == 1)
    Outcome { cls: cls, wcode: rep.0, rt: rep.1 }
}

// ------------------------------------------------------------------
// ws49 (lobo#46): the STREAM beside the loop. Until ws49 a large
// plaintext body (> 64 KiB) streamed to completion INSIDE the poll
// loop's step — inline, or through `run_stream`'s proc joined on the
// spot — so the loop was held until the rest of the file fitted the
// kernel's socket buffers or the write's budget fired: 3 to 8 s on a
// 64 KB/s client of a 1.3 MB file (the demo reel), the whole send
// budget on a client that stops reading. A held loop answers nothing:
// not a second client, not `lobo status`, not `-s reload`.
//
// wolf gives a spawn-free loop no way to step a slow writer: readiness
// is READ readiness only ([os.net.wait]) and `net_write` drains the
// whole buffer or fails with the bytes it sent unknown ([os.net.io]).
// So the body leaves in a proc beside the loop, and the loop learns
// the outcome the way it learns of a signal: a line down a loopback
// self-pipe whose read end is in its wait set. One proc per stream
// writes the chunks (each in its own region) and reports `<sock> <cls>
// <wcode> <rt>`. The loop never touches the socket while the row
// streams; the stream closes the file. `start_stream` says why it is
// one proc, uncapped, and why the loop bounds how many run at once.
// ------------------------------------------------------------------

/// The stream: the rest of `fd` to `sock`, in 64 KiB chunks, each in
/// its own region (the serve path's ws10 shape), then close `fd` and
/// report ONE line down the loop's stream pipe `out`: `<sock> <cls>
/// <wcode> <rt>` — `cls` 0 (the proc ran to its end; the loop reads
/// any other value as a broken stream), `wcode` 0 clean, 1 the peer
/// closed, 2 io (a fired write budget included), 3 the file read
/// failed, `rt` the per-chunk region HIGH WATER (ws12's number). The
/// line is one short write, so lines from concurrent streams never
/// interleave. Total.
fn stream_body(sock: int, fd: int, out: int) -> int {
    var rt = 0
    var wcode = 0
    var streaming = true
    while streaming && wcode == 0 {
        region chunkr {
            let chunk = fs_read_chunk(fd, 65536) else |e| match e {
                eof => {
                    streaming = false
                    List[byte]()
                },
                io => {
                    wcode = 3
                    List[byte]()
                },
            }
            if wcode == 0 && chunk.len > 0 {
                net_write_bytes(sock, chunk) else |e| match e {
                    closed => {
                        wcode = 1
                    },
                    invalid => {
                        wcode = 2
                    },
                    io => {
                        wcode = 2
                    },
                }
            }
            let crt = region_bytes(chunkr)
            if crt > rt {
                rt = crt
            }
            wcode = wcode
        }
    }
    fs_close(fd) else |_| {}
    net_write(out, "{sock} 0 {wcode} {rt}\n") else |_| {}
    0
}

/// Hand a large plaintext body to a stream beside the loop (ws49,
/// lobo#46): the head is already on the wire and `fd` is the open
/// file (the stream closes it). Returns at once; the outcome arrives
/// as one line on the pipe whose write end is `out`.
///
/// ONE proc per stream, uncapped, budget or not, because at the 0.2.22
/// pin a proc parked in a runtime wait holds its pool worker with no
/// compensation, so parked streams starve the procs spawned after
/// them (wolf-lang#570, with a 50-line repro). A watch proc (which
/// would report a FAULTED stream — a killed proc writes nothing, so
/// such a row would wait for its generation's drain) would double
/// that cost; the loop bounds what the rest costs (`stream_room` in
/// main.lu). The region cap ws13 built for the budgeted body is not
/// used here: the meter rules the body at the `file` site before a
/// byte is written, and since D40 the cap could not fire on this path
/// from any config (docs/BUDGET.md). Total.
pub fn start_stream(sock: int, fd: int, out: int) {
    let _w = spawn proc stream_body(sock, fd, out)
}

/// One line off the stream pipe, read back: (sock, cls, wcode, rt),
/// or sock -1 when the line is not one `stream_body` wrote. Pure and
/// total.
pub fn stream_line(line: str) -> (int, int, int, int) {
    var vals = List[int]()
    for w in line.words() {
        var n: int = 0
        var ok = !w.is_empty()
        for b_raw in w.bytes() {
            let b = b_raw as int
            if b >= 48 && b <= 57 {
                n = n * 10 + b - 48
            } else {
                ok = false
            }
        }
        if !ok {
            return (-1, 0, 0, 0)
        }
        (mut vals).push(n)
    }
    if vals.len != 4 {
        return (-1, 0, 0, 0)
    }
    (vals[0], vals[1], vals[2], vals[3])
}
