//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//! stage-src: shell config
//!
//! ws64 (lobo#84): OUT OF DESCRIPTORS, THE ORDER DESK STILL ANSWERS.
//! A real lobo is started with its descriptor limit lowered to 64 —
//! `ulimit -n` in the child shell that execs it, so the limit is that
//! one process's and nobody else's — and is driven to the limit twice:
//!   1. idle connections until a fresh GET is left unanswered (the
//!      accept fails; the connection waits in the kernel's queue, as
//!      nginx's does). Then, while it is out of descriptors:
//!        * `status` answers inside 1000 ms — lobo holds a descriptor
//!          in reserve and lets it go for the order's connection,
//!          BEFORE the accept (a failed accept leaves the connection
//!          queued on linux and drops it on macOS);
//!        * the failure is LOGGED, nginx's line, at nginx's rate:
//!          `[crit] accept() failed (24: Too many open files)`, the
//!          process sitting out half a second after each, so the
//!          lines are bounded by the clock and not by the queue;
//!        * `reload` takes (the second reserve is its file's);
//!      and when the connections close, a GET answers again with
//!      nothing restarted.
//!   2. slow downloads to the limit. The runtime makes its readiness
//!      set at the first call that parks; lobo now makes it at start.
//!      The process is still there, `status` answers, and it serves
//!      again afterwards.
//!   3. idle connections to the limit once more, and `stop`: answered,
//!      and the process exits 0.
//! RED AT TRUNK (1d23471): step 1's `status` gets no reply — the
//! control accept fails like every other and nothing is logged — and
//! step 2 ends the process (`epoll_create1 failed`). Against the real
//! binary (os_spawn + net + fs → native+checked). Loopback only,
//! OS-chosen ports; the scratch tree is cleared at the START and the
//! end; the server is stopped over its endpoint, or by its own handle
//! on a failure path.

use shell

fn free_port() -> int ! {io} {
    let l = net_listen("127.0.0.1:0") else |_| {
        return io
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return io
    }
    net_close(l) else |_| {}
    p
}

/// One GET /index.html on a fresh connection: the reply, or "" when
/// nothing arrived inside `ms` (refused, queued, or closed). Total.
fn fetch(port: int, ms: int) -> str {
    let c = net_connect("127.0.0.1:{port}") else |_| {
        return ""
    }
    net_deadline(c, ms) else |_| {}
    net_write(c, "GET /index.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") else |_| {
        net_close(c) else |_| {}
        return ""
    }
    var buf = ""
    var reading = true
    while reading {
        let piece = net_read(c, 4096) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    net_close(c) else |_| {}
    buf
}

/// Start `bin serve -p . -c conf` with its descriptor limit lowered to
/// `nofile`: a child `/bin/sh` lowers ITS OWN limit and execs lobo, so
/// the handle is lobo's and no limit outside that process moves.
/// stdout and stderr go to `out`. -1 when it could not start. Total.
fn lobo_limited(bin: str, conf: str, nofile: int, out: int) -> int {
    var args = List[str]()
    (mut args).push("-c")
    (mut args).push("ulimit -n \"$1\" || exit 97; exec \"$2\" serve -p . -c \"$3\"")
    (mut args).push("sh")
    (mut args).push("{nofile}")
    (mut args).push(bin)
    (mut args).push(conf)
    var map = List[int]()
    (mut map).push(1)
    (mut map).push(out)
    (mut map).push(2)
    (mut map).push(out)
    os_spawn_fds("/bin/sh", args, map) else |_| { -1 }
}

fn wait_alive(ep: str) -> bool {
    var i: int = 0
    while i < 200 {
        if shell.control_alive(ep) {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

/// How many lines of the file at `path` contain `need`. Total.
fn lines_with(path: str, need: str) -> int {
    let t = fs_read_text(path) else |_| { "" }
    var n: int = 0
    for line in t.lines() {
        if line.contains(need) {
            n = n + 1
        }
    }
    n
}

/// Wait up to ~5 s for a line of `path` to carry `need`. Total.
fn wait_line(path: str, need: str) -> bool {
    var i: int = 0
    while i < 100 {
        if lines_with(path, need) >= 1 {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

/// End a server this test could not stop the intended way, and reap
/// it: the handle's own kill, never a pid. Total.
fn put_down(h: int) {
    os_kill(h) else |_| {}
    let _ = os_wait(h) else |_| {
        0
    }
}

/// Print what the server wrote last (its final `n` lines), so a
/// failure's record carries it: an assert's own message is not in the
/// record (wolf-lang#150). Total.
fn tail_out(path: str, n: int) {
    let t = fs_read_text(path) else |_| { "" }
    var all = List[str]()
    for line in t.lines() {
        (mut all).push(line)
    }
    var i = if all.len > n { all.len - n } else { 0 }
    while i < all.len {
        print("server: {all[i]}")
        i = i + 1
    }
}

/// How many of `cs` the server has closed. Total.
fn dropped(cs: List[int]) -> int {
    var n: int = 0
    for c in cs {
        var one = List[int]()
        (mut one).push(c)
        let ready = net_wait(one, 0) else |_| {
            List[int]()
        }
        if ready.len > 0 {
            n = n + 1
        }
    }
    n
}

fn close_all(cs: List[int]) {
    for c in cs {
        net_close(c) else |_| {}
    }
}

/// `n` connections to `port`, each sending `req` when it is not empty;
/// the ones that connected. Total.
fn open_many(port: int, n: int, req: str) -> List[int] {
    var cs = List[int]()
    var k: int = 0
    while k < n {
        let c = net_connect("127.0.0.1:{port}") else |_| { -1 }
        if c >= 0 {
            if !req.is_empty() {
                net_write(c, req) else |_| {}
            }
            (mut cs).push(c)
        }
        k = k + 1
    }
    cs
}

/// `status` over the endpoint: (reply, milliseconds). Total.
fn ask_status(ep: str) -> (str, int) {
    let t0 = time_unix_ms()
    let st = shell.control_fetch(ep, "status") else |_| { "" }
    (st, time_unix_ms() - t0)
}

fn main() -> !int {
    let root = os_cwd() else |_| "."
    let d = "{root}/target/ws64_exhausted"
    fs_remove_dir_all(d) else |_| {}
    fs_create_dir_all("{d}/www")?
    fs_write_text("{d}/www/index.html", "small-page\n")?
    var mk = List[str]()
    (mut mk).push("/bin/sh")
    (mut mk).push("-c")
    (mut mk).push("head -c 25165824 /dev/zero | tr '\\000' w > \"$1\"")
    (mut mk).push("sh")
    (mut mk).push("{d}/www/big.bin")
    let mh = os_spawn(mk)?
    let mrc = os_wait(mh)?
    assert(mrc == 0, "the 24 MiB file is written")
    let bin = env_get("LOBO_BIN") else |_| { "{root}/target/lobo-debug" }
    let nofile = 64
    let crit = "[crit] accept() failed (24: Too many open files)"

    print("step 1: idle connections to the descriptor limit")
    let hp = free_port()?
    let cp = free_port()?
    let ep = "127.0.0.1:{cp}"
    let conf = "{d}/lobo.conf"
    fs_write_text(
        conf,
        "pid {d}/lobo.pid;\ncontrol {ep};\nhttp {{\n  types {{ text/html html; application/octet-stream bin; }}\n  server {{ listen 127.0.0.1:{hp}; root {d}/www; }}\n}}\n",
    )?
    let so_p = "{d}/server.out"
    let so = fs_create(so_p)?
    let h = lobo_limited(bin, conf, nofile, so)
    assert(h >= 0, "the server spawned")
    if !wait_alive(ep) {
        put_down(h)
        assert(false, "the server never answered on {ep}")
    }
    assert(fetch(hp, 2000).contains("small-page"), "it serves before the limit")
    // more idle connections than the limit has descriptors: the first
    // ones are accepted, the rest wait in the kernel's queue
    let idle = open_many(hp, 100, "")
    time_sleep_ms(300)
    let t_ex = time_unix_ms()
    let queued = fetch(hp, 1500)
    if !queued.is_empty() {
        close_all(idle)
        put_down(h)
        assert(
            false,
            "100 idle connections leave a 64-descriptor process unable to accept (a fresh GET was answered)",
        )
    }
    let s1 = ask_status(ep)
    print("status while out of descriptors: {s1.1} ms, {s1.0.len} bytes")
    if !s1.0.contains("current generation: 1") || s1.1 > 1000 {
        print("reply: [{s1.0}]; the endpoint answers a ping now: {shell.control_alive(ep)}")
        tail_out(so_p, 12)
        close_all(idle)
        put_down(h)
        assert(
            false,
            "out of descriptors, `status` answers inside 1000 ms: {s1.1} ms, reply [{s1.0}] (trunk: no reply — the control accept fails with the rest)",
        )
    }
    if !wait_line(so_p, crit) {
        tail_out(so_p, 12)
        close_all(idle)
        put_down(h)
        assert(false, "the failed accept is logged: {crit} (trunk: nothing)")
    }
    // a reload, out of descriptors: the configuration is read on the
    // second reserve
    let rl = shell.control_fetch(ep, "reload") else |_| { "" }
    if !rl.contains("reload complete (generation 2)") {
        print("reload: [{rl}]")
        tail_out(so_p, 12)
        close_all(idle)
        put_down(h)
        assert(false, "out of descriptors, `reload` takes: [{rl}]")
    }
    // the rate: half a second sat out after each failure, so the lines
    // are bounded by the time out of descriptors, not by the 50 or so
    // connections waiting
    time_sleep_ms(1200)
    let lines = lines_with(so_p, crit)
    let span = time_unix_ms() - t_ex + 300
    let most = span / 500 + 3
    if lines < 2 || lines > most {
        close_all(idle)
        put_down(h)
        assert(
            false,
            "the [crit] line comes about twice a second: {lines} lines in {span} ms (at most {most})",
        )
    }
    // what a failed accept costs the connection it could not take is
    // the host's (linux keeps it queued; macOS drops it): reported
    print(
        "{lines} accept-failure lines in {span} ms; {dropped(idle)} of {idle.len} idle connections closed by the host meanwhile",
    )
    // recovery: the connections close, the queue is served
    close_all(idle)
    var back = false
    let t_back = time_unix_ms()
    while !back && time_unix_ms() - t_back < 3000 {
        back = fetch(hp, 1000).contains("small-page")
    }
    if !back {
        put_down(h)
        assert(false, "with the connections closed lobo serves again, nothing restarted")
    }
    print("serving again {time_unix_ms() - t_back} ms after the connections closed")

    print("step 2: slow downloads to the descriptor limit")
    // each download holds two descriptors (its socket, its file); none
    // of these clients reads, so every body parks on its write
    let dl = open_many(hp, 40, "GET /big.bin HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
    time_sleep_ms(1500)
    let s2 = ask_status(ep)
    if !s2.0.contains("current generation: 2") || s2.1 > 1000 {
        print("status with downloads parked: {s2.1} ms, reply [{s2.0}]")
        tail_out(so_p, 12)
        close_all(dl)
        put_down(h)
        assert(
            false,
            "with downloads parked at the limit the process is there and `status` answers: {s2.1} ms, reply [{s2.0}] (trunk: the process ends at its first parked write)",
        )
    }
    close_all(dl)
    back = false
    let t_back2 = time_unix_ms()
    while !back && time_unix_ms() - t_back2 < 5000 {
        back = fetch(hp, 1000).contains("small-page")
    }
    if !back {
        put_down(h)
        assert(false, "with the downloads gone lobo serves again")
    }
    let panics = lines_with(so_p, "panicked")

    print("step 3: stop, out of descriptors")
    let idle3 = open_many(hp, 100, "")
    time_sleep_ms(300)
    if !fetch(hp, 1500).is_empty() {
        close_all(idle3)
        put_down(h)
        assert(false, "the process is at its limit again (a fresh GET was answered)")
    }
    let st = shell.control_fetch(ep, "stop") else |_| { "" }
    close_all(idle3)
    if !st.contains("stop") {
        print("stop: [{st}]")
        tail_out(so_p, 12)
        put_down(h)
        assert(false, "out of descriptors, `stop` is answered: [{st}]")
    }
    let rc = os_wait(h) else |_| { -1 }
    fs_close(so) else |_| {}
    assert(rc == 0, "the server exits 0 on stop: {rc}")
    assert(panics == 0, "the runtime never panicked")
    fs_remove_dir_all(d) else |_| {}
    0
}
