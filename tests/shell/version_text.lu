//! check: run(exit=0)
//! phase: run
//! lanes: native checked lupin
//! stage-src: shell config
//!
//! The text builders — nginx's one-fact-per-line shapes with lobo's own
//! identity (probed against the oracle 2026-08-27: `nginx version:
//! nginx/1.30.4`, the `-V` build lines, and the two-line Usage). Pure,
//! every lane. Also the signal-word table (stop=TERM, quit=QUIT,
//! reload=HUP, reopen=USR1) the deferred receiver will honor.

use shell

fn main() -> int {
    // the wire identity — bare on every channel, nginx's way
    assert(shell.version_token() == "lobo/0.1.0", "identity token")

    // the release stamp (ws19): five constants, held equal to wolf.pkg
    // and wolf-toolchain.toml by tools/lobo-stamp — this test pins the
    // SHAPES, the gate pins the values, so a pin bump moves neither
    let chan = shell.release_channel()
    assert(chan == "" || chan == "+dev", "the channel is the release or +dev, nothing else")
    assert(shell.release_version() == "0.1.0", "the package version (wolf.pkg's)")
    assert(shell.toolchain_pin().len == 7, "the toolchain pin is a short sha")
    assert(shell.toolchain_version().len > 0, "the toolchain version is named")
    assert(shell.std_rev().len == 7, "the std rev is a short sha")
    assert(
        shell.toolchain_line() ==
            "wolf {shell.toolchain_version()} (wolfgang, pin {shell.toolchain_pin()})",
        "the pin file's version_line, reassembled",
    )

    // -v: the version, the channel and the toolchain pin — W7's criterion
    let report = shell.version_report()
    assert(report.starts_with("lobo version: lobo/0.1.0"), "version line (nginx shape)")
    assert(
        report ==
            "lobo version: lobo/0.1.0{chan} (built with wolf {shell.toolchain_version()}, pin {shell.toolchain_pin()})",
        "-v names the version, the channel and the toolchain pin",
    )

    let v = shell.version_verbose()
    assert(v.starts_with("{report}\n"), "-V first line is the version report")
    assert(
        v.contains("built with {shell.toolchain_line()}\n"),
        "-V names the toolchain by its own version line",
    )
    assert(v.contains("std: wolf-std {shell.std_rev()}\n"), "-V names the std tree")
    assert(v.contains("tier: two-tier"), "-V names the tier posture")
    assert(v.contains("modules:"), "-V names the module set")

    let u = shell.usage_text()
    assert(
        u.contains("Usage: lobo [-?hvVtTq] [-s signal] [-p prefix]"),
        "usage line 1 (nginx shape)",
    )
    assert(u.contains("[-e filename] [-c filename] [-g directives]"), "usage line 2")
    assert(u.contains("serve | directives-md"), "usage names the lobo verbs")

    // the signal words and their unix mapping
    assert(shell.signal_ok("stop"), "stop is a verb")
    assert(shell.signal_ok("quit"), "quit is a verb")
    assert(shell.signal_ok("reload"), "reload is a verb")
    assert(shell.signal_ok("reopen"), "reopen is a verb")
    assert(!shell.signal_ok("bogus"), "bogus is not a verb")
    assert(!shell.signal_ok(""), "empty is not a verb")

    assert(shell.signal_unix("stop") == "TERM", "stop=TERM")
    assert(shell.signal_unix("quit") == "QUIT", "quit=QUIT")
    assert(shell.signal_unix("reload") == "HUP", "reload=HUP")
    assert(shell.signal_unix("reopen") == "USR1", "reopen=USR1")
    assert(shell.signal_unix("bogus") == "", "unknown verb → no signal")

    0
}
