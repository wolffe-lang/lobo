//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//! stage-src: shell config
//!
//! ws62 (px25's finding (b)): a hand the master REPLACES starts at the
//! master's current generation, not at 1. Against the real binary
//! (os_spawn + net + fs → native+checked; lupin declines the process
//! trio).
//! `target/lobo-debug serve` with `worker_processes 2`, then:
//!   1. two reloads: the master and both hands at generation 3;
//!   2. hand 1 is told `stop` directly; the master replaces it, and the
//!      replacement's row reads `generation=3` beside its sibling's
//!      (trunk at 944edc1: `generation=1 … restarts=1`);
//!   3. the replacement is a full member of the generation: the next
//!      reload moves BOTH hands to 4;
//!   4. the file edited with NO reload, then hand 2 stopped: its
//!      replacement serves the file it read (lobo's hands read the
//!      config; nginx's master hands down its own copy — a named
//!      delta, docs/WORKERS.md) and says so: a `warn` line in the
//!      error log naming the generation and both config ids.
//! Loopback only, OS-chosen ports. Idempotent: the scratch tree is
//! cleared at the START.

use shell

fn free_port() -> int ! {io} {
    let l = net_listen("127.0.0.1:0") else |_| {
        return io
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return io
    }
    net_close(l) else |_| {}
    p
}

fn write_conf(path: str, hp: int, cp: int, root: str) -> () ! {not_found, denied, io} {
    let text = "worker_processes 2;\npid ws62_regen/lobo.pid;\ncontrol 127.0.0.1:{cp};\nerror_log ws62_regen/error.log info;\nhttp {{\n  types {{ text/html html; }}\n  server {{ listen 127.0.0.1:{hp}; root {root}; }}\n}}\n"
    fs_write_text(path, text)?
}

/// The master's status stanza (text), or "". Total.
fn master_status(ep: str) -> str {
    shell.control_fetch(ep, "status") else |_| { "" }
}

/// The line for `worker N:` in a master stanza, or "". Total.
fn worker_row(st: str, n: int) -> str {
    for line in st.lines() {
        if line.starts_with("worker {n}: ") {
            return line
        }
    }
    ""
}

/// The `key=value` word's value on a row, or "". Total.
fn row_field(row: str, key: str) -> str {
    let probe = "{key}="
    for w in row.words() {
        if w.starts_with(probe) {
            return w[probe.len..w.len]
        }
    }
    ""
}

/// Poll an endpoint until it answers `ping`, up to ~15 s. Total.
fn wait_alive(ep: str) -> bool {
    var i: int = 0
    while i < 300 {
        if shell.control_alive(ep) {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

/// Poll the master until hand `n` serves with `restarts=r` and
/// generation `g`, up to ~30 s; answers the last row seen. Total.
fn wait_row(ep: str, n: int, r: str, g: str) -> str {
    var last = ""
    var i: int = 0
    while i < 600 {
        last = worker_row(master_status(ep), n)
        if last.contains(": serving ") &&
            row_field(last, "restarts") == r &&
            row_field(last, "generation") == g {
            return last
        }
        time_sleep_ms(50)
        i = i + 1
    }
    last
}

/// Stop the master and reap it (a failure path's cleanup). Total.
fn down(ep: str, child: int) {
    let _s = shell.control_send(ep, "stop") else |_| { "" }
    let _ = os_wait(child) else |_| {
        0
    }
}

fn main() -> !int {
    let scratch = "ws62_regen"
    fs_remove_dir_all(scratch) else |_| {}
    fs_create_dir_all("{scratch}/A")?
    fs_create_dir_all("{scratch}/B")?
    fs_write_text("{scratch}/A/index.html", "regen-A\n")?
    fs_write_text("{scratch}/B/index.html", "regen-B\n")?
    let hp = free_port()?
    let cp = free_port()?
    let ep = "127.0.0.1:{cp}"
    let confp = "{scratch}/lobo.conf"
    write_conf(confp, hp, cp, "{scratch}/A")?

    var argv = List[str]()
    let root = os_cwd() else |_| "."
    (mut argv).push("{root}/target/lobo-debug")
    (mut argv).push("serve")
    (mut argv).push("-p")
    (mut argv).push(".")
    (mut argv).push("-c")
    (mut argv).push(confp)
    let child = os_spawn(argv) else |_| {
        assert(false, "os_spawn of target/lobo-debug failed — is the debug tier built?")
        0
    }
    if !wait_alive(ep) {
        os_kill(child) else |_| {}
        let _ = os_wait(child) else |_| {
            0
        }
        assert(false, "the spawned master never became alive on {ep}")
    }
    let up1 = wait_row(ep, 1, "0", "1")
    let up2 = wait_row(ep, 2, "0", "1")
    assert(
        up1.contains(": serving ") && up2.contains(": serving "),
        "both hands serve: {up1} / {up2}",
    )

    print("step 1: two reloads")
    let r2 = shell.control_send(ep, "reload") else |_| { "" }
    assert(r2.starts_with("reload complete (generation 2)"), "reload 1: {r2}")
    let r3 = shell.control_send(ep, "reload") else |_| { "" }
    assert(r3.starts_with("reload complete (generation 3)"), "reload 2: {r3}")
    let st3 = master_status(ep)
    assert(st3.contains("current generation: 3\n"), "the master is at 3: {st3}")
    assert(row_field(worker_row(st3, 1), "generation") == "3", "hand 1 at 3: {st3}")
    assert(row_field(worker_row(st3, 2), "generation") == "3", "hand 2 at 3: {st3}")

    print("step 2: hand 1 stopped and replaced")
    let ep1 = row_field(worker_row(st3, 1), "control")
    let rs = shell.control_send(ep1, "stop") else |_| { "" }
    assert(rs.contains("shutting down"), "hand 1 takes the order: {rs}")
    let row1 = wait_row(ep, 1, "1", "3")
    if !(row_field(row1, "generation") == "3") {
        let seen = master_status(ep)
        down(ep, child)
        assert(
            false,
            "the replacement starts at the master's generation 3, not 1 (px25 (b)): {seen}",
        )
    }
    assert(
        row_field(worker_row(master_status(ep), 2), "generation") == "3",
        "its sibling is still at 3",
    )

    print("step 3: the replacement moves with the next reload")
    let r4 = shell.control_send(ep, "reload") else |_| { "" }
    assert(r4.starts_with("reload complete (generation 4)"), "reload 3: {r4}")
    assert(r4.contains("workers=2/2"), "both hands took it: {r4}")
    let st4 = master_status(ep)
    assert(row_field(worker_row(st4, 1), "generation") == "4", "the replacement at 4: {st4}")
    assert(row_field(worker_row(st4, 2), "generation") == "4", "its sibling at 4: {st4}")

    print("step 4: an edit with no reload, then hand 2 replaced")
    write_conf(confp, hp, cp, "{scratch}/B")?
    let ep2 = row_field(worker_row(st4, 2), "control")
    let rs2 = shell.control_send(ep2, "stop") else |_| { "" }
    assert(rs2.contains("shutting down"), "hand 2 takes the order: {rs2}")
    let row2 = wait_row(ep, 2, "1", "4")
    if !(row_field(row2, "generation") == "4") {
        let seen = master_status(ep)
        down(ep, child)
        assert(false, "hand 2's replacement starts at 4: {seen}")
    }
    // the warn line: the generation, and that the file is not its config
    var warned = false
    var w: int = 0
    while w < 200 && !warned {
        let log = fs_read_text("{scratch}/error.log") else |_| { "" }
        for line in log.lines() {
            if line.contains("[warn]") &&
                line.contains("generation 4") &&
                line.contains("is not generation 4's") &&
                line.contains("worker=2") {
                warned = true
            }
        }
        if !warned {
            time_sleep_ms(50)
        }
        w = w + 1
    }
    if !warned {
        let log = fs_read_text("{scratch}/error.log") else |_| { "" }
        down(ep, child)
        assert(false, "the replacement names the config it serves is not generation 4's: {log}")
    }

    print("step 5: stop")
    let rq = shell.control_send(ep, "stop") else |_| { "" }
    assert(rq.contains("shutting down"), "stop reply: {rq}")
    let code = os_wait(child) else |_| {
        -1
    }
    assert(code == 0, "the master exits 0: {code}")
    fs_remove_dir_all(scratch) else |_| {}
    0
}
