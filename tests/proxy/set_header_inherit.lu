//! check: run(exit=0, stdout="inherit ok\n")
//! phase: run
//! lanes: lupin
//! conforms: err.union
//! stage-src: proxy http config
//!
//! proxy_set_header inheritance — WWS-L002 as RUNTIME BEHAVIOR, and
//! the lint co-firing beside it (the charter's carry-AND-warn posture).
//! The EXACT rule the pinned oracle confirmed (probed: a location that
//! sets any proxy_set_header drops the http-level X-Http-Level from the
//! upstream request): the innermost level with any proxy_set_header
//! wins and discards ALL ancestor-level ones. This test builds the
//! config model, then asserts BOTH:
//!   (1) config.lint reports WWS-L002 on the child block (the load-time
//!       name), and
//!   (2) proxy.set_headers resolves the child's set ALONE at runtime
//!       (the parent's X-Http-Level is gone) — carry AND warn.
//! Lane: lupin (config.parse_str + Map/enum-free model resolution; the
//! model builder is the interpreter's lane, matching the config tests).

use config
use proxy

/// Render the effective proxy_set_header NAME set for the location that
/// routes `path`, as a space-joined string.
fn effective_names(c: config.Conf, path: str) -> str {
    let pl = proxy.plan(c, path)
    let sh = proxy.set_headers(c, pl.loc, pl.srv, pl.http_blk)
    let names = sh.0
    var out = ""
    for n in names {
        out = "{out}{n} "
    }
    out.trim()
}

fn main() -> int {
    // braces are DOUBLED: a `"""` block is an f-string, so `{{`/`}}`
    // are the literal braces the config needs (the D6 lesson).
    let src = """
http {{
  proxy_set_header X-Http-Level http-val;
  server {{
    listen 127.0.0.1:8080;
    location /def/ {{
      proxy_pass http://127.0.0.1:9401/;
    }}
    location /loc/ {{
      proxy_set_header X-Loc loc-val;
      proxy_pass http://127.0.0.1:9401/;
    }}
  }}
}}
"""
    let c = config.parse_str(src, "inherit.conf")

    // (1) the lint names WWS-L002 on the child block
    let report = config.lint(c)
    assert(report.contains("WWS-L002"), "lint must report WWS-L002")

    // (2) runtime: /def/ inherits the http-level set (no local psh)
    let def_set = effective_names(c, "/def/x")
    assert(def_set == "X-Http-Level", "def should inherit http-level, got `{def_set}`")

    // (2) runtime: /loc/ sets its own → the parent's X-Http-Level is
    // DISCARDED (WWS-L002 honored), only X-Loc remains
    let loc_set = effective_names(c, "/loc/x")
    assert(loc_set == "X-Loc", "loc should discard parent, got `{loc_set}`")
    assert(!loc_set.contains("X-Http-Level"), "parent header must be gone at the child")

    print("inherit ok")
    0
}
