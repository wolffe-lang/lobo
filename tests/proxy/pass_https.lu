//! check: run(exit=0, stdout="pass_https ok\n")
//! phase: run
//! lanes: native checked lupin
//! conforms: err.union, err.propagate
//! stage-src: proxy config http resolver
//!
//! wsm04, the D21 retirement's PURE half: `proxy_pass https://` now
//! PARSES (scheme carried, no named refusal — the io leg dials
//! std.x.tls.client), the plan resolves the proxy_ssl_* material
//! (trusted-certificate path and ssl_name, innermost level wins), and
//! the -t contract is STRICTER than nginx's with the deltas named:
//! an https target with no proxy_ssl_trusted_certificate is refused,
//! `proxy_ssl_verify off` is refused (lobo verifies ALWAYS),
//! `proxy_ssl_server_name off` is refused (SNI always rides). The
//! variable refusal and the unknown-scheme refusal stay.

use config
use proxy

fn conf_of(src: str) -> config.Conf {
    config.parse_str(src, "t.conf")
}

fn main() -> int {
    // --- https parses: scheme, authority, uri ---
    let c1 = conf_of(
        "http {{ server {{ listen 127.0.0.1:8080; location /api/ {{ proxy_pass https://up.example:9443/v2/; proxy_ssl_trusted_certificate /tmp/ca.pem; }} }} }}",
    )
    let t1 = proxy.parse_pass(c1, "https://up.example:9443/v2/")
    assert(t1.err.is_empty(), "https proxy_pass no longer refuses: {t1.err}")
    assert(t1.scheme == "https", "scheme carried")
    assert(t1.authority == "up.example:9443", "authority parsed")
    assert(t1.has_uri, "uri detected")
    assert(t1.uri == "/v2/", "uri kept")

    // the plan resolves the ssl material from the location
    let pl1 = proxy.plan(c1, "/api/x")
    assert(pl1.is_proxy, "plan is proxy")
    assert(pl1.pt.scheme == "https", "plan scheme https")
    assert(pl1.trust_path == "/tmp/ca.pem", "trust path resolved from location")
    assert(pl1.ssl_name.is_empty(), "no ssl_name override by default")

    // --- inheritance: server-level trusted cert + ssl_name reach the
    // location (innermost wins; here only the server level speaks) ---
    let c2 = conf_of(
        "http {{ server {{ listen 127.0.0.1:8080; proxy_ssl_trusted_certificate /srv/roots.pem; proxy_ssl_name up.internal; location /p/ {{ proxy_pass https://10.0.0.1:8443; }} }} }}",
    )
    let pl2 = proxy.plan(c2, "/p/x")
    assert(pl2.trust_path == "/srv/roots.pem", "trust path inherited from server")
    assert(pl2.ssl_name == "up.internal", "ssl_name inherited from server")

    // --- the -t contract (config.proxy_tls_check, pure half) ---
    // clean: https + trusted cert (+ the on-spellings) passes
    let ok1 = config.proxy_tls_check(c1)
    assert(ok1.is_empty(), "clean https config passes: {ok1}")
    let c3 = conf_of(
        "http {{ server {{ location /p/ {{ proxy_pass https://h:1; proxy_ssl_trusted_certificate /a.pem; proxy_ssl_verify on; proxy_ssl_server_name on; }} }} }}",
    )
    let ok2 = config.proxy_tls_check(c3)
    assert(ok2.is_empty(), "on-spellings pass: {ok2}")

    // missing trusted certificate: the named refusal (the delta from
    // nginx's verify-off default, said out loud)
    let c4 = conf_of("http {{ server {{ location /p/ {{ proxy_pass https://h:1; }} }} }}")
    let e1 = config.proxy_tls_check(c4)
    assert(e1.contains("proxy_ssl_trusted_certificate"), "missing anchors refused by name: {e1}")
    assert(
        e1.contains("verifies the upstream chain ALWAYS"),
        "the always-verify contract is stated",
    )

    // proxy_ssl_verify off: refused (no unverified mode)
    let c5 = conf_of(
        "http {{ server {{ location /p/ {{ proxy_pass https://h:1; proxy_ssl_trusted_certificate /a.pem; proxy_ssl_verify off; }} }} }}",
    )
    let e2 = config.proxy_tls_check(c5)
    assert(e2.contains("proxy_ssl_verify off"), "verify off refused by name: {e2}")

    // proxy_ssl_server_name off: refused (SNI always rides)
    let c6 = conf_of(
        "http {{ server {{ location /p/ {{ proxy_pass https://h:1; proxy_ssl_trusted_certificate /a.pem; proxy_ssl_server_name off; }} }} }}",
    )
    let e3 = config.proxy_tls_check(c6)
    assert(e3.contains("proxy_ssl_server_name off"), "server_name off refused by name: {e3}")

    // an http:// target owes none of this
    let c7 = conf_of("http {{ server {{ location /p/ {{ proxy_pass http://h:1; }} }} }}")
    assert(config.proxy_tls_check(c7).is_empty(), "plain http owes no ssl material")

    // --- the refusals that STAY ---
    let tvar = proxy.parse_pass(c7, "http://$backend")
    assert(!tvar.err.is_empty(), "variable form still refused")
    let tbad = proxy.parse_pass(c7, "ftp://h/")
    assert(tbad.err.contains("http:// or https://"), "unknown scheme refused, both named")

    print("pass_https ok")
    0
}
