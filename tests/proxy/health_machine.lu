//! check: run(exit=0, stdout="health ok\n")
//! phase: run
//! lanes: native checked lupin
//! conforms: err.union
//! stage-src: proxy http config
//!
//! Passive health as a PURE state machine — the clock is a parameter,
//! so every down/up transition is pinned WITHOUT wall time (the
//! contract's fake-clock option; no flakiness risk to name). nginx's
//! rule: once a peer reaches max_fails within fail_timeout it is down
//! until the window elapses from the last failure. All three lanes.

use proxy

fn main() -> int {
    // below max_fails → never down, whatever the clock
    assert(!proxy.peer_down(1, 1000, 3, 30000, 1000), "1<3 fails: up")
    assert(!proxy.peer_down(2, 1000, 3, 30000, 5000), "2<3 fails: up")

    // exactly max_fails, inside the window (last fail 1000, window
    // 30000 → down until 31000): at 5000 it is DOWN
    assert(proxy.peer_down(3, 1000, 3, 30000, 5000), "3 fails inside window: down")
    // at the window edge (31000) it is back UP (strict <)
    assert(!proxy.peer_down(3, 1000, 3, 30000, 31000), "window elapsed: up")
    assert(!proxy.peer_down(3, 1000, 3, 30000, 40000), "well past window: up")

    // more than max_fails, still inside the window → down
    assert(proxy.peer_down(9, 2000, 3, 10000, 5000), "9 fails inside window: down")

    // max_fails 0 disables the check (nginx: never down)
    assert(!proxy.peer_down(100, 1000, 0, 30000, 1001), "max_fails 0 disables")

    print("health ok")
    0
}
