//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//! stage-src: acme
//!
//! ws06 §2 material pins, the PURE half — the DER writers the CSR and
//! the harness CA build from, byte-exact against X.690/RFC 5280
//! vectors worked by hand. The encoder alone (no key, no store): the
//! store round trip and the crypto live in der_and_store. Native +
//! checked — the module's sibling flow.lu speaks net, so the whole
//! `acme` module is off the lupin lane (net has no sockets there);
//! the pure encoder would run on lupin in isolation, but a test
//! stages the whole module. If the pinned encoder ever drifts a
//! length or an OID byte, a signature or a certificate silently
//! corrupts — these are the guard.

use acme

fn eq(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    true
}

fn lit(bytes: List[byte]) -> List[byte] {
    bytes
}

fn main() -> int {
    // header lengths across the definite-length boundaries
    let h0 = acme.der_hdr(4, 0)
    assert(h0.len == 2 && h0[0] as int == 4 && h0[1] as int == 0, "0x04 0x00")
    assert(acme.der_hdr(4, 127)[1] as int == 127, "127 short form")
    let h128 = acme.der_hdr(4, 128)
    assert(h128[1] as int == 129 && h128[2] as int == 128, "128 -> 0x81 0x80")
    let h255 = acme.der_hdr(4, 255)
    assert(h255[1] as int == 129 && h255[2] as int == 255, "255 -> 0x81 0xff")
    let h256 = acme.der_hdr(4, 256)
    assert(
        h256[1] as int == 130 && h256[2] as int == 1 && h256[3] as int == 0,
        "256 -> 0x82 0x01 0x00",
    )

    // INTEGER minimality and the positivity pad
    var i0 = List[byte]()
    (mut i0).push(2 as byte)
    (mut i0).push(1 as byte)
    (mut i0).push(0 as byte)
    assert(eq(acme.der_int(0), i0), "INTEGER 0 = 02 01 00")
    var i127 = List[byte]()
    (mut i127).push(2 as byte)
    (mut i127).push(1 as byte)
    (mut i127).push(127 as byte)
    assert(eq(acme.der_int(127), i127), "INTEGER 127 = 02 01 7f")
    var i128 = List[byte]()
    (mut i128).push(2 as byte)
    (mut i128).push(2 as byte)
    (mut i128).push(0 as byte)
    (mut i128).push(128 as byte)
    assert(eq(acme.der_int(128), i128), "INTEGER 128 = 02 02 00 80 (sign pad)")
    var i256 = List[byte]()
    (mut i256).push(2 as byte)
    (mut i256).push(2 as byte)
    (mut i256).push(1 as byte)
    (mut i256).push(0 as byte)
    assert(eq(acme.der_int(256), i256), "INTEGER 256 = 02 02 01 00")

    // der_int_bytes: strip leading zeros, pad, all-zero -> 1
    var raw = List[byte]()
    (mut raw).push(0 as byte)
    (mut raw).push(0 as byte)
    (mut raw).push(200 as byte)
    var want = List[byte]()
    (mut want).push(2 as byte)
    (mut want).push(2 as byte)
    (mut want).push(0 as byte)
    (mut want).push(200 as byte)
    assert(eq(acme.der_int_bytes(raw), want), "0x0000c8 -> 02 02 00 c8")
    var zero = List[byte]()
    (mut zero).push(0 as byte)
    (mut zero).push(0 as byte)
    var one = List[byte]()
    (mut one).push(2 as byte)
    (mut one).push(1 as byte)
    (mut one).push(1 as byte)
    assert(eq(acme.der_int_bytes(zero), one), "all-zero serial -> INTEGER 1 (positivity)")

    // OID encoding: 1.3.101.112 (Ed25519) and 2.5.29.17 (SAN)
    let ed = acme.der_oid("1.3.101.112")
    var ed_want = List[byte]()
    (mut ed_want).push(6 as byte)
    (mut ed_want).push(3 as byte)
    (mut ed_want).push(43 as byte)
    (mut ed_want).push(101 as byte)
    (mut ed_want).push(112 as byte)
    assert(eq(ed, ed_want), "Ed25519 OID = 06 03 2b 65 70")
    let san = acme.der_oid("2.5.29.17")
    var san_want = List[byte]()
    (mut san_want).push(6 as byte)
    (mut san_want).push(3 as byte)
    (mut san_want).push(85 as byte)
    (mut san_want).push(29 as byte)
    (mut san_want).push(17 as byte)
    assert(eq(san, san_want), "SAN OID = 06 03 55 1d 11")
    // a multi-byte arc (the RSA extensionRequest OID's 113549)
    let big = acme.der_oid("1.2.840.113549.1.9.14")
    assert(big[0] as int == 6, "OID tag")
    assert(big[2] as int == 42, "first two arcs 1.2 -> 0x2a")
    // 840 = 0x86 0x48 in base-128
    assert(big[3] as int == 134 && big[4] as int == 72, "840 -> 0x86 0x48")

    // BIT STRING carries the zero-unused-bits prefix
    var key = List[byte]()
    (mut key).push(170 as byte)
    (mut key).push(187 as byte)
    let bs = acme.der_bitstring(key)
    assert(
        bs[0] as int == 3 &&
            bs[1] as int == 3 &&
            bs[2] as int == 0 &&
            bs[3] as int == 170 &&
            bs[4] as int == 187,
        "BIT STRING 03 03 00 aa bb",
    )

    // SEQUENCE/SET/OCTET tags
    var body = List[byte]()
    (mut body).push(1 as byte)
    assert(acme.der_seq(body)[0] as int == 48, "SEQUENCE tag 0x30")
    assert(acme.der_set(body)[0] as int == 49, "SET tag 0x31")
    assert(acme.der_octet(body)[0] as int == 4, "OCTET STRING tag 0x04")

    // the SPKI wraps alg + bitstring in a SEQUENCE
    var pk = List[byte]()
    var p = 0
    while p < 32 {
        (mut pk).push(p as byte)
        p = p + 1
    }
    let spki = acme.spki_ed25519(pk)
    assert(spki[0] as int == 48, "SPKI is a SEQUENCE")
    // last 35 bytes are the BIT STRING (03 21 00 <32 key bytes>)
    let at = spki.len - 35
    assert(
        spki[at] as int == 3 && spki[at + 1] as int == 33 && spki[at + 2] as int == 0,
        "SPKI key BIT STRING 03 21 00",
    )

    // the SAN extension value carries dNSName [2] entries (0x82)
    let sv = acme.san_names("a.test b.test")
    assert(sv[0] as int == 48, "GeneralNames SEQUENCE")
    assert(sv[2] as int == 130, "first name is dNSName context tag 0x82")

    let _ = lit(body)
    0
}
