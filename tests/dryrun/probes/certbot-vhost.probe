# certbot-vhost — lobo -t refuses this config since ws47 (lobo#38:
# `ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem` is absent, and nginx
# -t opens it for a server with a certificate and refuses the same
# config), so the dry-run predicts nothing: exit 1, nothing on stdout.
# Until ws46 this was the one https probe with --sni (the ws05
# selection answered offline); the args are kept so the refusal is
# the same request's. tests/config-corpus/INDEX.md names the class.
args: --request 'GET https://www.example.org/' --sni www.example.org
exit: 1
--- expect
