# flask-docs — ws41: "user" loads with nginx's own warning when lobo is unprivileged,
# so the dry-run predicts. Before ws41 lobo -t refused this config on "user"
# alone (tests/config-corpus/INDEX.md, the blocked table).
args: --request 'GET http://localhost/'
exit: 0
--- expect
== request: GET http://localhost/
listener: 127.0.0.1:18080
server: tests/config-corpus/flask-docs/conf.d/site.conf:1 [server_name _] — the first server block wins — server_name/Host selection is parse-only at this pin (a named delta)
location: / (tests/config-corpus/flask-docs/conf.d/site.conf:5)
  precedence: = exact > longest prefix (regex is parse-only at this pin and never wins)
  candidate location / (tests/config-corpus/flask-docs/conf.d/site.conf:5) — won: the longest matching prefix wins (1 bytes)
effective directives (the winning chain, with provenance):
  include       mime.types;  # from tests/config-corpus/flask-docs/nginx.conf:18
  default_type  application/octet-stream;  # from tests/config-corpus/flask-docs/nginx.conf:19
  log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';  # from tests/config-corpus/flask-docs/nginx.conf:21
  access_log  logs/access.log  main;  # from tests/config-corpus/flask-docs/nginx.conf:25
  sendfile        on;  # from tests/config-corpus/flask-docs/nginx.conf:27
  keepalive_timeout  65;  # from tests/config-corpus/flask-docs/nginx.conf:30
  include conf.d/*.conf;  # from tests/config-corpus/flask-docs/nginx.conf:34
  listen 18080;  # from tests/config-corpus/flask-docs/conf.d/site.conf:2 (via tests/config-corpus/flask-docs/nginx.conf:34)
  server_name _;  # from tests/config-corpus/flask-docs/conf.d/site.conf:3 (via tests/config-corpus/flask-docs/nginx.conf:34)
  proxy_pass http://127.0.0.1:8000/;  # from tests/config-corpus/flask-docs/conf.d/site.conf:6 (via tests/config-corpus/flask-docs/nginx.conf:34)
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # from tests/config-corpus/flask-docs/conf.d/site.conf:7 (via tests/config-corpus/flask-docs/nginx.conf:34)
  proxy_set_header X-Forwarded-Proto $scheme;  # from tests/config-corpus/flask-docs/conf.d/site.conf:8 (via tests/config-corpus/flask-docs/nginx.conf:34)
  proxy_set_header X-Forwarded-Host $host;  # from tests/config-corpus/flask-docs/conf.d/site.conf:9 (via tests/config-corpus/flask-docs/nginx.conf:34)
  proxy_set_header X-Forwarded-Prefix /;  # from tests/config-corpus/flask-docs/conf.d/site.conf:10 (via tests/config-corpus/flask-docs/nginx.conf:34)
  note: parsed but not implemented at this pin, so they do not shape this decision: `default_type`, `sendfile`, `keepalive_timeout`, `server_name` (statuses: docs/directives.md)
proxy headers (sent upstream):
  X-Forwarded-For: $proxy_add_x_forwarded_for -> UNRESOLVED (depends on the inbound X-Forwarded-For header)
  X-Forwarded-Proto: $scheme -> UNRESOLVED (this variable is outside the dry-run's knowledge)
  X-Forwarded-Host: localhost
  X-Forwarded-Prefix: /
decision: would proxy to http://127.0.0.1:8000/
