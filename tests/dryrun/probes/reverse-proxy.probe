  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # from tests/config-corpus/reverse-proxy/nginx.conf:24
  proxy_pass http://app_pool;  # from tests/config-corpus/reverse-proxy/nginx.conf:27
  proxy_http_version 1.1;  # from tests/config-corpus/reverse-proxy/nginx.conf:28
  proxy_set_header Connection "";  # from tests/config-corpus/reverse-proxy/nginx.conf:29
  proxy_connect_timeout 5s;  # from tests/config-corpus/reverse-proxy/nginx.conf:30
  proxy_read_timeout 60s;  # from tests/config-corpus/reverse-proxy/nginx.conf:31
