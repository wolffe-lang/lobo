# lobo.conf.in — the lobo side of the differential, rendered per case by
# tools/lobo-differential (@PORT@ and @ROOT@ substituted) into the
# case's scratch dir. Mirrors nginx.conf.in: the same one type, the
# same root, loopback only. lobo runs beside the pinned oracle and both
# replies go through the one differ (ws02).
http {
  types {
    text/html html;
  }
  server {
    listen 127.0.0.1:@PORT@;
    root @ROOT@/www;
    index index.html;
  }
}
