// head — HEAD returns the full 200 header block with ZERO body
// bytes (ws02 §2). Byte-identical to nginx modulo Server/Date.
--- request
HEAD /index.html HTTP/1.1
Host: 127.0.0.1
Connection: close

--- expect
HTTP/1.1 200 OK
Server: <normalized>
Date: <normalized>
Content-Type: text/html
Content-Length: 78
Last-Modified: Thu, 01 Jan 2026 00:00:00 GMT
Connection: close
ETag: "6955b900-4e"
Accept-Ranges: bytes

