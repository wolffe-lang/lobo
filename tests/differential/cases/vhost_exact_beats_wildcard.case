// vhost_exact_beats_wildcard — ws62 (px25's finding (a)): an exact name beats a wildcard that also matches. The case's
// `--- http` blocks join the template's http {} after its first
// server (tools/lobo-differential). Expected reply generated against
// the pinned nginx/1.30.4 with the corpus mtime 2026-01-01T00:00:00Z.
--- http
server { listen 127.0.0.1:@PORT@; server_name *.wild.test; root @ROOT@/www/w; }
server { listen 127.0.0.1:@PORT@; server_name x.wild.test; root @ROOT@/www/b; }
--- request
GET /index.html HTTP/1.1
Host: x.wild.test
Connection: close

--- expect
HTTP/1.1 200 OK
Server: <normalized>
Date: <normalized>
Content-Type: text/html
Content-Length: 74
Last-Modified: Thu, 01 Jan 2026 00:00:00 GMT
Connection: close
ETag: "6955b900-4a"
Accept-Ranges: bytes

<!doctype html>
<html><body>lobo differential vhost: b.test</body></html>
