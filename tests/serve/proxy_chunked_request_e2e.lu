//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//!
//! A CHUNKED REQUEST BODY ON A PROXIED ROUTE REACHES THE UPSTREAM
//! (lobo#137). A client sends `POST /up` with `Transfer-Encoding:
//! chunked` to a `proxy_pass` route, under `client_max_body_size 16`.
//! This test is the upstream, and it records what each proxy forwarded:
//! the request line, every `Content-Length` line, any
//! `Transfer-Encoding`, and the body's bytes (decoded when sent
//! chunked). It also records what the client was answered. Five
//! bodies, each sent whole, in this order:
//!   * `chunked`: `hello world` in two chunks;
//!   * `over`: 20 bytes in two chunks, over the limit;
//!   * `trailers`: `hello world` in two chunks, then a trailer field;
//!   * `pipelined`: the `chunked` body on a kept-alive connection, a
//!     `GET /r.html` in the same write after it;
//!   * `pipelined-file`: the same, its `POST` to the static file.
//! The same five go through the pinned nginx (the oracle,
//! tests/differential/bin/nginx) and lobo's debug tier, and lobo is held
//! to the oracle:
//!   * `proxy-chunked-body`: the upstream receives `hello world`;
//!   * `proxy-chunked-framing`: with the oracle's `Content-Length` and
//!     `Transfer-Encoding`;
//!   * `proxy-chunked-trailers`: the trailer case forwarded and
//!     answered as the oracle does;
//!   * `proxy-chunked-pipelined`: both pipelined cases answered as the
//!     oracle answers them, the request after the body among them;
//!   * `proxy-chunked-over`: the body over the limit refused and kept
//!     from the upstream as the oracle does.
//! Each proxy's forwarding in each case is printed as an `answered`
//! line whatever the outcome. A failure prints
//! `proxy_chunked_request: FAILED — [row]` with its reason, the
//! oracle's silence last. Each proxy is started on a probed port and
//! waited for until it serves its static file: 15 s a start, watched
//! for its exit, and a start that exits is retried on a new port (the
//! probe's release-to-rebind race), at most three starts. An oracle
//! that never serves, or answers a case with nothing, is
//! `proxy-chunked-oracle-silent`, with what each start did (its exit
//! code, or alive and silent) and the last lines of its error log, or
//! the case it left unanswered; lobo is then not compared with it, so
//! the oracle's silence is never read as lobo's difference. Then one assert (an assert's own message
//! is not in the record, wolf-lang#150). Every server is stopped by its
//! own handle. Loopback only, OS-chosen ports; the scratch trees are
//! cleared at the start and at the end.

fn free_port() -> int ! {io} {
    let l = net_listen("127.0.0.1:0") else |_| {
        return io
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return io
    }
    net_close(l) else |_| {}
    p
}

/// Print a named failure and keep it as `<row> <reason>`. Total.
fn note(mut fails: List[str], row: str, msg: str) {
    let one = msg.replace("\r", "\\r").replace("\n", "\\n")
    print("proxy_chunked_request: FAILED — [{row}] {one}")
    (mut fails).push("{row} {one}")
}

/// Whether `GET /r.html` on `port` answers 200 now: one connection, a
/// 500 ms read. Total.
fn serves(port: int) -> bool {
    let c = net_connect("127.0.0.1:{port}") else |_| { -1 }
    if c < 0 {
        return false
    }
    net_deadline(c, 500) else |_| {}
    net_write(c, "GET /r.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") else |_| {}
    let r = net_read(c, 4096) else |_| { "" }
    net_close(c) else |_| {}
    r.starts_with("HTTP/1.1 200 OK")
}

/// The last three lines of the oracle's error log, as ` (error log:
/// …)`; "" for lobo (its stderr is the row's) or an empty log. Total.
fn log_tail(kind: int, d: str) -> str {
    if kind != 0 {
        return ""
    }
    let text = fs_read_text("{d}/logs/ng.err") else |_| { "" }
    var lines = List[str]()
    for l in text.lines() {
        if !l.trim().is_empty() {
            (mut lines).push(l.trim())
        }
    }
    if lines.is_empty() {
        return ""
    }
    var out = ""
    var i = if lines.len > 3 { lines.len - 3 } else { 0 }
    while i < lines.len {
        out = if out.is_empty() { lines[i] } else { "{out} | {lines[i]}" }
        i = i + 1
    }
    " (error log: {out})"
}

/// Start one proxy and wait until it serves its static file. Each start
/// is on a newly probed port, given 15 s, and watched for its exit; a
/// start that exits is retried on a new port (the probe's
/// release-to-rebind race), at most three starts. `kind` 0 is the
/// oracle, 1 a lobo. Answers (the child's handle, its port, "") once it
/// serves, or (-1, 0, what each start did) when none did; a start that
/// stays alive and silent is put down by its handle. Total.
fn start(kind: int, bin: str, d: str, root: str, upp: int) -> (int, int, str) {
    var why = ""
    var k: int = 1
    while k <= 3 {
        let hp = free_port() else |_| { 0 }
        var argv = List[str]()
        (mut argv).push(bin)
        if kind == 0 {
            let conf = "daemon off;\nmaster_process off;\npid {root}/{d}/ng.pid;\nerror_log {root}/{d}/logs/ng.err;\nevents {{}}\nhttp {{\n  access_log off;\n  types {{ text/html html; }}\n  server {{\n    listen 127.0.0.1:{hp};\n    client_max_body_size 16;\n    location = /r.html {{ root {root}/{d}/w; }}\n    location / {{ proxy_pass http://127.0.0.1:{upp}; }}\n  }}\n}}\n"
            fs_write_text("{d}/ng.conf", conf) else |_| {}
            (mut argv).push("-p")
            (mut argv).push("{root}/{d}/")
            (mut argv).push("-c")
            (mut argv).push("{root}/{d}/ng.conf")
        } else {
            let conf = "pid {d}/lobo.pid;\nhttp {{\n  types {{ text/html html; }}\n  server {{\n    listen 127.0.0.1:{hp};\n    client_max_body_size 16;\n    location = /r.html {{ root {d}/w; }}\n    location / {{ proxy_pass http://127.0.0.1:{upp}; }}\n  }}\n}}\n"
            fs_write_text("{d}/lobo.conf", conf) else |_| {}
            (mut argv).push("serve")
            (mut argv).push("-p")
            (mut argv).push(".")
            (mut argv).push("-c")
            (mut argv).push("{d}/lobo.conf")
        }
        let child = os_spawn(argv) else |_| {
            return (-1, 0, "{why}start {k}: os_spawn failed (is {bin} there?)")
        }
        let t0 = time_now_ms()
        var gone = false
        var code: int = 0
        while !gone && time_now_ms() - t0 < 15000 {
            if serves(hp) {
                return (child, hp, "")
            }
            let w = os_wait_poll() else |_| { (0, 0) }
            if w.0 == child {
                gone = true
                code = w.1
            } else {
                time_sleep_ms(50)
            }
        }
        if !gone {
            os_kill(child) else |_| {}
            let _w = os_wait(child) else |_| { -1 }
            return (
                -1,
                0,
                "{why}start {k} on port {hp}: alive and silent for 15000 ms{log_tail(kind, d)}",
            )
        }
        why = "{why}start {k} on port {hp}: exited with code {code}{log_tail(kind, d)}; "
        k = k + 1
    }
    (-1, 0, why)
}

/// What one proxy forwarded to the upstream in one case.
struct Sent {
    kase: str,
    line: str,
    lengths: str,
    te: str,
    body: str,
    extra: str,
    reply: str,
}

/// The values of every header line named `name` (any case) in `head`,
/// joined by `,`; `none` when there is none. Total.
fn header_values(head: str, name: str) -> str {
    var out = ""
    let want = name.lower()
    for line in head.lines() {
        let at = line.find(":") else -1
        if at > 0 && line[0..at].lower() == want {
            let v = line[at + 1..line.len].trim()
            out = if out.is_empty() { v } else { "{out},{v}" }
        }
    }
    if out.is_empty() { "none" } else { out }
}

/// Decode a whole chunked body in `raw` (sizes in hex, no extensions
/// expected from a proxy); "" and false when it is not whole or not
/// chunked. Total.
fn dechunk(raw: str) -> (str, bool) {
    var out = ""
    var rest = raw
    loop {
        let nl = rest.find("\r\n") else -1
        if nl < 0 {
            return ("", false)
        }
        var n: int = 0
        for b_raw in rest[0..nl].bytes() {
            let b = b_raw as int
            var v = -1
            if b >= 48 && b <= 57 {
                v = b - 48
            } else if b >= 97 && b <= 102 {
                v = b - 87
            } else if b >= 65 && b <= 70 {
                v = b - 55
            }
            if v < 0 {
                return ("", false)
            }
            n = n * 16 + v
        }
        let from = nl + 2
        if n == 0 {
            return (out, true)
        }
        if rest.len < from + n + 2 {
            return ("", false)
        }
        out = "{out}{rest[from..from + n]}"
        rest = rest[from + n + 2..rest.len]
    }
}

/// The upstream's side: accept within `ms`, read the request's head,
/// its body by the framing the head declares, and whatever else comes
/// within 300 ms; answer `ok` and close. Total.
fn upstream(up: int, ms: int) -> Sent {
    var s = Sent { kase: "", line: "", lengths: "none", te: "none", body: "", extra: "", reply: "" }
    net_deadline(up, ms) else |_| {}
    let uc = net_accept(up) else |_| {
        s.line = "(no connection within {ms} ms)"
        return s
    }
    net_deadline(uc, 3000) else |_| {}
    var got = ""
    while !got.contains("\r\n\r\n") {
        let piece = net_read(uc, 4096) else |_| { "" }
        if piece.is_empty() {
            s.line = "(the head never ended: `{got}`)"
            net_close(uc) else |_| {}
            return s
        }
        got = "{got}{piece}"
    }
    let at = got.find("\r\n\r\n") else -1
    let head = got[0..at]
    var rest = got[at + 4..got.len]
    let first = head.find("\r\n") else -1
    s.line = if first < 0 { head } else { head[0..first] }
    s.lengths = header_values(head, "content-length")
    s.te = header_values(head, "transfer-encoding")
    // the body, as the head frames it, then anything more within 300 ms
    var want = -1
    if s.lengths != "none" {
        var n: int = 0
        var digits = true
        for b_raw in s.lengths.bytes() {
            let b = b_raw as int
            if digits && b >= 48 && b <= 57 {
                n = n * 10 + b - 48
            } else {
                digits = false
            }
        }
        want = n
    }
    let chunked = s.te.lower().contains("chunked")
    var done = false
    while !done {
        if want >= 0 && rest.len >= want {
            done = true
        } else if chunked && rest.ends_with("0\r\n\r\n") {
            done = true
        } else if want < 0 && !chunked {
            done = true
        } else {
            let piece = net_read(uc, 4096) else |_| { "" }
            if piece.is_empty() {
                done = true
            } else {
                rest = "{rest}{piece}"
            }
        }
    }
    if chunked {
        let d = dechunk(rest)
        s.body = if d.1 { d.0 } else { "(not a whole chunked body: `{rest}`)" }
    } else if want >= 0 && rest.len >= want {
        s.body = rest[0..want]
        s.extra = rest[want..rest.len]
    } else {
        s.extra = rest
    }
    net_deadline(uc, 300) else |_| {}
    let more = net_read(uc, 4096) else |_| { "" }
    s.extra = "{s.extra}{more}"
    net_write(uc, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok") else |_| {}
    net_close(uc) else |_| {}
    s
}

/// The five cases, in order: (name, the whole request). Total.
fn cases() -> List[(str, str)] {
    let h = "POST /up HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
    let ka = "Host: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    let next = "GET /r.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    [
        ("chunked", "{h}5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"),
        ("over", "{h}a\r\n0123456789\r\na\r\n0123456789\r\n0\r\n\r\n"),
        ("trailers", "{h}5\r\nhello\r\n6\r\n world\r\n0\r\nX-Sum: 11\r\n\r\n"),
        ("pipelined", "POST /up HTTP/1.1\r\n{ka}{next}"),
        ("pipelined-file", "POST /r.html HTTP/1.1\r\n{ka}{next}"),
    ]
}

/// The five cases through one proxy: `kind` 0 is the oracle, 1 a lobo.
/// Total: a proxy that does not start is a named failure.
fn through(mut fails: List[str], who: str, kind: int, bin: str) -> List[Sent] {
    var out = List[Sent]()
    let d = "proxy_chunked_request_{who}"
    fs_remove_dir_all(d) else |_| {}
    fs_create_dir_all("{d}/w") else |_| {}
    fs_create_dir_all("{d}/logs") else |_| {}
    fs_write_text("{d}/w/r.html", "READY\n") else |_| {}
    let root = os_cwd() else |_| "."
    let up = net_listen("127.0.0.1:0") else |_| {
        note(mut fails, "proxy-chunked-ready", "{who}: the upstream could not listen")
        return out
    }
    let upp = net_port(up) else |_| { 0 }
    let st = start(kind, bin, d, root, upp)
    let child = st.0
    let hp = st.1
    if child < 0 {
        if kind == 0 {
            note(
                mut fails,
                "proxy-chunked-oracle-silent",
                "the oracle never served its static file: {st.2}",
            )
        } else {
            note(mut fails, "proxy-chunked-ready", "{who} never served its static file: {st.2}")
        }
        net_close(up) else |_| {}
        fs_remove_dir_all(d) else |_| {}
        return out
    }
    for k in cases() {
        var s = Sent {
            kase: k.0,
            line: "",
            lengths: "none",
            te: "none",
            body: "",
            extra: "",
            reply: "",
        }
        let c = net_connect("127.0.0.1:{hp}") else |_| { -1 }
        if c < 0 {
            s.line = "(the proxy refused the client)"
        } else {
            net_write(c, k.1) else |_| {}
            let wait = if k.0 == "over" || k.0 == "pipelined-file" { 1500 } else { 3000 }
            s = upstream(up, wait)
            s.kase = k.0
            net_deadline(c, 3000) else |_| {}
            let r = net_read(c, 4096) else |_| { "" }
            let nl = r.find("\r\n") else -1
            s.reply = if nl < 0 { r } else { r[0..nl] }
            if k.0.starts_with("pipelined") {
                s.reply = status_lines(c, r)
            }
            net_close(c) else |_| {}
        }
        let after = s.extra.replace("\r", "\\r").replace("\n", "\\n")
        print(
            "proxy_chunked_request: {who} {s.kase}: forwarded `{s.line}`, Content-Length {s.lengths}, Transfer-Encoding {s.te}, body `{s.body}` ({s.body.len} bytes), after it `{after}`; the client was answered `{s.reply}`",
        )
        (mut out).push(s)
    }
    os_kill(child) else |_| {}
    let _w = os_wait(child) else |_| { -1 }
    net_close(up) else |_| {}
    fs_remove_dir_all(d) else |_| {}
    out
}

/// Every response a pipelined case was answered on its connection, read
/// to its close (the second request asks for it) or for three seconds:
/// each response's status line, joined by ` + `, and ` (READY)` when the
/// static file's body came. Total.
fn status_lines(c: int, first: str) -> str {
    var r = first
    var more = !first.is_empty()
    while more {
        let piece = net_read(c, 4096) else |_| { "" }
        if piece.is_empty() {
            more = false
        } else {
            r = "{r}{piece}"
        }
    }
    var out = ""
    for line in r.split("\r\n") {
        if line.starts_with("HTTP/") {
            out = if out.is_empty() { line } else { "{out} + {line}" }
        }
    }
    if r.contains("READY\n") {
        out = "{out} (READY)"
    }
    if out.is_empty() { "(no response)" } else { out }
}

/// The case `name` in `list`, or an empty one. Total.
fn pick(list: List[Sent], name: str) -> Sent {
    for s in list {
        if s.kase == name {
            return s
        }
    }
    Sent {
        kase: name,
        line: "(not run)",
        lengths: "none",
        te: "none",
        body: "",
        extra: "",
        reply: "",
    }
}

/// One case as the oracle comparison reads it. Total.
fn shape(s: Sent) -> str {
    "answered `{s.reply}`, upstream `{s.line}` Content-Length {s.lengths} Transfer-Encoding {s.te} body `{s.body}`"
}

fn main() -> !int {
    var fails = List[str]()
    let root = os_cwd() else |_| "."
    let oracle = "{root}/tests/differential/bin/nginx"
    let ng = through(mut fails, "nginx", 0, oracle)
    let lb = through(mut fails, "lobo", 1, "{root}/target/lobo-debug")
    let nc = pick(ng, "chunked")
    let lc = pick(lb, "chunked")
    let no = pick(ng, "over")
    let lo = pick(lb, "over")
    let np = pick(ng, "pipelined")
    let lp = pick(lb, "pipelined")
    let nf = pick(ng, "pipelined-file")
    let lf = pick(lb, "pipelined-file")
    let nt = pick(ng, "trailers")
    let lt = pick(lb, "trailers")
    // the oracle's silence is the oracle's fault: a case it answered with
    // nothing is named, and lobo is compared only with an oracle that
    // answered every case (a start that never served is named in
    // `through`)
    var heard = !ng.is_empty()
    for s in ng {
        if s.reply.is_empty() || s.reply == "(no response)" {
            heard = false
            note(
                mut fails,
                "proxy-chunked-oracle-silent",
                "the oracle answered `{s.kase}` with nothing within 3000 ms (its upstream saw `{s.line}`)",
            )
        }
    }
    if heard {
        check_against(mut fails, nc, lc, no, lo, np, lp, nf, lf, nt, lt)
    }
    if !lb.is_empty() && lc.body != "hello world" {
        note(
            mut fails,
            "proxy-chunked-body",
            "the upstream received `{lc.body}` ({lc.body.len} bytes) from lobo, for a chunked `hello world`",
        )
    }
    if fails.is_empty() {
        print(
            "proxy_chunked_request: ok — the oracle answered chunked: {shape(nc)}; over: {shape(no)}; trailers: {shape(nt)}; pipelined: {shape(np)}; to the file: {shape(nf)}; lobo the same",
        )
        return 0
    }
    let order = [
        "proxy-chunked-ready",
        "proxy-chunked-oracle",
        "proxy-chunked-over",
        "proxy-chunked-framing",
        "proxy-chunked-pipelined",
        "proxy-chunked-trailers",
        "proxy-chunked-body",
        "proxy-chunked-oracle-silent",
    ]
    var last = ""
    for r in order {
        var why = ""
        for f in fails {
            if why.is_empty() && f.starts_with("{r} ") {
                why = f[r.len + 1..f.len]
            }
        }
        if !why.is_empty() {
            last = "proxy_chunked_request: FAILED — [{r}] {why}"
            print(last)
        }
    }
    assert(false, "{last}")
    0
}

/// lobo held to an oracle that answered every case. Total.
fn check_against(
    mut fails: List[str],
    nc: Sent,
    lc: Sent,
    no: Sent,
    lo: Sent,
    np: Sent,
    lp: Sent,
    nf: Sent,
    lf: Sent,
    nt: Sent,
    lt: Sent,
) {
    if nc.body != "hello world" {
        note(
            mut fails,
            "proxy-chunked-oracle",
            "the oracle forwarded `{nc.body}`, not `hello world`",
        )
    }
    if shape(lo) != shape(no) {
        note(
            mut fails,
            "proxy-chunked-over",
            "over the limit, lobo {shape(lo)}; the oracle {shape(no)}",
        )
    }
    if lc.lengths != nc.lengths || lc.te != nc.te {
        note(
            mut fails,
            "proxy-chunked-framing",
            "lobo framed the body with Content-Length {lc.lengths}, Transfer-Encoding {lc.te}; the oracle with Content-Length {nc.lengths}, Transfer-Encoding {nc.te}",
        )
    }
    if shape(lp) != shape(np) || shape(lf) != shape(nf) {
        note(
            mut fails,
            "proxy-chunked-pipelined",
            "with a request after the body, lobo {shape(lp)}, to the file {shape(lf)}; the oracle {shape(np)}, to the file {shape(nf)}",
        )
    }
    if shape(lt) != shape(nt) {
        note(
            mut fails,
            "proxy-chunked-trailers",
            "with a trailer, lobo {shape(lt)}; the oracle {shape(nt)}",
        )
    }
}
