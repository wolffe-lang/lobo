//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//! stage-src: shell config obs
//!
//! ws27: THE WARM KIND TABLE, END TO END. Spawn the real lobo, serve a
//! file (200), then swap that path for a DIRECTORY under the server and
//! ask again inside the one-second window: the router still calls it a
//! file from memory, `serve_file` opens it, the handle says otherwise,
//! and the answer is 404 (the "swap under us" arm) — never a hang,
//! never a stale body. Past the window the router stats again, sees
//! the directory, and answers nginx's 301 to the slashed path. A path
//! deleted inside the window is 404 from the open. Loopback only,
//! OS-chosen ports, scratch cleared at START, the master stopped
//! through its desk and waited for.

use shell

fn free_port() -> int ! {io} {
    let l = net_listen("127.0.0.1:0") else |_| {
        return io
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return io
    }
    net_close(l) else |_| {}
    p
}

fn wait_alive(ep: str) -> bool {
    var i: int = 0
    while i < 120 {
        if shell.control_alive(ep) {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

fn ask(port: int, reqtext: str) -> str ! {io} {
    let c = net_connect("127.0.0.1:{port}") else |_| {
        return io
    }
    net_deadline(c, 3000) else |_| {
        net_close(c) else |_| {}
        return io
    }
    net_write(c, reqtext) else |_| {
        net_close(c) else |_| {}
        return io
    }
    var buf = ""
    var reading = true
    while reading {
        let piece = net_read(c, 4096) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    net_close(c) else |_| {}
    buf
}

fn get(port: int, path: str) -> str ! {io} {
    ask(port, "GET {path} HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
}

fn main() -> !int {
    let d = "ws27_fk_e2e"
    fs_remove_dir_all(d) else |_| {}
    fs_create_dir_all("{d}/w")?
    fs_write_text("{d}/w/a.html", "FILE-KINDS-A\n")?
    fs_write_text("{d}/w/gone.html", "FILE-KINDS-GONE\n")?

    let hp = free_port()?
    let cp = free_port()?
    let ep = "127.0.0.1:{cp}"
    let conf = "pid {d}/lobo.pid;\ncontrol 127.0.0.1:{cp};\nhttp {{\n  types {{ text/html html; }}\n  error_log {d}/error.log info;\n  server {{ listen 127.0.0.1:{hp}; root {d}/w; }}\n}}\n"
    fs_write_text("{d}/lobo.conf", conf)?

    var argv = List[str]()
    let root = os_cwd() else |_| "."
    (mut argv).push("{root}/target/lobo-debug")
    (mut argv).push("serve")
    (mut argv).push("-p")
    (mut argv).push(".")
    (mut argv).push("-c")
    (mut argv).push("{d}/lobo.conf")
    let child = os_spawn(argv) else |_| {
        assert(false, "os_spawn failed — is the debug tier built?")
        0
    }
    if !wait_alive(ep) {
        os_kill(child) else |_| {}
        let _ = os_wait(child) else |_| 0
        assert(false, "the spawned lobo never became alive")
    }

    // 1. the file serves, and its kind is now warm in this hand
    let r1 = get(hp, "/a.html")?
    assert(r1.starts_with("HTTP/1.1 200 OK"), "a.html serves: {r1}")
    assert(r1.contains("FILE-KINDS-A"), "the body: {r1}")
    let r1g = get(hp, "/gone.html")?
    assert(r1g.starts_with("HTTP/1.1 200 OK"), "gone.html serves first: {r1g}")

    // 2. the swap, inside the window: the path is a directory now;
    //    memory says file, the open succeeds, the handle says
    //    directory → 404, the swap-under-us arm, no hang
    fs_remove("{d}/w/a.html")?
    fs_create_dir_all("{d}/w/a.html")?
    let r2 = get(hp, "/a.html")?
    assert(
        r2.starts_with("HTTP/1.1 404 Not Found"),
        "inside the window a swapped path is 404: {r2}",
    )

    // 3. a deletion inside the window: the open answers not_found → 404
    fs_remove("{d}/w/gone.html")?
    let r3 = get(hp, "/gone.html")?
    assert(r3.starts_with("HTTP/1.1 404 Not Found"), "a deleted file is 404 from the open: {r3}")

    // 4. past the window the router stats again and sees the directory:
    //    nginx's 301 to the slashed path
    time_sleep_ms(1100)
    let r4 = get(hp, "/a.html")?
    assert(
        r4.starts_with("HTTP/1.1 301 Moved Permanently"),
        "past the window the directory redirects: {r4}",
    )

    let rq = shell.control_send(ep, "quit") else |_| {
        os_kill(child) else |_| {}
        assert(false, "control quit failed")
        ""
    }
    assert(rq.contains("draining then exiting"), "quit announces: {rq}")
    let code = os_wait(child) else |_| -1
    assert(code == 0, "lobo exited 0 (got {code})")
    fs_remove_dir_all(d) else |_| {}
    0
}
