//! check: run(exit=0, stdout="status=HTTP/1.1 200 OK\nct=application/octet-stream\nclen=7\nbody-len=7\nbody-ok=true")
//! phase: run
//! lanes: native checked
//! conforms: err.union, err.propagate
//! stage-src: serve conn tls proxy http config obs
//!
//! serve/ static GET of a BINARY file (wsm01 — s115's net byte path,
//! wolf-lang#137 delivered; deferral D8's "a binary static file is
//! not representable" retires here). The doc-root file carries bytes
//! no UTF-8 decoder accepts (0x00, 0x89, 0xFF): the old str-tier body
//! path 500'd reading it; the byte path serves it verbatim. The
//! client reads the reply through `net_read_bytes` (no utf8 row — a
//! lone 0x80 is data) and byte-compares the body. net + fs → native +
//! checked. Scratch cleared at the START (sc12 idempotency).

use config
use http
use serve

/// Read the whole reply as BYTES until the peer closes.
fn read_reply_bytes(cli: int) -> List[int] ! {io} {
    net_deadline(cli, 2000) else |_| {
        return io
    }
    var out = List[int]()
    var more = true
    while more {
        var bad = false
        let piece = net_read_bytes(cli, 4096) else |e| match e {
            closed => {
                more = false
                List[int]()
            },
            timeout => {
                bad = true
                List[int]()
            },
            io => {
                bad = true
                List[int]()
            },
        }
        if bad {
            return io
        }
        for b in piece {
            (mut out).push(b)
        }
    }
    out
}

/// The byte offset just past the head's CRLFCRLF, or -1.
fn body_start(raw: List[int]) -> int {
    var i: int = 0
    let n = raw.len
    while i + 3 < n {
        if raw[i] == 13 && raw[i + 1] == 10 && raw[i + 2] == 13 && raw[i + 3] == 10 {
            return i + 4
        }
        i = i + 1
    }
    -1
}

/// The head (ASCII by protocol) as a str: bytes 0..`end` decoded.
fn head_str(raw: List[int], end: int) -> str {
    var hb = List[int]()
    var i: int = 0
    while i < end {
        (mut hb).push(raw[i])
        i = i + 1
    }
    str_from_utf8(hb) else |_| { "" }
}

fn header_val(headers: str, name: str) -> str {
    for line in headers.lines() {
        let colon = line.find(": ") else -1
        if colon > 0 {
            let hn = line[0..colon]
            if hn == name {
                return line[colon + 2..line.len]
            }
        }
    }
    ""
}

fn main() -> !int {
    let root = "wsm01_sb"
    fs_remove_dir_all(root) else |_| {}
    fs_create_dir_all(root)?

    // 7 bytes, three of them illegal in UTF-8 anywhere: a NUL, a bare
    // continuation, and 0xFF (a never-byte).
    var blob = List[int]()
    (mut blob).push(137)
    (mut blob).push(80)
    (mut blob).push(78)
    (mut blob).push(71)
    (mut blob).push(0)
    (mut blob).push(255)
    (mut blob).push(10)
    fs_write_bytes("{root}/blob.bin", blob)?

    let src = "http {{\n  types {{ application/octet-stream bin; }}\n  server {{ root wsm01_sb; }}\n}}\n"
    let c = config.parse_str(src, "t.conf")
    let opts = serve.default_opts()
    let lim = http.default_limits()

    let l = net_listen("127.0.0.1:0")?
    let port = net_port(l)?
    let cli = net_connect("127.0.0.1:{port}")?
    net_write(cli, "GET /blob.bin HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
    let conn = net_accept(l)?
    serve.serve_conn(conn, c, opts, lim, port)
    let reply = read_reply_bytes(cli)?
    net_close(l) else |_| {}

    let cut = body_start(reply)
    assert(cut > 0, "no CRLFCRLF in the reply")
    let head = head_str(reply, cut - 4)
    let eol = head.find("\r\n") else head.len
    print("status={head[0..eol]}")
    var headers = ""
    if eol < head.len {
        headers = head[eol + 2..head.len]
    }
    print("ct={header_val(headers, "Content-Type")}")
    print("clen={header_val(headers, "Content-Length")}")
    print("body-len={reply.len - cut}")
    var ok = reply.len - cut == 7
    var i: int = 0
    while ok && i < 7 {
        if reply[cut + i] != blob[i] {
            ok = false
        }
        i = i + 1
    }
    print("body-ok={ok}")
    fs_remove_dir_all(root) else |_| {}
    0
}
