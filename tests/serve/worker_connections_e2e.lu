//! check: run(exit=0)
//! phase: run
//! lanes: native checked
//! stage-src: shell config
//!
//! ws64 (lobo#84): `worker_connections`, APPLIED — a live lobo under
//! `events { worker_connections 16; }` with one `listen` does at its
//! limit what the pinned nginx 1.30.4 does at its own (measured,
//! notes/ws64-contract.md §2; through ws63 the directive was parsed
//! and never read, and 24 of 24 slow downloads were served):
//!   A. 24 connections that send nothing: lobo holds 14 (16 less the
//!      listening socket less one) and closes the least recently used
//!      idle ones to make room — the FIRST ELEVEN, exactly nginx's
//!      count — logging `[warn] 16 worker_connections are not enough,
//!      reusing connections`;
//!   B. 14 slow downloads are all served; with none idle, each of five
//!      more connections is accepted and closed at once with `[alert]
//!      16 worker_connections are not enough`, one line each; `status`
//!      answers beside them; and when the downloads end a GET is
//!      served;
//!   C. a reload to `worker_connections 64` applies to the running
//!      process: the same 24 idle connections all stay open.
//! The same counts against the oracle itself are `tools/lobo-shell`'s
//! rows; the rule alone is tests/shell/conn_limit.lu. Against the real
//! binary (os_spawn + net + fs → native+checked). Loopback only,
//! OS-chosen ports; scratch under target/, cleared at START.

use shell

fn free_port() -> int ! {io} {
    let l = net_listen("127.0.0.1:0") else |_| {
        return io
    }
    let p = net_port(l) else |_| {
        net_close(l) else |_| {}
        return io
    }
    net_close(l) else |_| {}
    p
}

fn wait_alive(ep: str) -> bool {
    var i: int = 0
    while i < 200 {
        if shell.control_alive(ep) {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

/// One GET /index.html on a fresh connection: the reply, or "". Total.
fn fetch(port: int, ms: int) -> str {
    let c = net_connect("127.0.0.1:{port}") else |_| {
        return ""
    }
    net_deadline(c, ms) else |_| {}
    net_write(c, "GET /index.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") else |_| {
        net_close(c) else |_| {}
        return ""
    }
    var buf = ""
    var reading = true
    while reading {
        let piece = net_read(c, 4096) else |_| {
            reading = false
            ""
        }
        if piece.is_empty() {
            reading = false
        } else {
            buf = "{buf}{piece}"
        }
    }
    net_close(c) else |_| {}
    buf
}

/// What the server has done with connection `c`: 0 it is open and
/// silent, 1 the server closed it (end-of-stream or a reset), 2 it
/// sent bytes. Reads what is there. Total.
fn peer_state(c: int) -> int {
    var one = List[int]()
    (mut one).push(c)
    let ready = net_wait(one, 0) else |_| {
        List[int]()
    }
    if ready.len == 0 {
        return 0
    }
    var gone = false
    let b = net_read_bytes(c, 2048) else |_| {
        gone = true
        List[byte]()
    }
    if gone || b.len == 0 {
        return 1
    }
    2
}

/// How many lines of the file at `path` contain `need`. Total.
fn lines_with(path: str, need: str) -> int {
    let t = fs_read_text(path) else |_| { "" }
    var n: int = 0
    for line in t.lines() {
        if line.contains(need) {
            n = n + 1
        }
    }
    n
}

/// Wait up to ~5 s for `want` lines of `path` to carry `need`. Total.
fn wait_lines(path: str, need: str, want: int) -> bool {
    var i: int = 0
    while i < 100 {
        if lines_with(path, need) >= want {
            return true
        }
        time_sleep_ms(50)
        i = i + 1
    }
    false
}

fn put_down(h: int) {
    os_kill(h) else |_| {}
    let _ = os_wait(h) else |_| {
        0
    }
}

fn close_all(cs: List[int]) {
    for c in cs {
        net_close(c) else |_| {}
    }
}

/// `n` connections that send nothing, opened one after another. Total.
fn open_idle(port: int, n: int) -> List[int] {
    var cs = List[int]()
    var k: int = 0
    while k < n {
        let c = net_connect("127.0.0.1:{port}") else |_| { -1 }
        if c >= 0 {
            (mut cs).push(c)
        }
        k = k + 1
    }
    cs
}

/// "0110…": one digit a connection, 1 where the server closed it.
/// Total.
fn closed_map(cs: List[int]) -> str {
    var m = ""
    for c in cs {
        let s = if peer_state(c) == 1 { "1" } else { "0" }
        m = "{m}{s}"
    }
    m
}

/// One connection asking for the big file and reading nothing past
/// its first bytes: (handle, what came back: 2 a body began, 1 closed
/// with nothing, 0 nothing inside 5 s). Total.
fn open_download(port: int) -> (int, int) {
    let c = net_connect("127.0.0.1:{port}") else |_| {
        return (-1, 1)
    }
    net_deadline(c, 5000) else |_| {}
    net_write(c, "GET /big.bin HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") else |_| {
        return (c, 1)
    }
    var gone = false
    var late = false
    let b = net_read_bytes(c, 2048) else |e| match e {
        timeout => {
            late = true
            List[byte]()
        },
        closed => {
            gone = true
            List[byte]()
        },
        io => {
            gone = true
            List[byte]()
        },
    }
    if late {
        return (c, 0)
    }
    if gone || b.len == 0 {
        return (c, 1)
    }
    (c, 2)
}

fn main() -> !int {
    let root = os_cwd() else |_| "."
    let d = "{root}/target/ws64_wconn"
    fs_remove_dir_all(d) else |_| {}
    fs_create_dir_all("{d}/www")?
    fs_write_text("{d}/www/index.html", "small-page\n")?
    var mk = List[str]()
    (mut mk).push("/bin/sh")
    (mut mk).push("-c")
    (mut mk).push("head -c 25165824 /dev/zero | tr '\\000' w > \"$1\"")
    (mut mk).push("sh")
    (mut mk).push("{d}/www/big.bin")
    let mh = os_spawn(mk)?
    let mrc = os_wait(mh)?
    assert(mrc == 0, "the 24 MiB file is written")
    let bin = env_get("LOBO_BIN") else |_| { "{root}/target/lobo-debug" }
    let hp = free_port()?
    let cp = free_port()?
    let ep = "127.0.0.1:{cp}"
    let conf = "{d}/lobo.conf"
    let body = "http {{\n  types {{ text/html html; application/octet-stream bin; }}\n  server {{ listen 127.0.0.1:{hp}; root {d}/www; }}\n}}\n"
    fs_write_text(
        conf,
        "pid {d}/lobo.pid;\ncontrol {ep};\nevents {{ worker_connections 16; }}\n{body}",
    )?
    let so_p = "{d}/server.out"
    let so = fs_create(so_p)?
    var args = List[str]()
    (mut args).push("serve")
    (mut args).push("-p")
    (mut args).push(".")
    (mut args).push("-c")
    (mut args).push(conf)
    var map = List[int]()
    (mut map).push(1)
    (mut map).push(so)
    (mut map).push(2)
    (mut map).push(so)
    let h = os_spawn_fds(bin, args, map) else |_| { -1 }
    assert(h >= 0, "the server spawned")
    if !wait_alive(ep) {
        put_down(h)
        assert(false, "the server never answered on {ep}")
    }

    print("A: 24 idle connections at worker_connections 16")
    let idle = open_idle(hp, 24)
    time_sleep_ms(500)
    let m = closed_map(idle)
    close_all(idle)
    if !(m == "111111111110000000000000") {
        put_down(h)
        assert(
            false,
            "the first eleven of 24 idle connections are closed to make room, nginx's count and nginx's choice: [{m}] (trunk: none)",
        )
    }
    if !wait_lines(so_p, "[warn] 16 worker_connections are not enough, reusing connections", 1) {
        put_down(h)
        assert(false, "the reuse is logged, nginx's [warn]")
    }
    if lines_with(so_p, "[alert]") != 0 {
        put_down(h)
        assert(false, "no connection was refused while idle ones could make room")
    }
    time_sleep_ms(300)

    print("B: 14 slow downloads, then five more connections")
    var dl = List[int]()
    var started: int = 0
    var k: int = 0
    while k < 14 {
        let r = open_download(hp)
        if r.0 >= 0 {
            (mut dl).push(r.0)
        }
        if r.1 == 2 {
            started = started + 1
        }
        k = k + 1
    }
    if started != 14 {
        close_all(dl)
        put_down(h)
        assert(false, "fourteen downloads are served at worker_connections 16: {started}")
    }
    var refused: int = 0
    k = 0
    while k < 5 {
        let r = open_download(hp)
        if r.1 == 1 {
            refused = refused + 1
        }
        if r.0 >= 0 {
            net_close(r.0) else |_| {}
        }
        k = k + 1
    }
    let t0 = time_unix_ms()
    let st = shell.control_fetch(ep, "status") else |_| { "" }
    let st_ms = time_unix_ms() - t0
    if refused != 5 {
        close_all(dl)
        put_down(h)
        assert(
            false,
            "past the limit with none idle a connection is closed at once: {refused} of 5 (trunk: every one served)",
        )
    }
    if !wait_lines(so_p, "[alert] 16 worker_connections are not enough", 5) ||
        lines_with(so_p, "[alert] 16 worker_connections are not enough") != 5 {
        close_all(dl)
        put_down(h)
        assert(false, "one [alert] line a refused connection: {lines_with(so_p, "[alert]")}")
    }
    if !st.contains("current generation: 1") || st_ms > 1000 {
        close_all(dl)
        put_down(h)
        assert(false, "`status` answers at the limit: {st_ms} ms [{st}]")
    }
    close_all(dl)
    var back = false
    let t_back = time_unix_ms()
    while !back && time_unix_ms() - t_back < 5000 {
        back = fetch(hp, 1000).contains("small-page")
    }
    if !back {
        put_down(h)
        assert(false, "with the downloads gone a GET is served")
    }

    print("C: reload to worker_connections 64")
    fs_write_text(
        conf,
        "pid {d}/lobo.pid;\ncontrol {ep};\nevents {{ worker_connections 64; }}\n{body}",
    )?
    let rl = shell.control_fetch(ep, "reload") else |_| { "" }
    if !rl.contains("reload complete (generation 2)") {
        put_down(h)
        assert(false, "the reload takes: [{rl}]")
    }
    let idle2 = open_idle(hp, 24)
    time_sleep_ms(500)
    let m2 = closed_map(idle2)
    close_all(idle2)
    if !(m2 == "000000000000000000000000") {
        put_down(h)
        assert(false, "after the reload the limit is 64: 24 idle connections all stay open: [{m2}]")
    }
    let stop = shell.control_fetch(ep, "stop") else |_| { "" }
    if !stop.contains("stop") {
        put_down(h)
        assert(false, "`stop` is answered: [{stop}]")
    }
    let rc = os_wait(h) else |_| { -1 }
    fs_close(so) else |_| {}
    assert(rc == 0, "the server exits 0 on stop: {rc}")
    fs_remove_dir_all(d) else |_| {}
    0
}
