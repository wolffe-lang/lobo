//! check: run(exit=0, stdout="intact=10\nnodelay_default=on nodelay_off=off\n")
//! phase: run
//! lanes: native
//! conforms: conc.task.spawn, err.union, err.propagate
//! stage-src: serve budget conn tls proxy http config obs metrics resolver
//!
//! ws24 (wolf-lang#254 at the pin): a small static response is ONE
//! GATHERED write — `net_writev` over the head's bytes and the body,
//! no copy, on every size the small path serves. ws23's `one_write`
//! rule copied the body behind the head up to 64 KiB on keepalive and
//! up to 4 KiB on close, and wrote twice above that; the rule is
//! retired, so the arm's branch structure changed on BOTH sides of
//! each old bound. The witness is the bytes: four files at the
//! bounds' edges (4095, 4097, 65536 — the small path's last byte —
//! and 65537, the first streamed one) served on the close shape and
//! the keepalive shape, every response read whole and compared to
//! the file, byte for byte, through the served head's Content-Length.
//! The second line is `tcp_nodelay` resolved through
//! `serve.resolve_limits`: absent is the runtime's default (on), and
//! `off` is the one value that reaches an accept site. Native only:
//! net + fs + a spawned server task meet on no other lane.
//!
//! ws25 (wolf-lang#261 consumed): a fifth file, EMPTY — the small
//! arm now reads exactly the size `fs_fstat` answered off the handle
//! it opened (`serve.read_exact`), and zero is the edge where a read
//! answers `eof` before a byte: served as `Content-Length: 0` on both
//! shapes, the head intact, no body.

use config
use http
use serve

fn recv_one(cli: int) -> str ! {io} {
    var buf = ""
    loop {
        let cut = buf.find("\r\n\r\n") else -1
        if cut >= 0 {
            let head = buf[0..cut]
            let clh = header_len(head)
            let body_start = cut + 4
            while buf.len < body_start + clh {
                let piece = net_read(cli, 65536) else |_| {
                    return io
                }
                buf = "{buf}{piece}"
            }
            return buf[0..body_start + clh]
        }
        let piece = net_read(cli, 65536) else |_| {
            return io
        }
        buf = "{buf}{piece}"
    }
}

fn header_len(head: str) -> int {
    for line in head.lines() {
        let low = line.lower()
        if low.starts_with("content-length:") {
            let v = line[15..line.len]
            let t = v.trim()
            var n: int = 0
            for b_raw in t.bytes() {
                let b = b_raw as int
                if b >= 48 && b <= 57 {
                    n = n * 10 + b - 48
                }
            }
            return n
        }
    }
    0
}

/// A body of exactly `n` bytes whose content depends on its offset,
/// so a dropped or duplicated segment cannot compare equal.
fn body_of(n: int) -> str {
    var s = ""
    var i = 0
    while s.len < n {
        let line = "{i} abcdefghijklmnopqrstuvwxyz0123456789 the quick brown fox\n"
        s = "{s}{line}"
        i = i + 1
    }
    s[0..n]
}

fn main() -> !int {
    let root = "ws24_writev"
    fs_remove_dir_all(root) else |_| {}
    fs_create_dir_all("{root}/www")?
    var sizes = List[int]()
    (mut sizes).push(4095)
    (mut sizes).push(4097)
    (mut sizes).push(65536)
    (mut sizes).push(65537)
    (mut sizes).push(0)
    var bodies = List[str]()
    var k = 0
    while k < sizes.len {
        let b = body_of(sizes[k])
        fs_write_text("{root}/www/f{k}.html", b)?
        (mut bodies).push(b)
        k = k + 1
    }
    let src = "http {{\n  types {{ text/html html; }}\n  server {{ root ws24_writev/www; }}\n}}\n"
    let c = config.parse_str(src, "t.conf")
    let opts = serve.default_opts()
    let lim = http.default_limits()

    let l = net_listen("127.0.0.1:0")?
    let port = net_port(l)?
    var intact = 0
    scope s {
        // one serving task per connection, five connections: four on
        // the close shape, one keepalive carrying all four
        s.spawn(fn() {
            var served = 0
            while served < sizes.len + 1 {
                let conn = net_accept(l) else |_| -1
                if conn >= 0 {
                    serve.serve_conn(conn, c, opts, lim, port)
                }
                served = served + 1
            }
        })
        var i = 0
        while i < sizes.len {
            let cli = net_connect("127.0.0.1:{port}")?
            net_deadline(cli, 5000)?
            net_write(cli, "GET /f{i}.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
            let r = recv_one(cli)?
            if r.starts_with("HTTP/1.1 200 OK") && r.ends_with(bodies[i]) {
                if sizes[i] > 0 || r.contains("\r\nContent-Length: 0\r\n") {
                    intact = intact + 1
                }
            }
            net_close(cli) else |_| {}
            i = i + 1
        }
        let ka = net_connect("127.0.0.1:{port}")?
        net_deadline(ka, 5000)?
        var j = 0
        while j < sizes.len {
            net_write(ka, "GET /f{j}.html HTTP/1.1\r\nHost: x\r\n\r\n")?
            let r = recv_one(ka)?
            if r.starts_with("HTTP/1.1 200 OK") && r.ends_with(bodies[j]) {
                if sizes[j] > 0 || r.contains("\r\nContent-Length: 0\r\n") {
                    intact = intact + 1
                }
            }
            j = j + 1
        }
        net_write(ka, "GET /f0.html HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
        let last = recv_one(ka)?
        assert(last.starts_with("HTTP/1.1 200 OK"), "closing request served")
        net_close(ka) else |_| {}
    }
    net_close(l) else |_| {}
    fs_remove_dir_all(root) else |_| {}
    print("intact={intact}")

    let lim_default = serve.resolve_limits(c)
    let c_off = config.
        parse_str(
        "http {{\n  tcp_nodelay off;\n  server {{ root ws24_writev/www; }}\n}}\n",
        "t.conf",
    )
    let lim_off = serve.resolve_limits(c_off)
    let d = if lim_default.nodelay { "on" } else { "off" }
    let o = if lim_off.nodelay { "on" } else { "off" }
    print("nodelay_default={d} nodelay_off={o}")
    0
}
