//! check: run(exit=0)
//! phase: run
//! lanes: native
//! stage-src: config
//!
//! ws05 §2: the ssl_* config subset resolves and every refusal is
//! NAMED — the honest-scope posture (a cert wws cannot validate is a
//! config error, never a silent accept). Drives config.ssl_resolve
//! over the checked-in TEST fixtures (tests/tls/fixtures — marked
//! TEST there): the clean fullchain pair, the RSA key refusal, the
//! pair mismatch, the reordered fullchain (leaf-first named with the
//! reorder), the missing-cert error, the absent-file error, the
//! protocol honesty set, and SNI entry selection with default_server.
//! Lane: NATIVE only — the fs half rules lupin out, and the checked
//! tier's step budget is exhausted by curve25519.public (the Ed25519
//! keygen inside the pair check), measured at this pin: the miri-lite
//! answers `unsupported — step budget exhausted`, so declaring the
//! lane would pin a refusal, not a run. The rig runs every lane at
//! the repo root, so fixture paths are repo-relative.

use config

fn conf_of(body: str) -> config.Conf {
    config.parse_str(body, "ssl_resolve_errors.test")
}

fn srv_block(extra: str) -> str {
    "events {{\n}}\nhttp {{\n    server {{\n        listen 127.0.0.1:0 ssl;\n{extra}    }}\n}}\n"
}

fn pair_block(cert: str, key: str) -> str {
    srv_block(
        "        server_name localhost;\n        ssl_certificate {cert};\n        ssl_certificate_key {key};\n",
    )
}

fn main() -> int {
    let fx = "tests/tls/fixtures"

    // 1. the clean pair: resolves, one entry, selection lands on it
    let good = config.ssl_resolve(conf_of(pair_block("{fx}/fullchain.pem", "{fx}/leaf.key")), ".")
    assert(config.ssl_ok(good), "clean pair resolves: {good.err}")
    assert(good.on, "ssl is on")
    assert(good.names.len == 1, "one entry")
    assert(good.leaf_n[0] > 0, "leaf length recorded")
    assert(good.der_n[0] > good.leaf_n[0], "the chain carries the CA above the leaf")
    assert(good.seed.len == 32, "one 32-byte seed")
    assert(good.default_at == 0, "the only entry is the default")
    assert(config.ssl_select(good, "localhost") == 0, "SNI exact match")
    assert(config.ssl_select(good, "LOCALHOST") == 0, "SNI match is case-insensitive")
    assert(config.ssl_select(good, "") == 0, "no-SNI clients get the default entry")
    assert(config.ssl_select(good, "unknown.example") == 0, "unmatched SNI falls to the default")

    // 2. an RSA key is a NAMED refusal citing the ladder
    let rsa = config.ssl_resolve(conf_of(pair_block("{fx}/fullchain.pem", "{fx}/rsa.key")), ".")
    assert(!config.ssl_ok(rsa), "rsa key refused")
    assert(rsa.err.contains("rsa"), "the refusal names the algorithm: {rsa.err}")
    assert(rsa.err.contains("Ed25519 only"), "the refusal names the scope: {rsa.err}")

    // 3. a pair mismatch is named as the public-key comparison
    let mm = config.ssl_resolve(conf_of(pair_block("{fx}/fullchain.pem", "{fx}/other.key")), ".")
    assert(!config.ssl_ok(mm), "mismatched pair refused")
    assert(mm.err.contains("does not match"), "mismatch named: {mm.err}")

    // 4. the reordered fullchain names the reorder, not a bare mismatch
    let ro = config.ssl_resolve(conf_of(pair_block("{fx}/reordered.pem", "{fx}/leaf.key")), ".")
    assert(!config.ssl_ok(ro), "reordered chain refused")
    assert(ro.err.contains("not leaf-first"), "reorder named: {ro.err}")
    assert(ro.err.contains("entry 2"), "the matching entry is located: {ro.err}")

    // 5. an ssl listen with no certificate
    let nc = config.ssl_resolve(conf_of(srv_block("")), ".")
    assert(!config.ssl_ok(nc), "ssl listen without a cert refused")
    assert(nc.err.contains("no \"ssl_certificate\""), "missing cert named: {nc.err}")

    // 6. a certificate path that does not exist
    let nf = config.ssl_resolve(conf_of(pair_block("{fx}/nope.pem", "{fx}/leaf.key")), ".")
    assert(!config.ssl_ok(nf), "missing file refused")
    assert(nf.err.contains("no such file"), "missing file named: {nf.err}")

    // 7. protocol honesty: 1.2+1.3 warns and passes, 1.2-only errors
    let both = config.
        ssl_resolve(
        conf_of(
            srv_block(
                "        ssl_certificate {fx}/fullchain.pem;\n        ssl_certificate_key {fx}/leaf.key;\n        ssl_protocols TLSv1.2 TLSv1.3;\n",
            ),
        ),
        ".",
    )
    assert(config.ssl_ok(both), "1.2+1.3 passes: {both.err}")
    assert(both.warns.contains("TLSv1.2"), "the 1.2 delta is warned: {both.warns}")
    let only12 = config.
        ssl_resolve(
        conf_of(
            srv_block(
                "        ssl_certificate {fx}/fullchain.pem;\n        ssl_certificate_key {fx}/leaf.key;\n        ssl_protocols TLSv1.2;\n",
            ),
        ),
        ".",
    )
    assert(!config.ssl_ok(only12), "1.2-only is refused")
    assert(only12.err.contains("does not include TLSv1.3"), "named: {only12.err}")

    // 8. two servers: SNI selects by server_name; default_server wins
    // the no-SNI slot
    let two = "events {{\n}}\nhttp {{\n    server {{\n        listen 127.0.0.1:0 ssl;\n        server_name a.example;\n        ssl_certificate {fx}/fullchain.pem;\n        ssl_certificate_key {fx}/leaf.key;\n    }}\n    server {{\n        listen 127.0.0.1:0 ssl default_server;\n        server_name b.example;\n        ssl_certificate {fx}/fullchain.pem;\n        ssl_certificate_key {fx}/leaf.key;\n    }}\n}}\n"
    let ts = config.ssl_resolve(conf_of(two), ".")
    assert(config.ssl_ok(ts), "two-server model resolves: {ts.err}")
    assert(ts.names.len == 2, "two entries")
    assert(ts.default_at == 1, "default_server marks the default entry")
    assert(config.ssl_select(ts, "a.example") == 0, "SNI picks server a")
    assert(config.ssl_select(ts, "b.example") == 1, "SNI picks server b")
    assert(config.ssl_select(ts, "") == 1, "no SNI lands on default_server")
    assert(config.ssl_select(ts, "c.example") == 1, "unmatched SNI lands on default_server")

    print("ssl_resolve: every refusal named, selection pinned")
    0
}
