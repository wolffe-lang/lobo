//! check: run(exit=0, stdout="corpus ratchet: 16 configs — 7 parse-clean / 3 named-delta / 6 refused-by-name / 0 silent")
//! phase: run
//! lanes: native
//! stage-src: config
//!
//! THE RATCHET (contract target 4): the real-config corpus under
//! tests/config-corpus/, every config classified, counts GATED, zero
//! silent outcomes. fs lanes only (lupin has no fs by design). The
//! oracle-parity half lives in tools/lobo-confcheck (running child
//! processes needs the sh harness — F-0065/wolf-lang#129, ws00's D3
//! routing); THIS file is the wolf-side classification gate.
//! Classes:
//!   parse-clean — load() ok, zero named deltas (every directive
//!                 under an implemented/planned row)
//!   named-delta — load() ok, ≥1 named_error rows, each carried in
//!                 Conf.delta_at/delta_note BY NAME (the class-C
//!                 posture: lua-openresty's exhibit)
//!   refused-by-name — load() refuses with a message AND a located
//!                 file:line (ws40: a real config lobo has no row for —
//!                 `unknown directive "uwsgi_pass"` — or one nginx
//!                 refuses too, like a missing include). Every one is
//!                 annotated per config in tests/config-corpus/INDEX.md
//!                 with the directive that blocks it; the refusal names
//!                 what it refuses, so it is not silent.
//!   silent      — anything else would land here, and the count is
//!                 pinned at ZERO: a refusal with no message or no
//!                 location fails this test loudly.
//! Lane: NATIVE only since ws40. Measured at this pin: with the corpus
//! at 40 configs the checked tier answers `unsupported — step budget
//! exhausted` (kasumi, ~/lanes/ws40), so declaring the lane would pin
//! a refusal, not a run (the ssl_resolve_errors precedent). The
//! checked lane keeps exactly the coverage it had: the eight ws01 seed
//! configs, run native+checked in corpus_ratchet_seed.lu.

use config

/// The corpus ratchet counts — the lane-coverage convention, applied
/// to configs: RAISING a count is routine (add the corpus dir, bump
/// the number, done); LOWERING one needs the reason spelled out in
/// the commit message. The story so far (ws01 seed): 8 shapes —
/// nginx's own distro default + mime.types, static site with
/// gzip/expires, reverse proxy + upstream keepalive (the L002
/// exhibit), a certbot-managed vhost (ACME webroot + ssl pair +
/// options include), a redirect/rewrite farm, the fastcgi/php-fpm
/// shape, a map + if config (the L001/L003 exhibits), and the
/// OpenResty lua named_error exhibit — 7 parse clean, 1 carries its
/// named delta, 0 silent anything.
fn ratchet_configs() -> int {
    16
}

fn ratchet_parse_clean() -> int {
    7
}

fn ratchet_named_delta() -> int {
    3
}

/// ws40: real configs lobo refuses by name at load (no table row for
/// a directive, or a structural refusal nginx shares). LOWERING this
/// is the good direction (a directive landed); it still needs the
/// reason in the commit message, like every count here.
fn ratchet_refused() -> int {
    6
}

fn main() -> int {
    let root = "tests/config-corpus"
    let names = fs_read_dir(root) else |e| {
        assert(false, "corpus root missing: {root}")
        return 1
    }
    var configs: int = 0
    var clean: int = 0
    var delta: int = 0
    var refused: int = 0
    for nm in names {
        if fs_is_dir("{root}/{nm}") {
            configs = configs + 1
            let c = config.load("{root}/{nm}", "nginx.conf")
            if !config.ok(c) {
                // Refused BY NAME: a message and a located line, or it
                // is the silent class and this test fails.
                assert(
                    !c.err.is_empty() && !c.err_file.is_empty() && c.err_line > 0,
                    "SILENT corpus refusal {nm}: err=\"{c.err}\" at {c.err_file}:{c.err_line}",
                )
                refused = refused + 1
            } else if config.delta_count(c) > 0 {
                delta = delta + 1
                // Named means NAMED: every delta row carries its note.
                var i: int = 0
                while i < config.delta_count(c) {
                    assert(!c.delta_note[i].is_empty(), "unnamed delta in {nm}")
                    i = i + 1
                }
            } else {
                clean = clean + 1
            }
        }
    }
    assert(
        configs == ratchet_configs(),
        "config count moved: {configs} vs ratchet {ratchet_configs()} — raising is routine (bump the constant with the new corpus dir); silent shrinkage is not",
    )
    assert(
        clean == ratchet_parse_clean(),
        "parse-clean moved: {clean} vs ratchet {ratchet_parse_clean()}",
    )
    assert(
        delta == ratchet_named_delta(),
        "named-delta moved: {delta} vs ratchet {ratchet_named_delta()}",
    )
    assert(
        refused == ratchet_refused(),
        "refused-by-name moved: {refused} vs ratchet {ratchet_refused()}",
    )
    print(
        "corpus ratchet: {configs} configs — {clean} parse-clean / {delta} named-delta / {refused} refused-by-name / 0 silent",
    )
    0
}
