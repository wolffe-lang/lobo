//! check: run(exit=0)
//! phase: run
//! lanes: native checked lupin
//! stage-src: config
//!
//! ws41: the `user` directive. nginx drops privileges when its master
//! is root and warns when it is not (probed against nginx/1.30.4: `[warn]
//! the "user" directive makes sense only if the master process runs
//! with super-user privileges, ignored in <file>:<line>`, exit 0). ws67
//! (lobo#96): lobo drops too — as root the verdict is `drop:` and the
//! ids resolve from the account files by nginx's rules (measured as root
//! in a container, notes/ws67-contract.md §2: `user lw lwx;` is uid
//! 1500, gid 1600, groups 1600; `user lw;` takes the group NAMED lw,
//! 1500, and groups 1500 1600; an unknown name is `getpwnam("x") failed`
//! / `getgrnam("x") failed`, located). Through ws66 root was refused by
//! name. A host with no uid answer is still refused. ws68 (the `user`
//! default, ruled at audit "match nginx"): root with NO `user` line drops
//! to nginx's default `user nobody nobody`, resolved as the pinned nginx
//! was measured to resolve it (notes/ws68-contract.md §3: the account
//! named nobody; the group named nobody, else nogroup — the group is the
//! nginx build's; that gid and every group listing nobody), except where
//! no account named nobody exists (nginx refuses to start), on a host
//! that cannot drop and with `cert auto`, which keep root and say so. The
//! verdict and the resolution are pure (the uid and the texts passed in),
//! so all three lanes run them; the drop itself is tools/lobo-user's, as
//! root in a container.

use config

fn conf_of(main: str) -> config.Conf {
    config.parse_str("{main}\nhttp {{\n  server {{ listen 8080; }}\n}}\n", "t.conf")
}

fn main() -> !int {
    // ---- the row: implemented, one or two arguments, main only
    let c1 = conf_of("user www-data;")
    assert(config.ok(c1), "user parses")
    assert(config.delta_count(c1) == 0, "user is no longer a named_error delta")
    let c2 = conf_of("user nginx nginx;")
    assert(config.ok(c2), "user with a group parses")
    let c3 = conf_of("user a b c;")
    assert(!config.ok(c3), "three arguments are refused (nginx's arity: 1 or 2)")
    let cin = config.parse_str("http {{\n  user nobody;\n}}\n", "t.conf")
    assert(!config.ok(cin), "user inside http is not allowed here")

    // ---- the verdict
    let c0 = conf_of("")
    assert(config.user_verdict(c0, 1000).is_empty(), "no directive, no verdict")
    assert(config.user_verdict(c0, 0).is_empty(), "no directive, no verdict as root either")
    let w = config.user_verdict(c1, 1000)
    assert(
        w ==
            "warn:the \"user\" directive makes sense only if the master process runs with super-user privileges, ignored in t.conf:1",
        "unprivileged: nginx's warning, located: {w}",
    )
    let r = config.user_verdict(c1, 0)
    assert(r == "drop:t.conf:1", "root: the drop is asked for, located (ws41-ws66: refused): {r}")
    assert(config.user_drops(c1, 0), "root with a user line drops")
    assert(!config.user_drops(c1, 1000), "not root: no drop")
    assert(
        !config.user_drops(c0, 0),
        "root with no user line: no ROW drop (the default is default_drops)",
    )
    let u = config.user_verdict(c1, -1)
    assert(u.starts_with("emerg:"), "unknown uid: refused by name: {u}")
    assert(
        u.contains("os_euid is unsupported"),
        "unknown uid: the reason names the missing answer: {u}",
    )

    // ---- ws67: the ids, by nginx's rules, off the account files' texts
    let pw = "root:x:0:0:root:/root:/bin/sh\nlw:x:1500:1500::/nonexistent:/usr/sbin/nologin\nnobody:x:65534:65534:nobody:/:/usr/bin/nologin\n"
    let gr = "root:x:0:\nlw:x:1500:\nlwx:x:1600:lw\nnobody:x:65534:\nother:x:1700:root,lw\n"
    let a = config.user_ids(conf_of("user lw lwx;"), pw, gr)
    assert(a.ok && a.uid == 1500 && a.gid == 1600, "user lw lwx: uid 1500, gid 1600: {a}")
    assert(
        a.groups.len == 2 && a.groups[0] == 1600 && a.groups[1] == 1700,
        "user lw lwx: the group, then every group listing lw (lwx is the group itself): {a.groups}",
    )
    let b = config.user_ids(c1, pw, gr)
    assert(
        !b.ok && b.err == "getpwnam(\"www-data\") failed in t.conf:1",
        "an unknown user, nginx's words: {b.err}",
    )
    let lw = config.user_ids(conf_of("user lw;"), pw, gr)
    assert(
        lw.ok && lw.uid == 1500 && lw.gid == 1500 && lw.group == "lw",
        "user lw: the group NAMED lw: {lw}",
    )
    assert(
        lw.groups.len == 3 && lw.groups[0] == 1500 && lw.groups[1] == 1600 && lw.groups[2] == 1700,
        "user lw: 1500, then lwx and other, which list lw: {lw.groups}",
    )
    let ng = config.user_ids(conf_of("user lw nosuchgrp;"), pw, gr)
    assert(
        !ng.ok && ng.err == "getgrnam(\"nosuchgrp\") failed in t.conf:1",
        "an unknown group: {ng.err}",
    )
    let nb = config.user_ids(conf_of("user nobody;"), pw, "root:x:0:\nnogroup:x:65534:\n")
    assert(
        !nb.ok && nb.err == "getgrnam(\"nobody\") failed in t.conf:1",
        "user nobody where no group is named nobody: refused, as nginx: {nb.err}",
    )
    let none = config.user_ids(c0, pw, gr)
    assert(none.ok && none.uid == -1, "no user line: nothing to resolve")

    // ---- ws68: nginx's default, as measured (notes/ws68-contract.md §3)
    let nb_pw = "root:x:0:0::/root:/bin/sh\nnobody:x:65534:65534:Kernel Overflow User:/:/usr/bin/nologin\n"
    let arch_gr = "root:x:0:\nnobody:x:65534:\n"
    let ubu_gr = "root:x:0:\nnogroup:x:65534:\n"
    let d1 = config.default_ids(nb_pw, arch_gr)
    assert(
        d1.ok && d1.uid == 65534 && d1.gid == 65534 && d1.groups.len == 1 && d1.groups[0] == 65534,
        "arch's accounts: nobody:nobody, 65534:65534, groups 65534 (the arch-built nginx's worker): {d1}",
    )
    assert(d1.name == "nobody" && d1.group == "nobody", "the group named nobody first: {d1}")
    let d2 = config.default_ids(nb_pw, ubu_gr)
    assert(
        d2.ok && d2.uid == 65534 && d2.gid == 65534 && d2.group == "nogroup" && d2.groups.len == 1,
        "ubuntu's (no group named nobody): nogroup, 65534 (the ubuntu-built nginx's worker): {d2}",
    )
    let d3 = config.default_ids("nobody:x:99:99::/:/sbin/nologin\n", "nobody:x:99:\n")
    assert(
        d3.uid == 99 && d3.gid == 99 && d3.groups[0] == 99,
        "renumbered 99:99: read when it starts, as nginx: {d3}",
    )
    let d4 = config.default_ids(
        "nobody:x:65000:65000::/:/sbin/nologin\n",
        "nobody:x:65001:\ng650:x:65000:\n",
    )
    assert(
        d4.uid == 65000 && d4.gid == 65001,
        "the group NAMED nobody, not the account's gid: {d4}",
    )
    let d5 = config.default_ids("nobody:x:65000:65000::/:/sbin/nologin\n", ubu_gr)
    assert(
        d5.ok && d5.uid == 65000 && d5.gid == 65534,
        "no group named nobody: nogroup's gid, not the account's: {d5}",
    )
    let d6 = config.default_ids("root:x:0:0::/root:/bin/sh\n", "nobody:x:65534:\n")
    assert(
        !d6.ok && d6.err.contains("no account named \"nobody\""),
        "no account named nobody: unresolved (nginx: getpwnam(\"nobody\") failed): {d6.err}",
    )
    let d7 = config.default_ids(nb_pw, "{arch_gr}extra:x:1700:nobody\n")
    assert(
        d7.groups.len == 2 && d7.groups[0] == 65534 && d7.groups[1] == 1700,
        "a group listing nobody joins the groups (nginx: Groups: 1700 65534): {d7.groups}",
    )
    let d8 = config.default_ids("", "")
    assert(!d8.ok, "no account files at all: unresolved, as nginx with no name service: {d8.err}")
    let d9 = config.default_ids(nb_pw, "root:x:0:\nusers:x:100:\n")
    assert(
        !d9.ok && d9.err.contains("no group named \"nobody\" or \"nogroup\""),
        "the account, no group for it: unresolved (nginx: getgrnam failed): {d9.err}",
    )
    // who drops to it: root, no user line, a host that can drop, the default resolved, no cert auto
    assert(
        config.default_drops(c0, 0, true, true),
        "root, no user line, linux, nobody resolved: the default drops",
    )
    assert(!config.default_drops(c0, 1000, true, true), "not root: no drop")
    assert(
        !config.default_drops(c1, 0, true, true),
        "a user line: the row's drop, not the default's",
    )
    assert(!config.default_drops(c0, 0, false, true), "a host that cannot drop: root kept")
    assert(
        !config.default_drops(c0, 0, true, false),
        "no account named nobody: root kept (nginx would refuse)",
    )
    let ca = config.parse_str(
        "events {{\n}}\nhttp {{\n    server {{\n        listen 127.0.0.1:0 ssl;\n        server_name auto.test;\n        cert auto;\n        cert_ca http://127.0.0.1:14000/dir;\n    }}\n}}\n",
        "t.conf",
    )
    assert(config.ok(ca) && config.auto_on(ca), "a cert auto config parses")
    assert(!config.default_drops(ca, 0, true, true), "cert auto: root kept (lobo#102)")
    // the one line at start, or none (nginx prints none)
    assert(
        config.root_note(c0, 0, true, nb_pw, arch_gr).is_empty(),
        "root, nobody resolved: silent, as nginx",
    )
    assert(
        config.root_note(c0, 0, true, nb_pw, ubu_gr).is_empty(),
        "root, ubuntu's accounts: silent",
    )
    let rn_none = config.root_note(c0, 0, true, "root:x:0:0::/:/bin/sh\n", ubu_gr)
    assert(
        rn_none.starts_with(
            "running as root with no \"user\" directive and no account named \"nobody\"",
        ) &&
            rn_none.contains("lobo keeps root"),
        "no account named nobody: root kept, said once (nginx refuses to start): {rn_none}",
    )
    let rn_mac = config.root_note(c0, 0, false, nb_pw, arch_gr)
    assert(
        rn_mac.starts_with("running as root with no \"user\" directive") &&
            rn_mac.contains("cannot drop privileges"),
        "a host that cannot drop: root kept, said once: {rn_mac}",
    )
    let rn_ca = config.root_note(ca, 0, true, nb_pw, arch_gr)
    assert(
        rn_ca.contains("`cert auto`") && rn_ca.contains("lobo#102"),
        "cert auto: root kept, said once: {rn_ca}",
    )
    assert(config.root_note(c0, 1000, true, nb_pw, arch_gr).is_empty(), "not root: no note")
    assert(
        config.root_note(c1, 0, true, nb_pw, arch_gr).is_empty(),
        "root with a user line: no note",
    )

    // ---- the /proc/self/status reader (effective = the second field)
    let status = "Name:\tlobo\nUid:\t1000\t1001\t1000\t1000\nGid:\t1000\t1000\t1000\t1000\n"
    assert(config.status_euid(status) == 1001, "the effective uid is the second Uid field")
    assert(config.status_euid("Uid:\t0\t0\t0\t0\n") == 0, "root reads 0")
    assert(config.status_euid("Name:\tx\n") == -1, "no Uid line: unknown")
    assert(config.status_euid("Uid:\t7\n") == -1, "one field: unknown")
    assert(config.status_euid("Uid:\t5\t6") == 6, "no trailing separator")
    0
}
