//! check: run(exit=0)
//! phase: run
//! lanes: native checked lupin
//! stage-src: config
//!
//! The (name, context) key doing its job — the contract's demanded
//! collision unit test (`server` in `upstream` is NOT a server
//! block), the status tiers, the arity model (mime.types needs
//! at_least; exact and ranges exist), and the nearest-name engine
//! behind the unknown-directive suggestion. The generated docs page
//! is asserted to carry its counts and the generated banner.

use config

fn main() -> int {
    let t = config.table()
    // The collision: same name, two contexts, two shapes.
    let sh = config.find(t, "server", "http")
    let su = config.find(t, "server", "upstream")
    assert(sh >= 0, "server@http row exists")
    assert(su >= 0, "server@upstream row exists")
    assert(!(sh == su), "distinct rows for the collision")
    let sph = config.spec_at(t, sh)
    let spu = config.spec_at(t, su)
    assert(sph.opens == "server", "server@http opens a server block")
    assert(spu.opens == "", "server@upstream is a simple directive")
    assert(spu.min_args == 1, "pool member takes an address")
    assert(spu.max_args == -1, "pool member takes flags (at_least)")
    // Context misses vs name misses.
    assert(config.find(t, "listen", "main") == -2, "listen at main: not allowed here")
    assert(config.find(t, "flurble", "main") == -1, "no row at all")
    assert(config.find(t, "include", "types") >= 0, "include is any-context (p77)")
    // Status tiers.
    assert(
        config.spec_at(t, config.find(t, "include", "main")).status == "implemented",
        "include implemented",
    )
    assert(
        config.spec_at(t, config.find(t, "listen", "server")).status == "implemented",
        "listen implemented (status flipped at ws07 — sockets bind since ws02, ssl since ws05; the dry-run chain notes surfaced the stale row)",
    )
    assert(
        config.spec_at(t, config.find(t, "server_name", "server")).status == "planned(ws02)",
        "server_name stays planned: host matching is parse-only (what the ws07 trace explains)",
    )
    assert(
        config.spec_at(t, config.find(t, "ssl_certificate", "server")).status == "implemented",
        "ssl_certificate implemented at ws05 (the certs campaign lands)",
    )
    assert(
        config.spec_at(t, config.find(t, "ssl_session_cache", "server")).status == "planned(wsc02)",
        "resumption stays a named roadmap row (ws05 serves full handshakes only)",
    )
    assert(
        config.spec_at(t, config.find(t, "content_by_lua_block", "location")).status ==
            "named_error",
        "lua is a named error",
    )
    // The nearest-name engine.
    assert(config.nearest(t, "worker_procesess") == "worker_processes", "nearest transposition")
    assert(config.nearest(t, "porxy_pass") == "proxy_pass", "nearest swap")
    assert(config.nearest(t, "zzqqxx") == "", "nothing within distance 3")
    // The generated ledger carries its banner and counts line.
    let md = config.directives_markdown()
    assert(md.contains("GENERATED by `tools/lobo-directives`"), "docs banner")
    assert(md.contains("Status counts:"), "docs counts line")
    assert(md.contains("| `server` | upstream |"), "docs carries the collision row")
    0
}
