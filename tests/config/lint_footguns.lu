//! check: run(exit=0)
//! phase: run
//! lanes: native checked lupin
//! stage-src: config
//!
//! The three parse-visible footguns from report 11 §1C AS VERIFIED
//! (wolf/refs/articles/wws/class-c-config-footguns.md), each firing
//! on its exhibit with a span, naming nginx's behavior and wws's
//! stance:
//!   WWS-L001 if-inside-location (the "If Is Evil" wiki class)
//!   WWS-L002 proxy_set_header child presence discarding ALL parent
//!            lines (proxy module docs' iff-none inheritance rule) —
//!            the finding names exactly which parent lines stop
//!            applying
//!   WWS-L003 the alias off-by-slash traversal shape (PortSwigger/
//!            gixy advisory)
//! And the negative space: the clean shapes fire nothing.

use config

fn main() -> int {
    // L001 fires on if-in-location, with the span.
    let l1 = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    server {{\n        listen 8080;\n        location / {{\n            if ($http_x) {{\n                return 200;\n            }}\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(l1.contains("WWS-L001|t.conf:7|"), "L001 span: got\n{l1}")
    assert(l1.contains("If Is Evil"), "L001 cites the wiki")
    assert(l1.contains("wws parses the block today"), "L001 wws stance")
    // ...and NOT on if-in-server (legal, unambushed).
    let l1n = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    server {{\n        if ($http_x) {{\n            return 200;\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(!l1n.contains("WWS-L001"), "no L001 outside location: got\n{l1n}")

    // L002: a child location setting one header discards BOTH parent
    // levels' lines — the finding names each of them.
    let l2 = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    proxy_set_header Host $host;\n    server {{\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        location / {{\n            proxy_set_header X-Request-Id $request_id;\n            proxy_pass http://backend;\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(l2.contains("WWS-L002|t.conf:8|"), "L002 span is the child block: got\n{l2}")
    assert(l2.contains("t.conf:6, t.conf:7"), "L002 names the server-level lines")
    assert(l2.contains("t.conf:4"), "L002 names the http-level line")
    assert(l2.contains("if and only if there are no proxy_set_header"), "L002 quotes the rule")
    // The server level itself also shadows http's line.
    assert(l2.contains("WWS-L002|t.conf:5|"), "L002 fires per shadowing level: got\n{l2}")
    // ...and a single level sets headers with no ancestors: clean.
    let l2n = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    server {{\n        location / {{\n            proxy_set_header Host $host;\n            proxy_pass http://backend;\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(!l2n.contains("WWS-L002"), "no L002 without a shadowed parent: got\n{l2n}")

    // L003: prefix without trailing slash + alias with one.
    let l3 = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    server {{\n        location /i {{\n            alias /data/w3/images/;\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(l3.contains("WWS-L003|t.conf:6|"), "L003 span: got\n{l3}")
    assert(l3.contains("off-by-slash"), "L003 names the class")
    assert(l3.contains("/i../secret"), "L003 shows the escape under this location")
    // Matching slashes: clean. Exact-match location: clean.
    let l3n = config.
        lint(
        config.
            parse_str(
            "events {{\n}}\nhttp {{\n    server {{\n        location /i/ {{\n            alias /data/w3/images/;\n        }}\n        location = /x {{\n            alias /data/x/;\n        }}\n    }}\n}}\n",
            "t.conf",
        ),
    )
    assert(!l3n.contains("WWS-L003"), "no L003 on matched slashes or exact: got\n{l3n}")
    0
}
